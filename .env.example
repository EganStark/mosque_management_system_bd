# Server
PORT=3000
NODE_ENV=development
TRUST_PROXY=false
LANDING_PAGE_ORIGIN=http://localhost:8080
LANDING_PAGE_URL=http://localhost:8080
SESSION_SECRET=change-this-to-a-long-random-string
CSRF_SECRET=change-this-to-another-long-random-string
SUBMISSION_HASH_SECRET=change-this-to-a-separate-random-string
# In production, all three secrets above must be different and at least 32 characters.

# PostgreSQL connection
DATABASE_URL=postgres://postgres:postgres@localhost:5432/baitur_rahman
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/baitur_rahman_test
# Used by scripts/create-db.js to connect to the maintenance DB and create the app DB
PGADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres
DB_NAME=baitur_rahman

# Storage: use "local" for a persistent disk or "supabase" for free object storage.
STORAGE_PROVIDER=local
# Local provider paths. Production values must be explicit absolute paths.
IMAGE_UPLOAD_DIR=
DOCUMENT_STORAGE_DIR=
BACKUP_STORAGE_DIR=
BACKUP_RETENTION_DAYS=30

# Supabase provider. Never expose the service-role key to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLIC_BUCKET=public-media
SUPABASE_PRIVATE_BUCKET=private-documents
SUPABASE_BACKUP_BUCKET=database-backups

# Seeded super-admin account (created by `npm run seed`)
ADMIN_NAME=Administrator
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe@123

# Optional public portfolio account. It receives administrator-level read access,
# while server middleware blocks every state-changing request for this username.
DEMO_MODE=false
DEMO_NAME=Demo Administrator
DEMO_USERNAME=demo
DEMO_EMAIL=demo@example.invalid
DEMO_PASSWORD=Choose-A-Separate-Strong-Demo-Password

# Optional SMS gateway. Keep disabled until URL/token are supplied and tested.
SMS_GATEWAY_ENABLED=false
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
SMS_SENDER_ID=
SMS_UNIT_COST=0
SMS_COST_CURRENCY=BDT
SMS_WEBHOOK_SECRET=change-this-to-a-long-random-webhook-secret
