<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4"><div><p class="text-uppercase text-primary fw-bold small mb-1">Community welfare</p><h3 class="mb-1">কল্যাণ ও সহায়তা</h3><p class="text-muted mb-0">যাকাত, সদকা, চিকিৎসা, শিক্ষা ও জরুরি সহায়তার স্বচ্ছ ব্যবস্থাপনা</p></div></div>
<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-5 gap-4 mb-4"><div class="card"><div class="card-body"><p class="small text-muted mb-1">যোগ্য উপকারভোগী</p><h4><%= bn.num(summary.eligible) %></h4></div></div><div class="card"><div class="card-body"><p class="small text-muted mb-1">অপেক্ষমান আবেদন</p><h4><%= bn.num(summary.pending) %></h4></div></div><div class="card"><div class="card-body"><p class="small text-muted mb-1">জরুরি</p><h4 class="text-danger"><%= bn.num(summary.urgent) %></h4></div></div><div class="card"><div class="card-body"><p class="small text-muted mb-1">অনুমোদিত</p><h4>৳ <%= bn.money(summary.approved) %></h4></div></div><div class="card"><div class="card-body"><p class="small text-muted mb-1">বিতরণ</p><h4 class="text-success">৳ <%= bn.money(summary.disbursed) %></h4></div></div></div>
<div class="row g-4 mb-4"><div class="col-xl-6"><div class="card h-100"><div class="card-header">উপকারভোগী নিবন্ধন</div><div class="card-body"><form method="post" action="/welfare/beneficiaries" class="row g-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><div class="col-12"><label class="form-label">নিবন্ধিত সদস্য</label><select name="member_id" class="form-select select2"><option value="">সদস্য না হলে নিচে তথ্য দিন</option><% memberOptions.forEach(function(m){ %><option value="<%= m.id %>"><%= m.id_no %> — <%= m.name %> — <%= m.phone||'' %></option><% }) %></select></div><div class="col-md-6"><label class="form-label">নাম</label><input name="name" class="form-control"/></div><div class="col-md-6"><label class="form-label">মোবাইল</label><input name="phone" class="form-control"/></div><div class="col-md-6"><label class="form-label">পরিবারের সদস্য</label><input type="number" min="1" name="household_size" class="form-control"/></div><div class="col-md-6"><label class="form-label">মাসিক আয়</label><input type="number" min="0" step="0.01" name="monthly_income" class="form-control"/></div><div class="col-md-6"><label class="form-label">পরিচয় রেফারেন্স</label><input name="identity_reference" class="form-control"/></div><div class="col-md-6"><label class="form-label">ঠিকানা</label><input name="address" class="form-control"/></div><div class="col-12"><label class="form-label">যাচাই নোট</label><input name="verification_notes" class="form-control"/></div><div class="col-12"><button class="btn btn-primary">উপকারভোগী সংরক্ষণ</button></div></form></div></div></div>
<div class="col-xl-6"><div class="card h-100"><div class="card-header">নতুন সহায়তার আবেদন</div><div class="card-body"><form method="post" action="/welfare/applications" class="row g-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><div class="col-12"><label class="form-label required">উপকারভোগী</label><select name="beneficiary_id" class="form-select select2" required><option value="">নির্বাচন করুন</option><% beneficiaries.forEach(function(b){ %><option value="<%= b.id %>"><%= b.name %> — <%= b.phone||'' %> — <%= b.eligibility_status==='eligible'?'যোগ্য':b.eligibility_status==='ineligible'?'অযোগ্য':'যাচাই হয়নি' %></option><% }) %></select></div><div class="col-md-6"><label class="form-label required">সহায়তার ধরন</label><select name="assistance_type" class="form-select"><option value="medical">চিকিৎসা</option><option value="food">খাদ্য</option><option value="education">শিক্ষা</option><option value="housing">বাসস্থান</option><option value="emergency">জরুরি</option><option value="livelihood">জীবিকা</option><option value="other">অন্যান্য</option></select></div><div class="col-md-6"><label class="form-label required">তহবিল উৎস</label><select name="fund_source" class="form-select"><option value="zakat">যাকাত</option><option value="sadaqah">সদকা</option><option value="general">সাধারণ</option><option value="emergency">জরুরি তহবিল</option></select></div><div class="col-md-6"><label class="form-label required">প্রয়োজনীয় পরিমাণ</label><input type="number" min="0.01" step="0.01" name="requested_amount" class="form-control" required/></div><div class="col-md-6"><label class="form-label">জরুরিতা</label><select name="urgency" class="form-select"><option value="normal">সাধারণ</option><option value="urgent">জরুরি</option><option value="emergency">অতি জরুরি</option></select></div><div class="col-12"><label class="form-label required">সহায়তার কারণ</label><textarea name="reason" class="form-control" rows="3" required></textarea></div><div class="col-12"><button class="btn btn-primary">আবেদন তৈরি</button></div></form></div></div></div></div>
<div class="card"><div class="card-header">সহায়তার আবেদনসমূহ</div><div class="card-body"><div class="table-responsive"><table class="table table-hover datatable w-100"><thead><tr><th>আবেদন</th><th>উপকারভোগী</th><th>ধরন</th><th>তহবিল</th><th>অনুরোধ</th><th>বিতরণ</th><th>অবস্থা</th><th></th></tr></thead><tbody><% rows.forEach(function(r){ %><tr><td><strong><%= r.application_no %></strong><small class="d-block text-muted"><%= r.urgency %></small></td><td><%= r.beneficiary_name %><small class="d-block text-muted"><%= r.phone||'' %></small></td><td><%= r.assistance_type %></td><td><%= r.fund_source %></td><td>৳ <%= bn.money(r.requested_amount) %></td><td>৳ <%= bn.money(r.disbursed_amount) %></td><td><span class="badge <%= r.status==='paid'?'bg-success-subtle text-success':r.status==='rejected'?'bg-danger-subtle text-danger':'bg-warning-subtle text-warning' %>"><%= ({pending:'অপেক্ষমান',approved:'অনুমোদিত',partial:'আংশিক বিতরণ',paid:'সম্পূর্ণ বিতরণ',rejected:'বাতিল'})[r.status] %></span></td><td><a href="/welfare/<%= r.id %>" class="btn btn-sm btn-outline-primary">বিস্তারিত</a></td></tr><% }) %></tbody></table></div></div></div>
