<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4"><div><p class="text-uppercase text-primary fw-bold small mb-1">Store control</p><h3 class="mb-1">স্টোর ও মজুত ব্যবস্থাপনা</h3><p class="text-muted mb-0">ব্যবহারযোগ্য সামগ্রী, গ্রহণ, ইস্যু, প্রকৃত গণনা ও পুনঃঅর্ডার সতর্কতা</p></div></div>
<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 mb-4"><div class="card"><div class="card-body"><p class="small text-muted mb-1">সক্রিয় আইটেম</p><h4><%= bn.num(summary.items) %></h4></div></div><div class="card"><div class="card-body"><p class="small text-muted mb-1">কম মজুত</p><h4 class="text-danger"><%= bn.num(summary.low) %></h4></div></div><div class="card"><div class="card-body"><p class="small text-muted mb-1">মজুতের মূল্য</p><h4>৳ <%= bn.money(summary.value) %></h4></div></div><div class="card"><div class="card-body"><p class="small text-muted mb-1">এই মাসে ইস্যু</p><h4><%= bn.num(summary.issued) %></h4></div></div></div>
<% if(currentUser.role==='admin'){ %><div class="card mb-4"><div class="card-header">নতুন স্টক আইটেম</div><div class="card-body"><form method="post" action="/inventory" class="row g-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><div class="col-md-3"><label class="form-label">আইটেমের নাম</label><input name="name" class="form-control" required/></div><div class="col-md-2"><label class="form-label">শ্রেণি</label><select name="category_id" class="form-select"><option value="">অন্যান্য</option><% categories.forEach(function(c){ %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select></div><div class="col-md-2"><label class="form-label">একক</label><input name="unit" class="form-control" placeholder="টি/কেজি/লিটার" required/></div><div class="col-md-2"><label class="form-label">সংরক্ষণের স্থান</label><input name="storage_location" class="form-control"/></div><div class="col-md-1"><label class="form-label">সতর্কতা</label><input type="number" min="0" step="0.01" name="reorder_level" value="0" class="form-control"/></div><div class="col-md-2"><label class="form-label">পুনঃঅর্ডার পরিমাণ</label><input type="number" min="0" step="0.01" name="reorder_quantity" value="0" class="form-control"/></div><div class="col-12"><label class="form-label">বিবরণ</label><input name="description" class="form-control"/></div><div class="col-12"><button class="btn btn-primary">আইটেম তৈরি করুন</button></div></form></div></div><% } %>
<div class="card"><div class="card-body"><div class="table-responsive"><table class="table table-hover datatable w-100"><thead><tr><th>কোড</th><th>আইটেম</th><th>শ্রেণি</th><th>অবস্থান</th><th>বর্তমান মজুত</th><th>গড় দর</th><th>মূল্য</th><th></th></tr></thead><tbody><% rows.forEach(function(i){ var low=Number(i.stock_quantity)<=Number(i.reorder_level); %><tr class="<%= low?'table-warning':'' %>"><td><strong><%= i.item_code %></strong></td><td><%= i.name %><% if(low){ %><small class="d-block text-danger">পুনঃঅর্ডার প্রয়োজন: <%= bn.num(i.reorder_quantity) %> <%= i.unit %></small><% } %></td><td><%= i.category_name||'—' %></td><td><%= i.storage_location||'—' %></td><td><strong><%= bn.num(i.stock_quantity) %> <%= i.unit %></strong></td><td>৳ <%= bn.money(i.average_unit_cost) %></td><td>৳ <%= bn.money(Number(i.stock_quantity)*Number(i.average_unit_cost)) %></td><td><a href="/inventory/<%= i.id %>" class="btn btn-sm btn-outline-primary">লেজার</a></td></tr><% }) %></tbody></table></div></div></div>
