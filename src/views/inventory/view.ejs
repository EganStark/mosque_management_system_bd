<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4"><div><p class="text-uppercase text-primary fw-bold small mb-1"><%= item.item_code %> · <%= item.category_name||'অন্যান্য' %></p><h3 class="mb-1"><%= item.name %></h3><p class="text-muted mb-0"><%= item.description||'' %> · সংরক্ষণ: <%= item.storage_location||'নির্ধারিত নয়' %></p></div><div class="d-flex gap-2"><a href="/inventory" class="btn btn-outline-secondary">সব আইটেম</a><button onclick="window.print()" class="btn btn-outline-primary">লেজার প্রিন্ট</button></div></div>
<div class="row g-4 mb-4"><div class="col-md-4"><div class="card h-100"><div class="card-body"><p class="text-muted mb-1">বর্তমান মজুত</p><h2><%= bn.num(item.stock_quantity) %> <small><%= item.unit %></small></h2><p class="mb-0 <%= Number(item.stock_quantity)<=Number(item.reorder_level)?'text-danger':'text-success' %>"><%= Number(item.stock_quantity)<=Number(item.reorder_level)?'পুনঃঅর্ডার প্রয়োজন':'পর্যাপ্ত মজুত' %></p></div></div></div><div class="col-md-4"><div class="card h-100"><div class="card-body"><p class="text-muted mb-1">গড় একক দর</p><h2>৳ <%= bn.money(item.average_unit_cost) %></h2><p class="mb-0 text-muted">মোট মূল্য ৳ <%= bn.money(Number(item.stock_quantity)*Number(item.average_unit_cost)) %></p></div></div></div><div class="col-md-4"><div class="card h-100"><div class="card-body"><p class="text-muted mb-1">পুনঃঅর্ডার সীমা</p><h2><%= bn.num(item.reorder_level) %> <small><%= item.unit %></small></h2><p class="mb-0 text-muted">প্রস্তাবিত ক্রয় <%= bn.num(item.reorder_quantity) %> <%= item.unit %></p></div></div></div></div>
<% if(currentUser.role!=='viewer'){ %><div class="row g-4 mb-4"><div class="col-lg-6"><div class="card h-100"><div class="card-header">স্টক গ্রহণ</div><div class="card-body"><form method="post" action="/inventory/<%= item.id %>/receive" class="row g-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><div class="col-4"><label class="form-label">পরিমাণ</label><input type="number" min="0.01" step="0.01" name="quantity" class="form-control" required/></div><div class="col-4"><label class="form-label">একক দর</label><input type="number" min="0" step="0.01" name="unit_cost" class="form-control" required/></div><div class="col-4"><label class="form-label">তারিখ</label><input type="date" name="movement_date" value="<%= new Date().toISOString().slice(0,10) %>" class="form-control" required/></div><div class="col-12"><label class="form-label">ক্রয় গ্রহণপত্র</label><select name="goods_receipt_id" class="form-select"><option value="">সরাসরি/প্রারম্ভিক মজুত</option><% receipts.forEach(function(r){ %><option value="<%= r.id %>"><%= r.receipt_no %> · <%= r.order_no %> · <%= r.vendor_name %></option><% }) %></select></div><div class="col-12"><input name="external_reference" class="form-control" placeholder="চালান বা রেফারেন্স"/></div><div class="col-12"><textarea name="notes" class="form-control" placeholder="মন্তব্য"></textarea></div><div class="col-12"><button class="btn btn-success">স্টক গ্রহণ করুন</button></div></form></div></div></div><div class="col-lg-6"><div class="card h-100"><div class="card-header">স্টক ইস্যু</div><div class="card-body"><form method="post" action="/inventory/<%= item.id %>/issue" class="row g-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><div class="col-6"><label class="form-label">পরিমাণ</label><input type="number" min="0.01" max="<%= item.stock_quantity %>" step="0.01" name="quantity" class="form-control" required/></div><div class="col-6"><label class="form-label">তারিখ</label><input type="date" name="movement_date" value="<%= new Date().toISOString().slice(0,10) %>" class="form-control" required/></div><div class="col-4"><select name="issued_to_staff_id" class="form-select"><option value="">স্টাফ</option><% staff.forEach(function(s){ %><option value="<%= s.id %>"><%= s.name_bn %></option><% }) %></select></div><div class="col-4"><select name="facility_id" class="form-select"><option value="">সুবিধা/কক্ষ</option><% facilities.forEach(function(f){ %><option value="<%= f.id %>"><%= f.name %></option><% }) %></select></div><div class="col-4"><select name="program_id" class="form-select"><option value="">প্রোগ্রাম</option><% programs.forEach(function(p){ %><option value="<%= p.id %>"><%= p.name %></option><% }) %></select></div><div class="col-12"><input name="recipient_name" class="form-control" placeholder="অন্যান্য প্রাপক/কাজ"/></div><div class="col-12"><textarea name="notes" class="form-control" placeholder="ব্যবহারের উদ্দেশ্য"></textarea></div><div class="col-12"><button class="btn btn-primary">স্টক ইস্যু করুন</button></div></form></div></div></div></div><% } %>
<% if(currentUser.role==='admin'){ %><div class="card mb-4"><div class="card-header">প্রকৃত গণনা অনুযায়ী সমন্বয়</div><div class="card-body"><form method="post" action="/inventory/<%= item.id %>/adjust" class="row g-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><div class="col-md-3"><input type="number" min="0" step="0.01" name="counted_quantity" class="form-control" placeholder="গণনাকৃত মজুত" required/></div><div class="col-md-3"><input type="date" name="movement_date" value="<%= new Date().toISOString().slice(0,10) %>" class="form-control" required/></div><div class="col-md-4"><input name="notes" class="form-control" placeholder="সমন্বয়ের কারণ" required/></div><div class="col-md-2"><button class="btn btn-outline-warning w-100">সমন্বয়</button></div></form></div></div><% } %>
<div class="card"><div class="card-header">স্টক লেজার</div><div class="card-body"><div class="table-responsive"><table class="table datatable w-100"><thead><tr><th>রেফারেন্স</th><th>তারিখ</th><th>ধরন</th><th>পরিমাণ</th><th>পরবর্তী মজুত</th><th>দর</th><th>প্রাপক/উৎস</th><th>মন্তব্য</th></tr></thead><tbody><% item.movements.forEach(function(m){ %><tr><td><%= m.reference_no %></td><td><%= bn.date(m.movement_date) %></td><td><%= ({receipt:'গ্রহণ',issue:'ইস্যু',adjustment:'সমন্বয়'})[m.movement_type] %></td><td class="<%= Number(m.quantity)>=0?'text-success':'text-danger' %>"><%= Number(m.quantity)>0?'+':'' %><%= bn.num(m.quantity) %></td><td><strong><%= bn.num(m.balance_after) %></strong></td><td>৳ <%= bn.money(m.unit_cost) %></td><td><%= m.receipt_no||m.staff_name||m.facility_name||m.program_name||m.recipient_name||'—' %></td><td><%= m.notes||'—' %></td></tr><% }) %></tbody></table></div></div></div>
