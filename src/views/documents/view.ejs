<div class="document-toolbar no-print"><a href="/documents" class="btn btn-outline-secondary">নথি রেজিস্টার</a><div class="d-flex flex-wrap gap-2"><% if(currentUser.role!=='viewer'&&['draft','rejected'].includes(item.status)){ %><a href="/documents/<%= item.id %>/edit" class="btn btn-outline-primary">সম্পাদনা</a><form method="post" action="/documents/<%= item.id %>/submit"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><button class="btn btn-primary">অনুমোদনে পাঠান</button></form><% } %><% if(currentUser.role==='admin'&&item.status==='approved'){ %><form method="post" action="/documents/<%= item.id %>/issue"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><button class="btn btn-success">জারি করুন</button></form><% } %><% if(currentUser.role==='admin'&&['approved','issued'].includes(item.status)){ %><form method="post" action="/documents/<%= item.id %>/archive"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><button class="btn btn-outline-secondary">আর্কাইভ</button></form><% } %><button onclick="window.print()" class="btn btn-outline-primary"><i class="bi bi-printer me-1"></i> প্রিন্ট</button></div></div>
<section class="official-document mb-4"><% if(item.status==='draft'){ %><div class="document-watermark">খসড়া</div><% } %><header class="official-document__header"><% if(company&&company.logo){ %><img src="<%= company.logo %>" alt=""/><% }else{ %><span class="material-symbols-outlined">mosque</span><% } %><div><h2><%= company&&company.company_name?company.company_name:'Noor Community Mosque' %></h2><p><%= company&&company.company_address?company.company_address:'' %></p><p><%= company&&company.company_phone?'ফোন: '+company.company_phone:'' %></p></div><strong class="document-copy-label"><%= ({draft:'খসড়া',pending:'অপেক্ষমাণ',approved:'অনুমোদিত',issued:'জারি',rejected:'সংশোধন',archived:'আর্কাইভ'})[item.status] %></strong></header><div class="official-document__title"><h3><%= item.title %></h3><span>নং: <strong><%= item.reference_no %></strong></span></div><div class="document-meta"><span>তারিখ: <strong><%= bn.date(item.issue_date) %></strong></span><span>সংস্করণ: <strong><%= bn.num(item.current_version) %></strong></span><span>শ্রেণি: <strong><%= ({public:'প্রকাশযোগ্য',internal:'অভ্যন্তরীণ',confidential:'গোপনীয়'})[item.confidentiality] %></strong></span></div><% if(item.recipient_name){ %><div class="mb-3"><strong>প্রাপক</strong><br/><%= item.recipient_name %><% if(item.recipient_address){ %><br/><span class="text-muted"><%= item.recipient_address %></span><% } %></div><% } %><% if(item.subject){ %><p><strong>বিষয়: <%= item.subject %></strong></p><% } %><div style="white-space:pre-line;min-height:300px"><%= item.content||'' %></div><footer class="document-signatures"><div><span>প্রস্তুতকারী</span><small><%= item.creator_name||'' %></small></div><div><span>অনুমোদনকারী</span><small><%= item.approver_name||'' %></small></div><div><span>অফিস সিল</span></div></footer></section>
<div class="row g-4 no-print"><div class="col-lg-7"><div class="card mb-4"><div class="card-header">সংযুক্তি</div><div class="card-body"><% if(!item.attachments.length){ %><p class="text-muted mb-0">কোনো ফাইল সংযুক্ত নেই।</p><% } %><div class="list-group list-group-flush"><% item.attachments.forEach(function(a){ %><a href="/documents/attachments/<%= a.id %>" class="list-group-item list-group-item-action d-flex justify-content-between"><span><i class="bi bi-paperclip me-2"></i><%= a.original_name %></span><small><%= (Number(a.file_size)/1024/1024).toFixed(2) %> MB</small></a><% }) %></div></div></div><div class="card"><div class="card-header">সংস্করণ ইতিহাস</div><div class="card-body"><% item.versions.forEach(function(v){ %><div class="d-flex justify-content-between border-bottom py-2"><span>সংস্করণ <%= bn.num(v.version_no) %> · <%= v.title %></span><small class="text-muted"><%= v.creator_name||'—' %> · <%= bn.date(v.created_at) %></small></div><% }) %></div></div></div><div class="col-lg-5"><% if(currentUser.role==='admin'&&item.status==='pending'){ %><div class="card mb-4"><div class="card-header">অনুমোদনের সিদ্ধান্ত</div><div class="card-body"><form method="post" action="/documents/<%= item.id %>/decision"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><textarea name="comments" class="form-control mb-3" placeholder="মন্তব্য বা সংশোধনের নির্দেশনা"></textarea><div class="d-flex gap-2"><button name="action" value="approve" class="btn btn-success flex-fill">অনুমোদন</button><button name="action" value="reject" class="btn btn-outline-danger flex-fill">সংশোধনে ফেরত</button></div></form></div></div><% } %><div class="card"><div class="card-header">অনুমোদন লগ</div><div class="card-body"><% item.approvals.forEach(function(a){ %><div class="border-start border-2 ps-3 pb-3"><strong><%= ({created:'খসড়া তৈরি',revised:'নতুন সংস্করণ',submit:'অনুমোদনে প্রেরণ',approve:'অনুমোদন',reject:'সংশোধনে ফেরত',issue:'জারি',archive:'আর্কাইভ'})[a.action]||a.action %></strong><small class="d-block text-muted"><%= a.actor_name||'—' %> · <%= bn.date(a.acted_at) %></small><% if(a.comments){ %><p class="small mb-0"><%= a.comments %></p><% } %></div><% }) %></div></div></div></div>
