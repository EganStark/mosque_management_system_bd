<div class="d-flex justify-content-between align-items-center mb-4"><div><p class="text-uppercase text-primary fw-bold small mb-1">Controlled document</p><h3><%= item?'নথি সম্পাদনা':'নতুন নথি তৈরি' %></h3></div><a href="<%= item?'/documents/'+item.id:'/documents' %>" class="btn btn-outline-secondary">ফিরে যান</a></div>
<div class="card"><div class="card-body"><form method="post" enctype="multipart/form-data" action="<%= item?'/documents/'+item.id+'/edit':'/documents' %>?_csrf=<%= encodeURIComponent(csrfToken) %>" class="row g-3"><div class="col-md-4"><label class="form-label">নথির ধরন</label><select name="document_type" class="form-select" required <%= item?'disabled':'' %>><% [['notice','নোটিশ'],['letter','চিঠি'],['certificate','সনদ'],['resolution','সিদ্ধান্ত'],['agreement','চুক্তি'],['other','অন্যান্য']].forEach(function(x){ %><option value="<%= x[0] %>" <%= item&&item.document_type===x[0]?'selected':'' %>><%= x[1] %></option><% }) %></select><% if(item){ %><input type="hidden" name="document_type" value="<%= item.document_type %>"/><% } %></div><div class="col-md-5"><label class="form-label">শিরোনাম</label><input name="title" value="<%= item?item.title:'' %>" class="form-control" required/></div><div class="col-md-3"><label class="form-label">তারিখ</label><input type="date" name="issue_date" value="<%= item?new Date(item.issue_date).toISOString().slice(0,10):new Date().toISOString().slice(0,10) %>" class="form-control" required/></div><div class="col-md-8"><label class="form-label">বিষয়</label><input name="subject" value="<%= item&&item.subject?item.subject:'' %>" class="form-control"/></div><div class="col-md-4"><label class="form-label">গোপনীয়তা</label><select name="confidentiality" class="form-select"><option value="internal" <%= item&&item.confidentiality==='internal'?'selected':'' %>>অভ্যন্তরীণ</option><option value="public" <%= item&&item.confidentiality==='public'?'selected':'' %>>প্রকাশযোগ্য</option><option value="confidential" <%= item&&item.confidentiality==='confidential'?'selected':'' %>>গোপনীয়</option></select></div><div class="col-md-6"><label class="form-label">প্রাপক</label><input name="recipient_name" value="<%= item&&item.recipient_name?item.recipient_name:'' %>" class="form-control"/></div><div class="col-md-6"><label class="form-label">সংশ্লিষ্ট সদস্য</label><select name="related_member_id" class="form-select"><option value="">প্রযোজ্য নয়</option><% members.forEach(function(m){ %><option value="<%= m.id %>" <%= item&&Number(item.related_member_id)===Number(m.id)?'selected':'' %>><%= m.id_no %> — <%= m.name %></option><% }) %></select></div><div class="col-12"><label class="form-label">প্রাপকের ঠিকানা</label><input name="recipient_address" value="<%= item&&item.recipient_address?item.recipient_address:'' %>" class="form-control"/></div><div class="col-12"><label class="form-label">নথির মূল লেখা</label><textarea name="content" rows="12" class="form-control"><%= item&&item.content?item.content:'' %></textarea></div><div class="col-12"><label class="form-label">সংযুক্তি <small class="text-muted">PDF, DOC, DOCX, JPG বা PNG; সর্বোচ্চ ১০ MB</small></label><input type="file" name="attachment" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" class="form-control"/></div><div class="col-12"><button class="btn btn-primary"><%= item?'নতুন সংস্করণ সংরক্ষণ':'খসড়া তৈরি করুন' %></button></div></form></div></div>
