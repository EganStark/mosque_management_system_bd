<div class="d-flex justify-content-between align-items-center mb-4"><div><p class="text-uppercase text-primary fw-bold small mb-1">Smart document generator</p><h3 class="mb-1">চিঠি ও সনদ তৈরি</h3><p class="text-muted mb-0">বিদ্যমান রেকর্ড থেকে নির্ভুল, নম্বরযুক্ত ও অনুমোদনযোগ্য নথি তৈরি করুন</p></div><a href="/documents" class="btn btn-outline-secondary">নথি রেজিস্টার</a></div>
<form method="post" action="/documents/generate" class="row g-4"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><div class="col-xl-5"><div class="card h-100"><div class="card-header">১. নথির টেমপ্লেট</div><div class="card-body"><div class="mb-3"><label class="form-label required">টেমপ্লেট</label><select id="templateKey" name="template_key" class="form-select" required><option value="member_certificate">সদস্যপদ প্রত্যয়নপত্র</option><option value="donation_acknowledgement">দান প্রাপ্তির স্বীকৃতিপত্র</option><option value="welfare_approval">সহায়তা অনুমোদনপত্র</option><option value="staff_certificate">কর্মরত থাকার প্রত্যয়নপত্র</option><option value="general_letter">সাধারণ চিঠি</option></select></div>
<div class="source-field" data-for="member_certificate"><label class="form-label">সদস্য</label><select class="form-select select2" data-source="member_certificate"><option value="">নির্বাচন করুন</option><% options.members.forEach(function(x){ %><option value="<%= x.id %>"><%= x.id_no %> — <%= x.name %></option><% }) %></select></div>
<div class="source-field" data-for="donation_acknowledgement"><label class="form-label">আদায়ের রশিদ</label><select class="form-select select2" data-source="donation_acknowledgement"><option value="">নির্বাচন করুন</option><% options.collections.forEach(function(x){ %><option value="<%= x.id %>"><%= x.receipt_no %> — <%= x.member_name||x.payer_name||'দাতা' %> — ৳ <%= bn.money(x.amount) %></option><% }) %></select></div>
<div class="source-field" data-for="welfare_approval"><label class="form-label">সহায়তার আবেদন</label><select class="form-select select2" data-source="welfare_approval"><option value="">নির্বাচন করুন</option><% options.welfare.forEach(function(x){ %><option value="<%= x.id %>"><%= x.application_no %> — <%= x.beneficiary_name %></option><% }) %></select></div>
<div class="source-field" data-for="staff_certificate"><label class="form-label">স্টাফ</label><select class="form-select select2" data-source="staff_certificate"><option value="">নির্বাচন করুন</option><% options.staff.forEach(function(x){ %><option value="<%= x.id %>"><%= x.name_bn %> — <%= x.position_bn||'' %></option><% }) %></select></div>
<input type="hidden" id="sourceId" name="source_id"/><div id="generalFields" hidden><div class="mb-3"><label class="form-label">শিরোনাম</label><input name="title" class="form-control"/></div><div class="mb-3"><label class="form-label">বিষয়</label><input name="subject" class="form-control"/></div><div class="mb-3"><label class="form-label">প্রাপক</label><input name="recipient_name" class="form-control"/></div><div class="mb-3"><label class="form-label">ঠিকানা</label><input name="recipient_address" class="form-control"/></div><label class="form-label">মূল লেখা</label><textarea name="content" rows="7" class="form-control"></textarea></div></div></div></div>
<div class="col-xl-7"><div class="card h-100"><div class="card-header">২. ইস্যু ও স্বাক্ষর</div><div class="card-body row g-3"><div class="col-md-6"><label class="form-label required">ইস্যুর তারিখ</label><input type="date" name="issue_date" value="<%= new Date().toISOString().slice(0,10) %>" class="form-control" required/></div><div class="col-md-6"><label class="form-label">প্রধান স্বাক্ষরকারী</label><input name="signatory_name" class="form-control" placeholder="নাম"/></div><div class="col-md-6"><label class="form-label">প্রধান স্বাক্ষরকারীর পদ</label><input name="signatory_title" class="form-control" placeholder="সভাপতি/সাধারণ সম্পাদক"/></div><div class="col-md-6"><label class="form-label">দ্বিতীয় স্বাক্ষরকারী</label><input name="secondary_signatory_name" class="form-control" placeholder="নাম"/></div><div class="col-md-6"><label class="form-label">দ্বিতীয় স্বাক্ষরকারীর পদ</label><input name="secondary_signatory_title" class="form-control" placeholder="পদবি"/></div><div class="col-12"><div class="alert alert-info mb-0">নথিটি প্রথমে খসড়া হিসেবে তৈরি হবে। যাচাইয়ের পরে অনুমোদন ও ইস্যু করুন। প্রিন্ট ডায়ালগ থেকে “Save as PDF” নির্বাচন করে PDF সংরক্ষণ করা যাবে।</div></div><div class="col-12"><button class="btn btn-primary">খসড়া নথি তৈরি করুন</button></div></div></div></div></form>
<script>document.addEventListener('DOMContentLoaded',function(){var key=document.getElementById('templateKey'),target=document.getElementById('sourceId'),general=document.getElementById('generalFields');function sync(){var k=key.value;document.querySelectorAll('.source-field').forEach(function(f){var show=f.dataset.for===k;f.hidden=!show;var s=f.querySelector('select');if(show){target.value=s.value;s.onchange=function(){target.value=s.value;};}});general.hidden=k!=='general_letter';if(k==='general_letter')target.value='';}key.addEventListener('change',sync);sync();});</script>
