<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4"><div><p class="text-uppercase text-primary fw-bold small mb-1">Document control</p><h3 class="mb-1">নথি ও ডিজিটাল আর্কাইভ</h3><p class="text-muted mb-0">চিঠি, নোটিশ, সনদ, চুক্তি ও অনুমোদনের নিয়ন্ত্রিত রেজিস্টার</p></div><% if(currentUser.role!=='viewer'){ %><div class="d-flex gap-2"><a href="/documents/generate" class="btn btn-primary"><i class="bi bi-magic me-1"></i> চিঠি ও সনদ তৈরি</a><a href="/documents/new" class="btn btn-outline-primary"><i class="bi bi-file-earmark-plus me-1"></i> ফাঁকা নথি</a></div><% } %></div>
<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 mb-4"><div class="card"><div class="card-body"><p class="small text-muted mb-1">সর্বমোট নথি</p><h4><%= bn.num(summary.total) %></h4></div></div><div class="card"><div class="card-body"><p class="small text-muted mb-1">খসড়া</p><h4><%= bn.num(summary.drafts) %></h4></div></div><div class="card"><div class="card-body"><p class="small text-muted mb-1">অনুমোদনের অপেক্ষায়</p><h4 class="text-warning"><%= bn.num(summary.pending) %></h4></div></div><div class="card"><div class="card-body"><p class="small text-muted mb-1">অনুমোদিত/জারি</p><h4 class="text-success"><%= bn.num(summary.official) %></h4></div></div></div>
<div class="card mb-4"><div class="card-body"><form class="row g-2"><div class="col-md-5"><input name="q" value="<%= filters.q %>" class="form-control" placeholder="রেফারেন্স, শিরোনাম বা প্রাপক খুঁজুন"/></div><div class="col-md-3"><select name="type" class="form-select"><option value="">সব ধরনের নথি</option><% [['notice','নোটিশ'],['letter','চিঠি'],['certificate','সনদ'],['resolution','সিদ্ধান্ত'],['agreement','চুক্তি'],['other','অন্যান্য']].forEach(function(x){ %><option value="<%= x[0] %>" <%= filters.type===x[0]?'selected':'' %>><%= x[1] %></option><% }) %></select></div><div class="col-md-2"><select name="status" class="form-select"><option value="">সব অবস্থা</option><% [['draft','খসড়া'],['pending','অপেক্ষমাণ'],['approved','অনুমোদিত'],['issued','জারি'],['rejected','ফেরত'],['archived','আর্কাইভ']].forEach(function(x){ %><option value="<%= x[0] %>" <%= filters.status===x[0]?'selected':'' %>><%= x[1] %></option><% }) %></select></div><div class="col-md-2"><button class="btn btn-outline-primary w-100">ফিল্টার</button></div></form></div></div>
<div class="card"><div class="card-body"><div class="table-responsive"><table class="table table-hover datatable w-100"><thead><tr><th>রেফারেন্স</th><th>নথি</th><th>প্রাপক/সদস্য</th><th>তারিখ</th><th>সংস্করণ</th><th>অবস্থা</th><th></th></tr></thead><tbody><% rows.forEach(function(d){ %><tr><td><strong><%= d.reference_no %></strong><small class="d-block text-muted"><%= d.document_type %></small></td><td><%= d.title %><small class="d-block text-muted"><%= d.subject||'' %></small></td><td><%= d.recipient_name||d.member_name||'—' %></td><td><%= bn.date(d.issue_date) %></td><td><%= bn.num(d.current_version) %></td><td><%= ({draft:'খসড়া',pending:'অপেক্ষমাণ',approved:'অনুমোদিত',issued:'জারি',rejected:'ফেরত',archived:'আর্কাইভ'})[d.status] %></td><td><a href="/documents/<%= d.id %>" class="btn btn-sm btn-outline-primary">দেখুন</a></td></tr><% }) %></tbody></table></div></div></div>
