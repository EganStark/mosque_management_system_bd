<div class="document-toolbar no-print"><a href="/documents/<%= item.id %>" class="btn btn-outline-secondary">নথির বিস্তারিত</a><div class="d-flex gap-2"><a href="/documents" class="btn btn-outline-secondary">রেজিস্টার</a><button onclick="window.print()" class="btn btn-primary"><i class="bi bi-file-earmark-pdf me-1"></i> প্রিন্ট / PDF</button></div></div>
<section class="official-document mb-4"><% if(item.status==='draft'){ %><div class="document-watermark">খসড়া</div><% } %><header class="official-document__header"><% if(company&&company.logo){ %><img src="<%= company.logo %>" alt=""/><% }else{ %><span class="material-symbols-outlined">mosque</span><% } %><div><h2><%= company&&company.company_name?company.company_name:'Baitur Rahman Jame Moshjid' %></h2><p><%= company&&company.company_address?company.company_address:'' %></p><p><%= company&&company.company_phone?'ফোন: '+company.company_phone:'' %></p></div><strong class="document-copy-label"><%= item.document_type==='certificate'?'সনদ':'অফিসিয়াল পত্র' %></strong></header>
<div class="official-document__title"><h3><%= item.title %></h3><span>নং: <strong><%= item.reference_no %></strong></span></div><div class="document-meta"><span>তারিখ: <strong><%= bn.date(item.issue_date) %></strong></span><span>অবস্থা: <strong><%= ({draft:'খসড়া',pending:'অপেক্ষমাণ',approved:'অনুমোদিত',issued:'জারি',rejected:'সংশোধন',archived:'আর্কাইভ'})[item.status] %></strong></span></div>
<% if(item.recipient_name){ %><div class="mb-4"><strong>প্রাপক</strong><br/><%= item.recipient_name %><% if(item.recipient_address){ %><br/><%= item.recipient_address %><% } %></div><% } %><% if(item.subject){ %><p class="mb-4"><strong>বিষয়: <%= item.subject %></strong></p><% } %><div style="white-space:pre-line;min-height:360px;line-height:2"><%= item.content||'' %></div>
<footer class="document-signatures"><div><span><%= item.signatory_title||'প্রস্তুতকারী' %></span><small><%= item.signatory_name||item.creator_name||'' %></small></div><div><span><%= item.secondary_signatory_title||'অনুমোদনকারী' %></span><small><%= item.secondary_signatory_name||item.approver_name||'' %></small></div><div><span>অফিস সিল</span></div></footer></section>
<p class="small text-muted text-center no-print">PDF তৈরি করতে “প্রিন্ট / PDF” চাপুন এবং প্রিন্ট ডায়ালগে “Save as PDF” নির্বাচন করুন।</p>
