<div class="mx-auto" style="max-width:900px"><div class="mb-4"><p class="text-uppercase text-primary fw-bold small mb-1" data-bn="দ্রুত খুঁজুন" data-en="Find anything">দ্রুত খুঁজুন</p><h3 data-bn="মসজিদ ব্যবস্থাপনা অনুসন্ধান" data-en="Mosque management search">মসজিদ ব্যবস্থাপনা অনুসন্ধান</h3></div><form method="get" class="input-group input-group-lg mb-4"><span class="input-group-text"><span class="material-symbols-outlined">search</span></span><input name="q" value="<%= data.query %>" class="form-control" minlength="2" placeholder="নাম, ফোন, রশিদ, ভাউচার বা রেফারেন্স" autofocus/><button class="btn btn-primary" data-bn="খুঁজুন" data-en="Search">খুঁজুন</button></form>
<% if(data.query.length<2){ %><div class="card"><div class="card-body text-center p-5 text-muted"><span class="material-symbols-outlined fs-1">manage_search</span><p class="mb-0" data-bn="কমপক্ষে ২ অক্ষর লিখুন" data-en="Enter at least 2 characters">কমপক্ষে ২ অক্ষর লিখুন</p></div></div><% }else if(!data.total){ %><div class="alert alert-info" data-bn="আপনার অনুমোদিত মডিউলে কোনো মিল পাওয়া যায়নি।" data-en="No matches were found in modules you can access.">আপনার অনুমোদিত মডিউলে কোনো মিল পাওয়া যায়নি।</div><% } %>
<% data.groups.forEach(function(group){ %><section class="card mb-3"><div class="card-header d-flex justify-content-between"><strong><%= group.type %></strong><span class="badge text-bg-light"><%= bn.num(group.items.length) %></span></div><div class="list-group list-group-flush"><% group.items.forEach(function(item){ %><div class="list-group-item d-flex align-items-center justify-content-between gap-3 py-3"><a href="<%= item.href %>" class="d-flex align-items-center gap-3 min-w-0 text-decoration-none flex-grow-1"><span class="material-symbols-outlined text-primary"><%= item.icon %></span><div class="min-w-0"><strong class="d-block text-truncate text-on-surface"><%= item.title %></strong><small class="text-muted text-truncate d-block"><%= item.subtitle||'—' %></small></div></a><div class="d-flex align-items-center gap-2"><small class="text-muted text-nowrap"><%= item.meta||'' %></small><% if(pinnedHrefs.has(item.href)){ %><span class="material-symbols-outlined text-warning" title="Pinned">bookmark_added</span><% }else{ %><form method="post" action="/workspace/pins" class="m-0"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><input type="hidden" name="item_type" value="<%= item.type %>"/><input type="hidden" name="title" value="<%= item.title %>"/><input type="hidden" name="subtitle" value="<%= item.subtitle||'' %>"/><input type="hidden" name="icon" value="<%= item.icon %>"/><input type="hidden" name="href" value="<%= item.href %>"/><button class="btn btn-sm btn-link text-muted p-1" title="Pin shortcut"><span class="material-symbols-outlined">bookmark_add</span></button></form><% } %><a href="<%= item.href %>" class="text-muted"><span class="material-symbols-outlined">chevron_right</span></a></div></div><% }) %></div></section><% }) %></div>
