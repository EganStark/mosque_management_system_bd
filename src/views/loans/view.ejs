<% var balance=Number(item.principal_amount)-Number(item.repaid_amount); %>
<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4"><div><p class="text-uppercase text-primary fw-bold small mb-1"><%= item.loan_no %></p><h3 class="mb-1"><%= item.borrower_name %></h3><p class="text-muted mb-0"><%= item.purpose %></p></div><div class="d-flex gap-2"><a href="/loans" class="btn btn-outline-secondary">সব ঋণ</a><button onclick="window.print()" class="btn btn-outline-primary"><i class="bi bi-printer me-1"></i> প্রিন্ট</button></div></div>
<div class="row g-4 mb-4"><div class="col-lg-7"><div class="card h-100"><div class="card-header">ঋণগ্রহীতা ও চুক্তির তথ্য</div><div class="card-body"><dl class="row mb-0"><dt class="col-sm-4">সদস্য নম্বর</dt><dd class="col-sm-8"><%= item.member_no||'বহিরাগত' %></dd><dt class="col-sm-4">মোবাইল</dt><dd class="col-sm-8"><%= item.phone||'—' %></dd><dt class="col-sm-4">ঠিকানা</dt><dd class="col-sm-8"><%= item.address||'—' %></dd><dt class="col-sm-4">প্রদান</dt><dd class="col-sm-8"><%= bn.date(item.issue_date) %> · <%= item.payment_method==='bank'?(item.bank_name||'ব্যাংক'):item.payment_method==='mobile_banking'?(item.mobile_wallet_name+' · '+item.mobile_wallet_number):'নগদ' %></dd><dt class="col-sm-4">প্রস্তাবিত কিস্তি</dt><dd class="col-sm-8"><%= item.installment_amount?'৳ '+bn.money(item.installment_amount):'—' %></dd><dt class="col-sm-4">পরিশোধ সীমা</dt><dd class="col-sm-8"><%= item.first_due_date?bn.date(item.first_due_date):'—' %> — <%= item.final_due_date?bn.date(item.final_due_date):'—' %></dd><dt class="col-sm-4">জামিনদার</dt><dd class="col-sm-8"><%= item.guarantor_name||'—' %> <%= item.guarantor_phone?'· '+item.guarantor_phone:'' %></dd><dt class="col-sm-4">নোট</dt><dd class="col-sm-8"><%= item.notes||'—' %></dd></dl></div></div></div>
<div class="col-lg-5"><div class="card h-100"><div class="card-header">ঋণের হিসাব</div><div class="card-body"><div class="d-flex justify-content-between mb-3"><span>মূল ঋণ</span><strong>৳ <%= bn.money(item.principal_amount) %></strong></div><div class="d-flex justify-content-between mb-3"><span>আদায় হয়েছে</span><strong class="text-success">৳ <%= bn.money(item.repaid_amount) %></strong></div><div class="d-flex justify-content-between border-top pt-3"><span>বর্তমান বকেয়া</span><h4 class="text-warning mb-0">৳ <%= bn.money(balance) %></h4></div></div></div></div></div>
<% if(item.status==='cancelled'){ %><div class="alert alert-danger mb-4"><strong>ঋণটি বাতিল করা হয়েছে।</strong><% if(item.cancellation_reason){ %> কারণ: <%= item.cancellation_reason %><% } %><% if(item.cancelled_at){ %><small class="d-block mt-1"><%= bn.date(item.cancelled_at) %></small><% } %></div><% } %>
<% if(item.status==='pending'){ %><div class="card border-warning mb-4"><div class="card-header text-warning">অনুমোদনের অপেক্ষায়</div><div class="card-body"><p class="text-muted">এই আবেদন এখনো তহবিল থেকে অর্থ ছাড় করেনি। অ্যাডমিন অনুমোদনের সময় ব্যালেন্স ও হিসাব মাস আবার যাচাই হবে।</p><% if(currentUser.role==='admin'){ %><form method="post" action="/loans/<%= item.id %>/decision" class="row g-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><div class="col-md-8"><input name="decision_notes" class="form-control" placeholder="সিদ্ধান্তের মন্তব্য"/></div><div class="col-md-4 d-flex gap-2"><button name="decision" value="approve" class="btn btn-success flex-fill">অনুমোদন ও অর্থ ছাড়</button><button name="decision" value="reject" class="btn btn-outline-danger flex-fill">প্রত্যাখ্যান</button></div></form><% } %></div></div><% } %>
<% if(item.status==='rejected'){ %><div class="alert alert-danger mb-4"><strong>ঋণের আবেদন প্রত্যাখ্যাত হয়েছে।</strong><% if(item.decision_notes){ %> <%= item.decision_notes %><% } %></div><% } %>
<% if(currentUser.role!=='viewer' && ['active','overdue'].includes(item.status)){ %><div class="card mb-4"><div class="card-header">কিস্তি গ্রহণ</div><div class="card-body"><form method="post" action="/loans/<%= item.id %>/repayments" class="row g-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><div class="col-lg-3"><label class="form-label required">পরিমাণ</label><input type="number" min="0.01" max="<%= balance %>" step="0.01" name="amount" value="<%= item.installment_amount&&Number(item.installment_amount)<balance?item.installment_amount:balance %>" class="form-control" required/></div><div class="col-lg-3"><label class="form-label required">তারিখ</label><input type="date" name="payment_date" value="<%= new Date().toISOString().slice(0,10) %>" class="form-control" required/></div><div class="col-lg-3"><label class="form-label">পদ্ধতি</label><select name="payment_method" class="form-select"><option value="cash">নগদ</option><option value="bank">ব্যাংক</option><option value="mobile_banking">মোবাইল ব্যাংকিং</option></select></div><div class="col-lg-3"><label class="form-label">ব্যাংক হিসাব</label><select name="bank_id" class="form-select"><option value="">ব্যাংক হলে নির্বাচন করুন</option><% banks.forEach(function(b){ %><option value="<%= b.id %>"><%= b.name %></option><% }) %></select></div><div class="col-lg-4"><label class="form-label">মোবাইল ওয়ালেট</label><select name="mobile_wallet_id" class="form-select"><option value="">মোবাইল ব্যাংকিং হলে নির্বাচন করুন</option><% mobileWallets.forEach(function(w){ %><option value="<%= w.id %>"><%= w.name %> · <%= w.account_number %></option><% }) %></select></div><div class="col-lg-4"><label class="form-label">রেফারেন্স</label><input name="reference" class="form-control"/></div><div class="col-lg-4"><label class="form-label">মন্তব্য</label><input name="remarks" class="form-control"/></div><div class="col-12"><button class="btn btn-success">কিস্তি গ্রহণ করুন</button></div></form></div></div><% } %>
<% if(currentUser.role==='admin' && ['active','overdue'].includes(item.status) && Number(item.repaid_amount)===0){ %><div class="card border-danger mb-4"><div class="card-header text-danger">ভুল ঋণ বাতিল</div><div class="card-body"><p class="small text-muted">কোনো কিস্তি গ্রহণের আগে শুধু ভুলভাবে তৈরি ঋণ বাতিল করা যাবে। বাতিল করলে সংশ্লিষ্ট নগদ, ব্যাংক বা ওয়ালেট ব্যালেন্স পুনরুদ্ধার হবে।</p><form method="post" action="/loans/<%= item.id %>/cancel" class="d-flex flex-column flex-md-row gap-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><input name="cancellation_reason" class="form-control" placeholder="বাতিলের কারণ" required/><button class="btn btn-outline-danger text-nowrap" onclick="return confirm('ঋণটি বাতিল করবেন?')">ঋণ বাতিল</button></form></div></div><% } %>
<div class="card"><div class="card-header">কিস্তির ইতিহাস</div><div class="card-body"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>তারিখ</th><th>পদ্ধতি</th><th>হিসাব/রেফারেন্স</th><th>গ্রহণকারী</th><th>মন্তব্য</th><th>অবস্থা</th><th class="text-end">পরিমাণ</th><th></th></tr></thead><tbody><% item.repayments.forEach(function(r){ %><tr class="<%= r.status==='cancelled'?'text-muted':'' %>"><td><%= bn.date(r.payment_date) %></td><td><%= r.payment_method==='bank'?'ব্যাংক':r.payment_method==='mobile_banking'?'মোবাইল ব্যাংকিং':'নগদ' %></td><td><%= r.bank_name||(r.mobile_wallet_name?r.mobile_wallet_name+' · '+r.mobile_wallet_number:null)||r.reference||'—' %></td><td><%= r.received_by_name||'—' %></td><td><%= r.status==='cancelled'?(r.cancellation_reason||'বাতিল'):r.remarks||'—' %></td><td><span class="badge <%= r.status==='cancelled'?'text-bg-secondary':'text-bg-success' %>"><%= r.status==='cancelled'?'বাতিল':'কার্যকর' %></span></td><td class="text-end <%= r.status==='cancelled'?'text-decoration-line-through':'' %>">৳ <%= bn.money(r.amount) %></td><td><% if(r.status==='posted'&&currentUser.role==='admin'){ %><form method="post" action="/loans/<%= item.id %>/repayments/<%= r.id %>/cancel" class="d-flex gap-1"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><input name="cancellation_reason" class="form-control form-control-sm" placeholder="বাতিলের কারণ" required/><button class="btn btn-sm btn-outline-danger" onclick="return confirm('এই কিস্তি বাতিল করবেন?')"><i class="bi bi-x-circle"></i></button></form><% } %></td></tr><% }) %><% if(!item.repayments.length){ %><tr><td colspan="8" class="text-center text-muted">এখনও কোনো কিস্তি গ্রহণ হয়নি</td></tr><% } %></tbody></table></div></div></div>
