<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4"><div><p class="text-uppercase text-primary fw-bold small mb-1">Qard & receivables</p><h3 class="mb-1">ঋণ ও কিস্তি ব্যবস্থাপনা</h3><p class="text-muted mb-0">সুদমুক্ত ঋণ প্রদান, কিস্তি গ্রহণ, বকেয়া ও মেয়াদ পর্যবেক্ষণ</p></div></div>
<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-5 gap-4 mb-4">
  <div class="card"><div class="card-body"><p class="small text-muted mb-1">চলমান ঋণ</p><h4><%= bn.num(summary.active) %></h4></div></div>
  <div class="card"><div class="card-body"><p class="small text-muted mb-1">মেয়াদোত্তীর্ণ</p><h4 class="text-danger"><%= bn.num(summary.overdue) %></h4></div></div>
  <div class="card"><div class="card-body"><p class="small text-muted mb-1">মোট প্রদান</p><h4>৳ <%= bn.money(summary.issued) %></h4></div></div>
  <div class="card"><div class="card-body"><p class="small text-muted mb-1">মোট আদায়</p><h4 class="text-success">৳ <%= bn.money(summary.repaid) %></h4></div></div>
  <div class="card"><div class="card-body"><p class="small text-muted mb-1">মোট বকেয়া</p><h4 class="text-warning">৳ <%= bn.money(summary.outstanding) %></h4></div></div>
</div>
<% if(currentUser.role!=='viewer'){ %><div class="card mb-4"><div class="card-header">নতুন ঋণের আবেদন</div><div class="card-body"><form method="post" action="/loans" class="row g-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/>
  <div class="col-lg-4"><label class="form-label">নিবন্ধিত সদস্য</label><select name="member_id" class="form-select select2"><option value="">সদস্য না হলে ফাঁকা রাখুন</option><% memberOptions.forEach(function(m){ %><option value="<%= m.id %>"><%= m.id_no %> — <%= m.name %> — <%= m.phone||'' %></option><% }) %></select></div>
  <div class="col-lg-4"><label class="form-label required">ঋণগ্রহীতার নাম</label><input name="borrower_name" class="form-control" required/></div><div class="col-lg-4"><label class="form-label">মোবাইল</label><input name="phone" class="form-control"/></div>
  <div class="col-lg-4"><label class="form-label required">মূল ঋণ</label><input type="number" min="0.01" step="0.01" name="principal_amount" class="form-control" required/></div><div class="col-lg-4"><label class="form-label">প্রস্তাবিত কিস্তি</label><input type="number" min="0.01" step="0.01" name="installment_amount" class="form-control"/></div><div class="col-lg-4"><label class="form-label required">প্রদানের তারিখ</label><input type="date" name="issue_date" value="<%= new Date().toISOString().slice(0,10) %>" class="form-control" required/></div>
  <div class="col-lg-4"><label class="form-label">প্রথম কিস্তির তারিখ</label><input type="date" name="first_due_date" class="form-control"/></div><div class="col-lg-4"><label class="form-label">চূড়ান্ত পরিশোধের তারিখ</label><input type="date" name="final_due_date" class="form-control"/></div><div class="col-lg-4"><label class="form-label required">প্রদান পদ্ধতি</label><select name="payment_method" class="form-select"><option value="cash">নগদ</option><option value="bank">ব্যাংক</option><option value="mobile_banking">মোবাইল ব্যাংকিং</option></select></div>
  <div class="col-lg-4"><label class="form-label">ব্যাংক হিসাব</label><select name="bank_id" class="form-select"><option value="">ব্যাংক হলে নির্বাচন করুন</option><% banks.forEach(function(b){ %><option value="<%= b.id %>"><%= b.name %></option><% }) %></select></div><div class="col-lg-4"><label class="form-label">মোবাইল ওয়ালেট</label><select name="mobile_wallet_id" class="form-select"><option value="">মোবাইল ব্যাংকিং হলে নির্বাচন করুন</option><% mobileWallets.forEach(function(w){ %><option value="<%= w.id %>"><%= w.name %> · <%= w.account_number %></option><% }) %></select></div><div class="col-lg-4"><label class="form-label">লেনদেন রেফারেন্স</label><input name="reference" class="form-control"/></div><div class="col-lg-4"><label class="form-label">ঠিকানা</label><input name="address" class="form-control"/></div>
  <div class="col-lg-4"><label class="form-label">জামিনদারের নাম</label><input name="guarantor_name" class="form-control"/></div><div class="col-lg-4"><label class="form-label">জামিনদারের মোবাইল</label><input name="guarantor_phone" class="form-control"/></div><div class="col-lg-4"><label class="form-label required">ঋণের উদ্দেশ্য</label><input name="purpose" class="form-control" required/></div>
  <div class="col-12"><label class="form-label">অতিরিক্ত নোট</label><textarea name="notes" rows="2" class="form-control"></textarea></div><div class="col-12"><button class="btn btn-primary">অনুমোদনের জন্য জমা দিন</button></div>
</form></div></div><% } %>
<div class="card"><div class="card-header d-flex justify-content-between align-items-center"><span>ঋণ লেজার</span><form method="get"><select name="status" class="form-select form-select-sm" onchange="this.form.submit()"><option value="">সব অবস্থা</option><% [['pending','অপেক্ষমাণ'],['active','চলমান'],['overdue','মেয়াদোত্তীর্ণ'],['paid','পরিশোধিত'],['rejected','প্রত্যাখ্যাত']].forEach(function(s){ %><option value="<%= s[0] %>" <%= status===s[0]?'selected':'' %>><%= s[1] %></option><% }) %></select></form></div><div class="card-body"><div class="table-responsive"><table class="table table-hover datatable w-100"><thead><tr><th>ঋণ নম্বর</th><th>ঋণগ্রহীতা</th><th>প্রদানের তারিখ</th><th>মূল ঋণ</th><th>আদায়</th><th>বকেয়া</th><th>শেষ তারিখ</th><th>অবস্থা</th><th></th></tr></thead><tbody><% rows.forEach(function(r){ var balance=Number(r.principal_amount)-Number(r.repaid_amount); %><tr><td><strong><%= r.loan_no %></strong><small class="d-block text-muted"><%= r.member_no||'বহিরাগত' %></small></td><td><%= r.borrower_name %><small class="d-block text-muted"><%= r.phone||'' %></small></td><td><%= bn.date(r.issue_date) %></td><td>৳ <%= bn.money(r.principal_amount) %></td><td>৳ <%= bn.money(r.repaid_amount) %></td><td><strong>৳ <%= bn.money(balance) %></strong></td><td><%= r.final_due_date?bn.date(r.final_due_date):'—' %></td><td><span class="badge <%= r.status==='paid'?'bg-success-subtle text-success':r.status==='overdue'?'bg-danger-subtle text-danger':'bg-warning-subtle text-warning' %>"><%= ({pending:'অপেক্ষমাণ',active:'চলমান',overdue:'মেয়াদোত্তীর্ণ',paid:'পরিশোধিত',rejected:'প্রত্যাখ্যাত',cancelled:'বাতিল'})[r.status] %></span></td><td><a href="/loans/<%= r.id %>" class="btn btn-sm btn-outline-primary">বিস্তারিত</a></td></tr><% }) %></tbody></table></div></div></div>
