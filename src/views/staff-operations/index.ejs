<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4"><div><p class="text-uppercase text-primary fw-bold small mb-1">People operations</p><h3 class="mb-1">স্টাফ ডিউটি ও বেতন</h3><p class="text-muted mb-0">ইমাম, মুয়াজ্জিন ও কর্মীদের রোস্টার, হাজিরা এবং মাসিক বেতন</p></div><div class="d-flex gap-2"><a href="/staff-operations/attendance" class="btn btn-outline-primary">আজকের হাজিরা</a><form method="get" class="d-flex gap-2"><input type="month" name="month" value="<%= month %>" class="form-control"/><button class="btn btn-outline-secondary">দেখুন</button></form></div></div>
<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-4"><div class="card"><div class="card-body"><p class="small text-muted mb-1">মোট প্রদেয়</p><h4>৳ <%= bn.money(summary.payable) %></h4></div></div><div class="card"><div class="card-body"><p class="small text-muted mb-1">পরিশোধিত</p><h4 class="text-success">৳ <%= bn.money(summary.paid) %></h4></div></div><div class="card"><div class="card-body"><p class="small text-muted mb-1">বকেয়া বেতন</p><h4 class="text-danger">৳ <%= bn.money(summary.unpaid) %></h4></div></div></div>
<div class="row g-4 mb-4"><div class="col-lg-6"><div class="card h-100"><div class="card-header">মাসিক বেতন তৈরি</div><div class="card-body"><form method="post" action="/staff-operations/payroll/generate" class="d-flex gap-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><input type="month" name="month" value="<%= month %>" class="form-control"/><button class="btn btn-primary">বেতন হিসাব তৈরি</button></form><p class="small text-muted mt-3 mb-0">স্টাফ প্রোফাইলের মূল বেতন ও মাসিক ভাতা থেকে হিসাব তৈরি হবে। একই মাসে ডুপ্লিকেট হবে না।</p></div></div></div><div class="col-lg-6"><div class="card h-100"><div class="card-header">নতুন ডিউটি রোস্টার</div><div class="card-body"><form method="post" action="/staff-operations/rosters" class="row g-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><div class="col-md-6"><select name="staff_id" class="form-select" required><option value="">স্টাফ নির্বাচন</option><% staff.forEach(function(s){ %><option value="<%= s.id %>"><%= s.name_bn %> — <%= s.position_bn %></option><% }) %></select></div><div class="col-md-6"><select name="day_of_week" class="form-select"><option value="sat">শনিবার</option><option value="sun">রবিবার</option><option value="mon">সোমবার</option><option value="tue">মঙ্গলবার</option><option value="wed">বুধবার</option><option value="thu">বৃহস্পতিবার</option><option value="fri">শুক্রবার</option></select></div><div class="col-md-4"><input type="time" name="start_time" class="form-control" required/></div><div class="col-md-4"><input type="time" name="end_time" class="form-control" required/></div><div class="col-md-4"><input name="duty_name" class="form-control" placeholder="দায়িত্ব" required/></div><div class="col-8"><input name="location" class="form-control" placeholder="স্থান"/></div><div class="col-4"><button class="btn btn-outline-primary w-100">রোস্টার যোগ</button></div></form></div></div></div></div>
<div class="card mb-4"><div class="card-header">বেতন তালিকা — <%= month %></div><div class="card-body"><div class="table-responsive"><table class="table table-hover datatable w-100"><thead><tr><th>স্টাফ</th><th>মূল বেতন</th><th>ভাতা</th><th>কর্তন</th><th>নিট</th><th>পরিশোধ</th><th>অবস্থা</th><th></th></tr></thead><tbody><% payrolls.forEach(function(p){ %><tr><td><strong><%= p.name_bn %></strong><small class="d-block text-muted"><%= p.position_bn %></small></td><td>৳ <%= bn.money(p.basic_salary) %></td><td>৳ <%= bn.money(p.allowances) %></td><td>৳ <%= bn.money(p.deductions) %></td><td><strong>৳ <%= bn.money(p.net_payable) %></strong></td><td class="text-success">৳ <%= bn.money(p.amount_paid) %></td><td><%= p.status==='paid'?'পরিশোধিত':p.status==='partial'?'আংশিক':'বকেয়া' %></td><td><a href="/staff-operations/payroll/<%= p.id %>" class="btn btn-sm btn-outline-primary">বিস্তারিত</a></td></tr><% }) %></tbody></table></div></div></div>
<div class="card"><div class="card-header">সাপ্তাহিক ডিউটি রোস্টার</div><div class="card-body"><div class="table-responsive"><table class="table"><thead><tr><th>দিন</th><th>স্টাফ</th><th>সময়</th><th>দায়িত্ব</th><th>স্থান</th></tr></thead><tbody><% rosters.forEach(function(r){ %><tr><td><%= ({sat:'শনিবার',sun:'রবিবার',mon:'সোমবার',tue:'মঙ্গলবার',wed:'বুধবার',thu:'বৃহস্পতিবার',fri:'শুক্রবার'})[r.day_of_week] %></td><td><%= r.name_bn %></td><td><%= r.start_time.slice(0,5) %>–<%= r.end_time.slice(0,5) %></td><td><%= r.duty_name %></td><td><%= r.location||'—' %></td></tr><% }) %></tbody></table></div></div></div>
