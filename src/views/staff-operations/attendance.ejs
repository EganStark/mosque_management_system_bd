<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4"><div><h3 class="mb-1">স্টাফ হাজিরা</h3><p class="text-muted mb-0">দৈনিক উপস্থিতি, বিলম্ব, ছুটি এবং কর্মসময়</p></div><form method="get" class="d-flex gap-2"><input type="date" name="date" value="<%= date %>" class="form-control"/><button class="btn btn-outline-secondary">দেখুন</button><a href="/staff-operations" class="btn btn-outline-primary">স্টাফ অপারেশন</a></form></div>
<form method="post" action="/staff-operations/attendance"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><input type="hidden" name="date" value="<%= date %>"/><div class="card"><div class="card-body"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>স্টাফ</th><th>অবস্থা</th><th>প্রবেশ</th><th>প্রস্থান</th><th>মন্তব্য</th></tr></thead><tbody><% rows.forEach(function(r){ %><tr><td><strong><%= r.name_bn %></strong><small class="d-block text-muted"><%= r.position_bn %></small></td><td><select name="status_<%= r.id %>" class="form-select"><option value="present" <%= !r.attendance_status||r.attendance_status==='present'?'selected':'' %>>উপস্থিত</option><option value="absent" <%= r.attendance_status==='absent'?'selected':'' %>>অনুপস্থিত</option><option value="late" <%= r.attendance_status==='late'?'selected':'' %>>বিলম্ব</option><option value="leave" <%= r.attendance_status==='leave'?'selected':'' %>>ছুটি</option></select></td><td><input type="time" name="check_in_<%= r.id %>" value="<%= r.check_in?String(r.check_in).slice(0,5):'' %>" class="form-control"/></td><td><input type="time" name="check_out_<%= r.id %>" value="<%= r.check_out?String(r.check_out).slice(0,5):'' %>" class="form-control"/></td><td><input name="remarks_<%= r.id %>" value="<%= r.remarks||'' %>" class="form-control"/></td></tr><% }) %></tbody></table></div><% if(currentUser.role!=='viewer'){ %><button class="btn btn-primary">হাজিরা সংরক্ষণ</button><% } %></div></div></form>
