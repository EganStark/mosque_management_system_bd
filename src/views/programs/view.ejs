<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4"><div><p class="text-uppercase text-primary fw-bold small mb-1">Program management</p><h3 class="mb-1"><%= program.name %></h3><p class="text-muted mb-0"><%= program.schedule_text||'সময়সূচি নির্ধারিত হয়নি' %> · <%= program.venue||'স্থান নির্ধারিত হয়নি' %></p></div><div class="d-flex gap-2"><a href="/programs" class="btn btn-outline-secondary">সব প্রোগ্রাম</a><a href="/programs/<%= program.id %>/attendance" class="btn btn-primary"><i class="bi bi-calendar-check me-1"></i> উপস্থিতি নিন</a></div></div>
<div class="row g-4 mb-4"><div class="col-lg-4"><div class="card h-100"><div class="card-header">প্রোগ্রাম তথ্য</div><div class="card-body"><dl class="row mb-0"><dt class="col-5">দায়িত্বপ্রাপ্ত</dt><dd class="col-7"><%= program.instructor_name||'—' %></dd><dt class="col-5">সময়সীমা</dt><dd class="col-7"><%= program.start_date?bn.date(program.start_date):'—' %> – <%= program.end_date?bn.date(program.end_date):'চলমান' %></dd><dt class="col-5">আসন</dt><dd class="col-7"><%= program.capacity?bn.num(program.capacity):'সীমাহীন' %></dd><dt class="col-5">অবস্থা</dt><dd class="col-7"><%= program.status %></dd></dl><p class="text-muted small mt-3 mb-0"><%= program.description||'' %></p></div></div></div>
<div class="col-lg-8"><div class="card h-100"><div class="card-header">অংশগ্রহণকারী যোগ করুন</div><div class="card-body"><form method="post" action="/programs/<%= program.id %>/enroll" class="row g-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><div class="col-md-6"><label class="form-label">নিবন্ধিত সদস্য</label><select name="member_id" class="form-select select2"><option value="">সদস্য না হলে নিচে নাম লিখুন</option><% memberOptions.forEach(function(m){ %><option value="<%= m.id %>"><%= m.id_no %> — <%= m.name %> — <%= m.phone||'' %></option><% }) %></select></div><div class="col-md-6"><label class="form-label">অংশগ্রহণকারীর নাম</label><input name="participant_name" class="form-control"/></div><div class="col-md-4"><label class="form-label">মোবাইল</label><input name="phone" class="form-control"/></div><div class="col-md-4"><label class="form-label">অভিভাবকের নাম</label><input name="guardian_name" class="form-control"/></div><div class="col-md-4"><label class="form-label">অভিভাবকের মোবাইল</label><input name="guardian_phone" class="form-control"/></div><div class="col-12"><label class="form-label">নোট</label><input name="notes" class="form-control"/></div><div class="col-12"><button class="btn btn-primary">অংশগ্রহণকারী যোগ করুন</button></div></form></div></div></div></div>
<div class="card"><div class="card-header">অংশগ্রহণকারীর তালিকা</div><div class="card-body"><div class="table-responsive"><table class="table table-hover datatable w-100"><thead><tr><th>#</th><th>নাম</th><th>মোবাইল</th><th>অভিভাবক</th><th>ভর্তির তারিখ</th><th>অবস্থা</th></tr></thead><tbody><% program.enrollments.forEach(function(row,i){ %><tr><td><%= bn.num(i+1) %></td><td><strong><%= row.participant_name %></strong><small class="d-block text-muted"><%= row.member_id_no?'সদস্য: '+row.member_id_no:'বহিরাগত অংশগ্রহণকারী' %></small></td><td><%= row.phone||'—' %></td><td><%= row.guardian_name||'—' %><%= row.guardian_phone?' · '+row.guardian_phone:'' %></td><td><%= bn.date(row.enrolled_at) %></td><td><span class="badge bg-success-subtle text-success">সক্রিয়</span></td></tr><% }) %></tbody></table></div></div></div>
