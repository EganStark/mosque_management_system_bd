<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4"><div><p class="text-uppercase text-primary fw-bold small mb-1">Daily attendance</p><h3 class="mb-1"><%= program.name %> — উপস্থিতি</h3><p class="text-muted mb-0">তারিখভিত্তিক উপস্থিতি, অনুপস্থিতি ও বিলম্ব রেকর্ড</p></div><form method="get" class="d-flex gap-2"><input type="date" name="date" value="<%= date %>" class="form-control"/><button class="btn btn-outline-secondary">দেখুন</button><a href="/programs/<%= program.id %>" class="btn btn-outline-primary">প্রোগ্রাম</a></form></div>
<form method="post" action="/programs/<%= program.id %>/attendance"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><input type="hidden" name="date" value="<%= date %>"/><div class="card"><div class="card-body"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>#</th><th>অংশগ্রহণকারী</th><th style="min-width:190px">উপস্থিতি</th><th>মন্তব্য</th></tr></thead><tbody><% rows.forEach(function(row,i){ %><tr><td><%= bn.num(i+1) %></td><td><strong><%= row.participant_name %></strong><small class="d-block text-muted"><%= row.phone||'' %></small></td><td><select name="status_<%= row.id %>" class="form-select"><option value="present" <%= !row.attendance_status||row.attendance_status==='present'?'selected':'' %>>উপস্থিত</option><option value="absent" <%= row.attendance_status==='absent'?'selected':'' %>>অনুপস্থিত</option><option value="late" <%= row.attendance_status==='late'?'selected':'' %>>বিলম্ব</option><option value="excused" <%= row.attendance_status==='excused'?'selected':'' %>>অনুমোদিত ছুটি</option></select></td><td><input name="remarks_<%= row.id %>" value="<%= row.remarks||'' %>" class="form-control"/></td></tr><% }) %><% if(!rows.length){ %><tr><td colspan="4" class="text-center text-muted py-5">প্রথমে অংশগ্রহণকারী যোগ করুন।</td></tr><% } %></tbody></table></div><% if(rows.length&&currentUser.role!=='viewer'){ %><button class="btn btn-primary"><i class="bi bi-check2-all me-1"></i> উপস্থিতি সংরক্ষণ</button><% } %></div></div></form>
