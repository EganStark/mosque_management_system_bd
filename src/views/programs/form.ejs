<div class="d-flex justify-content-between align-items-center mb-4"><div><h3 class="mb-1">নতুন প্রোগ্রাম</h3><p class="text-muted mb-0">মসজিদের ক্লাস, প্রশিক্ষণ বা সামাজিক কার্যক্রম তৈরি করুন</p></div><a href="/programs" class="btn btn-outline-secondary">ফিরে যান</a></div>
<div class="card"><div class="card-body"><form method="post" action="/programs" class="row g-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><div class="col-md-8"><label class="form-label required">প্রোগ্রামের নাম</label><input name="name" class="form-control" required/></div><div class="col-md-4"><label class="form-label required">ধরন</label><select name="category" class="form-select" required><option value="education">শিক্ষা</option><option value="children">শিশু</option><option value="women">মহিলা</option><option value="volunteer">স্বেচ্ছাসেবক</option><option value="community">কমিউনিটি</option><option value="other">অন্যান্য</option></select></div><div class="col-md-4"><label class="form-label">শিক্ষক/দায়িত্বপ্রাপ্ত</label><input name="instructor_name" class="form-control"/></div><div class="col-md-4"><label class="form-label">স্থান</label><input name="venue" class="form-control"/></div><div class="col-md-4"><label class="form-label">সময়সূচি</label><input name="schedule_text" class="form-control" placeholder="যেমন: প্রতি শুক্র ও শনি, সকাল ৯টা"/></div><div class="col-md-3"><label class="form-label">শুরুর তারিখ</label><input type="date" name="start_date" class="form-control"/></div><div class="col-md-3"><label class="form-label">শেষের তারিখ</label><input type="date" name="end_date" class="form-control"/></div><div class="col-md-3"><label class="form-label">সর্বোচ্চ আসন</label><input type="number" min="1" name="capacity" class="form-control"/></div><div class="col-md-3"><label class="form-label">অবস্থা</label><select name="status" class="form-select"><option value="active">সক্রিয়</option><option value="planned">পরিকল্পিত</option><option value="completed">সম্পন্ন</option><option value="cancelled">বাতিল</option></select></div><div class="col-12"><label class="form-label">বিবরণ</label><textarea name="description" class="form-control" rows="3"></textarea></div><div class="col-12"><button class="btn btn-primary">প্রোগ্রাম তৈরি করুন</button></div></form></div></div>
