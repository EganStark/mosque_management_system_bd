<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4"><div><p class="text-uppercase text-primary fw-bold small mb-1">Community operations</p><h3 class="mb-1">প্রোগ্রাম ও শিক্ষা</h3><p class="text-muted mb-0">ক্লাস, প্রশিক্ষণ, অংশগ্রহণকারী এবং উপস্থিতি পরিচালনা</p></div><% if(currentUser.role!=='viewer'){ %><a href="/programs/new" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> নতুন প্রোগ্রাম</a><% } %></div>
<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-4"><div class="card"><div class="card-body"><p class="small text-muted mb-1">সক্রিয় প্রোগ্রাম</p><h4><%= bn.num(summary.activePrograms) %></h4></div></div><div class="card"><div class="card-body"><p class="small text-muted mb-1">সক্রিয় অংশগ্রহণকারী</p><h4><%= bn.num(summary.activeParticipants) %></h4></div></div><div class="card"><div class="card-body"><p class="small text-muted mb-1">আজকের উপস্থিতি রেকর্ড</p><h4><%= bn.num(summary.todayRecords) %></h4></div></div></div>
<div class="card"><div class="card-body"><div class="table-responsive"><table class="table table-hover datatable w-100"><thead><tr><th>প্রোগ্রাম</th><th>ধরন</th><th>শিক্ষক/দায়িত্বপ্রাপ্ত</th><th>সময়সূচি</th><th>অংশগ্রহণকারী</th><th>অবস্থা</th><th></th></tr></thead><tbody><% rows.forEach(function(row){ %><tr><td><strong><%= row.name %></strong><small class="d-block text-muted"><%= row.venue||'' %></small></td><td><%= ({education:'শিক্ষা',children:'শিশু',women:'মহিলা',volunteer:'স্বেচ্ছাসেবক',community:'কমিউনিটি',other:'অন্যান্য'})[row.category] %></td><td><%= row.instructor_name||'—' %></td><td><%= row.schedule_text||'—' %></td><td><%= bn.num(row.participant_count) %><%= row.capacity?' / '+bn.num(row.capacity):'' %></td><td><span class="badge <%= row.status==='active'?'bg-success-subtle text-success':'bg-secondary-subtle text-secondary' %>"><%= row.status==='active'?'সক্রিয়':'বন্ধ' %></span></td><td><a href="/programs/<%= row.id %>" class="btn btn-sm btn-outline-primary">পরিচালনা</a></td></tr><% }) %></tbody></table></div></div></div>
