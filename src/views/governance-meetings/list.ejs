<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4"><div><p class="text-uppercase text-primary fw-bold small mb-1">Committee governance</p><h3 class="mb-1">সভা, কার্যবিবরণী ও সিদ্ধান্ত</h3><p class="text-muted mb-0">কোরাম, উপস্থিতি, সিদ্ধান্ত এবং ফলো-আপ কাজের জবাবদিহি</p></div></div>
<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 mb-4"><div class="card"><div class="card-body"><p class="small text-muted mb-1">আসন্ন সভা</p><h4><%= bn.num(summary.upcoming) %></h4></div></div><div class="card"><div class="card-body"><p class="small text-muted mb-1">এই মাসে অনুষ্ঠিত</p><h4><%= bn.num(summary.held) %></h4></div></div><div class="card"><div class="card-body"><p class="small text-muted mb-1">খোলা করণীয়</p><h4><%= bn.num(summary.open) %></h4></div></div><div class="card"><div class="card-body"><p class="small text-muted mb-1">সময় পেরিয়েছে</p><h4 class="text-danger"><%= bn.num(summary.overdue) %></h4></div></div></div>
<% if(currentUser.role==='admin'){ %><div class="card mb-4"><div class="card-header">নতুন সভা নির্ধারণ</div><div class="card-body"><form method="post" action="/governance-meetings" class="row g-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><div class="col-md-4"><label class="form-label">কমিটি</label><select name="committee_id" class="form-select" required><option value="">নির্বাচন করুন</option><% committees.forEach(function(c){ %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select></div><div class="col-md-5"><label class="form-label">সভার শিরোনাম</label><input name="title" class="form-control" required/></div><div class="col-md-3"><label class="form-label">ধরন</label><select name="meeting_type" class="form-select"><option value="regular">নিয়মিত</option><option value="special">বিশেষ</option><option value="emergency">জরুরি</option><option value="annual">বার্ষিক</option></select></div><div class="col-md-3"><label class="form-label">তারিখ</label><input type="date" name="meeting_date" class="form-control" required/></div><div class="col-md-2"><label class="form-label">শুরু</label><input type="time" name="start_time" class="form-control" required/></div><div class="col-md-2"><label class="form-label">শেষ</label><input type="time" name="end_time" class="form-control"/></div><div class="col-md-3"><label class="form-label">স্থান</label><input name="venue" class="form-control"/></div><div class="col-md-2"><label class="form-label">কোরাম</label><input type="number" min="1" name="quorum_required" value="1" class="form-control" required/></div><div class="col-12"><label class="form-label">আলোচ্যসূচি</label><textarea name="agenda" class="form-control" rows="3"></textarea></div><div class="col-12"><button class="btn btn-primary">সভা নির্ধারণ</button></div></form></div></div><% } %>
<div class="card"><div class="card-body"><div class="table-responsive"><table class="table table-hover datatable w-100"><thead><tr><th>সভা</th><th>কমিটি</th><th>তারিখ ও সময়</th><th>স্থান</th><th>কোরাম</th><th>অবস্থা</th><th></th></tr></thead><tbody><% rows.forEach(function(r){ %><tr><td><strong><%= r.meeting_no %></strong><small class="d-block text-muted"><%= r.title %></small></td><td><%= r.committee_name %></td><td><%= bn.date(r.meeting_date) %><small class="d-block text-muted"><%= r.start_time.slice(0,5) %></small></td><td><%= r.venue||'—' %></td><td><%= bn.num(r.attendee_count) %> / <%= bn.num(r.quorum_required) %></td><td><%= r.status==='held'?'অনুষ্ঠিত':r.status==='cancelled'?'বাতিল':'নির্ধারিত' %></td><td><a href="/governance-meetings/<%= r.id %>" class="btn btn-sm btn-outline-primary">পরিচালনা</a></td></tr><% }) %></tbody></table></div></div></div>
