<% var attendanceByMember = new Map(item.attendees.map(function(a){ return [Number(a.committee_member_id), a]; })); %>
<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
  <div><p class="text-uppercase text-primary fw-bold small mb-1"><%= item.meeting_no %> · <%= item.committee_name %></p><h3 class="mb-1"><%= item.title %></h3><p class="text-muted mb-0"><%= bn.date(item.meeting_date) %> · <%= item.start_time.slice(0,5) %><%= item.end_time?'–'+item.end_time.slice(0,5):'' %> · <%= item.venue||'স্থান নির্ধারিত নয়' %></p></div>
  <div class="d-flex gap-2 no-print"><a href="/governance-meetings" class="btn btn-outline-secondary">সব সভা</a><button type="button" onclick="window.print()" class="btn btn-outline-primary"><i class="bi bi-printer me-1"></i> প্রিন্ট</button></div>
</div>
<div class="row g-4 mb-4"><div class="col-lg-8"><div class="card h-100"><div class="card-header">সভা সংক্ষিপ্তসার</div><div class="card-body"><div class="row g-3 mb-3"><div class="col-sm-4"><small class="text-muted d-block">ধরন</small><strong><%= ({regular:'নিয়মিত',special:'বিশেষ',emergency:'জরুরি',annual:'বার্ষিক'})[item.meeting_type]||item.meeting_type %></strong></div><div class="col-sm-4"><small class="text-muted d-block">অবস্থা</small><strong><%= ({scheduled:'নির্ধারিত',held:'অনুষ্ঠিত',cancelled:'বাতিল'})[item.status]||item.status %></strong></div><div class="col-sm-4"><small class="text-muted d-block">প্রয়োজনীয় কোরাম</small><strong><%= bn.num(item.quorum_required) %> জন</strong></div></div><h6>আলোচ্যসূচি</h6><p class="mb-0" style="white-space:pre-line"><%= item.agenda||'আলোচ্যসূচি লেখা হয়নি।' %></p></div></div></div><div class="col-lg-4"><div class="card h-100"><div class="card-header">উপস্থিতির হিসাব</div><div class="card-body"><% var presentCount=item.attendees.filter(function(a){return a.attendance_status==='present';}).length; %><div class="d-flex justify-content-between mb-2"><span>উপস্থিত</span><strong class="text-success"><%= bn.num(presentCount) %></strong></div><div class="d-flex justify-content-between mb-2"><span>কমিটি সদস্য</span><strong><%= bn.num(item.committeeMembers.length) %></strong></div><div class="d-flex justify-content-between border-top pt-2"><span>কোরাম</span><strong class="<%= presentCount>=Number(item.quorum_required)?'text-success':'text-warning' %>"><%= presentCount>=Number(item.quorum_required)?'পূর্ণ':'অপূর্ণ' %></strong></div></div></div></div></div>
<% if(currentUser.role==='admin' && item.status!=='cancelled'){ %><div class="card mb-4"><div class="card-header">হাজিরা ও কার্যবিবরণী</div><div class="card-body"><form method="post" action="/governance-meetings/<%= item.id %>/minutes"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><div class="table-responsive mb-3"><table class="table align-middle"><thead><tr><th>সদস্য</th><th>দায়িত্ব</th><th>হাজিরা</th><th>মন্তব্য</th></tr></thead><tbody><% item.committeeMembers.forEach(function(cm){ var a=attendanceByMember.get(Number(cm.id)); %><tr><td><strong><%= cm.name %></strong><small class="d-block text-muted"><%= cm.id_no %></small></td><td><%= cm.role_name %></td><td><select name="attendance_<%= cm.id %>" class="form-select"><option value="present" <%= a&&a.attendance_status==='present'?'selected':'' %>>উপস্থিত</option><option value="absent" <%= !a||a.attendance_status==='absent'?'selected':'' %>>অনুপস্থিত</option><option value="excused" <%= a&&a.attendance_status==='excused'?'selected':'' %>>ছুটিতে</option></select></td><td><input name="remarks_<%= cm.id %>" value="<%= a&&a.remarks?a.remarks:'' %>" class="form-control"/></td></tr><% }) %></tbody></table></div><div class="row g-3"><div class="col-md-3"><label class="form-label">শেষ হওয়ার সময়</label><input type="time" name="end_time" value="<%= item.end_time?item.end_time.slice(0,5):'' %>" class="form-control"/></div><div class="col-md-9"><label class="form-label">কার্যবিবরণী</label><textarea name="minutes" rows="5" class="form-control" required><%= item.minutes||'' %></textarea></div><div class="col-12"><p class="small text-muted">কমপক্ষে <%= bn.num(item.quorum_required) %> জন উপস্থিত না থাকলে কার্যবিবরণী চূড়ান্ত হবে না।</p><button class="btn btn-primary">হাজিরা ও কার্যবিবরণী সংরক্ষণ</button></div></div></form></div></div><% } else if(item.minutes){ %><div class="card mb-4"><div class="card-header">কার্যবিবরণী</div><div class="card-body" style="white-space:pre-line"><%= item.minutes %></div></div><% } %>
<div class="card mb-4"><div class="card-header d-flex justify-content-between"><span>সিদ্ধান্তসমূহ</span><span class="badge bg-primary-subtle text-primary"><%= bn.num(item.resolutions.length) %></span></div><div class="card-body"><% if(!item.resolutions.length){ %><p class="text-muted">এখনও কোনো সিদ্ধান্ত যোগ করা হয়নি।</p><% } %><% item.resolutions.forEach(function(r){ %><div class="border rounded p-3 mb-3"><div class="d-flex justify-content-between gap-3"><h6><%= bn.num(r.resolution_no) %>. <%= r.title %></h6><span class="badge <%= r.decision_type==='approved'?'bg-success-subtle text-success':r.decision_type==='rejected'?'bg-danger-subtle text-danger':'bg-warning-subtle text-warning' %>"><%= ({approved:'অনুমোদিত',rejected:'প্রত্যাখ্যাত',deferred:'স্থগিত',noted:'নথিভুক্ত'})[r.decision_type] %></span></div><p class="mb-0" style="white-space:pre-line"><%= r.resolution_text %></p></div><% }) %><% if(currentUser.role==='admin'){ %><form method="post" action="/governance-meetings/<%= item.id %>/resolutions" class="row g-3 border-top pt-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><div class="col-md-5"><label class="form-label">সিদ্ধান্তের শিরোনাম</label><input name="title" class="form-control" required/></div><div class="col-md-3"><label class="form-label">ফলাফল</label><select name="decision_type" class="form-select"><option value="approved">অনুমোদিত</option><option value="rejected">প্রত্যাখ্যাত</option><option value="deferred">স্থগিত</option><option value="noted">নথিভুক্ত</option></select></div><div class="col-md-4"><label class="form-label">প্রস্তাবকারী</label><select name="proposed_by_member_id" class="form-select"><option value="">নির্বাচন করুন</option><% members.forEach(function(m){ %><option value="<%= m.id %>"><%= m.name %></option><% }) %></select></div><div class="col-md-8"><label class="form-label">সিদ্ধান্তের পূর্ণ বিবরণ</label><textarea name="resolution_text" class="form-control" required></textarea></div><div class="col-md-4"><label class="form-label">সমর্থনকারী</label><select name="seconded_by_member_id" class="form-select"><option value="">নির্বাচন করুন</option><% members.forEach(function(m){ %><option value="<%= m.id %>"><%= m.name %></option><% }) %></select></div><div class="col-12"><button class="btn btn-outline-primary">সিদ্ধান্ত যোগ করুন</button></div></form><% } %></div></div>
<div class="card"><div class="card-header d-flex justify-content-between"><span>ফলো-আপ করণীয়</span><span class="badge bg-primary-subtle text-primary"><%= bn.num(item.actions.length) %></span></div><div class="card-body"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>কাজ</th><th>দায়িত্বপ্রাপ্ত</th><th>সময়সীমা</th><th>অগ্রাধিকার</th><th>অবস্থা</th></tr></thead><tbody><% item.actions.forEach(function(a){ %><tr><td><strong><%= a.title %></strong><small class="d-block text-muted"><%= a.description||'' %></small></td><td><%= a.member_name||a.staff_name||'—' %></td><td><%= a.due_date?bn.date(a.due_date):'—' %></td><td><%= ({low:'কম',normal:'স্বাভাবিক',high:'উচ্চ',critical:'জরুরি'})[a.priority] %></td><td><% if(currentUser.role!=='viewer'){ %><form method="post" action="/governance-meetings/actions/<%= a.id %>" class="d-flex gap-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><input type="hidden" name="meeting_id" value="<%= item.id %>"/><select name="status" class="form-select form-select-sm"><% [['open','খোলা'],['in_progress','চলমান'],['blocked','আটকে আছে'],['completed','সম্পন্ন']].forEach(function(s){ %><option value="<%= s[0] %>" <%= a.status===s[0]?'selected':'' %>><%= s[1] %></option><% }) %></select><button class="btn btn-sm btn-outline-primary">আপডেট</button></form><% }else{ %><%= a.status %><% } %></td></tr><% }) %><% if(!item.actions.length){ %><tr><td colspan="5" class="text-center text-muted">কোনো ফলো-আপ কাজ নেই।</td></tr><% } %></tbody></table></div><% if(currentUser.role!=='viewer'){ %><form method="post" action="/governance-meetings/<%= item.id %>/actions" class="row g-3 border-top pt-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><div class="col-md-4"><label class="form-label">কাজের শিরোনাম</label><input name="title" class="form-control" required/></div><div class="col-md-3"><label class="form-label">সংশ্লিষ্ট সিদ্ধান্ত</label><select name="resolution_id" class="form-select"><option value="">সাধারণ করণীয়</option><% item.resolutions.forEach(function(r){ %><option value="<%= r.id %>"><%= r.resolution_no %>. <%= r.title %></option><% }) %></select></div><div class="col-md-2"><label class="form-label">সময়সীমা</label><input type="date" name="due_date" class="form-control"/></div><div class="col-md-3"><label class="form-label">অগ্রাধিকার</label><select name="priority" class="form-select"><option value="normal">স্বাভাবিক</option><option value="high">উচ্চ</option><option value="critical">জরুরি</option><option value="low">কম</option></select></div><div class="col-md-6"><label class="form-label">সদস্যকে দায়িত্ব দিন</label><select name="assigned_member_id" class="form-select"><option value="">নির্বাচন করুন</option><% members.forEach(function(m){ %><option value="<%= m.id %>"><%= m.name %></option><% }) %></select></div><div class="col-md-6"><label class="form-label">অথবা স্টাফকে দায়িত্ব দিন</label><select name="assigned_staff_id" class="form-select"><option value="">নির্বাচন করুন</option><% staff.forEach(function(s){ %><option value="<%= s.id %>"><%= s.name_bn %> — <%= s.position_bn %></option><% }) %></select></div><div class="col-12"><label class="form-label">বিবরণ</label><textarea name="description" class="form-control"></textarea></div><div class="col-12"><button class="btn btn-primary">করণীয় যোগ করুন</button></div></form><% } %></div></div>
