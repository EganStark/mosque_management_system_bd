<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4"><div><p class="text-uppercase text-primary fw-bold small mb-1" data-bn="অপারেশন ইনবক্স" data-en="Operations inbox">অপারেশন ইনবক্স</p><h3 class="mb-1" data-bn="নোটিফিকেশন কেন্দ্র" data-en="Notification center">নোটিফিকেশন কেন্দ্র</h3><p class="text-muted mb-0"><span data-bn="অপঠিত" data-en="Unread">অপঠিত</span>: <strong><%= bn.num(notifications.unreadCount) %></strong></p></div><% if(notifications.unreadCount){ %><form method="post" action="/notifications/read-all"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><button class="btn btn-outline-primary" data-bn="সব পড়া হয়েছে" data-en="Mark all read">সব পড়া হয়েছে</button></form><% } %></div>
<div class="card"><div class="card-body p-0"><% if(!notifications.items.length){ %><div class="p-5 text-center"><span class="material-symbols-outlined fs-1 text-success">task_alt</span><h5 data-bn="এই মুহূর্তে কোনো সক্রিয় নোটিফিকেশন নেই" data-en="No active notifications right now">এই মুহূর্তে কোনো সক্রিয় নোটিফিকেশন নেই</h5></div><% } %><div class="list-group list-group-flush"><% notifications.items.forEach(function(item){ %><form method="post" action="/notifications/read" class="list-group-item <%= item.unread?'bg-primary bg-opacity-10':'' %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><input type="hidden" name="key" value="<%= item.key %>"/><button class="w-100 border-0 bg-transparent text-start d-flex align-items-center justify-content-between gap-3 py-2"><div class="d-flex align-items-center gap-3"><span class="material-symbols-outlined <%= item.severity==='danger'?'text-danger':item.severity==='warning'?'text-warning':'text-primary' %>"><%= item.severity==='danger'?'error':item.severity==='warning'?'warning':item.kind==='approval'?'approval':'info' %></span><div><strong class="d-block" data-bn="<%= item.title %>" data-en="<%= item.titleEn %>"><%= item.title %></strong><small class="text-muted" data-bn="<%= item.detail %>" data-en="<%= item.detailEn %>"><%= item.detail %></small></div></div><div class="d-flex align-items-center gap-2"><span class="badge text-bg-primary"><%= bn.num(item.count) %></span><span class="material-symbols-outlined">chevron_right</span></div></button></form><% }) %></div></div></div>
