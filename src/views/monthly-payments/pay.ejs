<% var outstanding=Number(bill.amount_due)-Number(bill.amount_paid); %>
<div class="d-flex justify-content-between align-items-center mb-4"><div><p class="text-uppercase text-primary fw-bold small mb-1">Monthly ledger</p><h3 class="mb-1"><%= bill.member_name %></h3><p class="text-muted mb-0">সদস্য আইডি: <%= bn.toBnDigits(bill.member_id_no) %> · বিলের মাস: <%= String(bill.billing_month).slice(0,7) %></p></div><a href="/monthly-payments?month=<%= String(bill.billing_month).slice(0,7) %>" class="btn btn-outline-secondary">ফিরে যান</a></div>
<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4"><div class="card"><div class="card-body"><p class="small text-muted mb-1">মাসিক বিল</p><h4>৳ <%= bn.money(bill.amount_due) %></h4></div></div><div class="card"><div class="card-body"><p class="small text-muted mb-1">পরিশোধিত</p><h4 class="text-success">৳ <%= bn.money(bill.amount_paid) %></h4></div></div><div class="card"><div class="card-body"><p class="small text-muted mb-1">বকেয়া</p><h4 class="text-danger">৳ <%= bn.money(outstanding) %></h4></div></div></div>
<% if(outstanding>0){ %><div class="card mb-4"><div class="card-header">চাঁদা গ্রহণ করুন</div><div class="card-body"><form method="post" action="/monthly-payments/<%= bill.id %>/pay" class="row g-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/>
  <div class="col-md-4"><label class="form-label required">পরিমাণ</label><input type="number" name="amount" min="0.01" max="<%= outstanding %>" step="0.01" value="<%= outstanding %>" class="form-control" required/></div><div class="col-md-4"><label class="form-label required">তারিখ</label><input type="date" name="payment_date" value="<%= new Date().toISOString().slice(0,10) %>" class="form-control" required/></div>
  <div class="col-md-4"><label class="form-label required">পেমেন্ট পদ্ধতি</label><select id="monthlyPaymentMethod" name="payment_method" class="form-select"><option value="cash">নগদ</option><option value="bank">ব্যাংক</option><option value="mobile_banking">মোবাইল ব্যাংকিং</option></select></div>
  <div class="col-md-4" id="monthlyBankField" hidden><label class="form-label">ব্যাংক</label><select name="bank_id" class="form-select"><option value="">নির্বাচন করুন</option><% banks.forEach(function(b){ %><option value="<%= b.id %>"><%= b.name %></option><% }) %></select></div><div class="col-md-4"><label class="form-label">রশিদ নম্বর</label><input name="receipt_no" class="form-control"/></div><div class="col-md-4"><label class="form-label">লেনদেন রেফারেন্স</label><input name="transaction_reference" class="form-control"/></div><div class="col-12"><label class="form-label">মন্তব্য</label><input name="remarks" class="form-control"/></div><div class="col-12"><button class="btn btn-primary"><i class="bi bi-check-lg me-1"></i> পেমেন্ট গ্রহণ</button></div>
  <div class="col-md-4" id="monthlyWalletField" hidden><label class="form-label">মোবাইল ওয়ালেট</label><select name="mobile_wallet_id" class="form-select"><option value="">নির্বাচন করুন</option><% wallets.forEach(function(w){ %><option value="<%= w.id %>"><%= w.name %></option><% }) %></select></div>
</form></div></div><% } %>
<div class="card"><div class="card-header">পেমেন্ট ইতিহাস</div><div class="card-body"><div class="table-responsive"><table class="table"><thead><tr><th>তারিখ</th><th>রশিদ</th><th>পদ্ধতি</th><th>পরিমাণ</th><th>অবস্থা</th></tr></thead><tbody><% paymentRows.forEach(function(p){ %><tr><td><%= bn.date(p.payment_date) %></td><td><%= p.receipt_no||'—' %></td><td><%= p.payment_method==='bank'?'ব্যাংক':(p.payment_method==='mobile_banking'?'মোবাইল ব্যাংকিং':'নগদ') %></td><td>৳ <%= bn.money(p.amount) %></td><td><%= p.status==='posted'?'অনুমোদিত':'বাতিল' %></td></tr><% }) %><% if(!paymentRows.length){ %><tr><td colspan="5" class="text-center text-muted">এখনও কোনো পেমেন্ট নেই</td></tr><% } %></tbody></table></div></div></div>
<script>document.addEventListener('DOMContentLoaded',function(){var m=document.getElementById('monthlyPaymentMethod'),f=document.getElementById('monthlyBankField'),w=document.getElementById('monthlyWalletField');if(!m)return;function sync(){f.hidden=m.value!=='bank';w.hidden=m.value!=='mobile_banking';}m.addEventListener('change',sync);sync();});</script>
