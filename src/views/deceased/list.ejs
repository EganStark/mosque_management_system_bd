<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4"><div><p class="text-uppercase text-primary fw-bold small mb-1">Historical register</p><h3 class="mb-1">মরহুম সদস্য রেজিস্টার</h3><p class="text-muted mb-0">মৃত্যু, জানাজা, দাফন এবং সংরক্ষিত সদস্য ইতিহাস</p></div><% if(currentUser.role!=='viewer'){ %><a href="/deceased/new" class="btn btn-primary"><i class="bi bi-heart me-1"></i> মৃত্যু তথ্য যোগ করুন</a><% } %></div>
<div class="card"><div class="card-body"><div class="table-responsive"><table class="table table-hover datatable w-100"><thead><tr><th>#</th><th>মরহুম সদস্য</th><th>মৃত্যুর তারিখ</th><th>জানাজা</th><th>দাফন স্থান</th><th>ওয়েব নোটিশ</th><th></th></tr></thead><tbody><% rows.forEach(function(r,i){ %><tr><td><%= bn.num(i+1) %></td><td><strong><%= r.member_name %></strong><small class="d-block text-muted">সদস্য আইডি: <%= bn.toBnDigits(r.member_id_no) %></small></td><td><%= bn.date(r.death_date) %></td><td><%= r.janaza_date?bn.date(r.janaza_date)+' · '+r.janaza_time:'—' %></td><td><%= r.burial_location||'—' %></td><td><span class="badge <%= r.notice_id&&r.notice_active?'bg-success-subtle text-success':'bg-secondary-subtle text-secondary' %>"><%= r.notice_id&&r.notice_active?'প্রকাশিত':'প্রকাশিত নয়' %></span></td><td><a href="/deceased/<%= r.id %>" class="btn btn-sm btn-outline-primary">বিস্তারিত</a></td></tr><% }) %></tbody></table></div></div></div>
