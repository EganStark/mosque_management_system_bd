<div class="d-flex justify-content-between align-items-center mb-4"><div><p class="text-uppercase text-primary fw-bold small mb-1">In memory</p><h3 class="mb-1"><%= record.member_name %></h3><p class="text-muted mb-0">মরহুম সদস্য · আইডি <%= bn.toBnDigits(record.member_id_no) %></p></div><div><a href="/members/<%= record.member_id %>" class="btn btn-outline-primary">ঐতিহাসিক প্রোফাইল</a> <a href="/deceased" class="btn btn-outline-secondary">ফিরে যান</a></div></div>
<div class="row g-4"><div class="col-lg-4"><div class="card"><div class="card-body text-center"><% if(record.photo){ %><img src="<%= record.photo %>" class="rounded-4 object-fit-cover mb-3" style="width:130px;height:150px"/><% } %><h4><%= record.member_name %></h4><p class="text-muted"><%= record.address_text||'' %></p><span class="badge bg-secondary-subtle text-secondary">মরহুম সদস্য</span></div></div></div><div class="col-lg-8"><div class="card mb-4"><div class="card-header">মৃত্যু তথ্য</div><div class="card-body"><dl class="row mb-0"><dt class="col-sm-4">মৃত্যুর তারিখ</dt><dd class="col-sm-8"><%= bn.date(record.death_date) %></dd><dt class="col-sm-4">মৃত্যুর স্থান</dt><dd class="col-sm-8"><%= record.death_place||'—' %></dd><dt class="col-sm-4">কারণ</dt><dd class="col-sm-8"><%= record.death_cause||'—' %></dd><dt class="col-sm-4">যোগাযোগ</dt><dd class="col-sm-8"><%= record.contact_person||'—' %> <%= record.contact_phone?'· '+record.contact_phone:'' %></dd></dl></div></div><div class="card"><div class="card-header">জানাজা ও দাফন</div><div class="card-body"><dl class="row mb-0"><dt class="col-sm-4">জানাজা</dt><dd class="col-sm-8"><%= record.janaza_date?bn.date(record.janaza_date)+' · '+record.janaza_time:'—' %></dd><dt class="col-sm-4">স্থান</dt><dd class="col-sm-8"><%= record.janaza_location||'—' %></dd><dt class="col-sm-4">দাফন</dt><dd class="col-sm-8"><%= record.burial_date?bn.date(record.burial_date):'—' %> <%= record.burial_location?'· '+record.burial_location:'' %></dd><dt class="col-sm-4">ওয়েব নোটিশ</dt><dd class="col-sm-8"><%= record.notice_id&&record.notice_active?'প্রকাশিত':'প্রকাশিত নয়' %></dd></dl></div></div></div></div>
