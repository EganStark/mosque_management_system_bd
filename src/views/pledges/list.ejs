<div class="d-flex justify-content-between align-items-center mb-4"><div><p class="text-uppercase text-primary fw-bold small mb-1">Donation commitments</p><h3 class="mb-1">দান অঙ্গীকার ও বকেয়া</h3><p class="text-muted mb-0">প্রতিশ্রুত দান, আদায়, বকেয়া ও ফলো-আপ</p></div></div>
<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-5 gap-4 mb-4"><% [['চলমান',summary.open,false],['মেয়াদোত্তীর্ণ',summary.overdue,false],['মোট অঙ্গীকার',summary.pledged,true],['মোট আদায়',summary.paid,true],['মোট বকেয়া',summary.due,true]].forEach(function(x){ %><div class="card"><div class="card-body"><p class="small text-muted mb-1"><%= x[0] %></p><h4><%= x[2]?'৳ '+bn.money(x[1]):bn.num(x[1]) %></h4></div></div><% }) %></div>
<div class="card mb-4"><div class="card-header">নতুন দান অঙ্গীকার</div><div class="card-body"><form method="post" action="/pledges" class="row g-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><div class="col-lg-4"><label class="form-label">নিবন্ধিত সদস্য</label><select name="member_id" class="form-select select2"><option value="">সদস্য না হলে ফাঁকা রাখুন</option><% memberOptions.forEach(function(m){ %><option value="<%= m.id %>"><%= m.id_no %> — <%= m.name %></option><% }) %></select></div><div class="col-lg-4"><label class="form-label required">দাতার নাম</label><input name="donor_name" class="form-control" required/></div><div class="col-lg-4"><label class="form-label">মোবাইল</label><input name="phone" class="form-control"/></div><div class="col-lg-4"><label class="form-label">আদায়ের খাত</label><select name="collection_category_id" class="form-select"><option value="">নির্বাচন করুন</option><% categories.forEach(function(c){ %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select></div><div class="col-lg-4"><label class="form-label required">অঙ্গীকারের পরিমাণ</label><input type="number" min="0.01" step="0.01" name="pledged_amount" class="form-control" required/></div><div class="col-lg-4"><label class="form-label required">অঙ্গীকারের তারিখ</label><input type="date" name="pledge_date" value="<%= new Date().toISOString().slice(0,10) %>" class="form-control" required/></div><div class="col-lg-4"><label class="form-label">শেষ তারিখ</label><input type="date" name="due_date" class="form-control"/></div><div class="col-lg-4"><label class="form-label">পরবর্তী যোগাযোগ</label><input type="date" name="next_follow_up_date" class="form-control"/></div><div class="col-lg-4"><label class="form-label required">উদ্দেশ্য</label><input name="purpose" class="form-control" required/></div><div class="col-12"><label class="form-label">নোট</label><input name="follow_up_notes" class="form-control"/></div><div class="col-12"><button class="btn btn-primary">অঙ্গীকার সংরক্ষণ</button></div></form></div></div>
<div class="card"><div class="card-header">অঙ্গীকার রেজিস্টার</div><div class="card-body"><div class="table-responsive"><table class="table table-hover datatable w-100"><thead><tr><th>নম্বর</th><th>দাতা</th><th>উদ্দেশ্য</th><th>অঙ্গীকার</th><th>আদায়</th><th>বকেয়া</th><th>শেষ তারিখ</th><th>অবস্থা</th><th></th></tr></thead><tbody><% rows.forEach(function(r){ %><tr><td><strong><%= r.pledge_no %></strong></td><td><%= r.donor_name %><small class="d-block text-muted"><%= r.phone||'' %></small></td><td><%= r.purpose %></td><td>৳ <%= bn.money(r.pledged_amount) %></td><td>৳ <%= bn.money(r.paid_amount) %></td><td>৳ <%= bn.money(Number(r.pledged_amount)-Number(r.paid_amount)) %></td><td><%= r.due_date?bn.date(r.due_date):'—' %></td><td><%= ({active:'চলমান',partial:'আংশিক',overdue:'মেয়াদোত্তীর্ণ',paid:'সম্পূর্ণ'})[r.status] %></td><td><a href="/pledges/<%= r.id %>" class="btn btn-sm btn-outline-primary">বিস্তারিত</a></td></tr><% }) %></tbody></table></div></div></div>
