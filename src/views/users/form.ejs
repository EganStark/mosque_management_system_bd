<%
  var isEdit = !!user;
  var action = isEdit ? '/users/' + user.id : '/users';
  function sel(v){ return user && user.role === v ? 'selected' : ''; }
%>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h3 class="mb-0"><%= title %></h3>
  <a href="/users" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> ফিরে যান</a>
</div>
<div class="card"><div class="card-body">
  <form method="post" action="<%= action %>" class="row g-3">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <div class="col-md-6"><label class="form-label required">নাম</label><input type="text" name="name" class="form-control" value="<%= isEdit?user.name:'' %>" required /></div>
    <div class="col-md-6"><label class="form-label required">ইউজারনেম</label><input type="text" name="username" class="form-control" value="<%= isEdit?user.username:'' %>" required /></div>
    <div class="col-md-6"><label class="form-label">ইমেইল</label><input type="email" name="email" class="form-control" value="<%= isEdit?(user.email||''):'' %>" /></div>
    <div class="col-md-3"><label class="form-label">ভূমিকা</label>
      <select name="role" class="form-select">
        <option value="admin" <%= sel('admin') %>>অ্যাডমিন</option>
        <option value="collector" <%= sel('collector') %>>কালেক্টর</option>
        <option value="viewer" <%= isEdit?sel('viewer'):'selected' %>>ভিউয়ার</option>
      </select></div>
    <% if (!isEdit) { %>
    <div class="col-md-3 d-flex align-items-end">
      <div class="form-check"><input type="checkbox" name="is_active" class="form-check-input" id="active" checked /><label for="active" class="form-check-label">সক্রিয়</label></div>
    </div>
    <% } else { %>
    <div class="col-md-3 d-flex align-items-end">
      <span class="badge bg-<%= user.is_active ? 'success' : 'secondary' %> mb-2"><%= user.is_active ? 'সক্রিয় অ্যাকাউন্ট' : 'নিষ্ক্রিয় অ্যাকাউন্ট' %></span>
    </div>
    <% } %>
    <div class="col-md-6"><label class="form-label <%= isEdit?'':'required' %>">পাসওয়ার্ড <% if(isEdit){ %><small class="text-muted">(পরিবর্তন না করলে খালি রাখুন)</small><% } %></label>
      <input type="password" name="password" class="form-control" <%= isEdit?'':'required' %> /></div>
    <div class="col-12"><button class="btn btn-primary"><i class="bi bi-check-lg me-1"></i> সংরক্ষণ</button></div>
  </form>
</div></div>
