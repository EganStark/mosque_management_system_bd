<div class="flex flex-col gap-3 mb-4 lg:flex-row lg:justify-between lg:items-center">
  <div><h3 class="font-headline-md text-xl md:text-2xl text-on-surface mb-1" data-bn="ড্যাশবোর্ড ওভারভিউ" data-en="Dashboard overview">ড্যাশবোর্ড ওভারভিউ</h3><p class="text-sm text-on-surface-variant mb-0"><%= bn.monthLabel(stats.month) %> <span data-bn="মাসের কার্যক্রম এবং সার্বিক চিত্র" data-en="activity and overall picture">মাসের কার্যক্রম এবং সার্বিক চিত্র</span></p></div>
  <div class="d-flex flex-wrap justify-content-end gap-2"><a href="/dashboard?month=<%= stats.previousMonthValue %>" class="btn btn-outline-secondary btn-sm" title="Previous month"><span class="material-symbols-outlined align-middle text-[18px]">chevron_left</span></a><form method="get" action="/dashboard" class="d-flex gap-2"><label class="visually-hidden" for="dashboardMonth">Month</label><input id="dashboardMonth" type="month" name="month" value="<%= stats.monthValue %>" class="form-control form-control-sm"/><button class="btn btn-primary btn-sm" data-bn="দেখুন" data-en="View">দেখুন</button></form><a href="/dashboard?month=<%= stats.nextMonthValue %>" class="btn btn-outline-secondary btn-sm" title="Next month"><span class="material-symbols-outlined align-middle text-[18px]">chevron_right</span></a><a href="/dashboard" class="btn btn-outline-secondary btn-sm" title="Current month"><span class="material-symbols-outlined align-middle text-[18px]">today</span></a><button type="button" class="btn btn-outline-secondary btn-sm" data-dashboard-customize-toggle aria-expanded="false" aria-controls="dashboardCustomize"><span class="material-symbols-outlined align-middle text-[18px]">tune</span> <span data-bn="ড্যাশবোর্ড সাজান" data-en="Customize dashboard">ড্যাশবোর্ড সাজান</span></button></div>
</div>
<div class="mb-4" id="dashboardCustomize" hidden><div class="card"><div class="card-header d-flex justify-content-between align-items-center"><span data-bn="দৃশ্যমান অংশ নির্বাচন" data-en="Choose visible sections">দৃশ্যমান অংশ নির্বাচন</span><span class="badge bg-primary" data-dashboard-visible-count></span></div><div class="card-body"><form method="post" action="/dashboard/preferences" data-dashboard-preferences-form><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><p class="small text-muted" data-bn="টিক চিহ্ন পরিবর্তন করলে নিচে সঙ্গে সঙ্গে প্রিভিউ দেখা যাবে। সংরক্ষণ করলে এই বিন্যাস শুধু আপনার জন্য থাকবে।" data-en="Changes preview immediately below. Save to keep this layout for your account.">টিক চিহ্ন পরিবর্তন করলে নিচে সঙ্গে সঙ্গে প্রিভিউ দেখা যাবে। সংরক্ষণ করলে এই বিন্যাস শুধু আপনার জন্য থাকবে।</p><div class="d-flex flex-wrap gap-2 mb-4"><button type="button" class="btn btn-sm btn-outline-primary" data-dashboard-preset="welcome,controls,schedule" data-bn="দৈনিক কাজ" data-en="Daily operations">দৈনিক কাজ</button><button type="button" class="btn btn-sm btn-outline-primary" data-dashboard-preset="controls,performance,stats" data-bn="ব্যবস্থাপনা" data-en="Management focus">ব্যবস্থাপনা</button><button type="button" class="btn btn-sm btn-outline-primary" data-dashboard-preset="welcome,controls" data-bn="সংক্ষিপ্ত" data-en="Compact">সংক্ষিপ্ত</button><button type="button" class="btn btn-sm btn-outline-secondary" data-dashboard-preset="welcome,controls,performance,schedule,stats" data-bn="সব অংশ" data-en="Show all">সব অংশ</button></div><div class="row g-3"><% [{k:'welcome',b:'স্বাগত ও দ্রুত কাজ',e:'Welcome & quick actions'},{k:'controls',b:'দৈনিক নিয়ন্ত্রণ',e:'Daily controls'},{k:'performance',b:'ব্যবস্থাপনা কর্মদক্ষতা',e:'Management performance'},{k:'schedule',b:'আসন্ন সূচি',e:'Upcoming schedule'},{k:'stats',b:'পরিসংখ্যান ও চার্ট',e:'Statistics & charts'}].forEach(function(widget){ %><div class="col-sm-6 col-lg-4"><label class="dashboard-widget-option"><input type="checkbox" name="visible_widgets" value="<%= widget.k %>" <%= dashboardPrefs.hidden.includes(widget.k)?'':'checked' %> data-dashboard-widget-choice/><span><strong data-bn="<%= widget.b %>" data-en="<%= widget.e %>"><%= widget.b %></strong><small data-bn="দেখানো হবে" data-en="Show on dashboard">দেখানো হবে</small></span></label></div><% }) %></div><div class="d-flex flex-wrap gap-2 mt-4"><button class="btn btn-primary" data-bn="বিন্যাস সংরক্ষণ" data-en="Save layout">বিন্যাস সংরক্ষণ</button><button type="button" class="btn btn-outline-secondary" data-dashboard-reset data-bn="পরিবর্তন বাতিল" data-en="Cancel preview">পরিবর্তন বাতিল</button></div></form></div></div></div>
<script>
document.addEventListener('DOMContentLoaded', function () {
  const toggle = document.querySelector('[data-dashboard-customize-toggle]');
  const panel = document.getElementById('dashboardCustomize');
  const choices = [...document.querySelectorAll('[data-dashboard-widget-choice]')];
  const count = document.querySelector('[data-dashboard-visible-count]');
  const reset = document.querySelector('[data-dashboard-reset]');
  const form = document.querySelector('[data-dashboard-preferences-form]');
  const zone = document.createElement('div'); zone.dataset.dashboardWidgetZone = ''; panel.after(zone);
  let order = <%- JSON.stringify(dashboardPrefs.order) %>;
  const initialOrder = order.slice();
  const initial = new Set(choices.filter(function (choice) { return choice.checked; }).map(function (choice) { return choice.value; }));
  if (!toggle || !panel) return;
  toggle.addEventListener('click', function () { const opening = panel.hidden; panel.hidden = !opening; toggle.setAttribute('aria-expanded', String(opening)); if (opening) panel.querySelector('input')?.focus(); });
  const orderBox = document.createElement('div'); orderBox.className = 'mt-4 rounded border border-border-subtle p-3'; form.querySelector('.row').after(orderBox);
  function renderOrder() { orderBox.innerHTML = '<small class="d-block text-muted mb-2" data-bn="অংশের ক্রম" data-en="Section order">Section order</small>'; order.forEach(function (key, index) { const choice = choices.find(function (item) { return item.value === key; }); const row = document.createElement('div'); row.className = 'd-flex align-items-center justify-content-between gap-2 border-top py-2'; row.innerHTML = '<span><span class="material-symbols-outlined align-middle text-muted me-2">drag_indicator</span>' + (choice?.closest('label')?.querySelector('strong')?.textContent || key) + '</span><span class="btn-group"><button type="button" class="btn btn-sm btn-outline-secondary" data-move="up"' + (index === 0 ? ' disabled' : '') + '>↑</button><button type="button" class="btn btn-sm btn-outline-secondary" data-move="down"' + (index === order.length - 1 ? ' disabled' : '') + '>↓</button></span>'; row.querySelector('[data-move="up"]')?.addEventListener('click', function () { [order[index - 1], order[index]] = [order[index], order[index - 1]]; preview(); }); row.querySelector('[data-move="down"]')?.addEventListener('click', function () { [order[index], order[index + 1]] = [order[index + 1], order[index]]; preview(); }); orderBox.appendChild(row); }); }
  function preview() { order.forEach(function (key) { const widget = document.querySelector('[data-dashboard-widget="' + key + '"]'); if (widget) zone.appendChild(widget); }); choices.forEach(function (choice) { document.querySelectorAll('[data-dashboard-widget="' + choice.value + '"]').forEach(function (widget) { widget.style.setProperty('display', choice.checked ? '' : 'none', choice.checked ? '' : 'important'); }); }); if (count) count.textContent = choices.filter(function (choice) { return choice.checked; }).length + '/' + choices.length; renderOrder(); }
  choices.forEach(function (choice) { choice.addEventListener('change', preview); });
  document.querySelectorAll('[data-dashboard-preset]').forEach(function (button) { button.addEventListener('click', function () { const selected = new Set(button.dataset.dashboardPreset.split(',')); choices.forEach(function (choice) { choice.checked = selected.has(choice.value); }); preview(); }); });
  if (reset) reset.addEventListener('click', function () { choices.forEach(function (choice) { choice.checked = initial.has(choice.value); }); order = initialOrder.slice(); preview(); });
  if (form) form.addEventListener('submit', function () { let input = form.querySelector('[name="widget_order"]'); if (!input) { input = document.createElement('input'); input.type = 'hidden'; input.name = 'widget_order'; form.appendChild(input); } input.value = order.join(','); });
  preview();
});
</script>

<section data-dashboard-widget="welcome" class="dashboard-welcome mb-6 overflow-hidden rounded-[24px] border border-border-subtle p-5 md:p-7">
  <div class="relative z-10 flex flex-col gap-5 md:flex-row md:items-center md:justify-between">
    <div>
      <p class="mb-2 text-[11px] font-bold uppercase tracking-[.2em] opacity-70" data-bn="মসজিদ পরিচালনা" data-en="Mosque operations">মসজিদ পরিচালনা</p>
      <h2 class="mb-1 text-2xl font-bold md:text-3xl"><span data-bn="আসসালামু আলাইকুম" data-en="Assalamu Alaikum">আসসালামু আলাইকুম</span>, <%= currentUser ? currentUser.name : 'Admin' %></h2>
      <p class="mb-0 max-w-2xl text-sm opacity-75" data-bn="সদস্য, অর্থ ও পাবলিক ওয়েবসাইটের কার্যক্রম দ্রুত সিদ্ধান্তের জন্য এখানে সংক্ষেপে দেখানো হয়েছে।" data-en="Members, finance and public website activity are summarized here for quick daily decisions.">সদস্য, অর্থ ও পাবলিক ওয়েবসাইটের কার্যক্রম দ্রুত সিদ্ধান্তের জন্য এখানে সংক্ষেপে দেখানো হয়েছে।</p>
    </div>
    <div class="flex flex-wrap gap-2">
      <% if(operations.capabilities['finance.manage']){ %><a href="/collections/new" class="dashboard-hero-action text-decoration-none"><span class="material-symbols-outlined text-[18px]">add_card</span><span data-bn="আদায় লিখুন" data-en="Record collection">আদায় লিখুন</span></a><% } %>
      <% if(operations.capabilities['members.manage']){ %><a href="/members/new" class="dashboard-hero-action secondary text-decoration-none"><span class="material-symbols-outlined text-[18px]">person_add</span><span data-bn="সদস্য যোগ করুন" data-en="Add member">সদস্য যোগ করুন</span></a><% } %>
    </div>
  </div>
</section>

<% if(workspace.pins.length || workspace.recentSearches.length){ %><section class="mb-6 grid grid-cols-1 gap-4 lg:grid-cols-3"><div class="card lg:col-span-2"><div class="card-header d-flex justify-content-between"><span data-bn="আমার শর্টকাট" data-en="My shortcuts">আমার শর্টকাট</span><a href="/search" class="small" data-bn="রেকর্ড খুঁজুন" data-en="Find records">রেকর্ড খুঁজুন</a></div><div class="card-body"><% if(!workspace.pins.length){ %><p class="text-muted mb-0" data-bn="অনুসন্ধান ফলাফল থেকে প্রয়োজনীয় রেকর্ড পিন করুন।" data-en="Pin useful records from search results.">অনুসন্ধান ফলাফল থেকে প্রয়োজনীয় রেকর্ড পিন করুন।</p><% } %><div class="grid grid-cols-1 gap-2 sm:grid-cols-2"><% workspace.pins.forEach(function(item){ %><div class="d-flex align-items-center justify-content-between gap-2 rounded border border-border-subtle p-3"><a href="<%= item.href %>" class="d-flex align-items-center gap-2 text-decoration-none min-w-0"><span class="material-symbols-outlined text-primary"><%= item.icon %></span><span class="text-truncate"><strong class="d-block text-on-surface"><%= item.title %></strong><small class="text-muted"><%= item.item_type %></small></span></a><form method="post" action="/workspace/pins/<%= item.id %>/remove"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><button class="btn btn-sm btn-link text-muted p-1" title="Remove"><span class="material-symbols-outlined">close</span></button></form></div><% }) %></div></div></div><div class="card"><div class="card-header" data-bn="সাম্প্রতিক অনুসন্ধান" data-en="Recent searches">সাম্প্রতিক অনুসন্ধান</div><div class="list-group list-group-flush"><% workspace.recentSearches.forEach(function(item){ %><a href="/search?q=<%= encodeURIComponent(item.query) %>" class="list-group-item list-group-item-action d-flex justify-content-between"><span><span class="material-symbols-outlined align-middle text-[18px] me-1">history</span><%= item.query %></span><small class="text-muted"><%= bn.num(item.result_count) %></small></a><% }) %></div></div></section><% } %>

<section data-dashboard-widget="controls" class="mb-6" aria-labelledby="operations-heading">
  <div class="mb-3 flex flex-col gap-1 sm:flex-row sm:items-end sm:justify-between">
    <div><p class="mb-1 text-[11px] font-bold uppercase tracking-[.18em] text-primary" data-bn="দৈনিক নিয়ন্ত্রণ" data-en="Daily control">দৈনিক নিয়ন্ত্রণ</p><h4 id="operations-heading" class="mb-0 text-lg font-bold text-on-surface" data-bn="অনুমোদন ও দ্রুত সিদ্ধান্ত" data-en="Approvals & quick decisions">অনুমোদন ও দ্রুত সিদ্ধান্ত</h4></div>
    <div class="flex flex-wrap gap-2 text-xs"><span class="rounded-full bg-warning/10 px-3 py-1 text-warning"><span data-bn="অনুমোদন" data-en="Approvals">অনুমোদন</span>: <strong><%= bn.num(operations.approvalTotal) %></strong></span><span class="rounded-full bg-error-container px-3 py-1 text-error"><span data-bn="জরুরি" data-en="Urgent">জরুরি</span>: <strong><%= bn.num(operations.urgentTotal) %></strong></span><span class="rounded-full bg-moss-tint px-3 py-1 text-primary"><span data-bn="মোট মনোযোগ" data-en="Total attention">মোট মনোযোগ</span>: <strong><%= bn.num(operations.attentionTotal) %></strong></span></div>
  </div>
  <% if(operations.approvals.length){ %><div class="grid grid-cols-2 gap-3 md:grid-cols-3 xl:grid-cols-5">
    <% operations.approvals.forEach(function(a){ %><a href="<%= a.href %>" class="group rounded-xl border border-border-subtle bg-white p-4 text-decoration-none shadow-sm transition hover:-translate-y-0.5 hover:border-primary/30 hover:shadow-md"><div class="mb-3 flex items-center justify-between"><span class="material-symbols-outlined rounded-lg bg-moss-tint p-2 text-primary"><%= a.icon %></span><strong class="text-xl <%= a.count?'text-warning':'text-on-surface' %>"><%= bn.num(a.count) %></strong></div><span class="text-sm font-semibold text-on-surface" data-bn="<%= a.label %>" data-en="<%= a.labelEn %>"><%= a.label %></span><small class="mt-1 block text-on-surface-variant" data-bn="<%= a.count?'পর্যালোচনা প্রয়োজন':'কোনো অপেক্ষমাণ নেই' %>" data-en="<%= a.count?'Review needed':'Nothing pending' %>"><%= a.count?'পর্যালোচনা প্রয়োজন':'কোনো অপেক্ষমাণ নেই' %></small></a><% }) %>
  </div><% } else { %><div class="rounded-xl border border-border-subtle bg-white p-5 text-sm text-on-surface-variant" data-bn="আপনার ভূমিকায় কোনো অনুমোদন কাজ নেই।" data-en="There are no approval tasks for your role.">আপনার ভূমিকায় কোনো অনুমোদন কাজ নেই।</div><% } %>
</section>

<% if(operations.alerts.length){ %><section class="mb-6"><div class="card"><div class="card-header d-flex justify-content-between align-items-center"><span data-bn="অগ্রাধিকার তালিকা" data-en="Priority queue">অগ্রাধিকার তালিকা</span><span class="badge bg-danger-subtle text-danger"><%= bn.num(operations.attentionTotal) %></span></div><div class="card-body p-0"><div class="list-group list-group-flush"><% operations.alerts.forEach(function(a){ %><a href="<%= a.href %>" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between gap-3 py-3"><div class="d-flex align-items-center gap-3"><span class="material-symbols-outlined <%= a.severity==='danger'?'text-danger':a.severity==='warning'?'text-warning':'text-primary' %>"><%= a.severity==='danger'?'error':a.severity==='warning'?'warning':'info' %></span><div><strong class="d-block" data-bn="<%= a.title %>" data-en="<%= a.titleEn %>"><%= a.title %></strong><small class="text-muted" data-bn="<%= a.detail %>" data-en="<%= a.detailEn %>"><%= a.detail %></small></div></div><div class="d-flex align-items-center gap-2"><span class="badge rounded-pill <%= a.severity==='danger'?'text-bg-danger':a.severity==='warning'?'text-bg-warning':'text-bg-primary' %>"><%= bn.num(a.count) %></span><span class="material-symbols-outlined text-muted">chevron_right</span></div></a><% }) %></div></div></div></section><% } %>

<section data-dashboard-widget="performance" class="mb-6 rounded-[20px] border border-border-subtle bg-white p-5 shadow-sm" aria-labelledby="performance-heading">
  <div class="mb-4 flex flex-col gap-3 md:flex-row md:items-center md:justify-between"><div><p class="mb-1 text-[11px] font-bold uppercase tracking-[.18em] text-primary" data-bn="ব্যবস্থাপনা কর্মদক্ষতা" data-en="Management performance">ব্যবস্থাপনা কর্মদক্ষতা</p><h4 id="performance-heading" class="mb-0 text-lg font-bold" data-bn="লক্ষ্য, বাজেট ও ফলো-আপ" data-en="Targets, budget & follow-ups">লক্ষ্য, বাজেট ও ফলো-আপ</h4></div><div class="flex gap-2"><a href="/dashboard/executive-summary?month=<%= executive.month %>" class="btn btn-outline-primary btn-sm" data-bn="নির্বাহী রিপোর্ট" data-en="Executive report">নির্বাহী রিপোর্ট</a><% if(currentUser.role==='admin'){ %><button class="btn btn-primary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#targetForm" data-bn="লক্ষ্য নির্ধারণ" data-en="Set targets">লক্ষ্য নির্ধারণ</button><% } %></div></div>
  <% if(currentUser.role==='admin'){ %><div class="collapse mb-4" id="targetForm"><form method="post" action="/dashboard/targets" class="rounded-xl bg-moss-tint/40 p-4"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><div class="row g-3 align-items-end"><div class="col-md-3"><label class="form-label" data-bn="মাস" data-en="Month">মাস</label><input type="month" name="month" value="<%= executive.month %>" class="form-control" required/></div><div class="col-md-3"><label class="form-label" data-bn="আদায়ের লক্ষ্য" data-en="Collection target">আদায়ের লক্ষ্য</label><input type="number" min="0" step="0.01" name="collection_target" value="<%= executive.target.collectionTarget %>" class="form-control" required/></div><div class="col-md-3"><label class="form-label" data-bn="ব্যয় বাজেট" data-en="Expense budget">ব্যয় বাজেট</label><input type="number" min="0" step="0.01" name="expense_budget" value="<%= executive.target.expenseBudget %>" class="form-control" required/></div><div class="col-md-3"><button class="btn btn-primary w-100" data-bn="সংরক্ষণ" data-en="Save">সংরক্ষণ</button></div><div class="col-12"><input name="notes" value="<%= executive.target.notes %>" class="form-control" placeholder="ব্যবস্থাপনা নোট / Management note"/></div></div></form></div><% } %>
  <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
    <div class="rounded-xl border border-border-subtle p-4"><div class="mb-2 flex items-center justify-between"><span class="font-semibold" data-bn="আদায়ের লক্ষ্য" data-en="Collection target">আদায়ের লক্ষ্য</span><strong class="text-success"><%= executive.performance.collectionPercent===null?'—':bn.num(executive.performance.collectionPercent)+'%' %></strong></div><div class="mb-2 h-2 overflow-hidden rounded-full bg-slate-100"><div class="h-full rounded-full bg-success" style="width:<%= Math.min(executive.performance.collectionPercent||0,100) %>%"></div></div><div class="flex justify-between text-xs text-on-surface-variant"><span>৳ <%= bn.money(executive.actual.collection) %> <span data-bn="আদায়" data-en="collected">আদায়</span></span><span><span data-bn="লক্ষ্য" data-en="Target">লক্ষ্য</span> ৳ <%= bn.money(executive.target.collectionTarget) %></span></div></div>
    <div class="rounded-xl border border-border-subtle p-4"><div class="mb-2 flex items-center justify-between"><span class="font-semibold" data-bn="ব্যয় বাজেট ব্যবহার" data-en="Expense budget used">ব্যয় বাজেট ব্যবহার</span><strong class="<%= executive.performance.expensePercent>100?'text-error':'text-primary' %>"><%= executive.performance.expensePercent===null?'—':bn.num(executive.performance.expensePercent)+'%' %></strong></div><div class="mb-2 h-2 overflow-hidden rounded-full bg-slate-100"><div class="h-full rounded-full <%= executive.performance.expensePercent>100?'bg-error':'bg-primary' %>" style="width:<%= Math.min(executive.performance.expensePercent||0,100) %>%"></div></div><div class="flex justify-between text-xs text-on-surface-variant"><span>৳ <%= bn.money(executive.actual.expense) %> <span data-bn="ব্যয়" data-en="spent">ব্যয়</span></span><span><span data-bn="বাজেট" data-en="Budget">বাজেট</span> ৳ <%= bn.money(executive.target.expenseBudget) %></span></div></div>
  </div>
  <% if(operations.capabilities['monthly.manage'] || operations.capabilities['finance.manage']){ %><div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-3"><% if(operations.capabilities['monthly.manage']){ %><a href="/monthly-payments" class="rounded-xl bg-error-container/40 p-4 text-decoration-none"><small class="text-on-surface-variant" data-bn="মাসিক চাঁদা বকেয়া" data-en="Monthly dues">মাসিক চাঁদা বকেয়া</small><strong class="mt-1 block text-error">৳ <%= bn.money(executive.followUps.monthlyAmount) %> · <%= bn.num(executive.followUps.monthlyRecords) %></strong></a><% } %><% if(operations.capabilities['finance.manage']){ %><a href="/pledges" class="rounded-xl bg-warning/10 p-4 text-decoration-none"><small class="text-on-surface-variant" data-bn="দান অঙ্গীকার বকেয়া" data-en="Outstanding pledges">দান অঙ্গীকার বকেয়া</small><strong class="mt-1 block text-warning">৳ <%= bn.money(executive.followUps.pledgeAmount) %> · <%= bn.num(executive.followUps.pledgeRecords) %></strong></a><a href="/pledges" class="rounded-xl bg-moss-tint p-4 text-decoration-none"><small class="text-on-surface-variant" data-bn="আজ ফলো-আপ" data-en="Follow up today">আজ ফলো-আপ</small><strong class="mt-1 block text-primary"><%= bn.num(executive.followUps.pledgeDueToday) %> <span data-bn="রেকর্ড" data-en="records">রেকর্ড</span></strong></a><% } %></div><% } %>
  <% if(executive.donationTrend.length){ var donationMax=Math.max.apply(null,executive.donationTrend.map(function(x){return x.amount;}))||1; %><div class="mt-4 border-t border-border-subtle pt-4"><div class="mb-3 flex items-center justify-between"><strong class="text-sm" data-bn="সাধারণ দানের ৬ মাসের প্রবণতা" data-en="Six-month donation trend">সাধারণ দানের ৬ মাসের প্রবণতা</strong><small class="text-on-surface-variant" data-bn="মাসিক চাঁদা ছাড়া" data-en="Excludes monthly dues">মাসিক চাঁদা ছাড়া</small></div><div class="flex h-28 items-end gap-3"><% executive.donationTrend.forEach(function(point){ %><div class="group flex h-full flex-1 flex-col items-center justify-end"><span class="mb-1 text-[10px] text-on-surface-variant opacity-0 transition group-hover:opacity-100">৳<%= bn.money(point.amount) %></span><div class="w-full max-w-12 rounded-t bg-primary/75" style="height:<%= Math.max(5,Math.round(point.amount/donationMax*78)) %>%"></div><small class="mt-1 text-[10px] text-on-surface-variant"><%= point.month.slice(5) %>/<%= point.month.slice(2,4) %></small></div><% }) %></div></div><% } %>
</section>

<% if(operations.capabilities['people.manage'] || operations.capabilities['finance.manage']){ %><section data-dashboard-widget="schedule" class="grid grid-cols-1 gap-4 <%= operations.capabilities['people.manage']&&operations.capabilities['finance.manage']?'lg:grid-cols-3':'lg:grid-cols-2' %> mb-6">
  <% if(operations.capabilities['people.manage']){ %><div class="card h-100"><div class="card-header d-flex justify-content-between"><span data-bn="আসন্ন কমিটি সভা" data-en="Upcoming committee meetings">আসন্ন কমিটি সভা</span><a href="/governance-meetings" class="small" data-bn="সব দেখুন" data-en="View all">সব দেখুন</a></div><div class="card-body"><% if(!operations.upcomingMeetings.length){ %><p class="text-muted mb-0" data-bn="কোনো আসন্ন সভা নেই।" data-en="No upcoming meetings.">কোনো আসন্ন সভা নেই।</p><% } %><% operations.upcomingMeetings.forEach(function(m){ %><a href="/governance-meetings/<%= m.id %>" class="d-flex justify-content-between gap-3 border-bottom py-2 text-decoration-none"><div><strong class="d-block text-on-surface"><%= m.title %></strong><small class="text-muted"><%= m.committee_name %> · <%= m.meeting_no %></small></div><small class="text-nowrap text-primary"><%= bn.date(m.meeting_date) %><br/><%= m.start_time.slice(0,5) %></small></a><% }) %></div></div><% } %>
  <% if(operations.capabilities['finance.manage']){ %><div class="card h-100"><div class="card-header d-flex justify-content-between"><span data-bn="সরবরাহের সময়সীমা" data-en="Delivery deadlines">সরবরাহের সময়সীমা</span><a href="/procurement" class="small" data-bn="সব দেখুন" data-en="View all">সব দেখুন</a></div><div class="card-body"><% if(!operations.deliveryDue.length){ %><p class="text-muted mb-0" data-bn="আগামী সাত দিনে কোনো সরবরাহ নেই।" data-en="No deliveries due in seven days.">আগামী সাত দিনে কোনো সরবরাহ নেই।</p><% } %><% operations.deliveryDue.forEach(function(o){ %><a href="/procurement/<%= o.request_id %>" class="d-flex justify-content-between gap-3 border-bottom py-2 text-decoration-none"><div><strong class="d-block text-on-surface"><%= o.order_no %></strong><small class="text-muted"><%= o.vendor_name %></small></div><small class="text-nowrap text-warning"><%= bn.date(o.expected_delivery) %></small></a><% }) %></div></div><% } %>
  <% if(operations.capabilities['people.manage']){ %><div class="card h-100"><div class="card-header d-flex justify-content-between"><span data-bn="সভায় নির্ধারিত করণীয়" data-en="Meeting action items">সভায় নির্ধারিত করণীয়</span><a href="/governance-meetings" class="small" data-bn="সব দেখুন" data-en="View all">সব দেখুন</a></div><div class="card-body"><% if(!operations.openActions.length){ %><p class="text-muted mb-0" data-bn="কোনো খোলা করণীয় নেই।" data-en="No open action items.">কোনো খোলা করণীয় নেই।</p><% } %><% operations.openActions.forEach(function(a){ %><a href="/governance-meetings/<%= a.meeting_id %>" class="d-flex justify-content-between gap-3 border-bottom py-2 text-decoration-none"><div><strong class="d-block text-on-surface"><%= a.title %></strong><small class="text-muted"><%= a.meeting_no %> · <%= a.status %></small></div><small class="text-nowrap <%= a.due_date&&new Date(a.due_date)<new Date()?'text-danger':'text-muted' %>"><%= a.due_date?bn.date(a.due_date):'তারিখ নেই' %></small></a><% }) %></div></div><% } %>
  <% if(operations.capabilities['people.manage']){ %><div class="card h-100"><div class="card-header d-flex justify-content-between"><span data-bn="সাধারণ কাজ ও ফলো-আপ" data-en="Operational tasks">সাধারণ কাজ ও ফলো-আপ</span><a href="/tasks" class="small" data-bn="সব দেখুন" data-en="View all">সব দেখুন</a></div><div class="card-body"><% if(!operations.taskQueue.length){ %><p class="text-muted mb-0" data-bn="কোনো খোলা কাজ নেই।" data-en="No open tasks.">কোনো খোলা কাজ নেই।</p><% } %><% operations.taskQueue.forEach(function(t){ %><a href="/tasks/<%= t.id %>" class="d-flex justify-content-between gap-3 border-bottom py-2 text-decoration-none"><div><strong class="d-block text-on-surface"><%= t.title %></strong><small class="text-muted"><%= t.task_no %> · <%= t.assigned_name||'অনির্ধারিত' %></small></div><small class="text-nowrap <%= t.due_date&&new Date(t.due_date)<new Date()?'text-danger':'text-muted' %>"><%= t.due_date?bn.date(t.due_date):'তারিখ নেই' %></small></a><% }) %></div></div><% } %>
</section><% } %>

<!-- Stats Card Grid -->
<div data-dashboard-widget="stats" class="dashboard-stat-grid grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 mb-6">

  <!-- Total Members -->
  <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm hover:-translate-y-1 hover:shadow-md transition-all duration-200 group">
    <div class="flex justify-between items-start mb-4">
      <div class="p-2.5 bg-moss-tint text-primary rounded-lg group-hover:bg-primary group-hover:text-white transition-colors flex items-center justify-center">
        <span class="material-symbols-outlined text-[24px]">groups</span>
      </div>
      <span class="text-primary font-bold text-xs bg-moss-tint px-2 py-0.5 rounded-full">
        <%= bn.num(memberCounts.active) %> সক্রিয়
      </span>
    </div>
    <p class="font-label-md text-sm text-on-surface-variant mb-1">সর্বমোট নিবন্ধিত সদস্য</p>
    <h3 class="font-headline-md text-2xl font-bold text-on-surface"><%= bn.num(memberCounts.total) %> জন</h3>
  </div>

  <!-- Monthly Collections -->
  <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm hover:-translate-y-1 hover:shadow-md transition-all duration-200 group">
    <div class="flex justify-between items-start mb-4">
      <div class="p-2.5 bg-moss-tint text-primary rounded-lg group-hover:bg-primary group-hover:text-white transition-colors flex items-center justify-center">
        <span class="material-symbols-outlined text-[24px]">payments</span>
      </div>
      <span class="text-primary font-bold text-xs bg-moss-tint px-2 py-0.5 rounded-full">চলতি মাস</span>
    </div>
    <p class="font-label-md text-sm text-on-surface-variant mb-1">চলতি মাসের মোট আদায়</p>
    <h3 class="font-headline-md text-2xl font-bold text-success">৳ <%= bn.money(stats.monthCollection) %></h3><small class="<%= stats.comparison.collectionPercent===null?'text-muted':stats.comparison.collectionPercent>=0?'text-success':'text-danger' %>"><%= stats.comparison.collectionPercent===null?'—':(stats.comparison.collectionPercent>=0?'↑ ':'↓ ')+bn.num(Math.abs(stats.comparison.collectionPercent))+'%' %> <span data-bn="আগের মাস থেকে" data-en="vs previous month">আগের মাস থেকে</span></small>
  </div>

  <!-- Monthly Expenses -->
  <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm hover:-translate-y-1 hover:shadow-md transition-all duration-200 group">
    <div class="flex justify-between items-start mb-4">
      <div class="p-2.5 bg-error-container text-on-error-container rounded-lg group-hover:bg-error group-hover:text-white transition-colors flex items-center justify-center">
        <span class="material-symbols-outlined text-[24px]">account_balance_wallet</span>
      </div>
      <span class="text-error font-bold text-xs bg-error-container px-2 py-0.5 rounded-full">চলতি মাস</span>
    </div>
    <p class="font-label-md text-sm text-on-surface-variant mb-1">চলতি মাসের মোট খরচ</p>
    <h3 class="font-headline-md text-2xl font-bold text-error">৳ <%= bn.money(stats.monthExpense) %></h3><small class="<%= stats.comparison.expensePercent===null?'text-muted':stats.comparison.expensePercent<=0?'text-success':'text-danger' %>"><%= stats.comparison.expensePercent===null?'—':(stats.comparison.expensePercent>=0?'↑ ':'↓ ')+bn.num(Math.abs(stats.comparison.expensePercent))+'%' %> <span data-bn="আগের মাস থেকে" data-en="vs previous month">আগের মাস থেকে</span></small>
  </div>

  <!-- Monthly Balance -->
  <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm hover:-translate-y-1 hover:shadow-md transition-all duration-200 group">
    <div class="flex justify-between items-start mb-4">
      <div class="p-2.5 bg-primary-container text-white rounded-lg flex items-center justify-center">
        <span class="material-symbols-outlined text-[24px]">verified</span>
      </div>
      <span class="text-primary font-bold text-xs bg-moss-tint px-2 py-0.5 rounded-full">অবশিষ্ট</span>
    </div>
    <p class="font-label-md text-sm text-on-surface-variant mb-1">চলতি মাসের ব্যালেন্স</p>
    <h3 class="font-headline-md text-2xl font-bold text-primary">৳ <%= bn.money(stats.monthBalance) %></h3><small class="<%= stats.monthBalance-stats.comparison.previousBalance>=0?'text-success':'text-danger' %>"><%= stats.monthBalance-stats.comparison.previousBalance>=0?'↑':'↓' %> ৳ <%= bn.money(Math.abs(stats.monthBalance-stats.comparison.previousBalance)) %> <span data-bn="আগের মাস থেকে" data-en="vs previous month">আগের মাস থেকে</span></small>
  </div>

</div>

<!-- Finance source overview -->
<div class="bg-white rounded-xl border border-border-subtle p-5 shadow-sm mb-4 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
  <div><p class="mb-1 text-sm font-semibold text-on-surface-variant">বর্তমান তহবিল অবস্থান</p><div class="flex flex-wrap gap-x-6 gap-y-2"><span>নগদ: <strong>৳ <%= bn.money(treasurySummary.cash) %></strong></span><span>ব্যাংক: <strong>৳ <%= bn.money(treasurySummary.bankTotal) %></strong></span><span>সর্বমোট: <strong class="text-success">৳ <%= bn.money(treasurySummary.total) %></strong></span></div></div>
  <a href="/treasury" class="btn btn-outline-primary text-decoration-none">ক্যাশ ও ব্যাংক</a>
</div>
<div class="bg-white rounded-xl border border-border-subtle p-5 shadow-sm mb-4 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
  <div><p class="mb-1 text-sm font-semibold text-on-surface-variant">মসজিদের সম্পদ</p><div class="flex flex-wrap gap-x-6 gap-y-2"><span>সক্রিয়: <strong><%= bn.num(assetSummary.activeCount) %></strong></span><span>ক্রয়মূল্য: <strong>৳ <%= bn.money(assetSummary.totalValue) %></strong></span><span>মনোযোগ প্রয়োজন: <strong class="text-error"><%= bn.num(assetSummary.attentionCount) %></strong></span></div></div>
  <a href="/assets" class="btn btn-outline-primary text-decoration-none">সম্পদ রেজিস্টার</a>
</div>
<div class="bg-white rounded-xl border border-border-subtle p-5 shadow-sm mb-4 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
  <div><p class="mb-1 text-sm font-semibold text-on-surface-variant">চলতি মাসের সদস্য চাঁদা</p><div class="flex flex-wrap gap-x-6 gap-y-2"><span>দাবি: <strong>৳ <%= bn.money(monthlySummary.totalDue) %></strong></span><span>আদায়: <strong class="text-success">৳ <%= bn.money(monthlySummary.totalPaid) %></strong></span><span>বকেয়া: <strong class="text-error">৳ <%= bn.money(monthlySummary.outstanding) %></strong></span></div></div>
  <a href="/monthly-payments" class="btn btn-primary text-decoration-none">মাসিক চাঁদা পরিচালনা</a>
</div>
<div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-6">
  <div class="bg-white rounded-xl border border-border-subtle p-5 shadow-sm">
    <div class="flex items-center justify-between mb-3"><span class="text-sm font-semibold text-on-surface-variant">নগদ হিসাবে অবশিষ্ট</span><span class="material-symbols-outlined text-primary">payments</span></div>
    <p class="mb-1 text-2xl font-bold text-on-surface">৳ <%= bn.money(stats.cashBalance) %></p><p class="mb-0 text-xs text-on-surface-variant">নগদ আদায় থেকে নগদ খরচ বাদ</p>
  </div>
  <div class="bg-white rounded-xl border border-border-subtle p-5 shadow-sm">
    <div class="flex items-center justify-between mb-3"><span class="text-sm font-semibold text-on-surface-variant">ব্যাংকে রেকর্ডকৃত</span><span class="material-symbols-outlined text-primary">account_balance</span></div>
    <p class="mb-1 text-2xl font-bold text-on-surface">৳ <%= bn.money(stats.bankRecordedBalance) %></p><p class="mb-0 text-xs text-on-surface-variant">ব্যাংক-পদ্ধতির আয় ও ব্যয়ের নিট হিসাব</p>
  </div>
  <div class="bg-white rounded-xl border border-border-subtle p-5 shadow-sm">
    <div class="flex items-center justify-between mb-3"><span class="text-sm font-semibold text-on-surface-variant">মোবাইল ব্যাংকিং</span><span class="material-symbols-outlined text-primary">phone_iphone</span></div>
    <p class="mb-1 text-2xl font-bold text-on-surface">৳ <%= bn.money(stats.mobileBankingBalance) %></p><p class="mb-0 text-xs text-on-surface-variant">মোবাইল ব্যাংকিং আয় ও ব্যয়ের নিট হিসাব</p>
  </div>
</div>

<!-- Main Content Grid -->
<div class="dashboard-main-grid grid grid-cols-1 lg:grid-cols-3 gap-5">

  <!-- Left: Dynamic Charts & Ledger -->
  <div class="lg:col-span-2 space-y-5">

    <!-- Collections vs Expenses Chart -->
    <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h4 class="font-headline-md text-base text-on-surface font-semibold">আদায় বনাম খরচ</h4>
          <p class="text-xs text-on-surface-variant">গত ৬ মাসের আর্থিক উপাত্তের তুলনাচিত্র</p>
        </div>
        <div class="flex gap-2">
          <span class="text-[11px] font-bold px-2.5 py-1 bg-moss-tint text-primary rounded-full uppercase">স্বয়ংক্রিয় আপডেট</span>
        </div>
      </div>

      <%
        // Find maximum value in chartData to scale heights
        let maxVal = 10000;
        stats.chartData.forEach(d => {
          if (d.collections > maxVal) maxVal = d.collections;
          if (d.expenses > maxVal) maxVal = d.expenses;
        });
      %>

      <!-- Column Chart Area -->
      <div class="relative h-[280px] w-full flex items-end justify-between px-2 pt-8 border-b border-border-subtle">
        <% stats.chartData.forEach(d => {
           const colHeight = Math.round((d.collections / maxVal) * 100);
           const expHeight = Math.round((d.expenses / maxVal) * 100);
        %>
          <div class="flex-1 flex flex-col items-center group relative h-full justify-end px-2">
            <!-- Tooltip on Hover -->
            <div class="absolute bottom-full mb-2 bg-slate-900 text-white text-[10px] rounded py-1 px-2 opacity-0 group-hover:opacity-100 transition-opacity z-20 pointer-events-none text-center shadow-lg">
              আদায়: ৳ <%= bn.money(d.collections) %><br/>
              খরচ: ৳ <%= bn.money(d.expenses) %>
            </div>

            <div class="w-full flex gap-1 justify-center items-end h-full">
              <!-- Collections Bar -->
              <div class="w-1/2 max-w-[20px] bg-primary rounded-t transition-all duration-300 hover:opacity-85" style="height: <%= colHeight %>%"></div>
              <!-- Expenses Bar -->
              <div class="w-1/2 max-w-[20px] bg-tertiary-container/30 rounded-t transition-all duration-300 hover:opacity-85" style="height: <%= expHeight %>%"></div>
            </div>
            <span class="text-[11px] mt-2 text-on-surface-variant font-semibold"><%= d.label %></span>
          </div>
        <% }) %>
      </div>

      <!-- Chart Legend -->
      <div class="flex gap-6 mt-4 pt-2 justify-center">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 bg-primary rounded-full"></span>
          <span class="text-xs font-semibold text-on-surface-variant">মোট আদায় (Collections)</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 bg-tertiary-container/35 rounded-full"></span>
          <span class="text-xs font-semibold text-on-surface-variant">মোট খরচ (Expenses)</span>
        </div>
      </div>
    </div>

    <!-- Overall Cash Ledger (সর্বমোট হিসাব) -->
    <div class="bg-white rounded-xl border border-border-subtle p-6 shadow-sm">
      <h4 class="font-headline-md text-base text-on-surface font-semibold mb-4">সর্বমোট আর্থিক হিসাব</h4>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-center">
        <div class="p-4 bg-moss-tint/40 rounded-xl border border-border-subtle/50">
          <p class="text-xs text-on-surface-variant mb-1 font-medium">সর্বমোট আদায়কৃত ফান্ড</p>
          <p class="text-lg font-bold text-success">৳ <%= bn.money(stats.totalCollection) %></p>
        </div>
        <div class="p-4 bg-error-container/20 rounded-xl border border-border-subtle/50">
          <p class="text-xs text-on-surface-variant mb-1 font-medium">সর্বমোট মসজিদ খরচ</p>
          <p class="text-lg font-bold text-error">৳ <%= bn.money(stats.totalExpense) %></p>
        </div>
        <div class="p-4 bg-primary/5 rounded-xl border border-border-subtle/50">
          <p class="text-xs text-on-surface-variant mb-1 font-medium">বর্তমানে নেট অবশিষ্ট</p>
          <p class="text-lg font-bold text-primary">৳ <%= bn.money(stats.totalBalance) %></p>
        </div>
      </div>
    </div>

  </div>

  <!-- Right: Member Demographics & Operations -->
  <div class="space-y-6">

    <!-- Member Demographics Card -->
    <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm">
      <h4 class="font-headline-md text-base text-on-surface font-semibold mb-4">সদস্য ডেমোগ্রাফিক</h4>

      <div class="space-y-4">
        <!-- Active Members Progress -->
        <%
          const activePercent = memberCounts.total > 0 ? Math.round((memberCounts.active / memberCounts.total) * 100) : 0;
          const malePercent = memberCounts.total > 0 ? Math.round((memberCounts.male / memberCounts.total) * 100) : 0;
          const femalePercent = memberCounts.total > 0 ? Math.round((memberCounts.female / memberCounts.total) * 100) : 0;
        %>
        <div>
          <div class="flex justify-between text-xs font-semibold text-on-surface-variant mb-1">
            <span>সক্রিয় সদস্য (Active)</span>
            <span><%= activePercent %>% (<%= bn.num(memberCounts.active) %> জন)</span>
          </div>
          <div class="w-full h-2 bg-slate-100 rounded-full overflow-hidden">
            <div class="h-full bg-primary transition-all duration-500" style="width: <%= activePercent %>%"></div>
          </div>
        </div>

        <!-- Male Members Progress -->
        <div>
          <div class="flex justify-between text-xs font-semibold text-on-surface-variant mb-1">
            <span>পুরুষ সদস্য (Male)</span>
            <span><%= malePercent %>% (<%= bn.num(memberCounts.male) %> জন)</span>
          </div>
          <div class="w-full h-2 bg-slate-100 rounded-full overflow-hidden">
            <div class="h-full bg-primary-container transition-all duration-500" style="width: <%= malePercent %>%"></div>
          </div>
        </div>

        <!-- Female Members Progress -->
        <div>
          <div class="flex justify-between text-xs font-semibold text-on-surface-variant mb-1">
            <span>মহিলা সদস্য (Female)</span>
            <span><%= femalePercent %>% (<%= bn.num(memberCounts.female) %> জন)</span>
          </div>
          <div class="w-full h-2 bg-slate-100 rounded-full overflow-hidden">
            <div class="h-full bg-secondary-container transition-all duration-500" style="width: <%= femalePercent %>%"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Quick Operations -->
    <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm">
      <h4 class="font-headline-md text-base text-on-surface font-semibold mb-4">দ্রুত অ্যাকশন</h4>

      <div class="space-y-3">
        <% if(operations.capabilities['members.manage']){ %><a href="/members/new" class="w-full flex items-center justify-between px-4 py-3 bg-moss-tint hover:bg-primary-container hover:text-white text-primary text-sm font-semibold rounded-lg transition-all text-decoration-none group">
          <span class="flex items-center gap-2">
            <span class="material-symbols-outlined text-[20px]">person_add</span>
            নতুন সদস্য যোগ করুন
          </span>
          <span class="material-symbols-outlined text-[18px] transition-transform group-hover:translate-x-1">chevron_right</span>
        </a><% } %>

        <% if(operations.capabilities['finance.manage']){ %><a href="/collections/new" class="w-full flex items-center justify-between px-4 py-3 bg-moss-tint hover:bg-primary-container hover:text-white text-primary text-sm font-semibold rounded-lg transition-all text-decoration-none group">
          <span class="flex items-center gap-2">
            <span class="material-symbols-outlined text-[20px]">add_card</span>
            নতুন আদায় লিপিবদ্ধ করুন
          </span>
          <span class="material-symbols-outlined text-[18px] transition-transform group-hover:translate-x-1">chevron_right</span>
        </a><% } %>

        <% if(operations.capabilities['website.manage']){ %><a href="/landing" class="w-full flex items-center justify-between px-4 py-3 bg-moss-tint hover:bg-primary-container hover:text-white text-primary text-sm font-semibold rounded-lg transition-all text-decoration-none group">
          <span class="flex items-center gap-2">
            <span class="material-symbols-outlined text-[20px]">web</span>
            ল্যান্ডিং পেজ কনটেন্ট এডিট
          </span>
          <span class="material-symbols-outlined text-[18px] transition-transform group-hover:translate-x-1">chevron_right</span>
        </a><% } %>
        <% if(!operations.capabilities['members.manage']&&!operations.capabilities['finance.manage']&&!operations.capabilities['website.manage']){ %><p class="mb-0 text-sm text-on-surface-variant" data-bn="আপনার ভূমিকার জন্য কোনো দ্রুত সম্পাদনা নেই।" data-en="No quick-edit actions are available for your role.">আপনার ভূমিকার জন্য কোনো দ্রুত সম্পাদনা নেই।</p><% } %>
      </div>
    </div>

  </div>

</div>
