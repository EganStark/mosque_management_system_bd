<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4"><div><p class="text-uppercase text-primary fw-bold small mb-1">Booking <%= item.booking_no %></p><h3 class="mb-1"><%= item.event_title %></h3><p class="text-muted mb-0"><%= item.facility_name %> · <%= bn.date(item.booking_date) %> · <%= item.start_time.slice(0,5) %>–<%= item.end_time.slice(0,5) %></p></div><div class="d-flex flex-wrap gap-2"><a href="/bookings" class="btn btn-outline-secondary">সব বুকিং</a><button onclick="window.print()" class="btn btn-outline-primary"><i class="bi bi-printer me-1"></i> প্রিন্ট</button><% if(currentUser.role==='admin'&&item.status==='pending'){ %><form method="post" action="/bookings/<%= item.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><input type="hidden" name="status" value="approved"/><button class="btn btn-success">অনুমোদন করুন</button></form><% } %><% if(currentUser.role==='admin'&&!['cancelled','completed'].includes(item.status)){ %><form method="post" action="/bookings/<%= item.id %>/status" class="confirm-delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><input type="hidden" name="status" value="cancelled"/><button class="btn btn-outline-danger">বাতিল</button></form><% } %></div></div>
<div class="row g-4 mb-4"><div class="col-lg-7"><div class="card h-100"><div class="card-header">বুকিং তথ্য</div><div class="card-body"><dl class="row mb-0"><dt class="col-sm-4">অবস্থা</dt><dd class="col-sm-8"><span class="badge <%= item.status==='approved'?'bg-success-subtle text-success':item.status==='cancelled'?'bg-danger-subtle text-danger':'bg-warning-subtle text-warning' %>"><%= ({pending:'অপেক্ষমান',approved:'অনুমোদিত',completed:'সম্পন্ন',cancelled:'বাতিল'})[item.status] %></span></dd><dt class="col-sm-4">আবেদনকারী</dt><dd class="col-sm-8"><strong><%= item.requester_name %></strong> · <%= item.requester_phone %><% if(item.member_id_no){ %><br/>সদস্য আইডি: <%= item.member_id_no %><% } %></dd><dt class="col-sm-4">আয়োজন</dt><dd class="col-sm-8"><%= item.booking_type %> · সম্ভাব্য অতিথি <%= item.expected_guests?bn.num(item.expected_guests):'—' %></dd><dt class="col-sm-4">বিশেষ প্রয়োজন</dt><dd class="col-sm-8"><%= item.requirements||'—' %></dd><dt class="col-sm-4">নোট</dt><dd class="col-sm-8"><%= item.notes||'—' %></dd></dl></div></div></div><div class="col-lg-5"><div class="card h-100"><div class="card-header">ফি ও পেমেন্ট</div><div class="card-body"><div class="d-flex justify-content-between mb-2"><span>নির্ধারিত ফি</span><strong>৳ <%= bn.money(item.fee_amount) %></strong></div><div class="d-flex justify-content-between mb-2"><span>পরিশোধিত</span><strong class="text-success">৳ <%= bn.money(item.amount_paid) %></strong></div><div class="d-flex justify-content-between border-top pt-2 mb-4"><span>বকেয়া</span><strong class="text-danger">৳ <%= bn.money(Number(item.fee_amount)-Number(item.amount_paid)) %></strong></div><% if(currentUser.role!=='viewer'&&Number(item.amount_paid)<Number(item.fee_amount)&&item.status!=='cancelled'){ %><form method="post" action="/bookings/<%= item.id %>/payments" class="row g-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><div class="col-6"><input type="number" min="0.01" max="<%= Number(item.fee_amount)-Number(item.amount_paid) %>" step="0.01" name="amount" class="form-control" placeholder="পরিমাণ" required/></div><div class="col-6"><input type="date" name="payment_date" value="<%= new Date().toISOString().slice(0,10) %>" class="form-control" required/></div><div class="col-6"><select name="payment_method" class="form-select"><option value="cash">নগদ</option><option value="bank">ব্যাংক</option><option value="mobile_banking">মোবাইল ব্যাংকিং</option></select></div><div class="col-6"><input name="reference" class="form-control" placeholder="রেফারেন্স"/></div><div class="col-12"><button class="btn btn-primary w-100">পেমেন্ট গ্রহণ</button></div></form><% } %></div></div></div></div>
<div class="card"><div class="card-header">পেমেন্ট ইতিহাস</div><div class="card-body"><div class="table-responsive"><table class="table"><thead><tr><th>তারিখ</th><th>পদ্ধতি</th><th>রেফারেন্স</th><th>গ্রহণকারী</th><th class="text-end">পরিমাণ</th></tr></thead><tbody><% item.payments.forEach(function(p){ %><tr><td><%= bn.date(p.payment_date) %></td><td><%= p.payment_method %></td><td><%= p.reference||'—' %></td><td><%= p.received_by_name||'—' %></td><td class="text-end">৳ <%= bn.money(p.amount) %></td></tr><% }); %><% if(!item.payments.length){ %><tr><td colspan="5" class="text-center text-muted">এখনও পেমেন্ট নেই</td></tr><% } %></tbody></table></div></div></div>
<script>
  (() => {
    const form = document.querySelector('form[action$="/payments"]');
    if (!form || form.querySelector('[name="bank_id"]')) return;
    const wrapper = document.createElement("div");
    wrapper.className = "col-12";
    const select = document.createElement("select");
    select.name = "bank_id";
    select.className = "form-select";
    select.innerHTML = '<option value="">ব্যাংক হিসাব (শুধু ব্যাংক পেমেন্টে)</option>';
    const bankOptions = <%- JSON.stringify(banks.map(function(bank){ return { id: bank.id, name: bank.name }; })).replace(/</g, "\\u003c") %>;
    bankOptions.forEach((bank) => select.add(new Option(bank.name, bank.id)));
    wrapper.appendChild(select);
    form.querySelector('button[type="submit"], button').closest("div").before(wrapper);
    const walletWrapper = document.createElement("div");
    walletWrapper.className = "col-12";
    const walletSelect = document.createElement("select");
    walletSelect.name = "mobile_wallet_id";
    walletSelect.className = "form-select";
    walletSelect.innerHTML = '<option value="">মোবাইল ওয়ালেট (শুধু মোবাইল পেমেন্টে)</option>';
    const walletOptions = <%- JSON.stringify(wallets.map(function(wallet){ return { id: wallet.id, name: wallet.name }; })).replace(/</g, "\\u003c") %>;
    walletOptions.forEach((wallet) => walletSelect.add(new Option(wallet.name, wallet.id)));
    walletWrapper.appendChild(walletSelect);
    form.querySelector('button[type="submit"], button').closest("div").before(walletWrapper);
  })();
</script>
