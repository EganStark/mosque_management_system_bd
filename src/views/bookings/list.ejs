<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4"><div><p class="text-uppercase text-primary fw-bold small mb-1">Facility operations</p><h3 class="mb-1">সুবিধা ও বুকিং</h3><p class="text-muted mb-0">হল, কক্ষ, বিবাহ, আকীকা ও সামাজিক আয়োজনের সময়সূচি</p></div><% if(currentUser.role!=='viewer'){ %><a href="/bookings/new" class="btn btn-primary"><i class="bi bi-calendar-plus me-1"></i> নতুন বুকিং</a><% } %></div>
<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 mb-4"><div class="card"><div class="card-body"><p class="small text-muted mb-1">আজকের বুকিং</p><h4><%= bn.num(summary.today) %></h4></div></div><div class="card"><div class="card-body"><p class="small text-muted mb-1">অনুমোদনের অপেক্ষায়</p><h4><%= bn.num(summary.pending) %></h4></div></div><div class="card"><div class="card-body"><p class="small text-muted mb-1">আসন্ন অনুমোদিত</p><h4><%= bn.num(summary.upcoming) %></h4></div></div><div class="card"><div class="card-body"><p class="small text-muted mb-1">বকেয়া ফি</p><h4>৳ <%= bn.money(summary.outstanding) %></h4></div></div></div>
<div class="card"><div class="card-body"><form method="get" class="row g-2 mb-4"><div class="col-md-3"><input type="date" name="from" value="<%= filters.from||'' %>" class="form-control"/></div><div class="col-md-3"><input type="date" name="to" value="<%= filters.to||'' %>" class="form-control"/></div><div class="col-md-3"><select name="status" class="form-select"><option value="">সব অবস্থা</option><option value="pending">অপেক্ষমান</option><option value="approved">অনুমোদিত</option><option value="completed">সম্পন্ন</option><option value="cancelled">বাতিল</option></select></div><div class="col-md-3"><button class="btn btn-outline-primary w-100">ফিল্টার</button></div></form><div class="table-responsive"><table class="table table-hover datatable w-100"><thead><tr><th>বুকিং</th><th>তারিখ ও সময়</th><th>স্থান</th><th>আয়োজন</th><th>আবেদনকারী</th><th>ফি</th><th>অবস্থা</th><th></th></tr></thead><tbody><% rows.forEach(function(row){ %><tr><td><strong><%= row.booking_no %></strong></td><td><%= bn.date(row.booking_date) %><small class="d-block text-muted"><%= row.start_time.slice(0,5) %> – <%= row.end_time.slice(0,5) %></small></td><td><%= row.facility_name %></td><td><%= row.event_title %></td><td><%= row.requester_name %><small class="d-block text-muted"><%= row.requester_phone %></small></td><td>৳ <%= bn.money(row.fee_amount) %><small class="d-block text-muted">পরিশোধ: ৳ <%= bn.money(row.amount_paid) %></small></td><td><span class="badge <%= row.status==='approved'?'bg-success-subtle text-success':row.status==='cancelled'?'bg-danger-subtle text-danger':'bg-warning-subtle text-warning' %>"><%= ({pending:'অপেক্ষমান',approved:'অনুমোদিত',completed:'সম্পন্ন',cancelled:'বাতিল'})[row.status] %></span></td><td><a href="/bookings/<%= row.id %>" class="btn btn-sm btn-outline-primary">বিস্তারিত</a></td></tr><% }) %></tbody></table></div></div></div>
