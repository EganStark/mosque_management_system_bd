<div class="d-flex justify-content-between align-items-center mb-4"><div><h3 class="mb-1">নতুন সুবিধা বুকিং</h3><p class="text-muted mb-0">একই স্থান ও সময়ে একাধিক বুকিং সিস্টেম স্বয়ংক্রিয়ভাবে প্রতিরোধ করবে</p></div><a href="/bookings" class="btn btn-outline-secondary">ফিরে যান</a></div>
<div class="card"><div class="card-body"><form method="post" action="/bookings" class="row g-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><div class="col-md-4"><label class="form-label required">সুবিধা/স্থান</label><select name="facility_id" id="bookingFacility" class="form-select" required><option value="">নির্বাচন করুন</option><% facilities.forEach(function(f){ %><option value="<%= f.id %>" data-fee="<%= f.default_fee %>"><%= f.name %> — ধারণক্ষমতা <%= f.capacity||'—' %></option><% }) %></select></div><div class="col-md-4"><label class="form-label required">আয়োজনের ধরন</label><select name="booking_type" class="form-select"><option value="nikah">বিবাহ/নিকাহ</option><option value="aqiqah">আকীকা</option><option value="meeting">সভা</option><option value="education">শিক্ষা</option><option value="community">সামাজিক আয়োজন</option><option value="iftar">ইফতার</option><option value="other">অন্যান্য</option></select></div><div class="col-md-4"><label class="form-label required">আয়োজনের নাম</label><input name="event_title" class="form-control" required/></div><div class="col-md-4"><label class="form-label required">তারিখ</label><input type="date" name="booking_date" min="<%= new Date().toISOString().slice(0,10) %>" class="form-control" required/></div><div class="col-md-2"><label class="form-label required">শুরু</label><input type="time" name="start_time" class="form-control" required/></div><div class="col-md-2"><label class="form-label required">শেষ</label><input type="time" name="end_time" class="form-control" required/></div><div class="col-md-2"><label class="form-label">অতিথি</label><input type="number" min="1" name="expected_guests" class="form-control"/></div><div class="col-md-2"><label class="form-label">নির্ধারিত ফি</label><input type="number" min="0" step="0.01" name="fee_amount" id="bookingFee" class="form-control" value="0"/></div><div class="col-12"><hr/><h6>আবেদনকারী</h6></div><div class="col-md-6"><label class="form-label">নিবন্ধিত সদস্য</label><select name="member_id" class="form-select select2"><option value="">সদস্য না হলে নিচে তথ্য দিন</option><% memberOptions.forEach(function(m){ %><option value="<%= m.id %>"><%= m.id_no %> — <%= m.name %> — <%= m.phone||'' %></option><% }) %></select></div><div class="col-md-3"><label class="form-label">আবেদনকারীর নাম</label><input name="requester_name" class="form-control"/></div><div class="col-md-3"><label class="form-label">মোবাইল</label><input name="requester_phone" class="form-control"/></div><div class="col-md-6"><label class="form-label">বিশেষ প্রয়োজন</label><textarea name="requirements" class="form-control"></textarea></div><div class="col-md-6"><label class="form-label">অভ্যন্তরীণ নোট</label><textarea name="notes" class="form-control"></textarea></div><div class="col-12"><button class="btn btn-primary">বুকিং আবেদন তৈরি</button></div></form></div></div>
<script>document.addEventListener('DOMContentLoaded',function(){var f=document.getElementById('bookingFacility'),fee=document.getElementById('bookingFee');if(f&&fee)f.addEventListener('change',function(){fee.value=f.options[f.selectedIndex].dataset.fee||0;});});</script>
