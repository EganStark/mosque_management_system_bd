<div class="d-flex justify-content-between align-items-center mb-4"><div><h3 class="mb-1">নতুন কাজের আদেশ</h3><p class="text-muted mb-0">সম্পদ বা মসজিদ সুবিধার সমস্যা রিপোর্ট ও দায়িত্ব প্রদান</p></div><a href="/maintenance" class="btn btn-outline-secondary">ফিরে যান</a></div>
<div class="row g-4"><div class="col-xl-8"><div class="card"><div class="card-body"><form method="post" action="/maintenance" class="row g-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><div class="col-md-6"><label class="form-label">সম্পদ</label><select name="asset_id" class="form-select select2"><option value="">প্রযোজ্য নয়</option><% assets.forEach(function(a){ %><option value="<%= a.id %>"><%= a.asset_code %> — <%= a.name %></option><% }) %></select></div><div class="col-md-6"><label class="form-label">সুবিধা/স্থান</label><select name="facility_id" class="form-select"><option value="">প্রযোজ্য নয়</option><% facilities.forEach(function(f){ %><option value="<%= f.id %>"><%= f.name %></option><% }) %></select></div><div class="col-md-8"><label class="form-label required">কাজের শিরোনাম</label><input name="title" class="form-control" required/></div><div class="col-md-4"><label class="form-label">ধরন</label><select name="maintenance_type" class="form-select"><option value="inspection">পরিদর্শন</option><option value="service">সার্ভিস</option><option value="repair">মেরামত</option><option value="replacement">যন্ত্রাংশ পরিবর্তন</option><option value="building">ভবন রক্ষণাবেক্ষণ</option></select></div><div class="col-12"><label class="form-label required">সমস্যা/কাজের বিবরণ</label><textarea name="description" class="form-control" rows="3" required></textarea></div><div class="col-md-3"><label class="form-label">অগ্রাধিকার</label><select name="priority" class="form-select"><option value="normal">সাধারণ</option><option value="low">কম</option><option value="high">উচ্চ</option><option value="critical">অতি জরুরি</option></select></div><div class="col-md-3"><label class="form-label">রিপোর্ট তারিখ</label><input type="date" name="reported_date" value="<%= today %>" class="form-control" required/></div><div class="col-md-3"><label class="form-label">কাজের তারিখ</label><input type="date" name="scheduled_date" class="form-control"/></div><div class="col-md-3"><label class="form-label">আনুমানিক খরচ</label><input type="number" min="0" step="0.01" name="estimated_cost" value="0" class="form-control"/></div><div class="col-md-6"><label class="form-label">দায়িত্বপ্রাপ্ত স্টাফ</label><select name="assigned_staff_id" class="form-select"><option value="">নির্ধারিত নয়</option><% staff.forEach(function(s){ %><option value="<%= s.id %>"><%= s.name_bn %> — <%= s.position_bn %></option><% }) %></select></div><div class="col-md-6"><label class="form-label">সেবাদাতা/ভেন্ডর</label><select name="vendor_id" class="form-select"><option value="">নির্ধারিত নয়</option><% vendors.forEach(function(v){ %><option value="<%= v.id %>"><%= v.name %> — <%= v.service_type||'' %></option><% }) %></select></div><div class="col-12"><button class="btn btn-primary">কাজের আদেশ তৈরি</button></div></form></div></div></div>
<div class="col-xl-4"><div class="card"><div class="card-header">নতুন সেবাদাতা</div><div class="card-body"><form method="post" action="/maintenance/vendors" class="row g-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><div class="col-12"><input name="name" class="form-control" placeholder="প্রতিষ্ঠান/সেবাদাতার নাম" required/></div><div class="col-12"><input name="contact_person" class="form-control" placeholder="যোগাযোগ ব্যক্তি"/></div><div class="col-12"><input name="phone" class="form-control" placeholder="মোবাইল"/></div><div class="col-12"><input name="service_type" class="form-control" placeholder="সেবার ধরন"/></div><div class="col-12"><button class="btn btn-outline-primary w-100">সেবাদাতা যোগ</button></div></form></div></div></div></div>
