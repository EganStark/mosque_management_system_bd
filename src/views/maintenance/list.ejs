<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4"><div><p class="text-uppercase text-primary fw-bold small mb-1">Maintenance operations</p><h3 class="mb-1">রক্ষণাবেক্ষণ ও কাজের আদেশ</h3><p class="text-muted mb-0">সম্পদ, ভবন, মেরামত, সেবাদাতা ও খরচের পূর্ণ জীবনচক্র</p></div><% if(currentUser.role!=='viewer'){ %><a href="/maintenance/new" class="btn btn-primary"><i class="bi bi-tools me-1"></i> নতুন কাজের আদেশ</a><% } %></div>
<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 mb-4"><div class="card"><div class="card-body"><p class="small text-muted mb-1">চলমান কাজ</p><h4><%= bn.num(summary.active) %></h4></div></div><div class="card"><div class="card-body"><p class="small text-muted mb-1">জরুরি সমস্যা</p><h4 class="text-danger"><%= bn.num(summary.critical) %></h4></div></div><div class="card"><div class="card-body"><p class="small text-muted mb-1">৭ দিনে নির্ধারিত</p><h4><%= bn.num(summary.due) %></h4></div></div><div class="card"><div class="card-body"><p class="small text-muted mb-1">এই মাসের খরচ</p><h4>৳ <%= bn.money(summary.monthCost) %></h4></div></div></div>
<div class="card"><div class="card-body"><div class="table-responsive"><table class="table table-hover datatable w-100"><thead><tr><th>কাজের আদেশ</th><th>বিষয়</th><th>সম্পদ/স্থান</th><th>অগ্রাধিকার</th><th>দায়িত্ব</th><th>নির্ধারিত তারিখ</th><th>অবস্থা</th><th></th></tr></thead><tbody><% rows.forEach(function(r){ %><tr><td><strong><%= r.work_order_no %></strong></td><td><%= r.title %><small class="d-block text-muted"><%= r.maintenance_type %></small></td><td><%= r.asset_name?`${r.asset_code} — ${r.asset_name}`:(r.facility_name||'—') %></td><td><span class="badge <%= r.priority==='critical'?'bg-danger text-white':r.priority==='high'?'bg-warning-subtle text-warning':'bg-secondary-subtle text-secondary' %>"><%= r.priority %></span></td><td><%= r.staff_name||r.vendor_name||'নির্ধারিত নয়' %></td><td><%= r.scheduled_date?bn.date(r.scheduled_date):'—' %></td><td><%= ({open:'খোলা',assigned:'দায়িত্ব দেওয়া',in_progress:'চলমান',completed:'সম্পন্ন',cancelled:'বাতিল'})[r.status] %></td><td><a href="/maintenance/<%= r.id %>" class="btn btn-sm btn-outline-primary">বিস্তারিত</a></td></tr><% }) %></tbody></table></div></div></div>
