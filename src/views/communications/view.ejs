<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4 no-print"><div><h3 class="mb-1"><%= item.channel==='letter'?'চিঠি প্রিভিউ':'SMS প্রিভিউ' %></h3><p class="text-muted mb-0">প্রাপক: <%= item.recipient_name %> · <%= item.recipient_address || 'ঠিকানা নেই' %></p></div><div class="d-flex flex-wrap gap-2"><a href="/communications" class="btn btn-outline-secondary">ফিরে যান</a><button onclick="window.print()" class="btn btn-outline-primary"><i class="bi bi-printer me-1"></i> প্রিন্ট</button><% if(currentUser.role==='admin'&&item.status==='draft'){ %><form method="post" action="/communications/<%= item.id %>/approve"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><button class="btn btn-primary">অনুমোদন করুন</button></form><% } %><% if(currentUser.role==='admin'&&item.channel==='sms'&&(item.status==='approved'||item.status==='failed')){ %><form method="post" action="/communications/<%= item.id %>/send"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><button class="btn btn-success" <%= providerStatus.enabled?'':'disabled title="SMS gateway বন্ধ"' %>>SMS পাঠান</button></form><% } %></div></div>

<% if(item.channel==='letter'){ %>
<article class="official-document bg-white text-dark mx-auto p-5" style="max-width:850px;min-height:900px">
  <header class="text-center border-bottom pb-4 mb-5"><h2><%= company.company_name %></h2><p class="mb-0"><%= company.company_address || '' %></p><p class="mb-0"><%= company.company_phone || '' %></p></header>
  <p>তারিখ: <%= bn.date(item.created_at) %></p><p>প্রাপক<br/><strong><%= item.recipient_name %></strong><br/><%= item.recipient_address || item.member_address || '' %></p>
  <% if(item.subject){ %><p class="mt-4"><strong>বিষয়: <%= item.subject %></strong></p><% } %>
  <div class="mt-4" style="white-space:pre-line;line-height:1.9"><%= item.body %></div>
  <div class="mt-5 pt-5"><p class="mb-0">বিনীত,</p><strong>মসজিদ পরিচালনা কমিটি</strong></div>
</article>
<% } else { %>
<div class="card mx-auto" style="max-width:650px"><div class="card-body p-4"><div class="d-flex justify-content-between mb-3"><span class="badge <%= item.status==='sent'?'bg-success-subtle text-success':item.status==='failed'?'bg-danger-subtle text-danger':'bg-warning-subtle text-warning' %>"><%= item.status==='draft'?'খসড়া — পাঠানো হয়নি':item.status==='approved'?'অনুমোদিত — পাঠানোর অপেক্ষায়':item.status==='sent'?'পাঠানো হয়েছে':item.status==='failed'?'পাঠানো ব্যর্থ':item.status %></span><span class="text-muted"><%= item.recipient_address || 'মোবাইল নেই' %></span></div><div class="rounded-4 bg-surface-container p-4" style="white-space:pre-line"><%= item.body %></div><% if(item.last_error){ %><div class="alert alert-danger mt-3 mb-0"><%= item.last_error %></div><% } %><p class="small text-muted mt-3 mb-0">Gateway: <%= providerStatus.enabled?'সক্রিয়':'বন্ধ' %> · চেষ্টা: <%= bn.num(item.send_attempts||0) %></p></div></div>
<% } %>
<% if(currentUser.role==='admin'&&item.channel==='sms'&&['draft','approved','failed'].includes(item.status)){ %><div class="card mx-auto mt-4 no-print" style="max-width:650px"><div class="card-header">SMS সময়সূচি</div><div class="card-body"><form method="post" action="/communications/<%= item.id %>/schedule" class="row g-3 align-items-end"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><div class="col-md-8"><label class="form-label">পাঠানোর তারিখ ও সময়</label><input type="datetime-local" name="scheduled_for" class="form-control" required/></div><div class="col-md-4"><button class="btn btn-primary w-100">সারিতে রাখুন</button></div></form><p class="small text-muted mt-2 mb-0">Gateway বন্ধ থাকলে বার্তাটি অনুমোদিত সারিতে থাকবে; পাঠানো বা ব্যর্থ হিসেবে চিহ্নিত হবে না।</p></div></div><% } %>
