<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
  <div><p class="text-uppercase text-primary fw-bold small mb-1">Member communication</p><h3 class="mb-1">যোগাযোগ কেন্দ্র</h3><p class="text-muted mb-0">SMS খসড়া, বকেয়া স্মরণিকা এবং প্রিন্টযোগ্য চিঠি তৈরি করুন</p></div>
  <div class="d-flex flex-wrap gap-2 align-items-center"><span class="badge <%= providerStatus.enabled?'bg-success-subtle text-success':'bg-warning-subtle text-warning' %>">SMS gateway: <%= providerStatus.enabled?'সক্রিয়':'বন্ধ' %></span><% if(currentUser.role==='admin'){ %><a href="/communications/operations" class="btn btn-outline-primary">ডেলিভারি অপারেশন</a><% } %><form method="get" class="d-flex gap-2"><input type="month" name="month" value="<%= month %>" class="form-control"/><button class="btn btn-outline-secondary">দেখুন</button></form></div>
</div>

<div class="card mb-4"><div class="card-header">একসাথে একাধিক খসড়া তৈরি</div><div class="card-body"><form method="post" action="/communications/drafts/bulk" class="row g-3">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>"/><input type="hidden" name="month" value="<%= month %>"/>
  <div class="col-lg-7"><label class="form-label required">সদস্য নির্বাচন</label><select name="member_ids" class="form-select select2" multiple required><% recipients.forEach(function(r){ %><option value="<%= r.id %>"><%= r.id_no %> — <%= r.name %><%= Number(r.outstanding)>0?' — বকেয়া ৳'+bn.money(r.outstanding):'' %></option><% }) %></select><small class="text-muted">একাধিক সদস্য নির্বাচন করা যাবে।</small></div>
  <div class="col-lg-5"><label class="form-label required">টেমপ্লেট</label><select name="template_id" class="form-select" required><option value="">নির্বাচন করুন</option><% templates.forEach(function(t){ %><option value="<%= t.id %>"><%= t.channel==='letter'?'চিঠি':'SMS' %> — <%= t.name %></option><% }) %></select><label class="form-label mt-2">অতিরিক্ত লেখা</label><input name="message" class="form-control"/></div>
  <div class="col-12"><button class="btn btn-outline-primary"><i class="bi bi-files me-1"></i> নির্বাচিত সদস্যদের খসড়া তৈরি</button></div>
</form></div></div>

<% if(currentUser.role==='admin'){ %><div class="card mb-4"><div class="card-header">টেমপ্লেট ব্যবস্থাপনা</div><div class="card-body"><div class="accordion" id="templateAccordion"><% templates.forEach(function(t,i){ %><div class="accordion-item"><h2 class="accordion-header"><button class="accordion-button <%= i?'collapsed':'' %>" type="button" data-bs-toggle="collapse" data-bs-target="#template-<%= t.id %>"><%= t.channel==='letter'?'চিঠি':'SMS' %> — <%= t.name %></button></h2><div id="template-<%= t.id %>" class="accordion-collapse collapse <%= i?'':'show' %>" data-bs-parent="#templateAccordion"><div class="accordion-body"><form method="post" action="/communications/templates/<%= t.id %>" class="row g-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><div class="col-md-6"><label class="form-label">নাম</label><input name="name" class="form-control" value="<%= t.name %>" required/></div><div class="col-md-6"><label class="form-label">বিষয়</label><input name="subject" class="form-control" value="<%= t.subject||'' %>"/></div><div class="col-12"><label class="form-label">বার্তার লেখা</label><textarea name="body" class="form-control" rows="4" required><%= t.body %></textarea></div><div class="col-12"><button class="btn btn-sm btn-primary">টেমপ্লেট সংরক্ষণ</button></div></form></div></div></div><% }) %></div></div></div><% } %>

<div class="alert alert-info d-flex gap-2 align-items-start"><i class="bi bi-shield-check"></i><div><strong>নিরাপদ খসড়া পদ্ধতি</strong><br/><small>SMS gateway যুক্ত না হওয়া পর্যন্ত সিস্টেম শুধু বার্তা প্রস্তুত ও লগ করবে; কোনো বার্তাকে ভুলভাবে “পাঠানো হয়েছে” দেখাবে না।</small></div></div>

<div class="row g-4 mb-4">
  <div class="col-xl-7"><div class="card h-100"><div class="card-header">নতুন বার্তা বা চিঠি</div><div class="card-body">
    <form method="post" action="/communications/drafts" class="row g-3">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>"/><input type="hidden" name="month" value="<%= month %>"/>
      <div class="col-12"><label class="form-label required">সদস্য</label><select name="member_id" id="communicationMember" class="form-select select2" required><option value="">নির্বাচন করুন</option><% recipients.forEach(function(r){ %><option value="<%= r.id %>" data-bill="<%= r.monthly_bill_id || '' %>"><%= r.id_no %> — <%= r.name %> — <%= r.phone || 'মোবাইল নেই' %><%= Number(r.outstanding)>0 ? ' — বকেয়া ৳'+bn.money(r.outstanding) : '' %></option><% }) %></select></div>
      <input type="hidden" name="monthly_bill_id" id="communicationBill"/>
      <div class="col-md-7"><label class="form-label required">টেমপ্লেট</label><select name="template_id" class="form-select" required><option value="">নির্বাচন করুন</option><% templates.forEach(function(t){ %><option value="<%= t.id %>"><%= t.channel==='letter'?'চিঠি':'SMS' %> — <%= t.name %></option><% }) %></select></div>
      <div class="col-md-5"><label class="form-label">ঘোষণার অতিরিক্ত লেখা</label><input name="message" class="form-control" placeholder="প্রযোজ্য হলে লিখুন"/></div>
      <div class="col-12"><button class="btn btn-primary"><i class="bi bi-file-earmark-text me-1"></i> খসড়া তৈরি করুন</button></div>
    </form>
  </div></div></div>
  <div class="col-xl-5"><div class="card h-100"><div class="card-header">ব্যবহারযোগ্য ভেরিয়েবল</div><div class="card-body"><div class="d-flex flex-wrap gap-2 mb-3"><code>{{name}}</code><code>{{month}}</code><code>{{outstanding}}</code><code>{{message}}</code></div><p class="text-muted small mb-0">খসড়া তৈরির সময় সদস্যের নাম, নির্বাচিত মাস এবং বকেয়া স্বয়ংক্রিয়ভাবে বসবে। টেমপ্লেট প্রশাসক পরিবর্তন করতে পারবেন।</p></div></div></div>
</div>

<div class="card"><div class="card-header">সাম্প্রতিক খসড়া ও ইতিহাস</div><div class="card-body"><div class="table-responsive"><table class="table table-hover datatable w-100"><thead><tr><th>তারিখ</th><th>ধরন</th><th>প্রাপক</th><th>ঠিকানা/মোবাইল</th><th>অবস্থা</th><th></th></tr></thead><tbody><% history.forEach(function(row){ var statusLabel={draft:'খসড়া',approved:'অনুমোদিত',sending:'পাঠানো হচ্ছে',sent:'পাঠানো হয়েছে',failed:'ব্যর্থ'}[row.status]||row.status; var statusClass=row.status==='sent'?'bg-success-subtle text-success':row.status==='failed'?'bg-danger-subtle text-danger':row.status==='approved'?'bg-primary-subtle text-primary':'bg-secondary-subtle text-secondary'; %><tr><td><%= bn.date(row.created_at) %></td><td><%= row.channel==='letter'?'চিঠি':'SMS' %></td><td><strong><%= row.recipient_name %></strong><small class="d-block text-muted"><%= row.member_id_no || '' %></small></td><td><%= row.recipient_address || '—' %></td><td><span class="badge <%= statusClass %>"><%= statusLabel %></span></td><td><a class="btn btn-sm btn-outline-primary" href="/communications/<%= row.id %>">প্রিভিউ</a></td></tr><% }) %></tbody></table></div></div></div>

<script>document.addEventListener('DOMContentLoaded',function(){var member=document.getElementById('communicationMember');var bill=document.getElementById('communicationBill');if(member&&bill){member.addEventListener('change',function(){bill.value=member.options[member.selectedIndex].dataset.bill||'';});}});</script>
