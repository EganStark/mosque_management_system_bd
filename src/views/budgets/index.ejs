<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3 mb-4"><div><p class="text-uppercase text-primary fw-bold small mb-1" data-bn="আর্থিক পরিকল্পনা" data-en="Financial planning">আর্থিক পরিকল্পনা</p><h3 class="mb-1" data-bn="খাতভিত্তিক বাজেট" data-en="Category budget planner">খাতভিত্তিক বাজেট</h3><p class="text-muted mb-0" data-bn="পরিকল্পিত লক্ষ্য ও প্রকৃত লেনদেনের পার্থক্য" data-en="Compare planned targets with actual transactions">পরিকল্পিত লক্ষ্য ও প্রকৃত লেনদেনের পার্থক্য</p></div><form method="get" class="d-flex gap-2"><input type="month" name="month" value="<%= data.month %>" class="form-control"/><button class="btn btn-outline-primary" data-bn="দেখুন" data-en="View">দেখুন</button></form></div>
<div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-4"><% [['আয়ের বাজেট',data.summary.incomeBudget,'text-primary'],['প্রকৃত আদায়',data.summary.incomeActual,'text-success'],['ব্যয় বাজেট',data.summary.expenseBudget,'text-primary'],['প্রকৃত ব্যয়',data.summary.expenseActual,'text-error']].forEach(function(x){ %><div class="card"><div class="card-body"><p class="small text-muted mb-1"><%= x[0] %></p><h4 class="<%= x[2] %>">৳ <%= bn.money(x[1]) %></h4></div></div><% }) %></div>
<% [['income','আদায়ের লক্ষ্য','Income targets',data.income],['expense','ব্যয়ের সীমা','Expense limits',data.expense]].forEach(function(section){ %><div class="card mb-4"><div class="card-header"><span data-bn="<%= section[1] %>" data-en="<%= section[2] %>"><%= section[1] %></span></div><div class="card-body p-0"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>খাত</th><th class="text-end">বাজেট</th><th class="text-end">প্রকৃত</th><th class="text-end">পার্থক্য</th><th>নোট</th><th></th></tr></thead><tbody><% section[3].forEach(function(row){ var formId='budget-'+section[0]+'-'+row.id; %><tr><td><strong><%= row.name %></strong><form id="<%= formId %>" method="post" action="/budgets/lines"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><input type="hidden" name="month" value="<%= data.month %>"/><input type="hidden" name="line_type" value="<%= section[0] %>"/><input type="hidden" name="reference_id" value="<%= row.id %>"/></form></td><td><input form="<%= formId %>" type="number" min="0" step="0.01" name="budget_amount" value="<%= row.budget %>" class="form-control form-control-sm text-end" <%= currentUser.role==='admin'?'':'disabled' %>/></td><td class="text-end">৳ <%= bn.money(row.actual) %></td><td class="text-end fw-bold <%= row.variance>=0?'text-success':'text-danger' %>">৳ <%= bn.money(row.variance) %></td><td><input form="<%= formId %>" name="notes" value="<%= row.notes %>" class="form-control form-control-sm" <%= currentUser.role==='admin'?'':'disabled' %>/></td><td><% if(currentUser.role==='admin'){ %><button form="<%= formId %>" class="btn btn-sm btn-outline-primary">সংরক্ষণ</button><% } %></td></tr><% }) %></tbody></table></div></div></div><% }) %>
