<div class="d-flex justify-content-between align-items-center mb-4"><div><p class="text-uppercase text-primary fw-bold small mb-1">Cash ledger</p><h3 class="mb-1">ক্যাশবুক</h3><p class="text-muted mb-0">নগদ আদায়, খরচ এবং ব্যাংক স্থানান্তরের চলমান হিসাব</p></div><a href="/treasury" class="btn btn-outline-secondary no-print">ফিরে যান</a></div>
<form method="get" class="card mb-4 no-print"><div class="card-body row g-3 align-items-end"><div class="col-md-4"><label class="form-label">শুরুর তারিখ</label><input type="date" name="from" value="<%= from||'' %>" class="form-control"/></div><div class="col-md-4"><label class="form-label">শেষের তারিখ</label><input type="date" name="to" value="<%= to||'' %>" class="form-control"/></div><div class="col-md-4"><button class="btn btn-primary">রিপোর্ট দেখুন</button> <button type="button" onclick="window.print()" class="btn btn-outline-secondary">প্রিন্ট</button></div></div></form>
<div class="card"><div class="card-body"><div class="report-header text-center mb-3"><h5><%= company.company_name %></h5><p class="text-muted">ক্যাশবুক<%= from?' · '+bn.date(from)+' — '+bn.date(to||from):'' %></p></div><div class="table-responsive"><table class="table table-bordered"><thead><tr><th>তারিখ</th><th>বিবরণ</th><th>ধরন</th><th class="text-end">জমা</th><th class="text-end">খরচ/স্থানান্তর</th><th class="text-end">অবশিষ্ট</th></tr></thead><tbody><% rows.forEach(function(r){ var labels={collection:'আদায়',expense:'খরচ',bank_to_cash:'ব্যাংক থেকে নগদ',cash_to_bank:'নগদ থেকে ব্যাংক',wallet_to_cash:'ওয়ালেট থেকে নগদ',cash_to_wallet:'নগদ থেকে ওয়ালেট',loan_issue:'ঋণ প্রদান',loan_repayment:'ঋণ কিস্তি'}; %><tr><td><%= bn.date(r.date) %></td><td><%= r.description||'—' %></td><td><%= labels[r.entry_type]||r.entry_type %></td><td class="text-end text-success"><%= r.incoming?bn.money(r.incoming):'' %></td><td class="text-end text-danger"><%= r.outgoing?bn.money(r.outgoing):'' %></td><td class="text-end fw-bold"><%= bn.money(r.balance) %></td></tr><% }) %></tbody></table></div></div></div>
