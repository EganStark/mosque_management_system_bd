<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4"><div><p class="text-uppercase text-primary fw-bold small mb-1">Treasury</p><h3 class="mb-1">ক্যাশ ও ব্যাংক ব্যবস্থাপনা</h3><p class="text-muted mb-0">নগদ, ব্যাংক হিসাব, অভ্যন্তরীণ স্থানান্তর ও স্টেটমেন্ট মিল</p></div><div class="d-flex gap-2"><a href="/treasury/cashbook" class="btn btn-outline-primary">ক্যাশবুক</a><% if(currentUser.role==='admin'){ %><a href="/treasury/transfer" class="btn btn-primary">তহবিল স্থানান্তর</a><% } %></div></div>
<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 mb-4"><div class="card"><div class="card-body"><p class="small text-muted mb-1">নগদ অবশিষ্ট</p><h4>৳ <%= bn.money(overview.cash) %></h4></div></div><div class="card"><div class="card-body"><p class="small text-muted mb-1">ব্যাংকে মোট</p><h4>৳ <%= bn.money(overview.bankTotal) %></h4></div></div><div class="card"><div class="card-body"><p class="small text-muted mb-1">সর্বমোট তহবিল</p><h4 class="text-success">৳ <%= bn.money(overview.total) %></h4></div></div><div class="card"><div class="card-body"><p class="small text-muted mb-1">ব্যাংক হিসাব</p><h4><%= bn.num(overview.accounts.length) %>টি</h4></div></div></div>
<div class="row g-4 mb-4"><div class="col-lg-7"><div class="card h-100"><div class="card-header">ব্যাংক ব্যালেন্স</div><div class="card-body"><div class="table-responsive"><table class="table"><thead><tr><th>ব্যাংক</th><th>হিসাব নম্বর</th><th class="text-end">সিস্টেম ব্যালেন্স</th></tr></thead><tbody><% overview.accounts.forEach(function(b){ %><tr><td><strong><%= b.name %></strong><small class="d-block text-muted"><%= b.branch_name||'' %></small></td><td><%= b.account_number||'—' %></td><td class="text-end fw-bold">৳ <%= bn.money(b.balance) %></td></tr><% }) %></tbody></table></div></div></div></div><div class="col-lg-5 <%= currentUser.role==='admin'?'':'d-none' %>"><div class="card h-100"><div class="card-header">স্টেটমেন্ট মিল করুন</div><div class="card-body"><form method="post" action="/treasury/reconcile" class="row g-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><div class="col-12"><label class="form-label required">ব্যাংক</label><select name="bank_id" class="form-select" required><option value="">নির্বাচন করুন</option><% overview.accounts.forEach(function(b){ %><option value="<%= b.id %>"><%= b.name %></option><% }) %></select></div><div class="col-6"><label class="form-label required">স্টেটমেন্ট তারিখ</label><input type="date" name="statement_date" class="form-control" required/></div><div class="col-6"><label class="form-label required">স্টেটমেন্ট ব্যালেন্স</label><input type="number" step="0.01" name="statement_balance" class="form-control" required/></div><div class="col-12"><label class="form-label">নোট</label><input name="notes" class="form-control"/></div><div class="col-12"><button class="btn btn-primary">মিল সংরক্ষণ</button></div></form></div></div></div></div>
<div class="card mb-4"><div class="card-header">সাম্প্রতিক স্থানান্তর</div><div class="card-body"><div class="table-responsive"><table class="table table-hover datatable w-100"><thead><tr><th>তারিখ</th><th>স্থানান্তর</th><th>রেফারেন্স</th><th>পরিমাণ</th><th>অবস্থা</th><th></th></tr></thead><tbody><% rows.forEach(function(t){var from=t.type.startsWith('cash_')?'নগদ':t.type.startsWith('bank_')?(t.from_bank_name||'ব্যাংক'):(t.from_wallet_name||'ওয়ালেট')+(t.from_wallet_number?' · '+t.from_wallet_number:'');var to=t.type.endsWith('_cash')?'নগদ':t.type.endsWith('_bank')?(t.to_bank_name||'ব্যাংক'):(t.to_wallet_name||'ওয়ালেট')+(t.to_wallet_number?' · '+t.to_wallet_number:'');var label=from+' → '+to;%><tr><td><%= bn.date(t.date) %></td><td><%= label %></td><td><%= t.reference||'—' %></td><td>৳ <%= bn.money(t.amount) %></td><td><%= t.status==='posted'?'অনুমোদিত':'বাতিল' %></td><td><% if(t.status==='posted'&&currentUser.role==='admin'){ %><form method="post" action="/treasury/transfers/<%= t.id %>/cancel" class="d-flex gap-1"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><input name="cancellation_reason" class="form-control form-control-sm" placeholder="বাতিলের কারণ" required/><button class="btn btn-sm btn-outline-danger"><i class="bi bi-x-circle"></i></button></form><% } %></td></tr><% }) %></tbody></table></div></div></div>
<div class="card"><div class="card-header">রিকনসিলিয়েশন ইতিহাস</div><div class="card-body"><div class="table-responsive"><table class="table"><thead><tr><th>তারিখ</th><th>ব্যাংক</th><th>সিস্টেম</th><th>স্টেটমেন্ট</th><th>পার্থক্য</th></tr></thead><tbody><% reconciliations.forEach(function(r){ %><tr><td><%= bn.date(r.statement_date) %></td><td><%= r.bank_name %></td><td>৳ <%= bn.money(r.system_balance) %></td><td>৳ <%= bn.money(r.statement_balance) %></td><td class="fw-bold <%= Number(r.difference)===0?'text-success':'text-danger' %>">৳ <%= bn.money(r.difference) %></td></tr><% }) %></tbody></table></div></div></div>
<div class="card mt-4"><div class="card-header d-flex justify-content-between"><span>মোবাইল ওয়ালেট ব্যালেন্স</span><strong>৳ <%= bn.money(overview.walletTotal) %></strong></div><div class="card-body"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>ওয়ালেট</th><th>প্রোভাইডার</th><th>হিসাব</th><th>অবস্থা</th><th class="text-end">ব্যালেন্স</th><th></th></tr></thead><tbody><% overview.walletAccounts.forEach(function(wallet){ %><tr class="<%= wallet.is_active?'':'text-muted' %>"><td><strong><%= wallet.name %></strong></td><td><%= wallet.provider %></td><td><%= wallet.account_number||'—' %></td><td><span class="badge <%= wallet.is_active?'text-bg-success':'text-bg-secondary' %>"><%= wallet.is_active?'সক্রিয়':'নিষ্ক্রিয়' %></span></td><td class="text-end fw-bold">৳ <%= bn.money(wallet.balance) %></td><td class="text-end"><% if(currentUser.role==='admin'){ %><button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#walletEdit<%= wallet.id %>">সম্পাদনা</button><form method="post" action="/treasury/wallets/<%= wallet.id %>/status" class="d-inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><input type="hidden" name="is_active" value="<%= wallet.is_active?'false':'true' %>"/><button class="btn btn-sm <%= wallet.is_active?'btn-outline-danger':'btn-outline-success' %>" onclick="return confirm('ওয়ালেটের অবস্থা পরিবর্তন করবেন?')"><i class="bi <%= wallet.is_active?'bi-archive':'bi-arrow-counterclockwise' %>"></i></button></form><% } %></td></tr><% if(currentUser.role==='admin'){ %><tr class="collapse" id="walletEdit<%= wallet.id %>"><td colspan="6"><form method="post" action="/treasury/wallets/<%= wallet.id %>" class="row g-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><div class="col-md-2"><select name="provider" class="form-select"><% ['bkash','nagad','rocket','other'].forEach(function(provider){ %><option value="<%= provider %>" <%= wallet.provider===provider?'selected':'' %>><%= provider %></option><% }) %></select></div><div class="col-md-2"><input name="name" value="<%= wallet.name %>" class="form-control" required/></div><div class="col-md-2"><input name="account_number" value="<%= wallet.account_number||'' %>" class="form-control" placeholder="হিসাব নম্বর"/></div><div class="col-md-2"><input type="number" min="0" step="0.01" name="opening_balance" value="<%= wallet.opening_balance %>" class="form-control" placeholder="প্রারম্ভিক ব্যালেন্স"/></div><div class="col-md-2"><input type="date" name="opening_balance_date" value="<%= wallet.opening_balance_date?String(wallet.opening_balance_date).slice(0,10):'' %>" class="form-control"/></div><div class="col-md-2"><button class="btn btn-success w-100">সংরক্ষণ</button></div></form></td></tr><% } %><% }) %></tbody></table></div></div></div>
<% if(currentUser.role==='admin'){ %><div class="card mt-4"><div class="card-header">নতুন মোবাইল ওয়ালেট</div><div class="card-body"><form method="post" action="/treasury/wallets" class="row g-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><div class="col-md-2"><select name="provider" class="form-select" required><option value="bkash">bKash</option><option value="nagad">Nagad</option><option value="rocket">Rocket</option><option value="other">Other</option></select></div><div class="col-md-2"><input name="name" class="form-control" placeholder="ওয়ালেটের নাম" required/></div><div class="col-md-2"><input name="account_number" class="form-control" placeholder="হিসাব নম্বর"/></div><div class="col-md-2"><input type="number" min="0" step="0.01" name="opening_balance" class="form-control" placeholder="প্রারম্ভিক ব্যালেন্স"/></div><div class="col-md-2"><input type="date" name="opening_balance_date" class="form-control" title="প্রারম্ভিক ব্যালেন্সের তারিখ"/></div><div class="col-md-2"><button class="btn btn-primary w-100">যোগ করুন</button></div></form></div></div><% } %>
