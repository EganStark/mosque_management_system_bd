<div class="d-flex justify-content-between align-items-center mb-4"><div><p class="text-uppercase text-primary fw-bold small mb-1">Internal transfer</p><h3 class="mb-1">তহবিল স্থানান্তর</h3><p class="text-muted mb-0">আয় বা খরচ নয়—এক হিসাব থেকে অন্য হিসাবে অর্থ স্থানান্তর</p></div><a href="/treasury" class="btn btn-outline-secondary">ফিরে যান</a></div>
<div class="card mb-4"><div class="card-header">নতুন স্থানান্তর অনুরোধ</div><div class="card-body"><form method="post" action="/treasury/transfer" class="row g-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/>
<div class="col-md-4"><label class="form-label required">স্থানান্তরের ধরন</label><select id="transferType" name="type" class="form-select" required><% [['cash_to_bank','নগদ → ব্যাংক'],['bank_to_cash','ব্যাংক → নগদ'],['bank_to_bank','ব্যাংক → ব্যাংক'],['cash_to_wallet','নগদ → মোবাইল ওয়ালেট'],['wallet_to_cash','মোবাইল ওয়ালেট → নগদ'],['bank_to_wallet','ব্যাংক → মোবাইল ওয়ালেট'],['wallet_to_bank','মোবাইল ওয়ালেট → ব্যাংক'],['wallet_to_wallet','ওয়ালেট → ওয়ালেট']].forEach(function(x){ %><option value="<%= x[0] %>"><%= x[1] %></option><% }) %></select></div>
<div class="col-md-4 transfer-account" id="fromBankField"><label class="form-label">উৎস ব্যাংক</label><select name="from_bank_id" class="form-select"><option value="">নির্বাচন করুন</option><% bankList.forEach(function(b){ %><option value="<%= b.id %>"><%= b.name %></option><% }) %></select></div>
<div class="col-md-4 transfer-account" id="toBankField"><label class="form-label">গন্তব্য ব্যাংক</label><select name="to_bank_id" class="form-select"><option value="">নির্বাচন করুন</option><% bankList.forEach(function(b){ %><option value="<%= b.id %>"><%= b.name %></option><% }) %></select></div>
<div class="col-md-4 transfer-account" id="fromWalletField"><label class="form-label">উৎস ওয়ালেট</label><select name="from_mobile_wallet_id" class="form-select"><option value="">নির্বাচন করুন</option><% walletList.forEach(function(w){ %><option value="<%= w.id %>"><%= w.name %></option><% }) %></select></div>
<div class="col-md-4 transfer-account" id="toWalletField"><label class="form-label">গন্তব্য ওয়ালেট</label><select name="to_mobile_wallet_id" class="form-select"><option value="">নির্বাচন করুন</option><% walletList.forEach(function(w){ %><option value="<%= w.id %>"><%= w.name %></option><% }) %></select></div>
<div class="col-md-4"><label class="form-label required">পরিমাণ</label><input type="number" min="0.01" step="0.01" name="amount" class="form-control" required/></div><div class="col-md-4"><label class="form-label required">তারিখ</label><input type="date" name="date" value="<%= new Date().toISOString().slice(0,10) %>" class="form-control" required/></div><div class="col-md-4"><label class="form-label">রেফারেন্স</label><input name="reference" class="form-control"/></div><div class="col-12"><label class="form-label">মন্তব্য</label><input name="remarks" class="form-control"/></div><div class="col-12"><button class="btn btn-primary">অনুমোদনের জন্য পাঠান</button></div></form></div></div>
<div class="card"><div class="card-header">স্থানান্তর অনুমোদন সারি</div><div class="card-body p-0"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>তারিখ</th><th>ধরন</th><th>পরিমাণ</th><th>অনুরোধকারী</th><th>অবস্থা</th><th></th></tr></thead><tbody><% (transferRequests||[]).forEach(function(r){ %><tr><td><%= bn.date(r.date) %></td><td><%= r.type.replaceAll('_',' ') %></td><td>৳ <%= bn.money(r.amount) %></td><td><%= r.requester_name||'—' %></td><td><span class="badge <%= r.status==='approved'?'text-bg-success':r.status==='rejected'?'text-bg-danger':'text-bg-warning' %>"><%= r.status %></span></td><td><% if(currentUser.role==='admin'&&r.status==='pending'){ %><form method="post" action="/treasury/transfer-requests/<%= r.id %>/decision" class="d-flex gap-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><input name="decision_notes" class="form-control form-control-sm" placeholder="সিদ্ধান্তের মন্তব্য"/><button name="decision" value="approved" class="btn btn-sm btn-success">অনুমোদন</button><button name="decision" value="rejected" class="btn btn-sm btn-outline-danger">প্রত্যাখ্যান</button></form><% } %></td></tr><% }) %><% if(!(transferRequests||[]).length){ %><tr><td colspan="6" class="text-center text-muted py-4">কোনো স্থানান্তর অনুরোধ নেই</td></tr><% } %></tbody></table></div></div></div>
<script>document.addEventListener('DOMContentLoaded',()=>{const t=document.getElementById('transferType'),f={fromBank:document.getElementById('fromBankField'),toBank:document.getElementById('toBankField'),fromWallet:document.getElementById('fromWalletField'),toWallet:document.getElementById('toWalletField')};function sync(){const [from,to]=t.value.split('_to_');f.fromBank.hidden=from!=='bank';f.toBank.hidden=to!=='bank';f.fromWallet.hidden=from!=='wallet';f.toWallet.hidden=to!=='wallet';}t.addEventListener('change',sync);sync();});</script>
