<div class="document-toolbar no-print"><a href="/expenses" class="btn btn-outline-secondary">ফিরে যান</a><button onclick="window.print()" class="btn btn-primary"><i class="bi bi-printer me-1"></i> ভাউচার প্রিন্ট</button></div>
<section class="official-document voucher-document <%= expense.status==='cancelled'?'is-cancelled':'' %>"><% if(expense.status==='cancelled'){ %><div class="document-watermark">বাতিল</div><% } %>
  <header class="official-document__header"><% if(company&&company.logo){ %><img src="<%= company.logo %>" alt=""/><% }else{ %><span class="material-symbols-outlined">mosque</span><% } %><div><h2><%= company&&company.company_name?company.company_name:'Baitur Rahman Jame Moshjid' %></h2><p><%= company&&company.company_address?company.company_address:'' %></p><p><%= company&&company.company_phone?'ফোন: '+company.company_phone:'' %></p></div></header>
  <div class="official-document__title"><h3>খরচের ভাউচার</h3><span>ভাউচার নং: <strong><%= expense.voucher_no %></strong></span></div>
  <div class="document-meta"><span>তারিখ: <strong><%= bn.date(expense.date) %></strong></span><span>খরচের খাত: <strong><%= expense.head_name||'অন্যান্য' %></strong></span></div>
  <div class="document-field"><span>প্রাপক</span><strong><%= expense.payee||'—' %></strong></div><div class="document-field"><span>ব্যয়ের বিবরণ</span><strong><%= expense.purpose||'—' %></strong></div>
  <div class="document-field"><span>পেমেন্ট পদ্ধতি</span><strong><%= expense.payment_method==='bank'?(expense.bank_name||'ব্যাংক'):expense.payment_method==='mobile_banking'?'মোবাইল ব্যাংকিং':'নগদ' %></strong></div><% if(expense.transaction_reference){ %><div class="document-field"><span>লেনদেন রেফারেন্স</span><strong><%= expense.transaction_reference %></strong></div><% } %>
  <% if(expense.unit||expense.rate){ %><div class="document-meta"><span>পরিমাণ: <strong><%= expense.unit||'—' %></strong></span><span>দর: <strong>৳ <%= bn.money(expense.rate||0) %></strong></span></div><% } %>
  <div class="document-amount"><span>সর্বমোট প্রদান</span><strong>৳ <%= bn.money(expense.amount) %></strong></div><% if(expense.remarks){ %><p class="document-note">মন্তব্য: <%= expense.remarks %></p><% } %>
  <footer class="document-signatures"><div><span>প্রাপকের স্বাক্ষর</span></div><div><span>প্রস্তুতকারী</span><small><%= expense.created_by_name||'' %></small></div><div><span>কোষাধ্যক্ষ</span></div><div><span>অনুমোদনকারী</span></div></footer>
</section>
