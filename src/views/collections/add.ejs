<div class="d-flex justify-content-between align-items-center mb-3">
  <h3 class="mb-0">নতুন আদায়</h3>
  <a href="/collections" class="btn btn-outline-secondary btn-sm"><i class="bi bi-list"></i> তালিকা</a>
</div>
<div class="card"><div class="card-body">
  <form method="post" action="/collections" class="row g-3">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <div class="col-md-6"><label class="form-label required">সদস্য</label>
      <select name="member_id" class="form-select select2" required>
        <option value="">নির্বাচন করুন</option>
        <% memberOptions.forEach(function(m){ %><option value="<%= m.id %>"><%= m.id_no %> - <%= m.name %><%= m.phone ? ' - '+m.phone : '' %></option><% }) %>
      </select></div>
    <div class="col-md-3"><label class="form-label required">পরিমাণ</label>
      <input type="number" step="0.01" name="amount" class="form-control" required /></div>
    <div class="col-md-3"><label class="form-label required">তারিখ</label>
      <input type="text" name="date" class="form-control datepicker" value="<%= new Date().toISOString().slice(0,10) %>" required /></div>
    <div class="col-md-4"><label class="form-label">উদ্দেশ্য</label>
      <input type="text" name="purpose" class="form-control" /></div>
    <div class="col-md-4"><label class="form-label">বই / রশিদ</label>
      <select name="book_number_id" class="form-select">
        <option value="">নির্বাচন করুন</option>
        <% activeBooks.forEach(function(b){ %><option value="<%= b.id %>"><%= b.book_type_name||'' %> - <%= b.book_number %></option><% }) %>
      </select></div>
    <div class="col-md-2"><label class="form-label">রশিদ নং</label>
      <input type="text" name="receipt_no" class="form-control" /></div>
    <div class="col-md-2"><label class="form-label">অ্যাকাউন্ট</label>
      <input type="text" name="account" class="form-control" /></div>
    <div class="col-md-12"><label class="form-label">মন্তব্য</label>
      <input type="text" name="remarks" class="form-control" /></div>
    <div class="col-12">
      <button class="btn btn-primary"><i class="bi bi-check-lg me-1"></i> সংরক্ষণ</button>
    </div>
  </form>
</div></div>
