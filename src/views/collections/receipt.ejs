<div class="document-toolbar no-print"><a href="/collections" class="btn btn-outline-secondary">ফিরে যান</a><button onclick="window.print()" class="btn btn-primary"><i class="bi bi-printer me-1"></i> রশিদ প্রিন্ট</button></div>
<% function copy(label){ %><section class="official-document receipt-document <%= collection.status==='cancelled'?'is-cancelled':'' %>">
  <% if(collection.status==='cancelled'){ %><div class="document-watermark">বাতিল</div><% } %>
  <header class="official-document__header"><% if(company&&company.logo){ %><img src="<%= company.logo %>" alt=""/><% }else{ %><span class="material-symbols-outlined">mosque</span><% } %><div><h2><%= company&&company.company_name?company.company_name:'Baitur Rahman Jame Moshjid' %></h2><p><%= company&&company.company_address?company.company_address:'' %></p><p><%= company&&company.company_phone?'ফোন: '+company.company_phone:'' %></p></div><strong class="document-copy-label"><%= label %></strong></header>
  <div class="official-document__title"><h3>আদায়ের রশিদ</h3><span>রশিদ নং: <strong><%= collection.receipt_no %></strong></span></div>
  <div class="document-meta"><span>তারিখ: <strong><%= bn.date(collection.date) %></strong></span><span>সদস্য আইডি: <strong><%= collection.member_id_no?bn.toBnDigits(collection.member_id_no):'প্রযোজ্য নয়' %></strong></span></div>
  <div class="document-field"><span>প্রদানকারীর নাম</span><strong><%= collection.member_name||collection.payer_name||'অজ্ঞাত প্রদানকারী' %></strong></div>
  <div class="document-field"><span>আদায়ের খাত</span><strong><%= collection.category_name||collection.purpose||'অন্যান্য' %></strong></div>
  <div class="document-field"><span>পেমেন্ট পদ্ধতি</span><strong><%= collection.payment_method==='bank'?(collection.bank_name||'ব্যাংক'):collection.payment_method==='mobile_banking'?'মোবাইল ব্যাংকিং':'নগদ' %></strong></div>
  <% if(collection.transaction_reference){ %><div class="document-field"><span>লেনদেন রেফারেন্স</span><strong><%= collection.transaction_reference %></strong></div><% } %>
  <div class="document-amount"><span>প্রাপ্ত অর্থ</span><strong>৳ <%= bn.money(collection.amount) %></strong></div>
  <% if(collection.remarks){ %><p class="document-note">মন্তব্য: <%= collection.remarks %></p><% } %>
  <footer class="document-signatures"><div><span>প্রদানকারীর স্বাক্ষর</span></div><div><span>গ্রহণকারীর স্বাক্ষর</span><small><%= collection.created_by_name||'' %></small></div><div><span>অনুমোদিত স্বাক্ষর</span></div></footer>
</section><% } %>
<% copy('প্রদানকারীর কপি'); %><div class="document-cut-line"><span>কেটে নিন</span></div><% copy('অফিস কপি'); %>
