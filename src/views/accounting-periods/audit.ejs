<main class="container py-4"><div class="d-flex justify-content-between align-items-start mb-4"><div><p class="text-uppercase text-primary fw-bold small mb-1">Period close audit package</p><h2 class="mb-1">মাসিক সমাপনী অডিট প্যাকেজ</h2><p class="mb-0"><strong><%= event.reference_no %></strong> · <%= String(event.period_month).slice(0,7) %></p></div><button class="btn btn-outline-primary no-print" onclick="window.print()">প্রিন্ট / PDF</button></div>
<div class="alert <%= event.integrityValid?'alert-success':'alert-danger' %>"><strong>অখণ্ডতা যাচাই:</strong> <%= event.integrityValid?'স্ন্যাপশট অপরিবর্তিত':'চেকসাম মিলেনি' %><br/><small class="font-monospace"><%= event.checksum %></small></div>
<div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-4"><% [['আদায়',event.snapshot.collections.total],['খরচ',event.snapshot.expenses.total],['নিট অবশিষ্ট',event.snapshot.netBalance],['অসম্পন্ন যাচাই',event.snapshot.checks.issueCount]].forEach(function(x,i){ %><div class="card"><div class="card-body"><p class="small text-muted mb-1"><%= x[0] %></p><h4><%= i<3?'৳ '+bn.money(x[1]):bn.num(x[1]) %></h4></div></div><% }) %></div>
<div class="card mb-4"><div class="card-header">ব্যাংক মিল</div><div class="card-body"><div class="table-responsive"><table class="table"><thead><tr><th>ব্যাংক</th><th>তারিখ</th><th>সিস্টেম</th><th>স্টেটমেন্ট</th><th>পার্থক্য</th></tr></thead><tbody><% event.snapshot.reconciliations.forEach(function(r){ %><tr><td><%= r.name %></td><td><%= bn.date(r.statement_date) %></td><td>৳ <%= bn.money(r.system_balance) %></td><td>৳ <%= bn.money(r.statement_balance) %></td><td>৳ <%= bn.money(r.difference) %></td></tr><% }) %></tbody></table></div></div></div>
<div class="card"><div class="card-body"><p><strong>বন্ধ করেছেন:</strong> <%= event.actor_name||'—' %></p><p><strong>সমাপনী নোট:</strong> <%= event.notes||'—' %></p><p><strong>ওভাররাইড কারণ:</strong> <%= event.override_reason||'প্রযোজ্য নয়' %></p><p class="mb-0"><strong>স্ন্যাপশট সময়:</strong> <%= event.snapshot.capturedAt %></p></div></div></main><style>@media print{.no-print{display:none!important}.card{break-inside:avoid}}</style>
