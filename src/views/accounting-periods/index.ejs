<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3 mb-4"><div><p class="text-uppercase text-primary fw-bold small mb-1">Financial control</p><h3 class="mb-1">মাসিক হিসাব বন্ধ</h3><p class="text-muted mb-0">রিপোর্ট চূড়ান্ত করার পর পুরোনো লেনদেন লক করুন</p></div><form method="get" class="d-flex gap-2"><input type="month" name="month" value="<%= data.month %>" class="form-control"/><button class="btn btn-outline-primary">দেখুন</button></form></div>
<div class="alert <%= data.state.status==='closed'?'alert-danger':'alert-success' %> d-flex justify-content-between align-items-center"><span><strong><%= data.month %></strong> — <%= data.state.status==='closed'?'বন্ধ ও লক করা':'খোলা আছে' %></span><span class="material-symbols-outlined"><%= data.state.status==='closed'?'lock':'lock_open' %></span></div>
<div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-4"><% [['আদায়',data.collections.total],['খরচ',data.expenses.total],['আদায় রেকর্ড',data.collections.count],['খরচ রেকর্ড',data.expenses.count]].forEach(function(x,i){ %><div class="card"><div class="card-body"><p class="small text-muted mb-1"><%= x[0] %></p><h4><%= i<2?'৳ '+bn.money(x[1]):bn.num(x[1]) %></h4></div></div><% }) %></div>
<div class="row g-4 mb-4"><div class="col-lg-7"><div class="card h-100"><div class="card-header d-flex justify-content-between"><span>বন্ধ করার প্রস্তুতি</span><span class="badge <%= data.checks.issueCount?'text-bg-warning':'text-bg-success' %>"><%= bn.num(data.checks.issueCount) %> সমস্যা</span></div><div class="card-body"><div class="d-flex justify-content-between border-bottom py-2"><span>সক্রিয় ব্যাংক বনাম মিল করা ব্যাংক</span><strong><%= bn.num(data.checks.reconciledBanks) %> / <%= bn.num(data.checks.activeBanks) %></strong></div><div class="d-flex justify-content-between border-bottom py-2"><span>অপেক্ষমাণ অনলাইন দান</span><strong class="<%= data.checks.pendingDonations?'text-danger':'text-success' %>"><%= bn.num(data.checks.pendingDonations) %></strong></div><div class="d-flex justify-content-between py-2"><span>খসড়া যোগাযোগ</span><strong><%= bn.num(data.checks.draftCommunications) %></strong></div></div></div></div><div class="col-lg-5"><div class="card h-100"><div class="card-header">প্রশাসনিক নিয়ন্ত্রণ</div><div class="card-body"><% if(currentUser.role!=='admin'){ %><p class="text-muted">শুধু অ্যাডমিন হিসাব মাস বন্ধ বা খুলতে পারবেন।</p><% }else if(data.state.status==='closed'){ %><form method="post" action="/accounting-periods/reopen"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><input type="hidden" name="month" value="<%= data.month %>"/><label class="form-label required">পুনরায় খোলার কারণ</label><textarea name="reason" class="form-control mb-3" required></textarea><button class="btn btn-danger w-100">মাস পুনরায় খুলুন</button></form><% }else{ %><form method="post" action="/accounting-periods/close"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><input type="hidden" name="month" value="<%= data.month %>"/><label class="form-label">সমাপনী নোট</label><textarea name="notes" class="form-control mb-3"></textarea><% if(data.checks.issueCount){ %><label class="form-label required text-danger">অসম্পন্ন যাচাই ওভাররাইডের কারণ</label><textarea name="override_reason" class="form-control mb-3" required></textarea><% } %><button class="btn btn-primary w-100" onclick="return confirm('এই মাসের আর্থিক লেনদেন লক করবেন?')">মাস বন্ধ ও অডিট স্ন্যাপশট তৈরি করুন</button></form><% } %></div></div></div></div>
<div class="card"><div class="card-header">সমাপনী ইতিহাস</div><div class="card-body"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>রেফারেন্স</th><th>মাস</th><th>ঘটনা</th><th>ব্যবহারকারী</th><th>সময়</th><th></th></tr></thead><tbody><% history.forEach(function(item){ %><tr><td><strong><%= item.reference_no %></strong></td><td><%= String(item.period_month).slice(0,7) %></td><td><%= item.event_type==='close'?'বন্ধ':'পুনরায় খোলা' %></td><td><%= item.actor_name||'—' %></td><td><%= bn.date(item.created_at) %></td><td><% if(item.event_type==='close'){ %><a href="/accounting-periods/audit/<%= item.id %>" class="btn btn-sm btn-outline-primary">অডিট প্যাকেজ</a><% } %></td></tr><% }) %></tbody></table></div></div></div>
