<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3 mb-4"><div><p class="text-uppercase text-primary fw-bold small mb-1" data-bn="কাজের প্রবাহ" data-en="Work flow">কাজের প্রবাহ</p><h3 class="mb-1" data-bn="ভিজ্যুয়াল কাজের বোর্ড" data-en="Visual task board">ভিজ্যুয়াল কাজের বোর্ড</h3><p class="text-muted mb-0" data-bn="দায়িত্ব, অগ্রগতি ও বাধা এক নজরে দেখুন" data-en="See assignments, progress and blockers at a glance">দায়িত্ব, অগ্রগতি ও বাধা এক নজরে দেখুন</p></div><a href="/tasks" class="btn btn-outline-secondary"><span class="material-symbols-outlined align-middle text-[18px]">table_rows</span> <span data-bn="তালিকা" data-en="List view">তালিকা</span></a></div>
<form method="get" class="card card-body mb-4"><div class="row g-2 align-items-center"><div class="col-md-4"><select name="assigned" class="form-select"><option value="">সবার কাজ</option><option value="me" <%= filters.assigned==='me'?'selected':'' %>>শুধু আমার কাজ</option></select></div><div class="col-md-4"><select name="category" class="form-select"><option value="">সব ধরন</option><% [['general','সাধারণ'],['finance','অর্থ'],['facility','স্থাপনা'],['community','কমিউনিটি'],['event','অনুষ্ঠান'],['compliance','কমপ্লায়েন্স']].forEach(function(x){ %><option value="<%= x[0] %>" <%= filters.category===x[0]?'selected':'' %>><%= x[1] %></option><% }) %></select></div><div class="col-md-2"><div class="form-check"><input class="form-check-input" type="checkbox" name="completed" value="1" id="showCompleted" <%= filters.includeCompleted?'checked':'' %>/><label class="form-check-label" for="showCompleted">সম্পন্ন দেখান</label></div></div><div class="col-md-2"><button class="btn btn-outline-primary w-100">ফিল্টার</button></div></div></form>
<div class="task-board mb-4"><% var labels={open:['খোলা','Open','inbox'],in_progress:['চলমান','In progress','pending_actions'],blocked:['বাধাগ্রস্ত','Blocked','block'],completed:['সম্পন্ন','Completed','task_alt']}; columns.forEach(function(column){var label=labels[column.status]; %><section class="task-column task-column-<%= column.status %>"><div class="task-column-head"><div><span class="material-symbols-outlined"><%= label[2] %></span><strong data-bn="<%= label[0] %>" data-en="<%= label[1] %>"><%= label[0] %></strong></div><span class="badge rounded-pill"><%= bn.num(column.items.length) %></span></div><div class="task-column-body"><% column.items.forEach(function(item){var overdue=item.due_date&&new Date(item.due_date)<new Date(); %><article class="task-board-card"><a href="/tasks/<%= item.id %>" class="text-decoration-none"><div class="d-flex justify-content-between gap-2 mb-2"><small class="text-muted"><%= item.task_no %></small><span class="badge <%= item.priority==='critical'?'text-bg-danger':item.priority==='high'?'text-bg-warning':'text-bg-light' %>"><%= item.priority %></span></div><strong class="d-block text-on-surface mb-2"><%= item.title %></strong><div class="d-flex justify-content-between gap-2 small"><span class="text-muted text-truncate"><span class="material-symbols-outlined align-middle text-[15px]">person</span> <%= item.assigned_name||'অনির্ধারিত' %></span><span class="text-nowrap <%= overdue?'text-danger fw-bold':'text-muted' %>"><%= item.due_date?bn.date(item.due_date):'—' %></span></div></a><div class="task-card-actions mt-3"><% [['open','খোলা'],['in_progress','চলমান'],['blocked','বাধা'],['completed','সম্পন্ন']].filter(function(x){return x[0]!==item.status;}).slice(0,2).forEach(function(x){ %><form method="post" action="/tasks/<%= item.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><input type="hidden" name="status" value="<%= x[0] %>"/><button class="btn btn-sm btn-outline-secondary"><%= x[1] %></button></form><% }) %></div></article><% }) %><% if(!column.items.length){ %><div class="task-column-empty">এই ধাপে কোনো কাজ নেই</div><% } %></div></section><% }) %></div>
<div class="card"><div class="card-header" data-bn="দায়িত্বের চাপ" data-en="Team workload">দায়িত্বের চাপ</div><div class="card-body"><div class="row g-3"><% workload.forEach(function(user){ %><div class="col-md-6 col-xl-4"><div class="rounded-xl border border-border-subtle p-3"><div class="d-flex justify-content-between"><div><strong><%= user.name %></strong><small class="d-block text-muted"><%= user.role %></small></div><span class="badge <%= user.overdue_count?'text-bg-danger':'text-bg-primary' %>"><%= bn.num(user.open_count) %></span></div><div class="mt-2 small text-muted"><span data-bn="সময় পেরিয়েছে" data-en="Overdue">সময় পেরিয়েছে</span>: <strong class="<%= user.overdue_count?'text-danger':'' %>"><%= bn.num(user.overdue_count) %></strong></div></div></div><% }) %></div></div></div>
