<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-start gap-3 mb-4"><div><p class="text-uppercase text-primary fw-bold small mb-1"><%= item.task_no %></p><h3 class="mb-1"><%= item.title %></h3><p class="text-muted mb-0"><%= item.description||'কোনো বিস্তারিত বিবরণ নেই' %></p></div><div class="d-flex gap-2"><button class="btn btn-outline-primary" data-bs-toggle="collapse" data-bs-target="#editTask"><span class="material-symbols-outlined align-middle text-[18px]">edit</span> <span data-bn="সম্পাদনা" data-en="Edit">সম্পাদনা</span></button><a href="/tasks" class="btn btn-outline-secondary" data-bn="সব কাজ" data-en="All tasks">সব কাজ</a></div></div>
<div class="collapse mb-4" id="editTask"><div class="card"><div class="card-header" data-bn="কাজ ও দায়িত্ব সম্পাদনা" data-en="Edit task and assignment">কাজ ও দায়িত্ব সম্পাদনা</div><div class="card-body"><form method="post" action="/tasks/<%= item.id %>/edit" class="row g-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><div class="col-md-8"><label class="form-label required">শিরোনাম</label><input name="title" value="<%= item.title %>" class="form-control" required/></div><div class="col-md-4"><label class="form-label">দায়িত্বপ্রাপ্ত</label><select name="assigned_user_id" class="form-select"><option value="">অনির্ধারিত</option><% users.forEach(function(u){ %><option value="<%= u.id %>" <%= String(item.assigned_user_id||'')===String(u.id)?'selected':'' %>><%= u.name %> · <%= u.role %></option><% }) %></select></div><div class="col-md-3"><label class="form-label">ধরন</label><select name="category" class="form-select"><% [['general','সাধারণ'],['finance','অর্থ'],['facility','স্থাপনা'],['community','কমিউনিটি'],['event','অনুষ্ঠান'],['compliance','কমপ্লায়েন্স']].forEach(function(x){ %><option value="<%= x[0] %>" <%= item.category===x[0]?'selected':'' %>><%= x[1] %></option><% }) %></select></div><div class="col-md-3"><label class="form-label">অগ্রাধিকার</label><select name="priority" class="form-select"><% [['low','কম'],['normal','সাধারণ'],['high','উচ্চ'],['critical','জরুরি']].forEach(function(x){ %><option value="<%= x[0] %>" <%= item.priority===x[0]?'selected':'' %>><%= x[1] %></option><% }) %></select></div><div class="col-md-3"><label class="form-label">শুরুর তারিখ</label><input type="date" name="start_date" value="<%= item.start_date?String(item.start_date).slice(0,10):'' %>" class="form-control"/></div><div class="col-md-3"><label class="form-label">শেষ তারিখ</label><input type="date" name="due_date" value="<%= item.due_date?String(item.due_date).slice(0,10):'' %>" class="form-control"/></div><div class="col-md-4"><label class="form-label">পুনরাবৃত্তি</label><select name="recurrence_type" class="form-select"><% [['none','একবার'],['daily','প্রতিদিন'],['weekly','প্রতি সপ্তাহে'],['monthly','প্রতি মাসে'],['yearly','প্রতি বছর']].forEach(function(x){ %><option value="<%= x[0] %>" <%= item.recurrence_type===x[0]?'selected':'' %>><%= x[1] %></option><% }) %></select></div><div class="col-md-4"><label class="form-label">ব্যবধান</label><input type="number" name="recurrence_interval" value="<%= item.recurrence_interval||1 %>" min="1" max="365" class="form-control"/></div><div class="col-md-4"><label class="form-label">পুনরাবৃত্তির শেষ</label><input type="date" name="recurrence_end_date" value="<%= item.recurrence_end_date?String(item.recurrence_end_date).slice(0,10):'' %>" class="form-control"/></div><div class="col-12"><label class="form-label">বিবরণ</label><textarea name="description" class="form-control" rows="3"><%= item.description||'' %></textarea></div><div class="col-12"><button class="btn btn-primary">পরিবর্তন সংরক্ষণ</button></div></form></div></div></div>
<div class="row g-4"><div class="col-lg-7">
  <div class="card mb-4"><div class="card-header" data-bn="কাজের তথ্য" data-en="Task information">কাজের তথ্য</div><div class="card-body"><dl class="row mb-0"><dt class="col-5">দায়িত্বপ্রাপ্ত</dt><dd class="col-7"><%= item.assigned_name||'অনির্ধারিত' %></dd><dt class="col-5">ধরন</dt><dd class="col-7"><%= item.category %></dd><dt class="col-5">অগ্রাধিকার</dt><dd class="col-7"><span class="badge <%= item.priority==='critical'?'text-bg-danger':item.priority==='high'?'text-bg-warning':'text-bg-light' %>"><%= item.priority %></span></dd><dt class="col-5">সময়সীমা</dt><dd class="col-7"><%= item.start_date?bn.date(item.start_date):'—' %> → <%= item.due_date?bn.date(item.due_date):'—' %></dd><dt class="col-5">পুনরাবৃত্তি</dt><dd class="col-7"><%= item.recurrence_type==='none'?'একবার':item.recurrence_type+' · প্রতি '+bn.num(item.recurrence_interval||1)+' ব্যবধানে' %><%= item.recurrence_end_date?' · '+bn.date(item.recurrence_end_date)+' পর্যন্ত':'' %></dd><dt class="col-5">অবস্থা</dt><dd class="col-7"><strong><%= item.status %></strong></dd><dt class="col-5">তৈরি করেছেন</dt><dd class="col-7"><%= item.creator_name||'—' %></dd></dl></div></div>
  <div class="card mb-4"><div class="card-header d-flex justify-content-between"><span data-bn="চেকলিস্ট" data-en="Checklist">চেকলিস্ট</span><span><%= bn.num(item.checklistCompleted) %>/<%= bn.num(item.checklist.length) %></span></div><div class="card-body"><% if(item.checklist.length){var percent=Math.round(item.checklistCompleted/item.checklist.length*100); %><div class="progress mb-3" style="height:7px"><div class="progress-bar" style="width:<%= percent %>%"></div></div><% } %><form method="post" action="/tasks/<%= item.id %>/checklist" class="d-flex gap-2 mb-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><input name="title" class="form-control" placeholder="নতুন করণীয় যোগ করুন" required/><button class="btn btn-outline-primary"><span class="material-symbols-outlined align-middle">add</span></button></form><div class="list-group list-group-flush"><% item.checklist.forEach(function(step){ %><div class="list-group-item px-0 d-flex align-items-center gap-2"><form method="post" action="/tasks/<%= item.id %>/checklist/<%= step.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><button class="btn btn-sm btn-link p-0 text-<%= step.is_completed?'success':'muted' %>" title="Toggle"><span class="material-symbols-outlined"><%= step.is_completed?'check_circle':'radio_button_unchecked' %></span></button></form><span class="flex-grow-1 <%= step.is_completed?'text-decoration-line-through text-muted':'' %>"><%= step.title %></span><form method="post" action="/tasks/<%= item.id %>/checklist/<%= step.id %>/remove" class="confirm-delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><button class="btn btn-sm btn-link text-danger p-0"><span class="material-symbols-outlined text-[18px]">delete</span></button></form></div><% }) %><% if(!item.checklist.length){ %><p class="text-muted text-center py-3 mb-0">এখনও কোনো চেকলিস্ট নেই।</p><% } %></div></div></div>
  <div class="card"><div class="card-header" data-bn="অগ্রগতি ও মন্তব্য" data-en="Progress and comments">অগ্রগতি ও মন্তব্য</div><div class="card-body"><form method="post" action="/tasks/<%= item.id %>/comments" class="d-flex gap-2 mb-4"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><input name="comment" class="form-control" placeholder="আপডেট বা মন্তব্য লিখুন" required/><button class="btn btn-outline-primary">যোগ করুন</button></form><div class="timeline"><% item.updates.forEach(function(u){ %><div class="border-start border-2 ps-3 pb-3"><strong><%= u.user_name||'System' %></strong><small class="text-muted ms-2"><%= bn.date(u.created_at) %></small><% if(u.from_status||u.to_status){ %><p class="small mb-1"><%= u.from_status||'—' %> → <%= u.to_status||'—' %></p><% } %><p class="mb-0"><%= u.comment||'' %></p></div><% }) %></div></div></div>
</div><div class="col-lg-5"><div class="card"><div class="card-header" data-bn="অবস্থা হালনাগাদ" data-en="Update status">অবস্থা হালনাগাদ</div><div class="card-body"><form method="post" action="/tasks/<%= item.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><select name="status" class="form-select mb-3"><% [['open','খোলা'],['in_progress','চলমান'],['blocked','বাধাগ্রস্ত'],['completed','সম্পন্ন'],['cancelled','বাতিল']].forEach(function(x){ %><option value="<%= x[0] %>" <%= item.status===x[0]?'selected':'' %>><%= x[1] %></option><% }) %></select><textarea name="comment" class="form-control mb-3" placeholder="পরিবর্তনের নোট"></textarea><button class="btn btn-primary w-100">অবস্থা সংরক্ষণ</button></form></div></div></div></div>
