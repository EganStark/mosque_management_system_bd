<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3 mb-4"><div><p class="text-uppercase text-primary fw-bold small mb-1" data-bn="পুনঃব্যবহারযোগ্য কাজ" data-en="Reusable workflows">পুনঃব্যবহারযোগ্য কাজ</p><h3 class="mb-1" data-bn="কাজের টেমপ্লেট" data-en="Task templates">কাজের টেমপ্লেট</h3><p class="text-muted mb-0" data-bn="নিয়মিত মসজিদ কার্যক্রম এক ক্লিকে তৈরি করুন" data-en="Create standard mosque workflows in one click">নিয়মিত মসজিদ কার্যক্রম এক ক্লিকে তৈরি করুন</p></div><div class="d-flex gap-2"><a href="/tasks" class="btn btn-outline-secondary">সব কাজ</a><button class="btn btn-primary" data-bs-toggle="collapse" data-bs-target="#newTemplate"><span class="material-symbols-outlined align-middle text-[18px]">add</span> নতুন টেমপ্লেট</button></div></div>
<div class="collapse mb-4" id="newTemplate"><div class="card"><div class="card-header">নতুন টেমপ্লেট</div><div class="card-body"><form method="post" action="/task-templates" class="row g-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><div class="col-md-8"><label class="form-label required">টেমপ্লেটের নাম</label><input name="name" class="form-control" placeholder="যেমন: জুমার প্রস্তুতি" required/></div><div class="col-md-4"><label class="form-label">ডিফল্ট দায়িত্বপ্রাপ্ত</label><select name="default_assigned_user_id" class="form-select"><option value="">অনির্ধারিত</option><% users.forEach(function(u){ %><option value="<%= u.id %>"><%= u.name %> · <%= u.role %></option><% }) %></select></div><div class="col-md-4"><label class="form-label">ধরন</label><select name="category" class="form-select"><% [['general','সাধারণ'],['finance','অর্থ'],['facility','স্থাপনা'],['community','কমিউনিটি'],['event','অনুষ্ঠান'],['compliance','কমপ্লায়েন্স']].forEach(function(x){ %><option value="<%= x[0] %>"><%= x[1] %></option><% }) %></select></div><div class="col-md-4"><label class="form-label">অগ্রাধিকার</label><select name="priority" class="form-select"><option value="normal">সাধারণ</option><option value="high">উচ্চ</option><option value="critical">জরুরি</option><option value="low">কম</option></select></div><div class="col-md-4"><label class="form-label">ডিফল্ট সময়কাল (দিন)</label><input type="number" name="default_duration_days" value="1" min="0" max="365" class="form-control" required/></div><div class="col-md-6"><label class="form-label">বিবরণ</label><textarea name="description" class="form-control" rows="5"></textarea></div><div class="col-md-6"><label class="form-label">চেকলিস্ট <small class="text-muted">(প্রতি লাইনে একটি)</small></label><textarea name="checklist" class="form-control" rows="5" placeholder="মাইক পরীক্ষা&#10;পরিচ্ছন্নতা যাচাই&#10;খুতবার সময় নিশ্চিত"></textarea></div><div class="col-12"><button class="btn btn-primary">টেমপ্লেট সংরক্ষণ</button></div></form></div></div></div>
<div class="row g-4"><% rows.forEach(function(item){ %><div class="col-md-6 col-xl-4"><div class="card h-100"><div class="card-body"><div class="d-flex justify-content-between gap-3 mb-3"><span class="material-symbols-outlined rounded-lg bg-moss-tint p-2 text-primary">assignment</span><span class="badge text-bg-light"><%= item.category %></span></div><h5><%= item.name %></h5><p class="text-muted small"><%= item.description||'কোনো বিবরণ নেই' %></p><div class="d-flex flex-wrap gap-2 small mb-4"><span class="badge bg-light text-dark"><%= item.priority %></span><span class="badge bg-light text-dark"><%= bn.num(item.item_count) %> ধাপ</span><span class="badge bg-light text-dark"><%= bn.num(item.default_duration_days) %> দিন</span></div><p class="small text-muted mb-3"><span class="material-symbols-outlined align-middle text-[16px]">person</span> <%= item.assigned_name||'অনির্ধারিত' %></p><form method="post" action="/task-templates/<%= item.id %>/use" class="row g-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><div class="col-6"><input type="date" name="start_date" value="<%= new Date().toISOString().slice(0,10) %>" class="form-control form-control-sm"/></div><div class="col-6"><button class="btn btn-primary btn-sm w-100">কাজ তৈরি</button></div></form></div><div class="card-footer d-flex justify-content-between bg-transparent"><a href="/task-templates/<%= item.id %>/edit" class="btn btn-sm btn-link">সম্পাদনা</a><form method="post" action="/task-templates/<%= item.id %>/archive" class="confirm-delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><button class="btn btn-sm btn-link text-danger">আর্কাইভ</button></form></div></div></div><% }) %><% if(!rows.length){ %><div class="col-12"><div class="card card-body text-center text-muted py-5">এখনও কোনো টেমপ্লেট নেই। প্রথম নিয়মিত কাজটি টেমপ্লেট হিসেবে তৈরি করুন।</div></div><% } %></div>
