<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3 mb-4"><div><p class="text-uppercase text-primary fw-bold small mb-1" data-bn="দৈনিক পরিচালনা" data-en="Daily operations">দৈনিক পরিচালনা</p><h3 class="mb-1" data-bn="কাজ ও ফলো-আপ কেন্দ্র" data-en="Tasks & follow-up center">কাজ ও ফলো-আপ কেন্দ্র</h3><p class="text-muted mb-0" data-bn="দায়িত্ব, সময়সীমা ও অগ্রগতি এক জায়গায়" data-en="Assignments, deadlines and progress in one place">দায়িত্ব, সময়সীমা ও অগ্রগতি এক জায়গায়</p></div><div class="d-flex flex-wrap gap-2"><a href="/task-templates" class="btn btn-outline-secondary"><span class="material-symbols-outlined align-middle text-[18px]">assignment</span> <span data-bn="টেমপ্লেট" data-en="Templates">টেমপ্লেট</span></a><a href="/tasks/board" class="btn btn-outline-primary"><span class="material-symbols-outlined align-middle text-[18px]">view_kanban</span> <span data-bn="বোর্ড" data-en="Board">বোর্ড</span></a><button class="btn btn-primary" data-bs-toggle="collapse" data-bs-target="#newTask"><span class="material-symbols-outlined align-middle text-[18px]">add_task</span> নতুন কাজ</button></div></div>
<div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-4"><% [['খোলা',summary.open],['সময় পেরিয়েছে',summary.overdue],['আমার দায়িত্ব',summary.mine],['এই মাসে সম্পন্ন',summary.completed_month]].forEach(function(x,i){ %><div class="card"><div class="card-body"><p class="small text-muted mb-1"><%= x[0] %></p><h3 class="<%= i===1&&x[1]?'text-danger':'' %>"><%= bn.num(x[1]) %></h3></div></div><% }) %></div>
<div class="collapse mb-4" id="newTask"><div class="card"><div class="card-header">নতুন কাজ তৈরি</div><div class="card-body"><form method="post" action="/tasks" class="row g-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><div class="col-md-8"><label class="form-label required">শিরোনাম</label><input name="title" class="form-control" required/></div><div class="col-md-4"><label class="form-label">দায়িত্বপ্রাপ্ত</label><select name="assigned_user_id" class="form-select"><option value="">পরে নির্ধারণ</option><% users.forEach(function(u){ %><option value="<%= u.id %>"><%= u.name %> · <%= u.role %></option><% }) %></select></div><div class="col-md-4"><label class="form-label required">ধরন</label><select name="category" class="form-select"><option value="general">সাধারণ</option><option value="finance">অর্থ</option><option value="facility">স্থাপনা</option><option value="community">কমিউনিটি</option><option value="event">অনুষ্ঠান</option><option value="compliance">কমপ্লায়েন্স</option></select></div><div class="col-md-4"><label class="form-label required">অগ্রাধিকার</label><select name="priority" class="form-select"><option value="normal">সাধারণ</option><option value="high">উচ্চ</option><option value="critical">জরুরি</option><option value="low">কম</option></select></div><div class="col-md-2"><label class="form-label">শুরুর তারিখ</label><input type="date" name="start_date" class="form-control"/></div><div class="col-md-2"><label class="form-label">শেষ তারিখ</label><input type="date" name="due_date" class="form-control"/></div><div class="col-md-4"><label class="form-label" data-bn="পুনরাবৃত্তি" data-en="Repeat">পুনরাবৃত্তি</label><select name="recurrence_type" class="form-select"><option value="none">একবার</option><option value="daily">প্রতিদিন</option><option value="weekly">প্রতি সপ্তাহে</option><option value="monthly">প্রতি মাসে</option><option value="yearly">প্রতি বছর</option></select></div><div class="col-md-4"><label class="form-label" data-bn="প্রতি কত ব্যবধানে" data-en="Repeat interval">প্রতি কত ব্যবধানে</label><input type="number" name="recurrence_interval" value="1" min="1" max="365" class="form-control"/></div><div class="col-md-4"><label class="form-label" data-bn="পুনরাবৃত্তির শেষ" data-en="Repeat until">পুনরাবৃত্তির শেষ</label><input type="date" name="recurrence_end_date" class="form-control"/></div><div class="col-12"><label class="form-label">বিবরণ</label><textarea name="description" class="form-control" rows="3"></textarea></div><div class="col-12"><button class="btn btn-primary">কাজ তৈরি করুন</button></div></form></div></div></div>
<form method="get" class="card card-body mb-4"><div class="row g-2"><div class="col-md-4"><select name="status" class="form-select"><option value="">সক্রিয় সব অবস্থা</option><% [['open','খোলা'],['in_progress','চলমান'],['blocked','বাধাগ্রস্ত'],['completed','সম্পন্ন'],['cancelled','বাতিল']].forEach(function(x){ %><option value="<%= x[0] %>" <%= filters.status===x[0]?'selected':'' %>><%= x[1] %></option><% }) %></select></div><div class="col-md-3"><select name="assigned" class="form-select"><option value="">সবার কাজ</option><option value="me" <%= filters.assigned==='me'?'selected':'' %>>শুধু আমার কাজ</option></select></div><div class="col-md-3"><select name="category" class="form-select"><option value="">সব ধরন</option><option value="general">সাধারণ</option><option value="finance">অর্থ</option><option value="facility">স্থাপনা</option><option value="community">কমিউনিটি</option><option value="event">অনুষ্ঠান</option><option value="compliance">কমপ্লায়েন্স</option></select></div><div class="col-md-2"><button class="btn btn-outline-primary w-100">ফিল্টার</button></div></div></form>
<div class="card"><div class="card-body p-0"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>কাজ</th><th>দায়িত্ব</th><th>অগ্রাধিকার</th><th>শেষ সময়</th><th>অবস্থা</th></tr></thead><tbody><% rows.forEach(function(item){var overdue=item.due_date&&new Date(item.due_date)<new Date()&&!['completed','cancelled'].includes(item.status); %><tr class="<%= overdue?'table-danger':'' %>"><td><a href="/tasks/<%= item.id %>" class="text-decoration-none"><strong><%= item.title %></strong><small class="d-block text-muted"><%= item.task_no %> · <%= item.category %></small></a></td><td><%= item.assigned_name||'অনির্ধারিত' %></td><td><span class="badge <%= item.priority==='critical'?'text-bg-danger':item.priority==='high'?'text-bg-warning':'text-bg-light' %>"><%= item.priority %></span></td><td class="<%= overdue?'text-danger fw-bold':'' %>"><%= item.due_date?bn.date(item.due_date):'—' %></td><td><%= item.status %></td></tr><% }) %></tbody></table></div><% if(!rows.length){ %><p class="text-center text-muted p-5 mb-0">কোনো কাজ পাওয়া যায়নি।</p><% } %></div></div>
