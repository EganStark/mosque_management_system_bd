<div class="d-flex justify-content-between align-items-start gap-3 mb-4"><div><p class="text-uppercase text-primary fw-bold small mb-1">Task template</p><h3><%= item.name %></h3></div><a href="/task-templates" class="btn btn-outline-secondary">সব টেমপ্লেট</a></div>
<div class="card"><div class="card-header">টেমপ্লেট সম্পাদনা</div><div class="card-body"><form method="post" action="/task-templates/<%= item.id %>/edit" class="row g-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><div class="col-md-8"><label class="form-label required">নাম</label><input name="name" value="<%= item.name %>" class="form-control" required/></div><div class="col-md-4"><label class="form-label">দায়িত্বপ্রাপ্ত</label><select name="default_assigned_user_id" class="form-select"><option value="">অনির্ধারিত</option><% users.forEach(function(u){ %><option value="<%= u.id %>" <%= String(item.default_assigned_user_id||'')===String(u.id)?'selected':'' %>><%= u.name %> · <%= u.role %></option><% }) %></select></div><div class="col-md-4"><label class="form-label">ধরন</label><select name="category" class="form-select"><% [['general','সাধারণ'],['finance','অর্থ'],['facility','স্থাপনা'],['community','কমিউনিটি'],['event','অনুষ্ঠান'],['compliance','কমপ্লায়েন্স']].forEach(function(x){ %><option value="<%= x[0] %>" <%= item.category===x[0]?'selected':'' %>><%= x[1] %></option><% }) %></select></div><div class="col-md-4"><label class="form-label">অগ্রাধিকার</label><select name="priority" class="form-select"><% [['low','কম'],['normal','সাধারণ'],['high','উচ্চ'],['critical','জরুরি']].forEach(function(x){ %><option value="<%= x[0] %>" <%= item.priority===x[0]?'selected':'' %>><%= x[1] %></option><% }) %></select></div><div class="col-md-4"><label class="form-label">সময়কাল (দিন)</label><input type="number" name="default_duration_days" value="<%= item.default_duration_days %>" min="0" max="365" class="form-control" required/></div><div class="col-md-6"><label class="form-label">বিবরণ</label><textarea name="description" class="form-control" rows="7"><%= item.description||'' %></textarea></div><div class="col-md-6"><label class="form-label">চেকলিস্ট <small class="text-muted">(প্রতি লাইনে একটি)</small></label><textarea name="checklist" class="form-control" rows="7"><%= item.items.map(function(x){return x.title;}).join('\n') %></textarea></div><div class="col-12"><button class="btn btn-primary">পরিবর্তন সংরক্ষণ</button></div></form></div></div>
