<% var names={annual:'বার্ষিক আর্থিক বিবরণী',loans:'ঋণ ও প্রাপ্য হিসাব',pledges:'দান অঙ্গীকার ও বকেয়া',welfare:'কল্যাণ তহবিল বিবরণী'};var months=['জানুয়ারি','ফেব্রুয়ারি','মার্চ','এপ্রিল','মে','জুন','জুলাই','আগস্ট','সেপ্টেম্বর','অক্টোবর','নভেম্বর','ডিসেম্বর']; %>
<div class="d-flex justify-content-between align-items-center mb-4"><div><p class="text-uppercase text-primary fw-bold small mb-1">Financial accountability</p><h3>আর্থিক জবাবদিহি রিপোর্ট</h3><p class="text-muted mb-0"><%= names[type] %></p></div><button onclick="window.print()" class="btn btn-outline-primary no-print">প্রিন্ট / PDF</button></div>
<form method="get" class="card mb-4 no-print"><div class="card-body row g-3 align-items-end"><div class="col-lg-4"><label class="form-label">রিপোর্ট</label><select name="type" class="form-select"><% Object.entries(names).forEach(function(x){ %><option value="<%= x[0] %>" <%= type===x[0]?'selected':'' %>><%= x[1] %></option><% }) %></select></div><div class="col-lg-2"><label class="form-label">বছর</label><input type="number" name="year" value="<%= year %>" class="form-control"/></div><div class="col-lg-2"><label class="form-label">অবস্থা</label><select name="status" class="form-select"><option value="open">চলমান/বকেয়া</option><option value="">সব</option><option value="overdue">মেয়াদোত্তীর্ণ</option><option value="paid">পরিশোধিত</option></select></div><div class="col-lg-2"><label class="form-label">তহবিল</label><select name="fund" class="form-select"><option value="">সব</option><option value="zakat">যাকাত</option><option value="sadaqah">সদকা</option><option value="general">সাধারণ</option><option value="emergency">জরুরি</option></select></div><div class="col-lg-2"><button class="btn btn-primary w-100">দেখুন</button></div></div></form>
<div class="report-header text-center mb-4"><h5><%= company.company_name %></h5><div><%= names[type] %> · <%= bn.num(year) %></div></div>
<% if(type==='annual'){ %><div class="grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-3 mb-4"><% [['মোট আদায়',data.summary.income],['মোট খরচ',data.summary.expense],['উদ্বৃত্ত',data.summary.operating],['নগদ ও ব্যাংক',data.summary.liquid],['ঋণ প্রাপ্য',data.summary.receivable],['আর্থিক সম্পদ',data.summary.resources]].forEach(function(x){ %><div class="card"><div class="card-body"><p class="small text-muted mb-1"><%= x[0] %></p><h5>৳ <%= bn.money(x[1]) %></h5></div></div><% }) %></div><div class="row g-4"><div class="col-xl-8"><div class="card h-100"><div class="card-header">মাসভিত্তিক আয়–ব্যয়</div><div class="card-body"><table class="table table-bordered datatable"><thead><tr><th>মাস</th><th class="text-end">আদায়</th><th class="text-end">খরচ</th><th class="text-end">উদ্বৃত্ত/ঘাটতি</th></tr></thead><tbody><% data.rows.forEach(function(r){ %><tr><td><%= months[r.month-1] %></td><td class="text-end"><%= bn.money(r.income) %></td><td class="text-end"><%= bn.money(r.expense) %></td><td class="text-end"><%= bn.money(r.balance) %></td></tr><% }) %></tbody></table></div></div></div><div class="col-xl-4"><div class="card h-100"><div class="card-header">তারল্য</div><div class="card-body"><div class="d-flex justify-content-between border-bottom py-2"><span>নগদ</span><strong>৳ <%= bn.money(data.summary.cash) %></strong></div><% data.accounts.forEach(function(a){ %><div class="d-flex justify-content-between border-bottom py-2"><span><%= a.name %></span><strong>৳ <%= bn.money(a.balance) %></strong></div><% }) %></div></div></div></div>
<% }else{ var s=data.summary; %><div class="grid grid-cols-2 lg:grid-cols-5 gap-3 mb-4"><% Object.entries(s).forEach(function(x){var labels={count:'রেকর্ড',issued:'ঋণ প্রদান',repaid:'কিস্তি আদায়',outstanding:'প্রাপ্য',overdue:'মেয়াদোত্তীর্ণ',pledged:'অঙ্গীকার',paid:'আদায়',due:'বকেয়া',requested:'আবেদন',approved:'অনুমোদন',disbursed:'বিতরণ',pending:'অপেক্ষমাণ'}; %><div class="card"><div class="card-body"><p class="small text-muted mb-1"><%= labels[x[0]] %></p><h5><%= ['count','pending'].includes(x[0])?bn.num(x[1]):'৳ '+bn.money(x[1]) %></h5></div></div><% }) %></div><div class="card"><div class="card-body"><div class="table-responsive"><table class="table table-bordered datatable w-100"><% if(type==='loans'){ %><thead><tr><th>ঋণ</th><th>ঋণগ্রহীতা</th><th>প্রদান</th><th>শেষ তারিখ</th><th>অবস্থা</th><th>মূল ঋণ</th><th>আদায়</th><th>প্রাপ্য</th></tr></thead><tbody><% data.rows.forEach(function(r){ %><tr><td><%= r.loan_no %></td><td><%= r.borrower_name %></td><td><%= bn.date(r.issue_date) %></td><td><%= r.final_due_date?bn.date(r.final_due_date):'—' %></td><td><%= r.status %></td><td><%= bn.money(r.principal_amount) %></td><td><%= bn.money(r.repaid_amount) %></td><td><%= bn.money(Number(r.principal_amount)-Number(r.repaid_amount)) %></td></tr><% }) %></tbody><% }else if(type==='pledges'){ %><thead><tr><th>অঙ্গীকার</th><th>দাতা</th><th>খাত</th><th>শেষ তারিখ</th><th>ফলো-আপ</th><th>অবস্থা</th><th>অঙ্গীকার</th><th>আদায়</th><th>বকেয়া</th></tr></thead><tbody><% data.rows.forEach(function(r){ %><tr><td><%= r.pledge_no %></td><td><%= r.donor_name %></td><td><%= r.category_name||'—' %></td><td><%= r.due_date?bn.date(r.due_date):'—' %></td><td><%= r.next_follow_up_date?bn.date(r.next_follow_up_date):'—' %></td><td><%= r.status %></td><td><%= bn.money(r.pledged_amount) %></td><td><%= bn.money(r.paid_amount) %></td><td><%= bn.money(Number(r.pledged_amount)-Number(r.paid_amount)) %></td></tr><% }) %></tbody><% }else{ %><thead><tr><th>আবেদন</th><th>উপকারভোগী</th><th>ধরন</th><th>তহবিল</th><th>অবস্থা</th><th>অনুরোধ</th><th>অনুমোদন</th><th>বিতরণ</th></tr></thead><tbody><% data.rows.forEach(function(r){ %><tr><td><%= r.application_no %></td><td><%= r.beneficiary_name %></td><td><%= r.assistance_type %></td><td><%= r.fund_source %></td><td><%= r.status %></td><td><%= bn.money(r.requested_amount) %></td><td><%= bn.money(r.approved_amount) %></td><td><%= bn.money(r.disbursed_amount) %></td></tr><% }) %></tbody><% } %></table></div></div></div><% } %>
