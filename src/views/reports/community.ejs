<% var titles={directory:'বিস্তারিত সদস্য তালিকা',occupation:'পেশাভিত্তিক বিশ্লেষণ',location:'এলাকাভিত্তিক বিশ্লেষণ',reference:'রেফারেন্স নেটওয়ার্ক'}; %>
<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4"><div><p class="text-uppercase text-primary fw-bold small mb-1">Community intelligence</p><h3 class="mb-1">কমিউনিটি ও সদস্য বিশ্লেষণ</h3><p class="text-muted mb-0"><%= titles[filters.group] %> · পরিকল্পনা ও যোগাযোগের জন্য হালনাগাদ তথ্য</p></div><button onclick="window.print()" class="btn btn-outline-primary no-print">প্রিন্ট</button></div>
<form method="get" class="card mb-4 no-print"><div class="card-body row g-3 align-items-end"><div class="col-lg-3"><label class="form-label">রিপোর্ট ধরন</label><select name="group" class="form-select"><% Object.entries(titles).forEach(function(x){ %><option value="<%= x[0] %>" <%= filters.group===x[0]?'selected':'' %>><%= x[1] %></option><% }) %></select></div><div class="col-md-3 col-lg-2"><label class="form-label">অবস্থা</label><select name="status" class="form-select"><option value="">সব</option><option value="active" <%= filters.status==='active'?'selected':'' %>>সক্রিয়</option><option value="deactive" <%= filters.status==='deactive'?'selected':'' %>>নিষ্ক্রিয়</option></select></div><div class="col-md-3 col-lg-2"><label class="form-label">লিঙ্গ</label><select name="gender" class="form-select"><option value="">সব</option><option value="male" <%= filters.gender==='male'?'selected':'' %>>পুরুষ</option><option value="female" <%= filters.gender==='female'?'selected':'' %>>নারী</option></select></div><div class="col-md-3 col-lg-2"><label class="form-label">মাসিক চাঁদা</label><select name="monthly" class="form-select"><option value="">সব</option><option value="yes" <%= filters.monthly==='yes'?'selected':'' %>>দেন</option><option value="no" <%= filters.monthly==='no'?'selected':'' %>>দেন না</option></select></div><div class="col-md-6 col-lg-3"><label class="form-label">পেশা</label><select name="occupation_id" class="form-select"><option value="">সব পেশা</option><% options.occupations.forEach(function(o){ %><option value="<%= o.id %>" <%= String(filters.occupation_id)===String(o.id)?'selected':'' %>><%= o.name %></option><% }) %></select></div><div class="col-md-6 col-lg-4"><label class="form-label">গ্রাম</label><select name="village_id" class="form-select select2"><option value="">সব গ্রাম</option><% options.villages.forEach(function(v){ %><option value="<%= v.id %>" <%= String(filters.village_id)===String(v.id)?'selected':'' %>><%= v.name %></option><% }) %></select></div><div class="col-md-6 col-lg-4"><label class="form-label">এলাকা</label><select name="area_id" class="form-select select2"><option value="">সব এলাকা</option><% options.areas.forEach(function(a){ %><option value="<%= a.id %>" <%= String(filters.area_id)===String(a.id)?'selected':'' %>><%= a.name %></option><% }) %></select></div><div class="col-md-6 col-lg-2"><button class="btn btn-primary w-100">রিপোর্ট দেখুন</button></div><div class="col-lg-2"><a href="/reports/community" class="btn btn-outline-secondary w-100">রিসেট</a></div></div></form>
<div class="grid grid-cols-2 lg:grid-cols-4 xl:grid-cols-7 gap-3 mb-4"><% [['মোট সদস্য',data.summary.total,false],['সক্রিয়',data.summary.active,false],['পুরুষ',data.summary.male,false],['নারী',data.summary.female,false],['মাসিক দাতা',data.summary.monthly,false],['মাসিক প্রতিশ্রুতি',data.summary.monthlyAmount,true],['রেফারেন্সসহ',data.summary.referenced,false]].forEach(function(x){ %><div class="card"><div class="card-body"><p class="small text-muted mb-1"><%= x[0] %></p><h5 class="mb-0"><%= x[2]?'৳ '+bn.money(x[1]):bn.num(x[1]) %></h5></div></div><% }) %></div>
<div class="card"><div class="card-body"><div class="report-header text-center mb-3"><h5><%= company.company_name %></h5><div class="text-muted"><%= titles[filters.group] %></div></div><div class="table-responsive"><% if(filters.group==='directory'){ %><table class="table table-sm table-bordered datatable w-100"><thead><tr><th>সদস্য</th><th>নাম</th><th>লিঙ্গ</th><th>মোবাইল</th><th>পেশা</th><th>এলাকা</th><th>রেফারেন্স</th><th>সন্তান</th><th>মাসিক চাঁদা</th><th>অবস্থা</th></tr></thead><tbody><% data.rows.forEach(function(r){ %><tr><td><%= r.id_no %></td><td><%= r.name %></td><td><%= r.gender==='female'?'নারী':'পুরুষ' %></td><td><%= r.phone||'—' %></td><td><%= r.occupation||'—' %></td><td><%= r.area||r.village||r.address_text||'—' %></td><td><%= r.reference_name?r.reference_no+' · '+r.reference_name:'—' %></td><td><%= bn.num(r.child_count) %></td><td><%= r.monthly_payment?'৳ '+bn.money(r.monthly_payment_amount):'—' %></td><td><%= r.status==='active'?'সক্রিয়':'নিষ্ক্রিয়' %></td></tr><% }) %></tbody></table><% }else{ %><table class="table table-sm table-bordered datatable w-100"><thead><tr><th><%= filters.group==='occupation'?'পেশা':filters.group==='location'?'এলাকা':'রেফারেন্স সদস্য' %></th><th class="text-end">মোট</th><th class="text-end">পুরুষ</th><th class="text-end">নারী</th><th class="text-end">মাসিক দাতা</th><th class="text-end">মাসিক প্রতিশ্রুতি</th></tr></thead><tbody><% data.groups.forEach(function(g){ %><tr><td><%= g.name %></td><td class="text-end"><%= bn.num(g.count) %></td><td class="text-end"><%= bn.num(g.male) %></td><td class="text-end"><%= bn.num(g.female) %></td><td class="text-end"><%= bn.num(g.monthly) %></td><td class="text-end">৳ <%= bn.money(g.amount) %></td></tr><% }) %></tbody></table><% } %></div></div></div>
