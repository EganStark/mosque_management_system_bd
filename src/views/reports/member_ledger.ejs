<div class="d-flex justify-content-between align-items-center mb-4"><div><h3 class="mb-1">সদস্য আর্থিক লেজার</h3><p class="text-muted mb-0">সকল আদায়, মাসিক বিল এবং বর্তমান বকেয়া</p></div><button onclick="window.print()" class="btn btn-outline-primary no-print"><i class="bi bi-printer me-1"></i> প্রিন্ট</button></div>
<form method="get" class="card mb-4 no-print"><div class="card-body row g-3 align-items-end"><div class="col-lg-4"><label class="form-label">সদস্য</label><select name="member_id" class="form-select select2"><option value="">সকল সদস্য</option><% memberOptions.forEach(function(m){ %><option value="<%= m.id %>" <%= String(member_id)===String(m.id)?'selected':'' %>><%= m.id_no %> — <%= m.name %></option><% }) %></select></div><div class="col-md-3"><label class="form-label">শুরু</label><input type="date" name="from" value="<%= from||'' %>" class="form-control"/></div><div class="col-md-3"><label class="form-label">শেষ</label><input type="date" name="to" value="<%= to||'' %>" class="form-control"/></div><div class="col-md-2"><button class="btn btn-primary w-100">দেখুন</button></div></div></form>
<div class="card"><div class="card-body"><div class="report-header text-center mb-3"><h5><%= company.company_name %></h5><p class="text-muted">সদস্য আর্থিক লেজার</p></div><div class="table-responsive"><table class="table table-bordered datatable w-100"><thead><tr><th>সদস্য</th><th>মোবাইল</th><th class="text-end">সর্বমোট আদায়</th><th class="text-end">মাসিক বিল</th><th class="text-end">মাসিক পরিশোধ</th><th class="text-end">বকেয়া</th></tr></thead><tbody><% rows.forEach(function(r){ %><tr><td><a href="/members/<%= r.id %>"><strong><%= r.name %></strong></a><small class="d-block text-muted">আইডি: <%= bn.toBnDigits(r.id_no) %></small></td><td><%= bn.toBnDigits(r.phone||'—') %></td><td class="text-end">৳ <%= bn.money(r.total_collections) %></td><td class="text-end">৳ <%= bn.money(r.total_billed) %></td><td class="text-end text-success">৳ <%= bn.money(r.monthly_paid) %></td><td class="text-end fw-bold <%= r.outstanding>0?'text-danger':'text-success' %>">৳ <%= bn.money(r.outstanding) %></td></tr><% }) %></tbody></table></div></div></div>
