<% var names={procurement:'ক্রয় ও সরবরাহ',inventory:'স্টক চলাচল',maintenance:'রক্ষণাবেক্ষণ',welfare:'কল্যাণ সহায়তা',payroll:'স্টাফ বেতন',programs:'প্রোগ্রাম ও উপস্থিতি',governance:'সভা ও সিদ্ধান্ত'}; %>
<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4"><div><p class="text-uppercase text-primary fw-bold small mb-1">Operational accountability</p><h3 class="mb-1">পরিচালনাগত রিপোর্ট</h3><p class="text-muted mb-0"><%= names[type] %> · নির্বাচিত সময়ের সারাংশ ও বিস্তারিত রেকর্ড</p></div><button onclick="window.print()" class="btn btn-outline-primary no-print"><i class="bi bi-printer me-1"></i> প্রিন্ট</button></div>
<form method="get" class="card mb-4 no-print"><div class="card-body row g-3 align-items-end"><div class="col-lg-4"><label class="form-label">রিপোর্ট</label><select name="type" class="form-select"><% Object.keys(names).forEach(function(k){ %><option value="<%= k %>" <%= type===k?'selected':'' %>><%= names[k] %></option><% }) %></select></div><div class="col-md-3"><label class="form-label">শুরু</label><input type="date" name="from" value="<%= from||'' %>" class="form-control"/></div><div class="col-md-3"><label class="form-label">শেষ</label><input type="date" name="to" value="<%= to||'' %>" class="form-control"/></div><div class="col-md-2"><button class="btn btn-primary w-100">রিপোর্ট দেখুন</button></div></div></form>
<div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-4"><% Object.entries(data.summary).forEach(function(x){ var labels={count:'রেকর্ড',total:'অর্ডার মূল্য',paid:'পরিশোধিত',received:'গ্রহণ',issued:'ইস্যু',value:'গ্রহণ মূল্য',open:'খোলা কাজ',estimated:'প্রাক্কলন',actual:'প্রকৃত খরচ',pending:'অপেক্ষমাণ',approved:'অনুমোদিত',disbursed:'বিতরণ',payable:'প্রদেয়',outstanding:'বকেয়া',active:'সক্রিয়',enrolled:'নিবন্ধিত',attendance:'উপস্থিতি',held:'অনুষ্ঠিত সভা',resolutions:'সিদ্ধান্ত',openActions:'খোলা করণীয়'};var money=['total','paid','value','estimated','actual','approved','disbursed','payable','outstanding'].includes(x[0]); %><div class="card"><div class="card-body"><p class="small text-muted mb-1"><%= labels[x[0]]||x[0] %></p><h5 class="mb-0"><%= money?'৳ '+bn.money(x[1]):bn.num(x[1]) %></h5></div></div><% }) %></div>
<div class="card"><div class="card-body"><div class="report-header text-center mb-3"><h5 class="mb-0"><%= company.company_name %></h5><div class="small text-muted"><%= names[type] %> রিপোর্ট<%= from?' · '+bn.date(from)+' — '+bn.date(to||new Date()):'' %></div></div><div class="table-responsive"><table class="table table-sm table-bordered datatable w-100"><% if(type==='procurement'){ %><thead><tr><th>অর্ডার</th><th>তারিখ</th><th>অনুরোধ</th><th>বিক্রেতা</th><th>অবস্থা</th><th class="text-end">মূল্য</th><th class="text-end">পরিশোধ</th><th class="text-end">বকেয়া</th></tr></thead><tbody><% data.rows.forEach(function(r){ %><tr><td><%= r.order_no %></td><td><%= bn.date(r.order_date) %></td><td><%= r.request_no %> · <%= r.request_title %></td><td><%= r.vendor_name %></td><td><%= r.status %></td><td class="text-end"><%= bn.money(r.order_total) %></td><td class="text-end"><%= bn.money(r.paid) %></td><td class="text-end"><%= bn.money(Number(r.order_total)-Number(r.paid)) %></td></tr><% }) %></tbody>
<% }else if(type==='inventory'){ %><thead><tr><th>রেফারেন্স</th><th>তারিখ</th><th>আইটেম</th><th>ধরন</th><th class="text-end">পরিমাণ</th><th class="text-end">পরবর্তী মজুত</th><th>প্রাপক/ব্যবহার</th><th>নোট</th></tr></thead><tbody><% data.rows.forEach(function(r){ %><tr><td><%= r.reference_no %></td><td><%= bn.date(r.movement_date) %></td><td><%= r.item_code %> · <%= r.item_name %></td><td><%= r.movement_type %></td><td class="text-end"><%= bn.num(r.quantity) %> <%= r.unit %></td><td class="text-end"><%= bn.num(r.balance_after) %></td><td><%= r.staff_name||r.facility_name||r.program_name||r.recipient_name||'—' %></td><td><%= r.notes||'—' %></td></tr><% }) %></tbody>
<% }else if(type==='maintenance'){ %><thead><tr><th>কাজের আদেশ</th><th>তারিখ</th><th>কাজ</th><th>সম্পদ/সুবিধা</th><th>বিক্রেতা</th><th>অবস্থা</th><th class="text-end">প্রাক্কলন</th><th class="text-end">প্রকৃত</th></tr></thead><tbody><% data.rows.forEach(function(r){ %><tr><td><%= r.work_order_no %></td><td><%= bn.date(r.reported_date) %></td><td><%= r.title %></td><td><%= r.asset_name||r.facility_name||'—' %></td><td><%= r.vendor_name||'—' %></td><td><%= r.status %></td><td class="text-end"><%= bn.money(r.estimated_cost) %></td><td class="text-end"><%= bn.money(r.actual_cost) %></td></tr><% }) %></tbody>
<% }else if(type==='welfare'){ %><thead><tr><th>আবেদন</th><th>তারিখ</th><th>উপকারভোগী</th><th>সহায়তা</th><th>তহবিল</th><th>অবস্থা</th><th class="text-end">অনুরোধ</th><th class="text-end">অনুমোদন</th><th class="text-end">বিতরণ</th></tr></thead><tbody><% data.rows.forEach(function(r){ %><tr><td><%= r.application_no %></td><td><%= bn.date(r.created_at) %></td><td><%= r.beneficiary_name %></td><td><%= r.assistance_type %></td><td><%= r.fund_source %></td><td><%= r.status %></td><td class="text-end"><%= bn.money(r.requested_amount) %></td><td class="text-end"><%= bn.money(r.approved_amount) %></td><td class="text-end"><%= bn.money(r.disbursed_amount) %></td></tr><% }) %></tbody>
<% }else if(type==='payroll'){ %><thead><tr><th>মাস</th><th>স্টাফ</th><th>পদ</th><th>অবস্থা</th><th class="text-end">মূল বেতন</th><th class="text-end">প্রদেয়</th><th class="text-end">পরিশোধ</th><th class="text-end">বকেয়া</th></tr></thead><tbody><% data.rows.forEach(function(r){ %><tr><td><%= bn.monthLabel(r.payroll_month) %></td><td><%= r.staff_name %></td><td><%= r.position_bn %></td><td><%= r.status %></td><td class="text-end"><%= bn.money(r.basic_salary) %></td><td class="text-end"><%= bn.money(r.net_payable) %></td><td class="text-end"><%= bn.money(r.amount_paid) %></td><td class="text-end"><%= bn.money(Number(r.net_payable)-Number(r.amount_paid)) %></td></tr><% }) %></tbody>
<% }else if(type==='programs'){ %><thead><tr><th>প্রোগ্রাম</th><th>ধরন</th><th>শিক্ষক</th><th>সময়সূচি</th><th>অবস্থা</th><th class="text-end">নিবন্ধিত</th><th class="text-end">ক্লাসের দিন</th><th class="text-end">উপস্থিতি চিহ্ন</th></tr></thead><tbody><% data.rows.forEach(function(r){ %><tr><td><%= r.name %></td><td><%= r.category %></td><td><%= r.instructor_name||'—' %></td><td><%= r.schedule_text||'—' %></td><td><%= r.status %></td><td class="text-end"><%= bn.num(r.enrolled) %></td><td class="text-end"><%= bn.num(r.class_days) %></td><td class="text-end"><%= bn.num(r.attendance_marks) %></td></tr><% }) %></tbody>
<% }else{ %><thead><tr><th>সভা</th><th>তারিখ</th><th>কমিটি</th><th>শিরোনাম</th><th>অবস্থা</th><th class="text-end">কোরাম</th><th class="text-end">সিদ্ধান্ত</th><th class="text-end">করণীয়</th><th class="text-end">খোলা</th></tr></thead><tbody><% data.rows.forEach(function(r){ %><tr><td><%= r.meeting_no %></td><td><%= bn.date(r.meeting_date) %></td><td><%= r.committee_name %></td><td><%= r.title %></td><td><%= r.status %></td><td class="text-end"><%= bn.num(r.quorum_required) %></td><td class="text-end"><%= bn.num(r.resolution_count) %></td><td class="text-end"><%= bn.num(r.action_count) %></td><td class="text-end"><%= bn.num(r.open_action_count) %></td></tr><% }) %></tbody><% } %></table></div></div></div>
