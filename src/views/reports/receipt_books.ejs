<div class="d-flex justify-content-between align-items-center mb-4"><div><h3 class="mb-1">রশিদ বই ব্যবহার রিপোর্ট</h3><p class="text-muted mb-0">প্রতিটি বইয়ের সীমা, ব্যবহৃত রশিদ এবং আদায়ের পরিমাণ</p></div><button onclick="window.print()" class="btn btn-outline-primary no-print"><i class="bi bi-printer me-1"></i> প্রিন্ট</button></div>
<div class="card"><div class="card-body"><div class="report-header text-center mb-3"><h5><%= company.company_name %></h5><p class="text-muted">রশিদ বই ব্যবহার রিপোর্ট</p></div><div class="table-responsive"><table class="table table-bordered datatable w-100"><thead><tr><th>বইয়ের ধরন</th><th>বই নম্বর</th><th>রশিদ সীমা</th><th>ব্যবহৃত</th><th class="text-end">আদায়ের মোট</th><th>অবস্থা</th></tr></thead><tbody><% rows.forEach(function(r){ %><tr><td><%= r.book_type_name||'—' %></td><td><%= bn.toBnDigits(r.book_number) %></td><td><%= bn.toBnDigits(r.receipt_from||'—') %> — <%= bn.toBnDigits(r.receipt_to||'—') %></td><td><%= bn.num(r.used_count) %></td><td class="text-end">৳ <%= bn.money(r.collected_total) %></td><td><%= r.status==='active'?'সক্রিয়':'নিষ্ক্রিয়' %></td></tr><% }) %></tbody></table></div></div></div>
