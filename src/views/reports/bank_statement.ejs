<h3 class="mb-3">ব্যাংক স্টেটমেন্ট</h3>
<%
  var extra = '<div class="col-md-3"><label class="form-label">ব্যাংক</label><select name="bank_id" class="form-select"><option value="">সব</option>';
  bankList.forEach(function(b){ extra += '<option value="'+b.id+'"'+(String(bank_id)===String(b.id)?' selected':'')+'>'+b.name+'</option>'; });
  extra += '</select></div>';
%>
<%- include('../partials/report_filter', { from, to, extraFilter: extra }) %>

<div class="card"><div class="card-body">
  <div class="report-header text-center mb-2">
    <h5 class="mb-0"><%= company.company_name %></h5>
    <div class="small text-muted">ব্যাংক স্টেটমেন্ট<%= from? ' ('+bn.date(from)+' - '+bn.date(to||from)+')':'' %></div>
  </div>
  <div class="table-responsive">
    <table class="table table-sm table-bordered w-100">
      <thead><tr><th>ক্রমিক</th><th>ব্যাংক</th><th>টাইপ</th><th>মন্তব্য</th><th class="text-end">ডিপোজিট</th><th class="text-end">উত্তোলন</th><th class="text-end">ব্যালেন্স</th><th>তারিখ</th></tr></thead>
      <tbody>
        <% if (from) { %>
        <tr class="table-light"><td colspan="6" class="text-end fw-bold">পূর্ববর্তী জের</td><td class="text-end"><%= bn.money(data.prevBalance) %></td><td></td></tr>
        <% } %>
        <% data.rows.forEach(function(r,i){ %>
        <tr>
          <td><%= bn.toBnDigits(i+1) %></td>
          <td><%= r.bank_name||'' %></td>
          <td><%= r.type==='deposit'?'জমা':'উত্তোলন' %></td>
          <td><%= r.remarks||'' %></td>
          <td class="text-end text-success"><%= r.deposit? bn.money(r.deposit):'' %></td>
          <td class="text-end text-danger"><%= r.withdraw? bn.money(r.withdraw):'' %></td>
          <td class="text-end"><%= bn.money(r.balance) %></td>
          <td><%= bn.date(r.date) %></td>
        </tr>
        <% }) %>
      </tbody>
      <tfoot>
        <tr class="fw-bold"><td colspan="4" class="text-end">উপমোট</td><td class="text-end"><%= bn.money(data.subDeposit) %></td><td class="text-end"><%= bn.money(data.subWithdraw) %></td><td colspan="2"></td></tr>
        <tr class="fw-bold table-primary"><td colspan="6" class="text-end">সর্বমোট ব্যালেন্স</td><td class="text-end"><%= bn.money(data.total) %></td><td></td></tr>
      </tfoot>
    </table>
  </div>
</div></div>
