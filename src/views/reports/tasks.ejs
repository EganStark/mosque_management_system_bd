<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3 mb-4"><div><p class="text-uppercase text-primary fw-bold small mb-1" data-bn="পরিচালনাগত কর্মদক্ষতা" data-en="Operational performance">পরিচালনাগত কর্মদক্ষতা</p><h3 class="mb-1" data-bn="কাজ ও কর্মদক্ষতা রিপোর্ট" data-en="Task and performance report">কাজ ও কর্মদক্ষতা রিপোর্ট</h3><p class="text-muted mb-0" data-bn="সমাপ্তি, বকেয়া, কাজের চাপ ও প্রবণতা" data-en="Completion, overdue work, workload and trends">সমাপ্তি, বকেয়া, কাজের চাপ ও প্রবণতা</p></div><div class="d-flex gap-2 no-print"><button onclick="window.print()" class="btn btn-outline-primary"><span class="material-symbols-outlined align-middle text-[18px]">print</span> প্রিন্ট</button><a href="/reports/tasks.csv?<%= new URLSearchParams(Object.fromEntries(Object.entries(filters).filter(function(x){return x[1];}))).toString() %>" class="btn btn-primary"><span class="material-symbols-outlined align-middle text-[18px]">download</span> CSV</a></div></div>
<form method="get" class="card card-body mb-4 no-print"><div class="row g-2"><div class="col-md-2"><label class="form-label">শুরু</label><input type="date" name="from" value="<%= filters.from||'' %>" class="form-control"/></div><div class="col-md-2"><label class="form-label">শেষ</label><input type="date" name="to" value="<%= filters.to||'' %>" class="form-control"/></div><div class="col-md-3"><label class="form-label">ধরন</label><select name="category" class="form-select"><option value="">সব ধরন</option><% [['general','সাধারণ'],['finance','অর্থ'],['facility','স্থাপনা'],['community','কমিউনিটি'],['event','অনুষ্ঠান'],['compliance','কমপ্লায়েন্স']].forEach(function(x){ %><option value="<%= x[0] %>" <%= filters.category===x[0]?'selected':'' %>><%= x[1] %></option><% }) %></select></div><div class="col-md-3"><label class="form-label">দায়িত্বপ্রাপ্ত</label><select name="assigned_user_id" class="form-select"><option value="">সবাই</option><% users.forEach(function(u){ %><option value="<%= u.id %>" <%= String(filters.assigned_user_id)===String(u.id)?'selected':'' %>><%= u.name %> · <%= u.role %></option><% }) %></select></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-outline-primary w-100">রিপোর্ট তৈরি</button></div></div></form>
<div class="grid grid-cols-2 lg:grid-cols-6 gap-3 mb-4"><% [['মোট কাজ',data.summary.total,''],['সক্রিয়',data.summary.active,'text-primary'],['সম্পন্ন',data.summary.completed,'text-success'],['সময় পেরিয়েছে',data.summary.overdue,'text-danger'],['সমাপ্তির হার',data.summary.completionRate+'%','text-success'],['গড় সময়',data.summary.averageDays+' দিন','']].forEach(function(x){ %><div class="card"><div class="card-body"><small class="text-muted"><%= x[0] %></small><h4 class="mb-0 mt-1 <%= x[2] %>"><%= typeof x[1]==='number'?bn.num(x[1]):x[1] %></h4></div></div><% }) %></div>
<div class="row g-4 mb-4"><div class="col-lg-7"><div class="card h-100"><div class="card-header" data-bn="ছয় মাসের কাজের প্রবণতা" data-en="Six-month task trend">ছয় মাসের কাজের প্রবণতা</div><div class="card-body"><% var trendMax=Math.max.apply(null,data.trend.map(function(x){return Math.max(x.created,x.completed);}).concat([1])); %><div class="task-report-chart"><% data.trend.forEach(function(point){ %><div class="task-report-month"><div class="task-report-bars"><div class="task-report-bar bg-primary" style="height:<%= Math.max(3,point.created/trendMax*100) %>%" title="Created <%= point.created %>"></div><div class="task-report-bar bg-success" style="height:<%= Math.max(3,point.completed/trendMax*100) %>%" title="Completed <%= point.completed %>"></div></div><small><%= point.month.slice(5) %>/<%= point.month.slice(2,4) %></small></div><% }) %></div><div class="d-flex justify-content-center gap-4 small mt-3"><span><i class="d-inline-block bg-primary rounded me-1" style="width:10px;height:10px"></i> তৈরি</span><span><i class="d-inline-block bg-success rounded me-1" style="width:10px;height:10px"></i> সম্পন্ন</span></div></div></div></div><div class="col-lg-5"><div class="card h-100"><div class="card-header">দায়িত্বের চাপ</div><div class="card-body"><% data.workload.forEach(function(user){var width=data.workload[0]?Math.round(user.total/data.workload[0].total*100):0; %><div class="mb-3"><div class="d-flex justify-content-between small mb-1"><span><strong><%= user.name %></strong></span><span><%= bn.num(user.total) %> · <span class="text-danger"><%= bn.num(user.overdue) %> বকেয়া</span></span></div><div class="progress" style="height:7px"><div class="progress-bar <%= user.overdue?'bg-warning':'bg-primary' %>" style="width:<%= width %>%"></div></div></div><% }) %><% if(!data.workload.length){ %><p class="text-muted text-center">কোনো সক্রিয় দায়িত্ব নেই</p><% } %></div></div></div></div>
<div class="card mb-4"><div class="card-header">ধরনভিত্তিক কর্মদক্ষতা</div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>ধরন</th><th>মোট</th><th>সম্পন্ন</th><th>বকেয়া</th><th style="width:35%">সমাপ্তির হার</th></tr></thead><tbody><% data.categories.forEach(function(row){ %><tr><td><strong><%= row.category %></strong></td><td><%= bn.num(row.total) %></td><td><%= bn.num(row.completed) %></td><td class="<%= row.overdue?'text-danger fw-bold':'' %>"><%= bn.num(row.overdue) %></td><td><div class="d-flex align-items-center gap-2"><div class="progress flex-grow-1" style="height:7px"><div class="progress-bar bg-success" style="width:<%= row.rate %>%"></div></div><span><%= bn.num(row.rate) %>%</span></div></td></tr><% }) %></tbody></table></div></div>
<div class="card"><div class="card-header d-flex justify-content-between"><span>কাজের বিস্তারিত</span><span class="badge bg-primary"><%= bn.num(data.rows.length) %></span></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>কাজ</th><th>ধরন</th><th>দায়িত্ব</th><th>শেষ সময়</th><th>অবস্থা</th></tr></thead><tbody><% data.rows.forEach(function(item){ %><tr><td><a href="/tasks/<%= item.id %>" class="text-decoration-none"><strong><%= item.title %></strong><small class="d-block text-muted"><%= item.task_no %> · <%= item.priority %></small></a></td><td><%= item.category %></td><td><%= item.assigned_name||'অনির্ধারিত' %></td><td><%= item.due_date?bn.date(item.due_date):'—' %></td><td><%= item.status %></td></tr><% }) %><% if(!data.rows.length){ %><tr><td colspan="5" class="text-center text-muted py-5">নির্বাচিত ফিল্টারে কোনো কাজ নেই</td></tr><% } %></tbody></table></div></div>
