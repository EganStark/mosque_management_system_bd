<div class="d-flex justify-content-between align-items-center mb-4"><div><h3 class="mb-1">খাতভিত্তিক আর্থিক সারাংশ</h3><p class="text-muted mb-0">আদায় ও খরচের খাত অনুযায়ী মোট পরিমাণ</p></div><button onclick="window.print()" class="btn btn-outline-primary no-print"><i class="bi bi-printer me-1"></i> প্রিন্ট</button></div>
<form method="get" class="card mb-4 no-print"><div class="card-body row g-3 align-items-end"><div class="col-md-4"><label class="form-label">শুরু</label><input type="date" name="from" value="<%= from||'' %>" class="form-control"/></div><div class="col-md-4"><label class="form-label">শেষ</label><input type="date" name="to" value="<%= to||'' %>" class="form-control"/></div><div class="col-md-4"><button class="btn btn-primary">রিপোর্ট দেখুন</button></div></div></form>
<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-4"><div class="card"><div class="card-body"><p class="small text-muted mb-1">মোট আদায়</p><h4 class="text-success">৳ <%= bn.money(data.totalIncome) %></h4></div></div><div class="card"><div class="card-body"><p class="small text-muted mb-1">মোট খরচ</p><h4 class="text-danger">৳ <%= bn.money(data.totalExpense) %></h4></div></div><div class="card"><div class="card-body"><p class="small text-muted mb-1">অবশিষ্ট</p><h4>৳ <%= bn.money(data.totalIncome-data.totalExpense) %></h4></div></div></div>
<div class="row g-4"><% [{title:'আদায়ের খাত',rows:data.income,color:'text-success'},{title:'খরচের খাত',rows:data.expense,color:'text-danger'}].forEach(function(group){ %><div class="col-lg-6"><div class="card h-100"><div class="card-header"><%= group.title %></div><div class="card-body"><table class="table"><thead><tr><th>খাত</th><th>লেনদেন</th><th class="text-end">মোট</th></tr></thead><tbody><% group.rows.forEach(function(r){ %><tr><td><%= r.category %></td><td><%= bn.num(r.count) %></td><td class="text-end fw-bold <%= group.color %>">৳ <%= bn.money(r.total) %></td></tr><% }) %></tbody></table></div></div></div><% }) %></div>
