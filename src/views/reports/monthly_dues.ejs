<div class="d-flex justify-content-between align-items-center mb-4"><div><h3 class="mb-1">মাসিক চাঁদা ও বকেয়া রিপোর্ট</h3><p class="text-muted mb-0">নির্বাচিত মাসের সদস্যভিত্তিক পরিশোধ অবস্থা</p></div><button onclick="window.print()" class="btn btn-outline-primary no-print"><i class="bi bi-printer me-1"></i> প্রিন্ট</button></div>
<form method="get" class="card mb-4 no-print"><div class="card-body row g-3 align-items-end"><div class="col-md-4"><label class="form-label">মাস</label><input type="month" name="month" value="<%= month %>" class="form-control"/></div><div class="col-md-4"><label class="form-label">অবস্থা</label><select name="status" class="form-select"><option value="due" <%= status==='due'?'selected':'' %>>বকেয়া ও আংশিক</option><option value="paid" <%= status==='paid'?'selected':'' %>>পরিশোধিত</option><option value="all" <%= status==='all'?'selected':'' %>>সকল</option></select></div><div class="col-md-4"><button class="btn btn-primary">রিপোর্ট দেখুন</button></div></div></form>
<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-4"><div class="card"><div class="card-body"><p class="small text-muted mb-1">দাবিকৃত</p><h4>৳ <%= bn.money(data.totals.billed) %></h4></div></div><div class="card"><div class="card-body"><p class="small text-muted mb-1">আদায়</p><h4 class="text-success">৳ <%= bn.money(data.totals.paid) %></h4></div></div><div class="card"><div class="card-body"><p class="small text-muted mb-1">বকেয়া</p><h4 class="text-danger">৳ <%= bn.money(data.totals.outstanding) %></h4></div></div></div>
<div class="card"><div class="card-body"><div class="report-header text-center mb-3"><h5><%= company.company_name %></h5><p class="text-muted"><%= month %> মাসের চাঁদা রিপোর্ট</p></div><div class="table-responsive"><table class="table table-bordered datatable w-100"><thead><tr><th>সদস্য</th><th>মোবাইল</th><th class="text-end">বিল</th><th class="text-end">পরিশোধ</th><th class="text-end">বকেয়া</th><th>অবস্থা</th></tr></thead><tbody><% data.rows.forEach(function(r){var due=Number(r.amount_due)-Number(r.amount_paid);%><tr><td><strong><%= r.name %></strong><small class="d-block text-muted">আইডি: <%= bn.toBnDigits(r.id_no) %></small></td><td><%= bn.toBnDigits(r.phone||'—') %></td><td class="text-end">৳ <%= bn.money(r.amount_due) %></td><td class="text-end text-success">৳ <%= bn.money(r.amount_paid) %></td><td class="text-end text-danger fw-bold">৳ <%= bn.money(due) %></td><td><%= r.status==='paid'?'পরিশোধিত':r.status==='partial'?'আংশিক':'বকেয়া' %></td></tr><% }) %></tbody></table></div></div></div>
