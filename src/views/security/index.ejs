<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4"><div><p class="text-uppercase text-primary fw-bold small mb-1">Access control</p><h3 class="mb-1">নিরাপত্তা ও ভূমিকার অনুমতি</h3><p class="text-muted mb-0">কে কোন ধরনের ব্যবস্থাপনা কাজ করতে পারবেন তা নির্ধারণ করুন</p></div><a href="/security/audit" class="btn btn-outline-primary"><i class="bi bi-clock-history me-1"></i> অডিট লগ</a></div>
<div class="alert alert-info"><i class="bi bi-shield-check me-2"></i>“ওয়েবসাইট কনটেন্ট সম্পাদনা” দিয়ে খসড়া তৈরির ক্ষমতা এবং “ওয়েবসাইট কনটেন্ট প্রকাশ” দিয়ে অনুমোদন ও প্রকাশের ক্ষমতা আলাদাভাবে দিন।</div>
<% const collectorAllowed=new Set(['members.manage','finance.manage','monthly.manage','assets.manage','deceased.manage','website.manage','website.publish','reports.view']); const viewerAllowed=new Set(['reports.view']); %><form method="post" action="/security/permissions"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><div class="card"><div class="card-body"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>মডিউল</th><th class="text-center">অ্যাডমিন</th><th class="text-center">কালেক্টর</th><th class="text-center">ভিউয়ার</th></tr></thead><tbody><% permissions.forEach(function(p){ %><tr><td><strong><%= p.label %></strong><small class="d-block text-muted"><%= p.key %></small></td><td class="text-center"><i class="bi bi-check-circle-fill text-success"></i></td><td class="text-center"><input class="form-check-input" type="checkbox" name="collector:<%= p.key %>" <%= matrix.collector[p.key]?'checked':'' %> <%= collectorAllowed.has(p.key)?'':'disabled' %>/></td><td class="text-center"><input class="form-check-input" type="checkbox" name="viewer:<%= p.key %>" <%= matrix.viewer[p.key]?'checked':'' %> <%= viewerAllowed.has(p.key)?'':'disabled' %>/></td></tr><% }) %></tbody></table></div><button class="btn btn-primary">অনুমতি সংরক্ষণ করুন</button></div></div></form>
