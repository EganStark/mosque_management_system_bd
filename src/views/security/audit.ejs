<div class="d-flex justify-content-between align-items-center mb-4"><div><p class="text-uppercase text-primary fw-bold small mb-1">Accountability</p><h3 class="mb-1">সিস্টেম অডিট লগ</h3><p class="text-muted mb-0">ব্যবহারকারীর গুরুত্বপূর্ণ পরিবর্তন ও ফলাফলের অপরিবর্তনীয় ইতিহাস</p></div><a href="/security" class="btn btn-outline-secondary">অনুমতি সেটিংস</a></div>
<form method="get" class="card mb-4"><div class="card-body row g-3 align-items-end"><div class="col-md-3"><label class="form-label">ব্যবহারকারী</label><select name="user_id" class="form-select"><option value="">সকল</option><% userRows.forEach(function(u){ %><option value="<%= u.id %>" <%= String(user_id)===String(u.id)?'selected':'' %>><%= u.name %></option><% }) %></select></div><div class="col-md-2"><label class="form-label">কাজ</label><select name="action" class="form-select"><option value="">সকল</option><% ['create','update','cancel','delete','login','logout'].forEach(function(a){ %><option value="<%= a %>" <%= action===a?'selected':'' %>><%= a %></option><% }) %></select></div><div class="col-md-2"><label class="form-label">শুরু</label><input type="date" name="from" value="<%= from||'' %>" class="form-control"/></div><div class="col-md-2"><label class="form-label">শেষ</label><input type="date" name="to" value="<%= to||'' %>" class="form-control"/></div><div class="col-md-3"><button class="btn btn-primary">ফিল্টার করুন</button></div></div></form>
<div class="card"><div class="card-body"><div class="table-responsive"><table class="table table-hover datatable w-100"><thead><tr><th>সময়</th><th>ব্যবহারকারী</th><th>কাজ</th><th>মডিউল</th><th>পথ</th><th>ফলাফল</th><th>পরিবর্তন</th></tr></thead><tbody><% rows.forEach(function(r){ %><tr><td><%= bn.dateTime?bn.dateTime(r.created_at):bn.date(r.created_at) %></td><td><strong><%= r.username||'অজানা' %></strong><small class="d-block text-muted"><%= r.role||'' %></small></td><td><span class="badge bg-primary-subtle text-primary"><%= r.action %></span></td><td><%= r.entity||'—' %><%= r.entity_id?' #'+r.entity_id:'' %></td><td><code><%= r.method %> <%= r.path %></code></td><td><span class="badge <%= r.status_code<400?'bg-success-subtle text-success':'bg-danger-subtle text-danger' %>"><%= r.status_code %></span></td><td><details><summary class="small">দেখুন</summary><pre class="audit-json"><%= JSON.stringify(r.changes||{},null,2) %></pre></details></td></tr><% }) %></tbody></table></div></div></div>
