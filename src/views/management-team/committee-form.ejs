<div class="d-flex justify-content-between align-items-center mb-4"><div><p class="text-uppercase text-primary fw-bold small mb-1">Committee setup</p><h3 class="mb-1">নতুন পরিচালনা কমিটি</h3><p class="text-muted mb-0">কমিটির মেয়াদ ও অবস্থা নির্ধারণ করুন</p></div><a href="/management-team" class="btn btn-outline-secondary">ফিরে যান</a></div>
<div class="card"><div class="card-body"><form method="post" action="/management-team/committees" class="row g-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><div class="col-md-6"><label class="form-label required">কমিটির নাম</label><input name="name" class="form-control" placeholder="যেমন: পরিচালনা কমিটি ২০২৬–২০২৮" required/></div><div class="col-md-3"><label class="form-label required">শুরুর তারিখ</label><input type="date" name="start_date" class="form-control" required/></div><div class="col-md-3"><label class="form-label">শেষের তারিখ</label><input type="date" name="end_date" class="form-control"/></div><div class="col-md-4"><label class="form-label">অবস্থা</label><select name="status" class="form-select"><option value="active">সক্রিয়</option><option value="completed">সম্পন্ন</option></select></div><div class="col-md-8"><label class="form-label">মন্তব্য</label><input name="notes" class="form-control"/></div><div class="col-12"><button class="btn btn-primary">কমিটি তৈরি করুন</button></div></form></div></div>
