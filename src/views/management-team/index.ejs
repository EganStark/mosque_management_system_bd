<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4"><div><p class="text-uppercase text-primary fw-bold small mb-1">People management</p><h3 class="mb-1">কমিটি, ইমাম ও স্টাফ</h3><p class="text-muted mb-0">মসজিদের পরিচালনা পরিষদ এবং সেবাদানকারী দলের কেন্দ্রীয় ব্যবস্থাপনা</p></div><div class="d-flex gap-2"><a href="/landing/staff/new" class="btn btn-outline-primary"><i class="bi bi-person-plus me-1"></i> স্টাফ যোগ করুন</a><a href="/management-team/committees/new" class="btn btn-primary"><i class="bi bi-people me-1"></i> নতুন কমিটি</a></div></div>
<div class="row g-4"><div class="col-lg-7"><div class="card"><div class="card-header">পরিচালনা কমিটি</div><div class="card-body"><div class="table-responsive"><table class="table table-hover"><thead><tr><th>কমিটি</th><th>মেয়াদ</th><th>সদস্য</th><th>অবস্থা</th><th></th></tr></thead><tbody><% committees.forEach(function(c){ %><tr><td><strong><%= c.name %></strong></td><td><%= bn.date(c.start_date) %> — <%= c.end_date?bn.date(c.end_date):'চলমান' %></td><td><%= bn.num(c.member_count) %> জন</td><td><span class="badge <%= c.status==='active'?'bg-success-subtle text-success':'bg-secondary-subtle text-secondary' %>"><%= c.status==='active'?'সক্রিয়':'সম্পন্ন' %></span></td><td><a href="/management-team/committees/<%= c.id %>" class="btn btn-sm btn-outline-primary">পরিচালনা</a></td></tr><% }) %><% if(!committees.length){ %><tr><td colspan="5" class="text-center text-muted py-4">এখনও কোনো কমিটি তৈরি হয়নি</td></tr><% } %></tbody></table></div></div></div></div>
<div class="col-lg-5"><div class="card"><div class="card-header d-flex justify-content-between"><span>ইমাম ও স্টাফ</span><a href="/landing/staff" class="small">সব পরিচালনা</a></div><div class="card-body"><div class="vstack gap-3"><% staffRows.slice(0,8).forEach(function(s){ %><div class="d-flex align-items-center gap-3"><% if(s.photo){ %><img src="<%= s.photo %>" class="rounded-circle object-fit-cover" style="width:44px;height:44px"/><% }else{ %><div class="rounded-circle bg-light d-grid place-items-center" style="width:44px;height:44px"><i class="bi bi-person"></i></div><% } %><div class="flex-grow-1"><strong class="d-block"><%= s.name_bn %></strong><small class="text-muted"><%= s.position_bn %></small></div><span class="badge <%= s.is_active?'bg-success-subtle text-success':'bg-secondary-subtle text-secondary' %>"><%= s.is_active?'সক্রিয়':'নিষ্ক্রিয়' %></span></div><% }) %><% if(!staffRows.length){ %><p class="text-center text-muted mb-0">কোনো স্টাফ যোগ করা হয়নি</p><% } %></div></div></div></div></div>
