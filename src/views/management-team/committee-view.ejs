<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4"><div><p class="text-uppercase text-primary fw-bold small mb-1">Committee</p><h3 class="mb-1"><%= committee.name %></h3><p class="text-muted mb-0"><%= bn.date(committee.start_date) %> — <%= committee.end_date?bn.date(committee.end_date):'চলমান' %></p></div><a href="/management-team" class="btn btn-outline-secondary">ফিরে যান</a></div>
<div class="card mb-4"><div class="card-header">কমিটিতে সদস্য যোগ করুন</div><div class="card-body"><form method="post" action="/management-team/committees/<%= committee.id %>/members" class="row g-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><div class="col-lg-5"><label class="form-label required">নিবন্ধিত সদস্য</label><select name="member_id" class="form-select select2" required><option value="">নির্বাচন করুন</option><% memberOptions.forEach(function(m){ %><option value="<%= m.id %>"><%= m.id_no %> — <%= m.name %></option><% }) %></select></div><div class="col-lg-3"><label class="form-label required">পদ</label><select name="committee_type_id" class="form-select" required><option value="">নির্বাচন করুন</option><% types.forEach(function(t){ %><option value="<%= t.id %>"><%= t.name %></option><% }) %></select></div><div class="col-lg-2"><label class="form-label">ক্রম</label><input type="number" name="sort_order" value="0" class="form-control"/></div><div class="col-lg-2 d-flex align-items-end"><button class="btn btn-primary w-100">যোগ করুন</button></div></form></div></div>
<div class="card"><div class="card-header">কমিটির সদস্যবৃন্দ</div><div class="card-body"><div class="table-responsive"><table class="table table-hover datatable w-100"><thead><tr><th>ক্রম</th><th>সদস্য</th><th>পদ</th><th>মোবাইল</th><th>অবস্থা</th><th class="no-print"></th></tr></thead><tbody><% committee.members.forEach(function(m,i){ %><tr><td><%= bn.num(i+1) %></td><td><strong><%= m.member_name %></strong><small class="d-block text-muted">আইডি: <%= bn.toBnDigits(m.member_id_no) %></small></td><td><%= m.position_name %></td><td><%= bn.toBnDigits(m.phone||'—') %></td><td><span class="badge bg-success-subtle text-success">সক্রিয়</span></td><td class="no-print"><form method="post" action="/management-team/committees/<%= committee.id %>/members/<%= m.id %>/delete" class="confirm-delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button></form></td></tr><% }) %><% if(!committee.members.length){ %><tr><td colspan="6" class="text-center text-muted py-4">এখনও সদস্য যোগ করা হয়নি</td></tr><% } %></tbody></table></div></div></div>
