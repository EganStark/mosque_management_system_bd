<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4"><div><p class="text-uppercase text-primary fw-bold small mb-1">Public requests</p><h3 class="mb-1">পাবলিক ইনবক্স ও অনলাইন দান যাচাই</h3><p class="text-muted mb-0">ওয়েবসাইট থেকে আসা বার্তা ও লেনদেনের দাবি নিরাপদে পর্যালোচনা করুন</p></div></div>
<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 mb-4"><div class="card"><div class="card-body"><p class="small text-muted mb-1">নতুন বার্তা</p><h4><%= bn.num(summary.newMessages) %></h4></div></div><div class="card"><div class="card-body"><p class="small text-muted mb-1">চলমান বার্তা</p><h4><%= bn.num(summary.activeMessages) %></h4></div></div><div class="card"><div class="card-body"><p class="small text-muted mb-1">যাচাইয়ের অপেক্ষায় দান</p><h4><%= bn.num(summary.pendingDonations) %></h4></div></div><div class="card"><div class="card-body"><p class="small text-muted mb-1">অযাচাইকৃত পরিমাণ</p><h4>৳ <%= bn.money(summary.pendingAmount) %></h4></div></div></div>
<ul class="nav nav-tabs mb-4"><li class="nav-item"><a class="nav-link <%= tab==='messages'?'active':'' %>" href="/public-inbox">যোগাযোগ বার্তা</a></li><li class="nav-item"><a class="nav-link <%= tab==='donations'?'active':'' %>" href="/public-inbox?tab=donations">অনলাইন দানের দাবি</a></li></ul>
<% if(tab==='messages'){ %><div class="card"><div class="card-body"><div class="table-responsive"><table class="table align-middle datatable w-100"><thead><tr><th>টিকেট</th><th>প্রেরক</th><th>বিষয় ও বার্তা</th><th>সময়</th><th>অবস্থা ও দায়িত্ব</th></tr></thead><tbody><% messages.forEach(function(m){ %><tr><td><strong><%= m.ticket_no %></strong></td><td><%= m.full_name %><small class="d-block"><a href="mailto:<%= m.email %>"><%= m.email %></a></small><small><%= m.phone||'' %></small></td><td><strong><%= m.subject %></strong><p class="small mb-0" style="white-space:pre-line;max-width:480px"><%= m.message %></p></td><td><%= bn.date(m.created_at) %></td><td><form method="post" action="/public-inbox/messages/<%= m.id %>" class="row g-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><div class="col-12"><select name="status" class="form-select form-select-sm"><% [['new','নতুন'],['in_progress','চলমান'],['resolved','সমাধান'],['spam','স্প্যাম']].forEach(function(x){ %><option value="<%= x[0] %>" <%= m.status===x[0]?'selected':'' %>><%= x[1] %></option><% }) %></select></div><div class="col-12"><select name="assigned_to" class="form-select form-select-sm"><option value="">নিজ দায়িত্বে</option><% users.forEach(function(u){ %><option value="<%= u.id %>" <%= Number(m.assigned_to)===Number(u.id)?'selected':'' %>><%= u.name %></option><% }) %></select></div><div class="col-12"><textarea name="response_notes" class="form-control form-control-sm" placeholder="উত্তর/সমাধান নোট"><%= m.response_notes||'' %></textarea></div><div class="col-12"><button class="btn btn-sm btn-outline-primary">আপডেট</button></div></form></td></tr><% }) %></tbody></table></div></div></div><% } %>
<% if(tab==='donations'){ %><div class="card"><div class="card-body"><div class="table-responsive"><table class="table align-middle datatable w-100"><thead><tr><th>নিশ্চিতকরণ</th><th>দাতা</th><th>দান</th><th>লেনদেন</th><th>সময়</th><th>অবস্থা/যাচাই</th></tr></thead><tbody><% donations.forEach(function(d){ %><tr><td><strong><%= d.confirmation_no %></strong></td><td><%= d.is_anonymous?'নাম প্রকাশে অনিচ্ছুক':d.donor_name %><small class="d-block"><%= d.phone %> · <%= d.email||'' %></small></td><td><strong>৳ <%= bn.money(d.amount) %></strong><small class="d-block"><%= d.donation_type %></small></td><td><%= d.payment_method %><small class="d-block font-monospace"><%= d.transaction_id %></small></td><td><%= bn.date(d.created_at) %></td><td><% if(d.status==='pending'&&currentUser.role==='admin'){ %><form method="post" action="/public-inbox/donations/<%= d.id %>/review"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><% if(d.payment_method==='bank'){ %><select name="bank_id" class="form-select form-select-sm mb-2" required><option value="">যে ব্যাংকে টাকা এসেছে</option><% banks.forEach(function(b){ %><option value="<%= b.id %>"><%= b.bank_name %> · <%= b.account_number %></option><% }) %></select><% } %><% if(['bkash','nagad','rocket'].includes(d.payment_method)){ var matchingWallets=mobileWallets.filter(function(w){return w.provider===d.payment_method}); %><select name="mobile_wallet_id" class="form-select form-select-sm mb-2" required><option value="">যে ওয়ালেটে টাকা এসেছে</option><% matchingWallets.forEach(function(w){ %><option value="<%= w.id %>" <%= matchingWallets.length===1?'selected':'' %>><%= w.name %> · <%= w.account_number %></option><% }) %></select><% } %><textarea name="review_notes" class="form-control form-control-sm mb-2" placeholder="যাচাই নোট"></textarea><div class="d-flex gap-2"><button name="decision" value="verify" class="btn btn-sm btn-success">যাচাই ও রশিদ</button><button name="decision" value="reject" class="btn btn-sm btn-outline-danger" formnovalidate>প্রত্যাখ্যান</button></div></form><% }else{ %><strong><%= ({pending:'অপেক্ষমাণ',verified:'যাচাইকৃত',rejected:'প্রত্যাখ্যাত',reversed:'রশিদ বাতিল'})[d.status]||d.status %></strong><% if(d.receipt_no){ %><a href="/collections/<%= d.collection_id %>/receipt" class="d-block small"><%= d.receipt_no %></a><% } %><% if(d.bank_name){ %><small class="d-block"><%= d.bank_name %> · <%= d.account_number %></small><% } %><% if(d.mobile_wallet_name){ %><small class="d-block"><%= d.mobile_wallet_name %> · <%= d.mobile_wallet_number %></small><% } %><% if(d.review_notes){ %><small class="d-block"><%= d.review_notes %></small><% } %><% } %></td></tr><% }) %></tbody></table></div></div></div><% } %>
