    <%- include('partials/sidebar') %>
    <div class="app-main">
      <%- include('partials/navbar') %>
      <main class="content p-3 p-md-4">
        <%- include('partials/flash') %>
        <%- body %>
      </main>
      <footer class="footer text-center text-muted small py-3">
