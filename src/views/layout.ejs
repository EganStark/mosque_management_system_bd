<!DOCTYPE html>
<html lang="bn">
<head>
  <script>
    (function () {
      var saved = localStorage.getItem('brjm-admin-theme');
      var dark = saved ? saved === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.classList.toggle('dark', dark);
      document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
    })();
  </script>
  <%- include('partials/head') %>
  <style>
    /* Sidebar toggle transition support */
    #sidebar {
      transition: transform 0.3s ease;
    }
    .app-main {
      transition: margin-left 0.3s ease;
    }
    .app-shell.collapsed #sidebar {
      transform: translateX(-260px);
    }
    .app-shell.collapsed .app-main {
      margin-left: 0;
    }
    @media (max-width: 1024px) {
      #sidebar {
        transform: translateX(-260px);
      }
      .app-main {
        margin-left: 0 !important;
      }
      .app-shell.active-mobile #sidebar {
        transform: translateX(0);
      }
    }
  </style>
</head>
<body class="bg-surface font-body-md text-on-surface antialiased">
  <div class="flex min-h-screen app-shell">
    <!-- Sidebar -->
    <%- include('partials/sidebar') %>

    <!-- Main Content Area -->
    <div class="app-main flex-1 ml-[260px] bg-background min-h-screen flex flex-col">
      <!-- Navbar -->
      <%- include('partials/navbar') %>

      <% if (isDemoSession) { %>
        <div class="alert alert-warning rounded-0 border-x-0 border-top-0 mb-0 px-4 py-2 text-center" role="status">
          <strong>Demo mode:</strong> This account can explore every module, but all data changes are disabled.
        </div>
      <% } %>

      <!-- Content -->
      <main class="flex-1 p-4 md:p-6 lg:p-8 max-w-[1500px] mx-auto w-full">
        <%- include('partials/flash') %>
        <%- body %>
      </main>

      <!-- Footer -->
      <footer class="w-full py-stack-md border-t border-border-subtle bg-surface-container-low mt-auto">
        <div class="flex flex-col items-center justify-center gap-2 px-gutter text-center">
          <p class="font-label-md text-label-md text-on-surface-variant mb-0">
            &copy; <%= bn.toBnDigits(new Date().getFullYear()) %> <%= company && company.company_name ? company.company_name : 'Baitur Rahman Jame Moshjid' %>
          </p>
        </div>
      </footer>
    </div>
  </div>
  <%- include('partials/scripts') %>
</body>
</html>
