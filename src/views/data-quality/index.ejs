<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4"><div><p class="text-uppercase text-primary fw-bold small mb-1" data-bn="ব্যবস্থাপনা অডিট" data-en="Management audit">ব্যবস্থাপনা অডিট</p><h3 class="mb-1" data-bn="ডেটা স্বাস্থ্য কেন্দ্র" data-en="Data health center">ডেটা স্বাস্থ্য কেন্দ্র</h3><p class="text-muted mb-0" data-bn="অসম্পূর্ণ, অসামঞ্জস্যপূর্ণ ও সম্ভাব্য ডুপ্লিকেট রেকর্ড" data-en="Incomplete, inconsistent and potentially duplicated records">অসম্পূর্ণ, অসামঞ্জস্যপূর্ণ ও সম্ভাব্য ডুপ্লিকেট রেকর্ড</p></div><button class="btn btn-outline-primary no-print" onclick="window.print()"><span class="material-symbols-outlined align-middle text-[18px]">print</span> প্রিন্ট / PDF</button></div>
<div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-4"><div class="card"><div class="card-body"><p class="small text-muted mb-1">স্বাস্থ্য স্কোর</p><h2 class="<%= data.score>=80?'text-success':data.score>=50?'text-warning':'text-danger' %>"><%= bn.num(data.score) %>/১০০</h2><div class="progress"><div class="progress-bar <%= data.score>=80?'bg-success':data.score>=50?'bg-warning':'bg-danger' %>" style="width:<%= data.score %>%"></div></div></div></div><div class="card"><div class="card-body"><p class="small text-muted mb-1">মোট সমস্যা</p><h2><%= bn.num(data.totalIssues) %></h2></div></div><div class="card"><div class="card-body"><p class="small text-muted mb-1">গুরুতর</p><h2 class="text-danger"><%= bn.num(data.critical) %></h2></div></div></div>
<% if(!data.issues.length){ %><div class="alert alert-success p-4"><strong>চমৎকার!</strong> স্বয়ংক্রিয় পরীক্ষায় কোনো ডেটা সমস্যা পাওয়া যায়নি।</div><% } %>
<div class="accordion" id="qualityIssues"><% data.issues.forEach(function(issue,index){ %><div class="accordion-item"><h2 class="accordion-header"><button class="accordion-button <%= index?'collapsed':'' %>" type="button" data-bs-toggle="collapse" data-bs-target="#quality-<%= issue.key %>"><span class="material-symbols-outlined me-2 <%= issue.severity==='danger'?'text-danger':'text-warning' %>"><%= issue.severity==='danger'?'error':'warning' %></span><span class="flex-grow-1" data-bn="<%= issue.title %>" data-en="<%= issue.titleEn %>"><%= issue.title %></span><span class="badge <%= issue.severity==='danger'?'text-bg-danger':'text-bg-warning' %> me-3"><%= bn.num(issue.count) %></span></button></h2><div id="quality-<%= issue.key %>" class="accordion-collapse collapse <%= index?'':'show' %>" data-bs-parent="#qualityIssues"><div class="accordion-body"><div class="d-flex justify-content-between align-items-center mb-3"><p class="text-muted mb-0"><%= issue.detail %></p><a href="<%= issue.href %>" class="btn btn-sm btn-outline-primary no-print">রেকর্ড খুলুন</a></div><div class="table-responsive"><table class="table table-sm align-middle"><thead><tr><th>রেফারেন্স</th><th>বিবরণ</th><th>মান/অবস্থা</th></tr></thead><tbody><% issue.items.forEach(function(item){ var ref=item.id_no||item.loan_no||item.receipt_no||item.voucher_no||item.item_code||item.asset_code||item.reference_no||item.name||item.transaction_reference||'#'+(item.id||''); var desc=item.description||item.name||item.title||item.purpose||item.names||''; var value=item.phone||item.amount||item.payment_total||item.stock_quantity||item.difference||item.count||item.location||item.account_number||''; %><tr><td><%= ref %></td><td><%= desc %></td><td><%= value %><% if(currentUser.role==='admin'&&(issue.key==='collection-bank'||issue.key==='collection-wallet')){ %><form method="post" action="/data-quality/collections/<%= item.id %>/account" class="d-flex gap-2 mt-2 no-print"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><% if(issue.key==='collection-bank'){ %><select name="bank_id" class="form-select form-select-sm" required><option value="">গ্রহণকারী ব্যাংক নির্বাচন</option><% banks.forEach(function(bank){ %><option value="<%= bank.id %>"><%= bank.name %> · <%= bank.account_number||'' %></option><% }) %></select><% if(!banks.length){ %><a href="/banks/setup" class="btn btn-sm btn-outline-primary text-nowrap">আগে ব্যাংক যোগ করুন</a><% } %><% }else{ %><select name="mobile_wallet_id" class="form-select form-select-sm" required><option value="">গ্রহণকারী ওয়ালেট নির্বাচন</option><% mobileWallets.forEach(function(wallet){ %><option value="<%= wallet.id %>"><%= wallet.name %> · <%= wallet.account_number||'' %></option><% }) %></select><% } %><button class="btn btn-sm btn-success" <%= issue.key==='collection-bank'&&!banks.length?'disabled':'' %>>সংশোধন</button></form><% } %></td></tr><% }) %></tbody></table></div></div></div></div><% }) %></div><p class="text-muted small mt-3">শেষ পরীক্ষা: <%= bn.date(data.checkedAt) %></p><style>@media print{.no-print,.sidebar,.navbar{display:none!important}.accordion-collapse{display:block!important}.accordion-button{box-shadow:none!important}.accordion-item{break-inside:avoid}}</style>
