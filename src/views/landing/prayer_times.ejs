<div class="d-flex justify-content-between align-items-center mb-3">
  <h3 class="mb-0">নামাজের সময়সূচী ও ভেন্যু তথ্য</h3>
  <a href="/landing" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> ফিরে যান</a>
</div>

<div class="card shadow-sm"><div class="card-body">
  <form method="post" action="/landing/prayer-times?_csrf=<%= encodeURIComponent(csrfToken) %>" class="row g-3">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

    <h5 class="border-bottom pb-2 text-primary"><i class="bi bi-clock me-1"></i> নামাজের সময়সমূহ (২৪ ঘণ্টার ফরম্যাট, যেমন: 15:45)</h5>

    <div class="col-md-4 col-sm-6">
      <label class="form-label required">ফজর (Fajr)</label>
      <input type="text" name="fajr" class="form-control" value="<%= settings.fajr %>" placeholder="HH:MM" required />
    </div>
    <div class="col-md-4 col-sm-6">
      <label class="form-label required">যোহর (Dhuhr)</label>
      <input type="text" name="dhuhr" class="form-control" value="<%= settings.dhuhr %>" placeholder="HH:MM" required />
    </div>
    <div class="col-md-4 col-sm-6">
      <label class="form-label required">আসর (Asr)</label>
      <input type="text" name="asr" class="form-control" value="<%= settings.asr %>" placeholder="HH:MM" required />
    </div>
    <div class="col-md-4 col-sm-6">
      <label class="form-label required">মাগরিব (Maghrib)</label>
      <input type="text" name="maghrib" class="form-control" value="<%= settings.maghrib %>" placeholder="HH:MM" required />
    </div>
    <div class="col-md-4 col-sm-6">
      <label class="form-label required">ইশা (Isha)</label>
      <input type="text" name="isha" class="form-control" value="<%= settings.isha %>" placeholder="HH:MM" required />
    </div>
    <div class="col-md-4 col-sm-6">
      <label class="form-label required">জুম্মাহ (Jummah)</label>
      <input type="text" name="jummah" class="form-control" value="<%= settings.jummah %>" placeholder="HH:MM" required />
    </div>

    <h5 class="border-bottom pb-2 pt-3 text-primary"><i class="bi bi-calendar-date me-1"></i> হিজরি ক্যালেন্ডার তথ্য</h5>
    <h5 class="border-bottom pb-2 pt-4 text-primary"><i class="bi bi-sunrise me-1"></i> Fasting, Waqt End & Forbidden Times</h5>
    <% [
      ['fajr_start', 'Fajr waqt starts'], ['asr_start', 'Asr waqt starts'],
      ['maghrib_start', 'Maghrib waqt starts'], ['isha_start', 'Isha waqt starts'],
      ['sahri_end', 'Sahri ends'], ['iftar_time', 'Iftar'], ['sunrise', 'Sunrise'],
      ['fajr_end', 'Fajr waqt ends'], ['dhuhr_start', 'Dhuhr waqt starts'], ['dhuhr_end', 'Dhuhr waqt ends'],
      ['asr_end', 'Asr waqt ends'], ['maghrib_end', 'Maghrib waqt ends'], ['isha_end', 'Isha waqt ends'],
      ['sunrise_forbidden_end', 'Sunrise prohibition ends'], ['zawal_start', 'Zawal starts'],
      ['zawal_end', 'Zawal ends'], ['sunset_forbidden_start', 'Sunset prohibition starts']
    ].forEach(function(field) { %>
      <div class="col-md-4 col-sm-6">
        <label class="form-label required"><%= field[1] %></label>
        <input type="time" name="<%= field[0] %>" class="form-control" value="<%= settings[field[0]] %>" required />
      </div>
    <% }); %>
    <div class="col-12">
      <div class="alert alert-warning mb-0"><strong>Important:</strong> These times vary by date and location. Update them from a verified local timetable whenever the seasonal schedule changes.</div>
    </div>

    <div class="col-md-12">
      <label class="form-label required">হিজরি তারিখ (আজকের তারিখ)</label>
      <input type="text" name="hijri_date" class="form-control" value="<%= settings.hijri_date %>" placeholder="যেমন: 17 Dhul-Hijjah 1447" required />
    </div>

    <h5 class="border-bottom pb-2 pt-3 text-primary"><i class="bi bi-geo-alt me-1"></i> ভেন্যু তথ্য (মোবাইল অ্যাপ/ল্যান্ডিং পেইজে প্রদর্শনের জন্য)</h5>
    <div class="col-md-4">
      <label class="form-label required">ভেন্যুর নাম</label>
      <input type="text" name="venue_name" class="form-control" value="<%= settings.venue_name %>" required />
    </div>
    <div class="col-md-4">
      <label class="form-label required">ভেন্যুর ঠিকানা</label>
      <input type="text" name="venue_address" class="form-control" value="<%= settings.venue_address %>" required />
    </div>
    <div class="col-md-4">
      <label class="form-label required">যোগাযোগ ফোন নম্বর</label>
      <input type="text" name="venue_phone" class="form-control" value="<%= settings.venue_phone %>" required />
    </div>

    <div class="col-12 mt-4">
      <button class="btn btn-primary btn-lg"><i class="bi bi-check-lg me-1"></i> সংরক্ষণ করুন</button>
    </div>
  </form>
</div></div>
