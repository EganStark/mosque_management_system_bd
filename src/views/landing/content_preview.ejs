<% const item=preview.item; const statusBn=item.publication_status==='published'?'প্রকাশিত':item.publication_status==='scheduled'?'নির্ধারিত':item.publication_status==='expired'?'মেয়াদ শেষ':'খসড়া'; const statusClass=item.publication_status==='published'?'text-bg-success':item.publication_status==='scheduled'?'text-bg-info':item.publication_status==='expired'?'text-bg-secondary':'text-bg-warning'; const image=item.image_path||item.photo; %>
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
  <div><p class="text-uppercase text-primary fw-bold small mb-1" data-bn="নিরাপদ প্রিভিউ" data-en="Secure preview">নিরাপদ প্রিভিউ</p><h3 class="mb-1" data-bn="প্রকাশের আগে যাচাই" data-en="Review before publishing">প্রকাশের আগে যাচাই</h3><p class="text-muted mb-0" data-bn="এই পেজটি শুধু অনুমোদিত অ্যাডমিন দেখতে পারবেন" data-en="Only authorized administrators can see this page">এই পেজটি শুধু অনুমোদিত অ্যাডমিন দেখতে পারবেন</p></div>
  <div class="d-flex flex-wrap gap-2"><form method="post" action="/landing/publishing/<%= preview.type %>/<%= item.id %>/duplicate"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><button class="btn btn-outline-success" data-bn="খসড়া কপি" data-en="Duplicate draft">খসড়া কপি</button></form><a href="<%= preview.editHref %>" class="btn btn-outline-secondary" data-bn="সম্পাদনা" data-en="Edit">সম্পাদনা</a><a href="/landing/publishing" class="btn btn-outline-primary" data-bn="প্রকাশনা তালিকা" data-en="Publishing queue">প্রকাশনা তালিকা</a></div>
</div>
<div class="alert alert-light border d-flex flex-wrap align-items-center gap-2"><span class="badge <%= statusClass %>"><%= statusBn %></span><span class="badge text-bg-light"><%= preview.typeLabel %></span><span class="text-muted small">ID #<%= item.id %></span><% if(item.scheduled_at){ %><span class="ms-md-auto text-info"><span data-bn="প্রকাশ হবে:" data-en="Publishes:">প্রকাশ হবে:</span> <%= bn.date(item.scheduled_at) %></span><% } else if(item.expires_at){ %><span class="ms-md-auto text-warning"><span data-bn="মেয়াদ শেষ হবে:" data-en="Expires:">মেয়াদ শেষ হবে:</span> <%= bn.date(item.expires_at) %></span><% } %></div>
<% if(!preview.canPublish){ %><div class="alert alert-danger"><strong data-bn="প্রকাশের আগে সম্পূর্ণ করুন:" data-en="Complete before publishing:">প্রকাশের আগে সম্পূর্ণ করুন:</strong> <%= preview.issues.join(', ') %> <a href="<%= preview.editHref %>" class="alert-link ms-2" data-bn="এখন সম্পাদনা করুন" data-en="Edit now">এখন সম্পাদনা করুন</a></div><% } %>
<% if(item.review_status==='submitted'){ %><div class="alert alert-primary"><strong data-bn="পর্যালোচনার অপেক্ষায়" data-en="Awaiting review">পর্যালোচনার অপেক্ষায়</strong><span class="d-block" data-bn="কনটেন্টটি একজন অনুমোদিত প্রকাশকের সিদ্ধান্তের অপেক্ষায় আছে।" data-en="This content is waiting for an authorized publisher's decision.">কনটেন্টটি একজন অনুমোদিত প্রকাশকের সিদ্ধান্তের অপেক্ষায় আছে।</span></div><% } else if(item.review_status==='changes_requested'){ %><div class="alert alert-warning"><strong data-bn="পরিবর্তন চাওয়া হয়েছে" data-en="Changes requested">পরিবর্তন চাওয়া হয়েছে</strong><span class="d-block"><%= item.review_notes %></span></div><% } %>

<div class="card overflow-hidden mb-4">
  <% if(image){ %><div class="bg-dark text-center"><img src="<%= image %>" alt="" style="width:100%;max-height:420px;object-fit:cover"/></div><% } %>
  <div class="card-body p-4 p-lg-5">
    <% if(preview.type==='events'){ %><p class="text-primary fw-semibold mb-2"><%= item.category %> · <%= bn.date(item.event_date) %> · <%= item.event_time %></p><h2><%= item.title_bn %></h2><p class="lead"><%= item.description_bn || '—' %></p><p class="text-muted"><span class="material-symbols-outlined align-middle">location_on</span> <%= item.location %></p><hr/><h3><%= item.title_en %></h3><p><%= item.description_en || '—' %></p>
    <% } else if(preview.type==='staff'){ %><h2><%= item.name_bn %></h2><p class="text-primary fw-semibold"><%= item.position_bn %></p><p><%= item.bio_bn || '—' %></p><p class="text-muted"><%= item.phone || '' %><%= item.phone&&item.email?' · ':'' %><%= item.email || '' %></p><hr/><h3><%= item.name_en %></h3><p class="text-primary"><%= item.position_en %></p><p><%= item.bio_en || '—' %></p>
    <% } else if(preview.type==='announcements'){ %><p class="text-primary fw-semibold"><%= item.category %> · <%= bn.date(item.publish_date) %></p><h2><%= item.title_bn %></h2><p class="lead"><%= item.content_bn || '—' %></p><hr/><h3><%= item.title_en %></h3><p><%= item.content_en || '—' %></p>
    <% } else if(preview.type==='gallery'){ %><p class="text-primary fw-semibold"><%= item.category %></p><h2><%= item.title_bn %></h2><hr/><h3><%= item.title_en %></h3>
    <% } else if(preview.type==='faq'){ %><p class="text-uppercase text-primary fw-semibold">FAQ</p><h2><%= item.question_bn %></h2><p class="lead"><%= item.answer_bn %></p><hr/><h3><%= item.question_en %></h3><p><%= item.answer_en %></p>
    <% } else if(preview.type==='janaza'){ %><p class="text-primary fw-semibold"><%= bn.date(item.janaza_date) %> · <%= item.janaza_time %></p><h2><%= item.deceased_name_bn %></h2><p><%= item.location_bn %></p><p class="lead"><%= item.message_bn || '—' %></p><hr/><h3><%= item.deceased_name_en %></h3><p><%= item.location_en %></p><p><%= item.message_en || '—' %></p><% } %>
  </div>
</div>
<div class="d-flex flex-wrap justify-content-end gap-2 mb-4"><% if(navCapabilities.websitePublish && item.publication_status!=='draft'){ %><form method="post" action="/landing/publishing/<%= preview.type %>/<%= item.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><input type="hidden" name="status" value="draft"/><button class="btn btn-outline-warning" data-bn="খসড়ায় ফেরত নিন" data-en="Return to draft">খসড়ায় ফেরত নিন</button></form><% } %><% if(navCapabilities.websitePublish && item.publication_status!=='published'){ %><form method="post" action="/landing/publishing/<%= preview.type %>/<%= item.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><input type="hidden" name="status" value="published"/><button class="btn btn-success" <%= preview.canPublish?'':'disabled' %> data-bn="এখনই প্রকাশ করুন" data-en="Publish now">এখনই প্রকাশ করুন</button></form><% } %></div>
<% if(item.publication_status==='draft' && item.review_status!=='submitted'){ %><div class="card mb-4"><div class="card-body d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3"><div><strong data-bn="প্রকাশকের অনুমোদন নিন" data-en="Request publisher approval">প্রকাশকের অনুমোদন নিন</strong><small class="d-block text-muted" data-bn="সম্পাদনা শেষ হলে কনটেন্টটি পর্যালোচনার জন্য পাঠান।" data-en="When editing is complete, submit this content for review.">সম্পাদনা শেষ হলে কনটেন্টটি পর্যালোচনার জন্য পাঠান।</small></div><form method="post" action="/landing/publishing/<%= preview.type %>/<%= item.id %>/review"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><button class="btn btn-primary" <%= preview.canPublish?'':'disabled' %> data-bn="পর্যালোচনার জন্য পাঠান" data-en="Submit for review">পর্যালোচনার জন্য পাঠান</button></form></div></div><% } %>
<% if(item.review_status==='submitted' && navCapabilities.websitePublish){ %><div class="card border-warning mb-4"><div class="card-body"><form method="post" action="/landing/publishing/<%= preview.type %>/<%= item.id %>/changes" class="row g-3 align-items-end"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><div class="col-md-9"><label class="form-label" data-bn="পরিবর্তনের নির্দেশনা" data-en="Change request notes">পরিবর্তনের নির্দেশনা</label><textarea name="notes" class="form-control" rows="2" minlength="3" required></textarea></div><div class="col-md-3"><button class="btn btn-outline-warning w-100" data-bn="পরিবর্তন চান" data-en="Request changes">পরিবর্তন চান</button></div></form></div></div><% } %>
<% if(item.publication_status==='published' && navCapabilities.websitePublish){ %><div class="card mb-4"><div class="card-body"><form method="post" action="/landing/publishing/<%= preview.type %>/<%= item.id %>/expiry" class="row g-3 align-items-end"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><div class="col-md-9"><label class="form-label" data-bn="স্বয়ংক্রিয়ভাবে সরানোর সময়" data-en="Automatic unpublish time">স্বয়ংক্রিয়ভাবে সরানোর সময়</label><input type="datetime-local" name="expires_at" class="form-control" required/></div><div class="col-md-3"><button class="btn btn-outline-secondary w-100" data-bn="মেয়াদ নির্ধারণ" data-en="Set expiration">মেয়াদ নির্ধারণ</button></div></form></div></div><% } %>
