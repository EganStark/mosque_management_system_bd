<%
  const published = rows.filter((item) => item.publication_status === 'published' && item.is_active).length;
  const drafts = rows.filter((item) => item.publication_status === 'draft').length;
  const localUploads = rows.filter((item) => String(item.image_path || '').startsWith('/uploads/')).length;
%>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
  <div>
    <p class="text-uppercase text-primary fw-bold small mb-1" data-bn="ওয়েবসাইট কনটেন্ট" data-en="Website content">ওয়েবসাইট কনটেন্ট</p>
    <h3 class="mb-1" data-bn="গ্যালারি ব্যবস্থাপনা" data-en="Gallery management">গ্যালারি ব্যবস্থাপনা</h3>
    <p class="text-muted mb-0" data-bn="ছবি প্রকাশ, সাজানো এবং হালনাগাদ করুন" data-en="Publish, arrange, and update mosque photos">ছবি প্রকাশ, সাজানো এবং হালনাগাদ করুন</p>
  </div>
  <div class="d-flex flex-wrap gap-2">
    <a href="/landing" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i><span data-bn="ল্যান্ডিং ড্যাশবোর্ড" data-en="Landing dashboard">ল্যান্ডিং ড্যাশবোর্ড</span></a>
    <a href="/landing/gallery/new" class="btn btn-primary"><i class="bi bi-image-fill me-1"></i><span data-bn="নতুন ছবি" data-en="Add photo">নতুন ছবি</span></a>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-6 col-lg-3"><div class="card h-100 border-0 shadow-sm"><div class="card-body">
    <small class="text-muted" data-bn="মোট ছবি" data-en="Total photos">মোট ছবি</small>
    <div class="fs-3 fw-bold mt-1"><%= bn.toBnDigits(rows.length) %></div>
  </div></div></div>
  <div class="col-6 col-lg-3"><div class="card h-100 border-0 shadow-sm"><div class="card-body">
    <small class="text-muted" data-bn="প্রকাশিত" data-en="Published">প্রকাশিত</small>
    <div class="fs-3 fw-bold text-success mt-1"><%= bn.toBnDigits(published) %></div>
  </div></div></div>
  <div class="col-6 col-lg-3"><div class="card h-100 border-0 shadow-sm"><div class="card-body">
    <small class="text-muted" data-bn="খসড়া" data-en="Drafts">খসড়া</small>
    <div class="fs-3 fw-bold text-warning mt-1"><%= bn.toBnDigits(drafts) %></div>
  </div></div></div>
  <div class="col-6 col-lg-3"><div class="card h-100 border-0 shadow-sm"><div class="card-body">
    <small class="text-muted" data-bn="নিজস্ব আপলোড" data-en="Local uploads">নিজস্ব আপলোড</small>
    <div class="fs-3 fw-bold text-primary mt-1"><%= bn.toBnDigits(localUploads) %></div>
  </div></div></div>
</div>

<div class="card shadow-sm">
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-hover align-middle datatable w-100">
        <thead>
          <tr>
            <th data-bn="ক্রম" data-en="No.">ক্রম</th>
            <th data-bn="ছবি" data-en="Photo">ছবি</th>
            <th data-bn="শিরোনাম" data-en="Title">শিরোনাম</th>
            <th data-bn="বিভাগ" data-en="Category">বিভাগ</th>
            <th data-bn="প্রদর্শন ক্রম" data-en="Display order">প্রদর্শন ক্রম</th>
            <th data-bn="উৎস" data-en="Source">উৎস</th>
            <th data-bn="অবস্থা" data-en="Status">অবস্থা</th>
            <th class="no-print" data-bn="কার্যক্রম" data-en="Actions">কার্যক্রম</th>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach(function(img, i) { %>
          <tr>
            <td><%= bn.toBnDigits(i + 1) %></td>
            <td>
              <div class="position-relative border rounded overflow-hidden bg-light d-flex align-items-center justify-content-center" style="width:76px;height:54px">
                <img src="<%= img.image_path %>" alt="<%= img.title_bn %>" style="width:100%;height:100%;object-fit:cover" onerror="this.classList.add('d-none');this.nextElementSibling.classList.remove('d-none')" />
                <span class="material-symbols-outlined text-muted d-none">broken_image</span>
              </div>
            </td>
            <td>
              <strong class="d-block"><%= img.title_bn %></strong>
              <small class="text-muted"><%= img.title_en %></small>
            </td>
            <td><span class="badge bg-primary-subtle text-primary-emphasis"><%= img.category %></span></td>
            <td><%= bn.toBnDigits(img.sort_order) %></td>
            <td>
              <% if (String(img.image_path || '').startsWith('/uploads/')) { %>
                <span class="badge bg-success-subtle text-success-emphasis" data-bn="আপলোড" data-en="Upload">আপলোড</span>
              <% } else { %>
                <span class="badge bg-secondary-subtle text-secondary-emphasis" data-bn="বাহ্যিক লিংক" data-en="External URL">বাহ্যিক লিংক</span>
              <% } %>
            </td>
            <td>
              <% if (img.publication_status === 'published' && img.is_active) { %>
                <span class="badge bg-success" data-bn="প্রকাশিত" data-en="Published">প্রকাশিত</span>
              <% } else if (img.publication_status === 'draft') { %>
                <span class="badge bg-warning text-dark" data-bn="খসড়া" data-en="Draft">খসড়া</span>
              <% } else { %>
                <span class="badge bg-secondary" data-bn="নিষ্ক্রিয়" data-en="Inactive">নিষ্ক্রিয়</span>
              <% } %>
            </td>
            <td class="no-print text-nowrap">
              <form method="post" action="/landing/gallery/<%= img.id %>/move" class="d-inline">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <button name="direction" value="up" class="btn btn-sm btn-outline-secondary" title="Move up" <%= i === 0 ? 'disabled' : '' %>><i class="bi bi-arrow-up"></i></button>
                <button name="direction" value="down" class="btn btn-sm btn-outline-secondary" title="Move down" <%= i === rows.length - 1 ? 'disabled' : '' %>><i class="bi bi-arrow-down"></i></button>
              </form>
              <a href="/landing/gallery/<%= img.id %>/edit" class="btn btn-sm btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
              <form method="post" action="/landing/gallery/<%= img.id %>/delete" class="d-inline confirm-delete">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <button class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
              </form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
