<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
  <div><p class="text-uppercase text-primary fw-bold small mb-1" data-bn="প্রকাশনা নিরীক্ষা" data-en="Publishing audit">প্রকাশনা নিরীক্ষা</p><h3 class="mb-1" data-bn="কনটেন্ট প্রকাশনার ইতিহাস" data-en="Content publishing history">কনটেন্ট প্রকাশনার ইতিহাস</h3><p class="text-muted mb-0" data-bn="প্রকাশ, পর্যালোচনা, পরিবর্তন ও পুনরুদ্ধারের সম্পূর্ণ রেকর্ড" data-en="A complete record of publishing, reviews, changes and restorations">প্রকাশ, পর্যালোচনা, পরিবর্তন ও পুনরুদ্ধারের সম্পূর্ণ রেকর্ড</p></div>
  <div class="d-flex gap-2"><a href="<%= exportHref %>" class="btn btn-outline-success"><span class="material-symbols-outlined align-middle" style="font-size:18px">download</span> CSV</a><a href="/landing/publishing" class="btn btn-outline-primary" data-bn="প্রকাশনা তালিকা" data-en="Publishing queue">প্রকাশনা তালিকা</a></div>
</div>

<div class="card mb-4"><div class="card-body"><form method="get" class="row g-3 align-items-end">
  <div class="col-lg-5"><label class="form-label" data-bn="শিরোনাম খুঁজুন" data-en="Search title">শিরোনাম খুঁজুন</label><div class="input-group"><span class="input-group-text"><span class="material-symbols-outlined">search</span></span><input name="q" value="<%= filters.q %>" class="form-control"/></div></div>
  <div class="col-md-3"><label class="form-label" data-bn="কনটেন্টের ধরন" data-en="Content type">কনটেন্টের ধরন</label><select name="type" class="form-select"><option value="" data-bn="সব ধরন" data-en="All types">সব ধরন</option><% types.forEach(function(type){ %><option value="<%= type.value %>" <%= filters.type===type.value?'selected':'' %> data-bn="<%= type.label %>" data-en="<%= type.labelEn %>"><%= type.label %></option><% }) %></select></div>
  <div class="col-md-3"><label class="form-label" data-bn="কার্যক্রম" data-en="Action">কার্যক্রম</label><select name="action" class="form-select"><option value="" data-bn="সব কার্যক্রম" data-en="All actions">সব কার্যক্রম</option><option value="status_change" <%= filters.action==='status_change'?'selected':'' %> data-bn="অবস্থা পরিবর্তন" data-en="Status change">অবস্থা পরিবর্তন</option><option value="review_requested" <%= filters.action==='review_requested'?'selected':'' %> data-bn="পর্যালোচনা অনুরোধ" data-en="Review requested">পর্যালোচনা অনুরোধ</option><option value="changes_requested" <%= filters.action==='changes_requested'?'selected':'' %> data-bn="পরিবর্তন অনুরোধ" data-en="Changes requested">পরিবর্তন অনুরোধ</option><option value="duplicated" <%= filters.action==='duplicated'?'selected':'' %> data-bn="খসড়া কপি" data-en="Duplicated">খসড়া কপি</option><option value="expiry_scheduled" <%= filters.action==='expiry_scheduled'?'selected':'' %> data-bn="মেয়াদ নির্ধারণ" data-en="Expiry scheduled">মেয়াদ নির্ধারণ</option><option value="automatic_publish" <%= filters.action==='automatic_publish'?'selected':'' %> data-bn="স্বয়ংক্রিয় প্রকাশ" data-en="Automatic publish">স্বয়ংক্রিয় প্রকাশ</option><option value="automatic_unpublish" <%= filters.action==='automatic_unpublish'?'selected':'' %> data-bn="স্বয়ংক্রিয় অপসারণ" data-en="Automatic unpublish">স্বয়ংক্রিয় অপসারণ</option><option value="restore" <%= filters.action==='restore'?'selected':'' %> data-bn="পুনরুদ্ধার" data-en="Restore">পুনরুদ্ধার</option></select></div>
  <div class="col-md-1 d-flex gap-2"><button class="btn btn-primary"><span class="material-symbols-outlined">filter_alt</span></button><a href="/landing/publishing/history" class="btn btn-outline-secondary"><span class="material-symbols-outlined">restart_alt</span></a></div>
</form></div></div>

<div class="card"><div class="card-header d-flex justify-content-between align-items-center"><span data-bn="সাম্প্রতিক কার্যক্রম" data-en="Recent activity">সাম্প্রতিক কার্যক্রম</span><span class="badge bg-primary"><%= bn.num(events.length) %></span></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th data-bn="সময়" data-en="Time">সময়</th><th data-bn="কনটেন্ট" data-en="Content">কনটেন্ট</th><th data-bn="ধরন" data-en="Type">ধরন</th><th data-bn="কার্যক্রম" data-en="Action">কার্যক্রম</th><th data-bn="ব্যবহারকারী" data-en="User">ব্যবহারকারী</th><th></th></tr></thead><tbody>
  <% events.forEach(function(event){ var actionLabel={status_change:'অবস্থা পরিবর্তন',automatic_publish:'স্বয়ংক্রিয় প্রকাশ',automatic_unpublish:'স্বয়ংক্রিয় অপসারণ',expiry_scheduled:'মেয়াদ নির্ধারণ',review_requested:'পর্যালোচনায় পাঠানো',changes_requested:'পরিবর্তন চাওয়া',duplicated:'খসড়া কপি',restore:'পুনরুদ্ধার'}[event.action]||event.action; var actionClass=event.action==='changes_requested'?'text-bg-warning':event.action==='review_requested'?'text-bg-primary':event.action==='duplicated'?'text-bg-success':event.action==='automatic_publish'?'text-bg-info':event.action==='automatic_unpublish'?'text-bg-secondary':event.action==='expiry_scheduled'?'text-bg-warning':event.action==='restore'?'text-bg-secondary':'text-bg-light'; %>
    <tr><td class="text-nowrap"><%= bn.date(event.created_at) %></td><td><strong><%= event.content_title %></strong><small class="d-block text-muted">#<%= event.content_id %></small><% if(event.action==='changes_requested' && event.snapshot && event.snapshot.review_notes){ %><small class="d-block text-warning mt-1"><%= event.snapshot.review_notes %></small><% } %></td><td><span class="badge text-bg-light"><%= event.typeLabel %></span></td><td><span class="badge <%= actionClass %>"><%= actionLabel %></span><small class="d-block mt-1"><%= event.previous_status || '—' %> → <%= event.new_status %></small></td><td><%= event.actor_name || event.actor_username || 'System' %></td><td class="text-end"><div class="d-flex justify-content-end gap-2"><a href="/landing/publishing/history/<%= event.id %>" class="btn btn-sm btn-outline-dark" data-bn="পরিবর্তন" data-en="Changes">পরিবর্তন</a><% if(event.editHref){ %><a href="<%= event.editHref %>" class="btn btn-sm btn-outline-secondary" data-bn="কনটেন্ট" data-en="Content">কনটেন্ট</a><% } %><% if(event.snapshot && navCapabilities.websitePublish){ %><form method="post" action="/landing/publishing/history/<%= event.id %>/restore" data-confirm="এই সংস্করণটি খসড়া হিসেবে পুনরুদ্ধার করবেন?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><button class="btn btn-sm btn-outline-primary" data-bn="ফিরিয়ে আনুন" data-en="Restore">ফিরিয়ে আনুন</button></form><% } %></div></td></tr>
  <% }) %>
  <% if(!events.length){ %><tr><td colspan="6" class="text-center text-muted py-5" data-bn="এই ফিল্টারে কোনো কার্যক্রম পাওয়া যায়নি" data-en="No activity matches these filters">এই ফিল্টারে কোনো কার্যক্রম পাওয়া যায়নি</td></tr><% } %>
</tbody></table></div></div>
