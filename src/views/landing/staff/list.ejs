<div class="d-flex justify-content-between align-items-center mb-3">
  <h3 class="mb-0">ল্যান্ডিং পেজ স্টাফ সদস্যবৃন্দ</h3>
  <div>
    <a href="/landing" class="btn btn-outline-secondary me-2"><i class="bi bi-arrow-left me-1"></i> ফিরে যান</a>
    <a href="/landing/staff/new" class="btn btn-primary"><i class="bi bi-person-plus-fill me-1"></i> নতুন স্টাফ সদস্য</a>
  </div>
</div>

<div class="card shadow-sm"><div class="card-body">
  <div class="table-responsive">
    <table class="table table-striped table-hover datatable w-100">
      <thead>
        <tr>
          <th>ক্রমিক</th>
          <th>ছবি</th>
          <th>নাম (বাংলা)</th>
          <th>নাম (ইংরেজি)</th>
          <th>পদবী (বাংলা)</th>
          <th>পদবী (ইংরেজি)</th>
          <th>ক্রম নং</th>
          <th>স্ট্যাটাস</th>
          <th class="no-print">অ্যাকশন</th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(function(m, i) { %>
        <tr>
          <td><%= bn.toBnDigits(i + 1) %></td>
          <td>
            <img class="rounded-circle border" src="<%= m.photo || '/static/img/avatar.png' %>" alt="" style="width:40px; height:40px; object-fit:cover;" onerror="this.src='/static/img/avatar.png'" />
          </td>
          <td><strong><%= m.name_bn %></strong></td>
          <td><%= m.name_en %></td>
          <td><%= m.position_bn %></td>
          <td><%= m.position_en %></td>
          <td><%= bn.toBnDigits(m.sort_order) %></td>
          <td>
            <% if (m.is_active) { %>
            <span class="badge bg-success">সক্রিয়</span>
            <% } else { %>
            <span class="badge bg-secondary">নিষ্ক্রিয়</span>
            <% } %>
          </td>
          <td class="no-print">
            <a href="/landing/staff/<%= m.id %>/edit" class="btn btn-sm btn-outline-primary" title="সম্পাদনা"><i class="bi bi-pencil"></i></a>
            <form method="post" action="/landing/staff/<%= m.id %>/delete" class="d-inline confirm-delete">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <button class="btn btn-sm btn-outline-danger" title="মুছুন"><i class="bi bi-trash"></i></button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div></div>
