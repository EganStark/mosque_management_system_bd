<div class="d-flex justify-content-between align-items-center mb-3">
  <h3 class="mb-0">জানাযা নোটিশসমূহ</h3>
  <div>
    <a href="/landing" class="btn btn-outline-secondary me-2"><i class="bi bi-arrow-left me-1"></i> ফিরে যান</a>
    <a href="/landing/janaza/new" class="btn btn-primary"><i class="bi bi-heart-fill me-1"></i> নতুন জানাযা নোটিশ</a>
  </div>
</div>

<div class="card shadow-sm"><div class="card-body">
  <div class="table-responsive">
    <table class="table table-striped table-hover datatable w-100">
      <thead>
        <tr>
          <th>ক্রমিক</th>
          <th>মরহুমের নাম (বাংলা)</th>
          <th>মরহুমের নাম (ইংরেজি)</th>
          <th>তারিখ</th>
          <th>সময়</th>
          <th>স্থান (বাংলা)</th>
          <th>স্ট্যাটাস</th>
          <th class="no-print">অ্যাকশন</th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(function(n, i) { %>
        <tr>
          <td><%= bn.toBnDigits(i + 1) %></td>
          <td><strong><%= n.deceased_name_bn %></strong></td>
          <td><%= n.deceased_name_en %></td>
          <td><%= bn.date(n.janaza_date) %></td>
          <td><%= n.janaza_time %></td>
          <td><%= n.location_bn %></td>
          <td>
            <% if (n.is_active) { %>
            <span class="badge bg-success">সক্রিয়</span>
            <% } else { %>
            <span class="badge bg-secondary">নিষ্ক্রিয়</span>
            <% } %>
          </td>
          <td class="no-print">
            <a href="/landing/janaza/<%= n.id %>/edit" class="btn btn-sm btn-outline-primary" title="সম্পাদনা"><i class="bi bi-pencil"></i></a>
            <form method="post" action="/landing/janaza/<%= n.id %>/delete" class="d-inline confirm-delete">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <button class="btn btn-sm btn-outline-danger" title="মুছুন"><i class="bi bi-trash"></i></button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div></div>
