<%
  const isEdit = notice !== null;
  const action = isEdit ? `/landing/janaza/${notice.id}/edit` : '/landing/janaza/new';
%>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h3 class="mb-0"><%= title %></h3>
  <a href="/landing/janaza" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> ফিরে যান</a>
</div>

<div class="card shadow-sm"><div class="card-body">
  <form method="post" action="<%= action %>?_csrf=<%= encodeURIComponent(csrfToken) %>" class="row g-3">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

    <div class="col-md-6">
      <label class="form-label required">মরহুম/মরহুমার নাম (বাংলা)</label>
      <input type="text" name="deceased_name_bn" class="form-control" value="<%= isEdit ? notice.deceased_name_bn : '' %>" required />
    </div>

    <div class="col-md-6">
      <label class="form-label required">মরহুম/মরহুমার নাম (ইংরেজি)</label>
      <input type="text" name="deceased_name_en" class="form-control" value="<%= isEdit ? notice.deceased_name_en : '' %>" required />
    </div>

    <div class="col-md-6 col-sm-12">
      <label class="form-label required">জানাযার তারিখ</label>
      <input type="date" name="janaza_date" class="form-control" value="<%= isEdit && notice.janaza_date ? String(notice.janaza_date).slice(0, 10) : '' %>" required />
    </div>

    <div class="col-md-6 col-sm-12">
      <label class="form-label required">জানাযার সময় (যেমন: বাদ যোহর বা বিকাল ৪:০০)</label>
      <input type="text" name="janaza_time" class="form-control" value="<%= isEdit ? notice.janaza_time : '' %>" required />
    </div>

    <div class="col-md-6">
      <label class="form-label required">জানাযার স্থান (বাংলা)</label>
      <input type="text" name="location_bn" class="form-control" value="<%= isEdit ? notice.location_bn : 'মসজিদ প্রাঙ্গণ' %>" required />
    </div>

    <div class="col-md-6">
      <label class="form-label required">জানাযার স্থান (ইংরেজি)</label>
      <input type="text" name="location_en" class="form-control" value="<%= isEdit ? notice.location_en : 'Mosque Prayer Hall' %>" required />
    </div>

    <div class="col-md-6">
      <label class="form-label">শোক বার্তা/অন্যান্য তথ্য (বাংলা)</label>
      <textarea name="message_bn" class="form-control" rows="3"><%= isEdit ? notice.message_bn : '' %></textarea>
    </div>

    <div class="col-md-6">
      <label class="form-label">শোক বার্তা/অন্যান্য তথ্য (ইংরেজি)</label>
      <textarea name="message_en" class="form-control" rows="3"><%= isEdit ? notice.message_en : '' %></textarea>
    </div>

    <div class="col-12">
      <div class="form-check form-switch mt-2">
        <input class="form-check-input" type="checkbox" name="is_active" id="isActiveSwitch" value="true" <%= !isEdit || notice.is_active ? 'checked' : '' %>>
        <label class="form-check-label font-weight-bold" for="isActiveSwitch">সক্রিয় রাখুন (ল্যান্ডিং পেজে প্রদর্শন করার জন্য)</label>
      </div>
    </div>

    <div class="col-12 mt-4">
      <button class="btn btn-primary"><i class="bi bi-check-lg me-1"></i> সংরক্ষণ করুন</button>
    </div>
  </form>
</div></div>
