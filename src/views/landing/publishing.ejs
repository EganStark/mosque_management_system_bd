<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
  <div>
    <p class="text-uppercase text-primary fw-bold small mb-1" data-bn="প্রকাশনা কর্মপ্রবাহ" data-en="Publishing workflow">প্রকাশনা কর্মপ্রবাহ</p>
    <h3 class="mb-1" data-bn="সম্পাদনা, পর্যালোচনা ও প্রকাশ" data-en="Edit, review and publish">সম্পাদনা, পর্যালোচনা ও প্রকাশ</h3>
    <p class="text-muted mb-0" data-bn="পাবলিক ওয়েবসাইটে কী এবং কখন দেখা যাবে তা নিয়ন্ত্রণ করুন" data-en="Control what appears on the public website and when">পাবলিক ওয়েবসাইটে কী এবং কখন দেখা যাবে তা নিয়ন্ত্রণ করুন</p>
  </div>
  <div class="d-flex flex-wrap gap-2">
    <a href="/landing/archive" class="btn btn-outline-danger"><span class="material-symbols-outlined align-middle" style="font-size:18px">archive</span> <span data-bn="আর্কাইভ" data-en="Archive">আর্কাইভ</span></a>
    <a href="<%= publishing.exportHref %>" class="btn btn-outline-success"><span class="material-symbols-outlined align-middle" style="font-size:18px">download</span> CSV</a>
    <a href="/landing/publishing/history" class="btn btn-outline-primary" data-bn="প্রকাশনার ইতিহাস" data-en="Publishing history">প্রকাশনার ইতিহাস</a>
    <a href="/landing" class="btn btn-outline-secondary">CMS ড্যাশবোর্ড</a>
    <a href="<%= landingPageUrl %>" target="_blank" rel="noopener" class="btn btn-primary"><span class="material-symbols-outlined align-middle" style="font-size:18px">visibility</span> <span data-bn="লাইভ সাইট" data-en="Live site">লাইভ সাইট</span></a>
  </div>
</div>

<% if(!navCapabilities.websitePublish){ %>
  <div class="alert alert-info d-flex gap-2"><span class="material-symbols-outlined">rate_review</span><div><strong data-bn="সম্পাদক মোড" data-en="Editor mode">সম্পাদক মোড</strong><span class="d-block" data-bn="আপনি খসড়া তৈরি, সম্পাদনা ও পর্যালোচনার জন্য পাঠাতে পারবেন। চূড়ান্ত প্রকাশ একজন অনুমোদিত প্রকাশক করবেন।" data-en="You can create, edit and submit drafts for review. An authorized publisher performs final publishing.">আপনি খসড়া তৈরি, সম্পাদনা ও পর্যালোচনার জন্য পাঠাতে পারবেন। চূড়ান্ত প্রকাশ একজন অনুমোদিত প্রকাশক করবেন।</span></div></div>
<% } %>

<div class="grid grid-cols-2 lg:grid-cols-8 gap-3 mb-4">
  <% [['মোট','Total',publishing.summary.total,''],['প্রকাশিত','Published',publishing.summary.published,'text-success'],['পর্যালোচনা','In review',publishing.summary.review,'text-primary'],['নির্ধারিত','Scheduled',publishing.summary.scheduled,'text-info'],['মেয়াদ শেষ','Expired',publishing.summary.expired,'text-secondary'],['খসড়া','Drafts',publishing.summary.drafts,'text-warning'],['অসম্পূর্ণ','Incomplete',publishing.summary.incomplete,'text-danger'],['নিষ্ক্রিয়','Inactive',publishing.summary.inactive,'text-muted']].forEach(function(x){ %>
    <div class="card"><div class="card-body"><small class="text-muted" data-bn="<%= x[0] %>" data-en="<%= x[1] %>"><%= x[0] %></small><h3 class="mb-0 <%= x[3] %>"><%= bn.num(x[2]) %></h3></div></div>
  <% }) %>
</div>

<div class="card mb-4"><div class="card-body">
  <form method="get" action="/landing/publishing" class="row g-3 align-items-end">
    <div class="col-lg-4"><label class="form-label" data-bn="কনটেন্ট খুঁজুন" data-en="Search content">কনটেন্ট খুঁজুন</label><div class="input-group"><span class="input-group-text"><span class="material-symbols-outlined">search</span></span><input name="q" value="<%= publishing.filters.q %>" class="form-control" placeholder="শিরোনাম / Title"/></div></div>
    <div class="col-sm-6 col-lg-3"><label class="form-label" data-bn="কনটেন্টের ধরন" data-en="Content type">কনটেন্টের ধরন</label><select name="type" class="form-select"><option value="" data-bn="সব ধরন" data-en="All types">সব ধরন</option><% publishing.types.forEach(function(type){ %><option value="<%= type.value %>" <%= publishing.filters.type===type.value?'selected':'' %> data-bn="<%= type.label %>" data-en="<%= type.labelEn %>"><%= type.label %></option><% }) %></select></div>
    <div class="col-sm-6 col-lg-2"><label class="form-label" data-bn="অবস্থা" data-en="Status">অবস্থা</label><select name="status" class="form-select"><option value="" data-bn="সব অবস্থা" data-en="All statuses">সব অবস্থা</option><option value="draft" <%= publishing.filters.status==='draft'?'selected':'' %> data-bn="খসড়া" data-en="Draft">খসড়া</option><option value="review" <%= publishing.filters.status==='review'?'selected':'' %> data-bn="পর্যালোচনা" data-en="In review">পর্যালোচনা</option><option value="scheduled" <%= publishing.filters.status==='scheduled'?'selected':'' %> data-bn="নির্ধারিত" data-en="Scheduled">নির্ধারিত</option><option value="published" <%= publishing.filters.status==='published'?'selected':'' %> data-bn="প্রকাশিত" data-en="Published">প্রকাশিত</option><option value="expired" <%= publishing.filters.status==='expired'?'selected':'' %> data-bn="মেয়াদ শেষ" data-en="Expired">মেয়াদ শেষ</option><option value="incomplete" <%= publishing.filters.status==='incomplete'?'selected':'' %> data-bn="অসম্পূর্ণ" data-en="Incomplete">অসম্পূর্ণ</option><option value="inactive" <%= publishing.filters.status==='inactive'?'selected':'' %> data-bn="নিষ্ক্রিয়" data-en="Inactive">নিষ্ক্রিয়</option></select></div>
    <div class="col-sm-4 col-lg-1"><label class="form-label" data-bn="প্রতি পাতা" data-en="Per page">প্রতি পাতা</label><select name="per_page" class="form-select"><% [10,25,50,100].forEach(function(size){ %><option value="<%= size %>" <%= publishing.filters.per_page===size?'selected':'' %>><%= size %></option><% }) %></select></div>
    <div class="col-sm-8 col-lg-2 d-flex gap-2"><button class="btn btn-primary flex-grow-1" data-bn="ফিল্টার" data-en="Filter">ফিল্টার</button><a href="/landing/publishing" class="btn btn-outline-secondary" title="Reset"><span class="material-symbols-outlined">restart_alt</span></a></div>
  </form>
</div></div>

<% if(navCapabilities.websitePublish){ %>
  <form id="landingBulkForm" method="post" action="/landing/publishing/bulk" class="d-flex flex-wrap justify-content-end align-items-end gap-2 mb-3" data-bulk-form><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><div><label class="form-label small mb-1" data-bn="নির্বাচিত কনটেন্ট" data-en="Selected content">নির্বাচিত কনটেন্ট</label><select name="status" class="form-select form-select-sm" required><option value="" data-bn="কাজ বেছে নিন" data-en="Choose action">কাজ বেছে নিন</option><option value="published" data-bn="প্রকাশ করুন" data-en="Publish">প্রকাশ করুন</option><option value="draft" data-bn="খসড়ায় নিন" data-en="Move to draft">খসড়ায় নিন</option></select></div><button class="btn btn-sm btn-primary" data-bulk-submit disabled><span data-bn="প্রয়োগ করুন" data-en="Apply">প্রয়োগ করুন</span> (<span data-bulk-count>0</span>)</button></form>
<% } %>

<div class="card">
  <div class="card-header d-flex justify-content-between"><span data-bn="প্রকাশনা তালিকা" data-en="Publishing queue">প্রকাশনা তালিকা</span><span class="badge bg-primary"><%= bn.num(publishing.filteredCount) %> / <%= bn.num(publishing.summary.total) %></span></div>
  <div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><% if(navCapabilities.websitePublish){ %><th style="width:40px"><input class="form-check-input" type="checkbox" data-bulk-select-all aria-label="Select all"/></th><% } %><th data-bn="কনটেন্ট" data-en="Content">কনটেন্ট</th><th data-bn="ধরন" data-en="Type">ধরন</th><th data-bn="অবস্থা" data-en="Status">অবস্থা</th><th data-bn="সর্বশেষ পরিবর্তন" data-en="Last changed">সর্বশেষ পরিবর্তন</th><th class="text-end" data-bn="কাজ" data-en="Actions">কাজ</th></tr></thead><tbody>
    <% publishing.items.forEach(function(item){ var statusLabel=item.status==='published'?'প্রকাশিত':item.status==='scheduled'?'নির্ধারিত':item.status==='expired'?'মেয়াদ শেষ':'খসড়া'; var statusClass=item.status==='published'?'text-bg-success':item.status==='scheduled'?'text-bg-info':item.status==='expired'?'text-bg-secondary':'text-bg-warning'; %>
      <tr>
        <% if(navCapabilities.websitePublish){ %><td><input class="form-check-input" type="checkbox" name="selected[]" value="<%= item.type %>:<%= item.id %>" form="landingBulkForm" data-bulk-item aria-label="Select <%= item.title %>"/></td><% } %>
        <td><strong><%= item.title %></strong><% if(item.reviewStatus==='submitted'){ %><small class="d-block text-primary mt-1"><span class="material-symbols-outlined align-middle" style="font-size:16px">rate_review</span> <span data-bn="অনুমোদনের অপেক্ষায়" data-en="Awaiting approval">অনুমোদনের অপেক্ষায়</span></small><% } else if(item.reviewStatus==='changes_requested'){ %><small class="d-block text-warning mt-1"><span class="material-symbols-outlined align-middle" style="font-size:16px">edit_note</span> <%= item.reviewNotes %></small><% } %><% if(!item.canPublish){ %><small class="d-block text-danger mt-1"><span class="material-symbols-outlined align-middle" style="font-size:16px">warning</span> <%= item.issues.join(', ') %></small><% } %><% if(!item.isActive){ %><small class="d-block text-danger" data-bn="নিষ্ক্রিয়" data-en="Inactive">নিষ্ক্রিয়</small><% } %></td>
        <td><span class="badge text-bg-light"><%= item.typeLabel %></span></td>
        <td><span class="badge <%= statusClass %>"><%= statusLabel %></span><% if(item.reviewStatus==='submitted'){ %><span class="badge text-bg-primary ms-1" data-bn="পর্যালোচনা" data-en="Review">পর্যালোচনা</span><% } %><% if(item.scheduledAt){ %><small class="d-block text-info mt-1"><%= bn.date(item.scheduledAt) %></small><% } else if(item.expiresAt){ %><small class="d-block text-warning mt-1"><span data-bn="শেষ:" data-en="Expires:">শেষ:</span> <%= bn.date(item.expiresAt) %></small><% } else if(item.publishedAt){ %><small class="d-block text-muted mt-1"><%= bn.date(item.publishedAt) %></small><% } %></td>
        <td><%= bn.date(item.updatedAt) %></td>
        <td><div class="d-flex flex-wrap justify-content-end gap-2"><a href="/landing/publishing/<%= item.type %>/<%= item.id %>/preview" class="btn btn-sm btn-outline-primary" data-bn="প্রিভিউ" data-en="Preview">প্রিভিউ</a><a href="<%= item.editHref %>" class="btn btn-sm btn-outline-secondary" data-bn="সম্পাদনা" data-en="Edit">সম্পাদনা</a><% if(item.status==='draft' && item.reviewStatus!=='submitted' && item.canPublish){ %><form method="post" action="/landing/publishing/<%= item.type %>/<%= item.id %>/review"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><button class="btn btn-sm btn-primary" data-bn="পর্যালোচনায় পাঠান" data-en="Submit review">পর্যালোচনায় পাঠান</button></form><% } %><% if(navCapabilities.websitePublish && item.status!=='published'){ %><form method="post" action="/landing/publishing/<%= item.type %>/<%= item.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><input type="hidden" name="status" value="published"/><button class="btn btn-sm btn-success" <%= item.canPublish?'':'disabled' %> data-bn="এখনই প্রকাশ" data-en="Publish now">এখনই প্রকাশ</button></form><% } %><% if(navCapabilities.websitePublish && item.status!=='draft'){ %><form method="post" action="/landing/publishing/<%= item.type %>/<%= item.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><input type="hidden" name="status" value="draft"/><button class="btn btn-sm btn-outline-warning" data-bn="খসড়া করুন" data-en="Move to draft">খসড়া করুন</button></form><% } %></div><% if(navCapabilities.websitePublish){ %><form method="post" action="/landing/publishing/<%= item.type %>/<%= item.id %>" class="d-flex justify-content-end gap-2 mt-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><input type="hidden" name="status" value="scheduled"/><input type="datetime-local" name="scheduled_at" class="form-control form-control-sm" style="max-width:190px" required <%= item.canPublish?'':'disabled' %>/><button class="btn btn-sm btn-outline-info text-nowrap" <%= item.canPublish?'':'disabled' %> data-bn="সময় নির্ধারণ" data-en="Schedule">সময় নির্ধারণ</button></form><% } %></td>
      </tr>
    <% }) %>
    <% if(!publishing.items.length){ %><tr><td colspan="<%= navCapabilities.websitePublish?6:5 %>" class="text-center text-muted py-5" data-bn="কোনো কনটেন্ট পাওয়া যায়নি" data-en="No content found">কোনো কনটেন্ট পাওয়া যায়নি</td></tr><% } %>
  </tbody></table></div>
  <% if(publishing.filteredCount){ %><div class="card-footer d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2"><small class="text-muted"><span data-bn="দেখানো হচ্ছে" data-en="Showing">দেখানো হচ্ছে</span> <%= bn.num(publishing.pagination.from) %>–<%= bn.num(publishing.pagination.to) %> / <%= bn.num(publishing.filteredCount) %></small><nav aria-label="Publishing pages"><ul class="pagination pagination-sm mb-0"><li class="page-item <%= publishing.pagination.previousHref?'':'disabled' %>"><a class="page-link" href="<%= publishing.pagination.previousHref || '#' %>">‹</a></li><% publishing.pagination.links.forEach(function(link){ %><li class="page-item <%= link.active?'active':'' %>"><a class="page-link" href="<%= link.href %>"><%= bn.num(link.number) %></a></li><% }) %><li class="page-item <%= publishing.pagination.nextHref?'':'disabled' %>"><a class="page-link" href="<%= publishing.pagination.nextHref || '#' %>">›</a></li></ul></nav></div><% } %>
</div>
