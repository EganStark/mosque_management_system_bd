<div class="flex justify-between items-center mb-6">
  <div>
    <h3 class="font-headline-md text-xl md:text-2xl text-on-surface mb-1">ল্যান্ডিং পেজ এডমিন ড্যাশবোর্ড</h3>
    <p class="text-sm text-on-surface-variant mb-0">পাবলিক ল্যান্ডিং পেজের কনটেন্টসমূহ সরাসরি এখান থেকে আপডেট করুন।</p>
  </div>
  <div class="d-flex gap-2"><a href="/landing/publishing" class="flex items-center gap-2 bg-white border border-border-subtle text-primary hover:bg-moss-tint px-4 py-2 rounded-lg font-button text-sm shadow-sm transition-all text-decoration-none"><span class="material-symbols-outlined text-[18px]">publish</span><span data-bn="প্রকাশনা" data-en="Publishing">প্রকাশনা</span></a><a href="<%= landingPageUrl %>" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 bg-white border border-border-subtle text-primary hover:bg-moss-tint px-4 py-2 rounded-lg font-button text-sm shadow-sm transition-all text-decoration-none">
    <span class="material-symbols-outlined text-[18px]">open_in_new</span>
    ল্যান্ডিং পেজ দেখুন
  </a></div>
</div>

<section class="mb-6">
  <div class="d-flex justify-content-between align-items-end mb-3"><div><p class="text-uppercase text-primary fw-bold small mb-1" data-bn="আজকের কার্যক্রম" data-en="Today's operations">আজকের কার্যক্রম</p><h4 class="mb-0" data-bn="প্রকাশনা নিয়ন্ত্রণ কেন্দ্র" data-en="Publishing control center">প্রকাশনা নিয়ন্ত্রণ কেন্দ্র</h4></div><a href="/landing/publishing" class="btn btn-sm btn-outline-primary" data-bn="সব কনটেন্ট দেখুন" data-en="View all content">সব কনটেন্ট দেখুন</a></div>
  <div class="grid grid-cols-2 lg:grid-cols-5 gap-3 mb-4">
    <a href="/landing/publishing?status=draft" class="card text-decoration-none"><div class="card-body"><div class="d-flex justify-content-between"><small class="text-muted" data-bn="সম্পাদনার খসড়া" data-en="Editing drafts">সম্পাদনার খসড়া</small><span class="material-symbols-outlined text-warning">draft</span></div><strong class="d-block fs-3 text-warning"><%= bn.num(publishing.summary.drafts) %></strong></div></a>
    <a href="/landing/publishing?status=review" class="card text-decoration-none"><div class="card-body"><div class="d-flex justify-content-between"><small class="text-muted" data-bn="অনুমোদনের অপেক্ষায়" data-en="Awaiting approval">অনুমোদনের অপেক্ষায়</small><span class="material-symbols-outlined text-primary">rate_review</span></div><strong class="d-block fs-3 text-primary"><%= bn.num(publishing.summary.review) %></strong></div></a>
    <a href="/landing/publishing?status=incomplete" class="card text-decoration-none"><div class="card-body"><div class="d-flex justify-content-between"><small class="text-muted" data-bn="তথ্য অসম্পূর্ণ" data-en="Incomplete content">তথ্য অসম্পূর্ণ</small><span class="material-symbols-outlined text-danger">warning</span></div><strong class="d-block fs-3 text-danger"><%= bn.num(publishing.summary.incomplete) %></strong></div></a>
    <a href="/landing/publishing?status=scheduled" class="card text-decoration-none"><div class="card-body"><div class="d-flex justify-content-between"><small class="text-muted" data-bn="প্রকাশ নির্ধারিত" data-en="Scheduled">প্রকাশ নির্ধারিত</small><span class="material-symbols-outlined text-info">schedule_send</span></div><strong class="d-block fs-3 text-info"><%= bn.num(publishing.summary.scheduled) %></strong></div></a>
    <a href="/landing/publishing?status=published" class="card text-decoration-none"><div class="card-body"><div class="d-flex justify-content-between"><small class="text-muted" data-bn="লাইভ কনটেন্ট" data-en="Live content">লাইভ কনটেন্ট</small><span class="material-symbols-outlined text-success">public</span></div><strong class="d-block fs-3 text-success"><%= bn.num(publishing.summary.published) %></strong></div></a>
  </div>
  <div class="row g-4">
    <div class="col-lg-7"><div class="card h-100"><div class="card-header d-flex justify-content-between"><span data-bn="এখন যে কনটেন্টে কাজ প্রয়োজন" data-en="Content needing attention">এখন যে কনটেন্টে কাজ প্রয়োজন</span><span class="badge bg-warning text-dark"><%= bn.num(publishing.attention.length) %></span></div><div class="list-group list-group-flush"><% publishing.attention.forEach(function(item){ %><a href="/landing/publishing/<%= item.type %>/<%= item.id %>/preview" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center gap-3"><div><strong><%= item.title %></strong><small class="d-block text-muted"><%= item.typeLabel %> · <%= item.canPublish ? 'পর্যালোচনা প্রয়োজন' : item.issues.join(', ') %></small></div><span class="badge <%= item.canPublish?'text-bg-warning':'text-bg-danger' %>"><%= item.canPublish?'খসড়া':'অসম্পূর্ণ' %></span></a><% }) %><% if(!publishing.attention.length){ %><div class="text-center text-muted py-5" data-bn="কোনো অপেক্ষমাণ কাজ নেই" data-en="Nothing needs attention">কোনো অপেক্ষমাণ কাজ নেই</div><% } %></div></div></div>
    <div class="col-lg-5"><div class="card h-100"><div class="card-header d-flex justify-content-between"><span data-bn="সাম্প্রতিক প্রকাশনা কার্যক্রম" data-en="Recent publishing activity">সাম্প্রতিক প্রকাশনা কার্যক্রম</span><a href="/landing/publishing/history" class="small" data-bn="ইতিহাস" data-en="History">ইতিহাস</a></div><div class="list-group list-group-flush"><% publishing.recentActivity.forEach(function(event){ %><a href="<%= event.editHref || '/landing/publishing/history' %>" class="list-group-item list-group-item-action"><div class="d-flex justify-content-between gap-2"><strong class="text-truncate"><%= event.content_title %></strong><small class="text-muted text-nowrap"><%= bn.date(event.created_at) %></small></div><small class="text-muted"><%= event.typeLabel %> · <%= event.actor_name || event.actor_username || 'System' %> · <%= event.new_status %></small></a><% }) %><% if(!publishing.recentActivity.length){ %><div class="text-center text-muted py-5" data-bn="এখনও কোনো কার্যক্রম নেই" data-en="No activity yet">এখনও কোনো কার্যক্রম নেই</div><% } %></div></div></div>
  </div>
  <% if(publishing.scheduled.length){ %><div class="card mt-4"><div class="card-header" data-bn="পরবর্তী নির্ধারিত প্রকাশনা" data-en="Upcoming scheduled publications">পরবর্তী নির্ধারিত প্রকাশনা</div><div class="card-body d-flex flex-wrap gap-3"><% publishing.scheduled.forEach(function(item){ %><a href="/landing/publishing/<%= item.type %>/<%= item.id %>/preview" class="border rounded-3 p-3 text-decoration-none flex-grow-1"><small class="text-info"><%= bn.date(item.scheduledAt) %></small><strong class="d-block text-on-surface"><%= item.title %></strong><small class="text-muted"><%= item.typeLabel %></small></a><% }) %></div></div><% } %>
</section>

<section class="card mb-6 overflow-hidden"><div class="card-body p-0"><div class="landing-readiness-head p-5"><div><p class="text-uppercase fw-bold small mb-1 opacity-75" data-bn="প্রকাশের প্রস্তুতি" data-en="Publishing readiness">প্রকাশের প্রস্তুতি</p><h4 class="mb-1" data-bn="ল্যান্ডিং পেজ কনটেন্ট অডিট" data-en="Landing page content audit">ল্যান্ডিং পেজ কনটেন্ট অডিট</h4><p class="mb-0 small opacity-75" data-bn="বাংলা, ইংরেজি, ছবি ও সক্রিয় কনটেন্ট যাচাই" data-en="Checks Bengali, English, images and active content">বাংলা, ইংরেজি, ছবি ও সক্রিয় কনটেন্ট যাচাই</p></div><div class="landing-readiness-score"><strong><%= bn.num(readiness.score) %>%</strong><small data-bn="সম্পূর্ণ" data-en="complete">সম্পূর্ণ</small></div></div><div class="p-4"><div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-4"><div class="rounded-xl bg-moss-tint p-3"><small class="text-muted">সম্পূর্ণ বিভাগ</small><strong class="d-block text-primary fs-4"><%= bn.num(readiness.ready) %>/<%= bn.num(readiness.sections.length) %></strong></div><div class="rounded-xl bg-warning bg-opacity-10 p-3"><small class="text-muted">অসম্পূর্ণ রেকর্ড</small><strong class="d-block text-warning fs-4"><%= bn.num(readiness.incomplete) %></strong></div><div class="rounded-xl bg-secondary bg-opacity-10 p-3"><small class="text-muted">নিষ্ক্রিয় রেকর্ড</small><strong class="d-block fs-4"><%= bn.num(readiness.inactive) %></strong></div><div class="rounded-xl bg-light p-3"><small class="text-muted">সর্বশেষ যাচাই</small><strong class="d-block mt-1"><%= bn.date(new Date()) %></strong></div></div><div class="row g-3"><% readiness.sections.forEach(function(section){ %><div class="col-md-6 col-xl-3"><a href="<%= section.href %>" class="landing-audit-card text-decoration-none"><div class="d-flex justify-content-between gap-2"><strong class="text-on-surface"><%= section.name %></strong><span class="badge <%= section.score===100?'text-bg-success':section.score>=70?'text-bg-warning':'text-bg-danger' %>"><%= bn.num(section.score) %>%</span></div><div class="progress my-2" style="height:6px"><div class="progress-bar <%= section.score===100?'bg-success':section.score>=70?'bg-warning':'bg-danger' %>" style="width:<%= section.score %>%"></div></div><small class="text-muted"><%= bn.num(section.active) %> সক্রিয় · <%= bn.num(section.incomplete) %> অসম্পূর্ণ</small><% if(section.issues.length){ %><small class="d-block text-danger mt-2 text-truncate"><%= section.issues[0].label %>: <%= section.issues[0].missing.join(', ') %></small><% } %></a></div><% }) %></div></div></div></section>

<!-- Main Action Grid -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 mb-6">

  <!-- Prayer Times -->
  <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm hover:-translate-y-1 hover:shadow-md transition-all duration-200 group flex flex-col justify-between">
    <div>
      <div class="flex justify-between items-start mb-4">
        <div class="p-3 bg-moss-tint text-primary rounded-xl group-hover:bg-primary group-hover:text-white transition-colors flex items-center justify-center">
          <span class="material-symbols-outlined text-[28px]">schedule</span>
        </div>
        <span class="text-primary font-bold text-xs bg-moss-tint px-2 py-1 rounded-full">প্রতিদিন আপডেট</span>
      </div>
      <h4 class="font-headline-md text-base text-on-surface mb-1">নামাজের সময়সূচী</h4>
      <p class="text-xs text-on-surface-variant leading-relaxed mb-4">
        প্রতিদিনের নামাজের ওয়াক্ত, জামাত শুরুর সময় এবং হিজরি তারিখ নির্ধারণ করুন।
      </p>
    </div>
    <a href="/landing/prayer-times" class="w-full bg-primary hover:bg-forest-deep text-white text-center py-2.5 rounded-lg font-button text-xs transition-colors text-decoration-none block">
      সময়সূচী পরিবর্তন করুন
    </a>
  </div>

  <!-- Events -->
  <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm hover:-translate-y-1 hover:shadow-md transition-all duration-200 group flex flex-col justify-between">
    <div>
      <div class="flex justify-between items-start mb-4">
        <div class="p-3 bg-moss-tint text-primary rounded-xl group-hover:bg-primary group-hover:text-white transition-colors flex items-center justify-center">
          <span class="material-symbols-outlined text-[28px]">event</span>
        </div>
        <span class="text-primary font-bold text-xs bg-moss-tint px-2.5 py-1 rounded-full">
          <%= bn.num(stats.events) %> টি অনুষ্ঠান
        </span>
      </div>
      <h4 class="font-headline-md text-base text-on-surface mb-1">মসজিদ অনুষ্ঠানসূচী</h4>
      <p class="text-xs text-on-surface-variant leading-relaxed mb-4">
        ইসলামী সেমিনার, জুম্মার খুতবা ও বিভিন্ন ইসলামী ইভেন্ট পরিচালনা করুন।
      </p>
    </div>
    <a href="/landing/events" class="w-full bg-primary hover:bg-forest-deep text-white text-center py-2.5 rounded-lg font-button text-xs transition-colors text-decoration-none block">
      অনুষ্ঠানসমূহ পরিচালনা
    </a>
  </div>

  <!-- Staff -->
  <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm hover:-translate-y-1 hover:shadow-md transition-all duration-200 group flex flex-col justify-between">
    <div>
      <div class="flex justify-between items-start mb-4">
        <div class="p-3 bg-moss-tint text-primary rounded-xl group-hover:bg-primary group-hover:text-white transition-colors flex items-center justify-center">
          <span class="material-symbols-outlined text-[28px]">badge</span>
        </div>
        <span class="text-primary font-bold text-xs bg-moss-tint px-2.5 py-1 rounded-full">
          <%= bn.num(stats.staff) %> জন স্টাফ
        </span>
      </div>
      <h4 class="font-headline-md text-base text-on-surface mb-1">স্টাফ ও খতিববৃন্দ</h4>
      <p class="text-xs text-on-surface-variant leading-relaxed mb-4">
        মসজিদের খতিব, ইমাম, মুয়াজ্জিন ও কমিটি সদস্যদের প্রোফাইল ও বায়ো যুক্ত করুন।
      </p>
    </div>
    <a href="/landing/staff" class="w-full bg-primary hover:bg-forest-deep text-white text-center py-2.5 rounded-lg font-button text-xs transition-colors text-decoration-none block">
      স্টাফ তালিকা পরিচালনা
    </a>
  </div>

  <!-- Announcements -->
  <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm hover:-translate-y-1 hover:shadow-md transition-all duration-200 group flex flex-col justify-between">
    <div>
      <div class="flex justify-between items-start mb-4">
        <div class="p-3 bg-moss-tint text-primary rounded-xl group-hover:bg-primary group-hover:text-white transition-colors flex items-center justify-center">
          <span class="material-symbols-outlined text-[28px]">campaign</span>
        </div>
        <span class="text-primary font-bold text-xs bg-moss-tint px-2.5 py-1 rounded-full">
          <%= bn.num(stats.announcements) %> টি নোটিশ
        </span>
      </div>
      <h4 class="font-headline-md text-base text-on-surface mb-1">ঘোষণা ও নোটিশসমূহ</h4>
      <p class="text-xs text-on-surface-variant leading-relaxed mb-4">
        জরুরী ঘোষণা, মসজিদ সম্পর্কিত সাধারণ বিজ্ঞপ্তি ও আপডেট সরাসরি প্রকাশ করুন।
      </p>
    </div>
    <a href="/landing/announcements" class="w-full bg-primary hover:bg-forest-deep text-white text-center py-2.5 rounded-lg font-button text-xs transition-colors text-decoration-none block">
      ঘোষণাসমূহ পরিচালনা
    </a>
  </div>

  <!-- Gallery -->
  <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm hover:-translate-y-1 hover:shadow-md transition-all duration-200 group flex flex-col justify-between">
    <div>
      <div class="flex justify-between items-start mb-4">
        <div class="p-3 bg-moss-tint text-primary rounded-xl group-hover:bg-primary group-hover:text-white transition-colors flex items-center justify-center">
          <span class="material-symbols-outlined text-[28px]">gallery_thumbnail</span>
        </div>
        <span class="text-primary font-bold text-xs bg-moss-tint px-2.5 py-1 rounded-full">
          <%= bn.num(stats.gallery) %> টি ছবি
        </span>
      </div>
      <h4 class="font-headline-md text-base text-on-surface mb-1">ফটো গ্যালারি</h4>
      <p class="text-xs text-on-surface-variant leading-relaxed mb-4">
        মসজিদের সুন্দর মুহূর্ত, সামাজিক কার্যক্রম ও স্থাপনার ছবি আপলোড ও ডিলিট করুন।
      </p>
    </div>
    <a href="/landing/gallery" class="w-full bg-primary hover:bg-forest-deep text-white text-center py-2.5 rounded-lg font-button text-xs transition-colors text-decoration-none block">
      গ্যালারি পরিচালনা
    </a>
  </div>

  <!-- FAQs -->
  <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm hover:-translate-y-1 hover:shadow-md transition-all duration-200 group flex flex-col justify-between">
    <div>
      <div class="flex justify-between items-start mb-4">
        <div class="p-3 bg-moss-tint text-primary rounded-xl group-hover:bg-primary group-hover:text-white transition-colors flex items-center justify-center">
          <span class="material-symbols-outlined text-[28px]">help</span>
        </div>
        <span class="text-primary font-bold text-xs bg-moss-tint px-2.5 py-1 rounded-full">
          <%= bn.num(stats.faqs) %> টি প্রশ্নোত্তর
        </span>
      </div>
      <h4 class="font-headline-md text-base text-on-surface mb-1">জিজ্ঞাসা ও উত্তর (FAQ)</h4>
      <p class="text-xs text-on-surface-variant leading-relaxed mb-4">
        সাধারণ জিজ্ঞাসিত প্রশ্নাবলীর উত্তর ও প্রয়োজনীয় শরয়ী দিকনির্দেশনা আপডেট করুন।
      </p>
    </div>
    <a href="/landing/faq" class="w-full bg-primary hover:bg-forest-deep text-white text-center py-2.5 rounded-lg font-button text-xs transition-colors text-decoration-none block">
      FAQ পরিচালনা করুন
    </a>
  </div>

  <!-- Janaza -->
  <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm hover:-translate-y-1 hover:shadow-md transition-all duration-200 group flex flex-col justify-between">
    <div>
      <div class="flex justify-between items-start mb-4">
        <div class="p-3 bg-moss-tint text-primary rounded-xl group-hover:bg-primary group-hover:text-white transition-colors flex items-center justify-center">
          <span class="material-symbols-outlined text-[28px]">healing</span>
        </div>
        <span class="text-primary font-bold text-xs bg-moss-tint px-2.5 py-1 rounded-full">
          <%= bn.num(stats.janaza) %> টি নোটিশ
        </span>
      </div>
      <h4 class="font-headline-md text-base text-on-surface mb-1">জানাযা নোটিশসমূহ</h4>
      <p class="text-xs text-on-surface-variant leading-relaxed mb-4">
        এলাকার কোন সদস্যের ইন্তেকালের সংবাদ, জানাযার সময় ও স্থান নির্ধারণ করে বিজ্ঞপ্তি প্রকাশ করুন।
      </p>
    </div>
    <a href="/landing/janaza" class="w-full bg-primary hover:bg-forest-deep text-white text-center py-2.5 rounded-lg font-button text-xs transition-colors text-decoration-none block">
      জানাযা নোটিশ পরিচালনা
    </a>
  </div>

</div>
