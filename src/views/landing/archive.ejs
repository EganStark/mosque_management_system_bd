<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
  <div><p class="text-uppercase text-danger fw-bold small mb-1" data-bn="নিরাপদ সংরক্ষণ" data-en="Safe storage">নিরাপদ সংরক্ষণ</p><h3 class="mb-1" data-bn="কনটেন্ট আর্কাইভ" data-en="Content archive">কনটেন্ট আর্কাইভ</h3><p class="text-muted mb-0" data-bn="সরানো কনটেন্ট এখানে নিরাপদ থাকে এবং খসড়া হিসেবে পুনরুদ্ধার করা যায়।" data-en="Removed content stays safely here and can be restored as a draft.">সরানো কনটেন্ট এখানে নিরাপদ থাকে এবং খসড়া হিসেবে পুনরুদ্ধার করা যায়।</p></div>
  <a href="/landing/publishing" class="btn btn-outline-primary" data-bn="প্রকাশনা তালিকা" data-en="Publishing queue">প্রকাশনা তালিকা</a>
</div>

<div class="card mb-4"><div class="card-body"><form method="get" class="row g-3 align-items-end">
  <div class="col-lg-5"><label class="form-label" data-bn="আর্কাইভে খুঁজুন" data-en="Search archive">আর্কাইভে খুঁজুন</label><div class="input-group"><span class="input-group-text"><span class="material-symbols-outlined">search</span></span><input class="form-control" name="q" value="<%= archive.filters.q %>" placeholder="Title / শিরোনাম"/></div></div>
  <div class="col-sm-6 col-lg-3"><label class="form-label" data-bn="কনটেন্টের ধরন" data-en="Content type">কনটেন্টের ধরন</label><select class="form-select" name="type"><option value="" data-bn="সব ধরন" data-en="All types">সব ধরন</option><% archive.types.forEach(function(type){ %><option value="<%= type.value %>" <%= archive.filters.type===type.value?'selected':'' %> data-bn="<%= type.label %>" data-en="<%= type.labelEn %>"><%= type.label %></option><% }) %></select></div>
  <div class="col-sm-3 col-lg-2"><label class="form-label" data-bn="প্রতি পাতা" data-en="Per page">প্রতি পাতা</label><select class="form-select" name="per_page"><% [10,25,50,100].forEach(function(size){ %><option value="<%= size %>" <%= archive.filters.per_page===size?'selected':'' %>><%= size %></option><% }) %></select></div>
  <div class="col-sm-3 col-lg-2 d-flex gap-2"><button class="btn btn-primary flex-grow-1" data-bn="ফিল্টার" data-en="Filter">ফিল্টার</button><a href="/landing/archive" class="btn btn-outline-secondary"><span class="material-symbols-outlined">restart_alt</span></a></div>
</form></div></div>

<form id="archiveBulkForm" method="post" action="/landing/archive/restore-bulk" class="d-flex justify-content-end align-items-center gap-2 mb-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><span class="small text-muted"><span data-archive-count>0</span> <span data-bn="নির্বাচিত" data-en="selected">নির্বাচিত</span></span><button class="btn btn-sm btn-primary" data-archive-submit disabled><span class="material-symbols-outlined align-middle" style="font-size:17px">restore</span> <span data-bn="সব পুনরুদ্ধার" data-en="Restore selected">সব পুনরুদ্ধার</span></button></form>

<div class="card"><div class="card-header d-flex justify-content-between"><span data-bn="আর্কাইভ তালিকা" data-en="Archived content">আর্কাইভ তালিকা</span><span class="badge bg-secondary"><%= bn.num(archive.total) %></span></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th style="width:42px"><input type="checkbox" class="form-check-input" data-archive-all aria-label="Select all"/></th><th data-bn="কনটেন্ট" data-en="Content">কনটেন্ট</th><th data-bn="ধরন" data-en="Type">ধরন</th><th data-bn="আর্কাইভ করেছেন" data-en="Archived by">আর্কাইভ করেছেন</th><th data-bn="সময়" data-en="Time">সময়</th><th class="text-end" data-bn="কাজ" data-en="Action">কাজ</th></tr></thead><tbody>
<% archive.items.forEach(function(item){ %><tr><td><input type="checkbox" class="form-check-input" name="selected[]" value="<%= item.type %>:<%= item.id %>" form="archiveBulkForm" data-archive-item/></td><td><strong><%= item.content_title %></strong></td><td><span data-bn="<%= item.typeLabel %>" data-en="<%= item.typeLabelEn %>"><%= item.typeLabel %></span></td><td><%= item.deleted_by_name || 'System' %></td><td><%= bn.dateTime(item.deleted_at) %></td><td class="text-end"><form method="post" action="/landing/archive/<%= item.type %>/<%= item.id %>/restore" class="d-inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><button class="btn btn-sm btn-outline-primary"><span class="material-symbols-outlined align-middle" style="font-size:17px">restore</span> <span data-bn="পুনরুদ্ধার" data-en="Restore">পুনরুদ্ধার</span></button></form></td></tr><% }) %>
<% if(!archive.items.length){ %><tr><td colspan="6" class="text-center text-muted py-5" data-bn="কোনো আর্কাইভ কনটেন্ট পাওয়া যায়নি।" data-en="No archived content found.">কোনো আর্কাইভ কনটেন্ট পাওয়া যায়নি।</td></tr><% } %>
</tbody></table></div></div>

<% if(archive.pagination.totalPages>1){ %><div class="d-flex justify-content-between align-items-center mt-3"><small class="text-muted"><%= bn.num(archive.pagination.from) %>–<%= bn.num(archive.pagination.to) %> / <%= bn.num(archive.total) %></small><div class="btn-group"><a class="btn btn-sm btn-outline-secondary <%= archive.pagination.previousHref?'':'disabled' %>" href="<%= archive.pagination.previousHref || '#' %>">‹</a><span class="btn btn-sm btn-outline-secondary disabled"><%= archive.pagination.page %> / <%= archive.pagination.totalPages %></span><a class="btn btn-sm btn-outline-secondary <%= archive.pagination.nextHref?'':'disabled' %>" href="<%= archive.pagination.nextHref || '#' %>">›</a></div></div><% } %>

<script>
document.addEventListener('DOMContentLoaded', function(){ const items=[...document.querySelectorAll('[data-archive-item]')], all=document.querySelector('[data-archive-all]'), count=document.querySelector('[data-archive-count]'), submit=document.querySelector('[data-archive-submit]'); function sync(){ const n=items.filter(x=>x.checked).length; count.textContent=n; submit.disabled=!n; if(all){ all.checked=n===items.length&&n>0; all.indeterminate=n>0&&n<items.length; } } items.forEach(x=>x.addEventListener('change',sync)); if(all) all.addEventListener('change',()=>{items.forEach(x=>{x.checked=all.checked});sync()}); sync(); });
</script>
