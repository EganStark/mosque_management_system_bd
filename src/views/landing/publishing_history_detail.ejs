<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
  <div><p class="text-uppercase text-primary fw-bold small mb-1" data-bn="সংস্করণ তুলনা" data-en="Version comparison">সংস্করণ তুলনা</p><h3 class="mb-1"><%= detail.event.content_title %></h3><p class="text-muted mb-0"><span data-bn="পরিবর্তন" data-en="Change">পরিবর্তন</span> #<%= detail.event.id %> · <%= bn.dateTime(detail.event.created_at) %></p></div>
  <div class="d-flex gap-2"><a href="/landing/publishing/history" class="btn btn-outline-primary" data-bn="ইতিহাস" data-en="History">ইতিহাস</a><% if(detail.event.editHref){ %><a href="<%= detail.event.editHref %>" class="btn btn-primary" data-bn="বর্তমান কনটেন্ট" data-en="Current content">বর্তমান কনটেন্ট</a><% } %></div>
</div>
<div class="row g-3 mb-4"><div class="col-md-4"><div class="card h-100"><div class="card-body"><small class="text-muted" data-bn="কনটেন্টের ধরন" data-en="Content type">কনটেন্টের ধরন</small><h5 class="mb-0" data-bn="<%= detail.event.typeLabel %>" data-en="<%= detail.event.typeLabelEn %>"><%= detail.event.typeLabel %></h5></div></div></div><div class="col-md-4"><div class="card h-100"><div class="card-body"><small class="text-muted" data-bn="কার্যক্রম" data-en="Action">কার্যক্রম</small><h5 class="mb-0"><%= detail.event.action.replace(/_/g, ' ') %></h5></div></div></div><div class="col-md-4"><div class="card h-100"><div class="card-body"><small class="text-muted" data-bn="ব্যবহারকারী" data-en="User">ব্যবহারকারী</small><h5 class="mb-0"><%= detail.event.actor_name || detail.event.actor_username || 'System' %></h5></div></div></div></div>
<div class="card"><div class="card-header d-flex justify-content-between"><span data-bn="পরিবর্তিত ফিল্ড" data-en="Changed fields">পরিবর্তিত ফিল্ড</span><span class="badge bg-primary"><%= bn.num(detail.changes.length) %></span></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th data-bn="ফিল্ড" data-en="Field">ফিল্ড</th><th style="width:38%" data-bn="আগে" data-en="Before">আগে</th><th style="width:38%" data-bn="পরে" data-en="After">পরে</th></tr></thead><tbody><% detail.changes.forEach(function(change){ %><tr><td><strong><%= change.label %></strong><small class="d-block text-muted"><%= change.key %></small></td><td class="text-break"><% if(change.before){ %><span class="d-inline-block bg-danger-subtle rounded px-2 py-1"><%= change.before %></span><% } else { %><span class="text-muted">—</span><% } %></td><td class="text-break"><% if(change.after){ %><span class="d-inline-block bg-success-subtle rounded px-2 py-1"><%= change.after %></span><% } else { %><span class="text-muted">—</span><% } %></td></tr><% }) %><% if(!detail.changes.length){ %><tr><td colspan="3" class="text-center text-muted py-5" data-bn="এই রেকর্ডে তুলনাযোগ্য ফিল্ড পরিবর্তন নেই।" data-en="This record has no comparable field changes.">এই রেকর্ডে তুলনাযোগ্য ফিল্ড পরিবর্তন নেই।</td></tr><% } %></tbody></table></div></div>
