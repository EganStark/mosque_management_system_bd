<div class="d-flex justify-content-between align-items-center mb-3">
  <h3 class="mb-0">ল্যান্ডিং পেজ ঘোষণাসমূহ</h3>
  <div>
    <a href="/landing" class="btn btn-outline-secondary me-2"><i class="bi bi-arrow-left me-1"></i> ফিরে যান</a>
    <a href="/landing/announcements/new" class="btn btn-primary"><i class="bi bi-megaphone me-1"></i> নতুন ঘোষণা</a>
  </div>
</div>

<div class="card shadow-sm"><div class="card-body">
  <div class="table-responsive">
    <table class="table table-striped table-hover datatable w-100">
      <thead>
        <tr>
          <th>ক্রমিক</th>
          <th>শিরোনাম (বাংলা)</th>
          <th>শিরোনাম (ইংরেজি)</th>
          <th>বিভাগ</th>
          <th>প্রকাশের তারিখ</th>
          <th>স্ট্যাটাস</th>
          <th class="no-print">অ্যাকশন</th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(function(ann, i) { %>
        <tr>
          <td><%= bn.toBnDigits(i + 1) %></td>
          <td><strong><%= ann.title_bn %></strong></td>
          <td><%= ann.title_en %></td>
          <td>
            <% if (ann.category === 'emergency') { %>
            <span class="badge bg-danger">জরুরি (Emergency)</span>
            <% } else if (ann.category === 'event') { %>
            <span class="badge bg-success">অনুষ্ঠান (Event)</span>
            <% } else if (ann.category === 'meeting') { %>
            <span class="badge bg-primary">মিটিং (Meeting)</span>
            <% } else { %>
            <span class="badge bg-secondary">সাধারণ (General)</span>
            <% } %>
          </td>
          <td><%= bn.toBnDigits(ann.publish_date.toISOString().slice(0, 10)) %></td>
          <td>
            <% if (ann.is_active) { %>
            <span class="badge bg-success">সক্রিয়</span>
            <% } else { %>
            <span class="badge bg-secondary">নিষ্ক্রিয়</span>
            <% } %>
          </td>
          <td class="no-print">
            <a href="/landing/announcements/<%= ann.id %>/edit" class="btn btn-sm btn-outline-primary" title="সম্পাদনা"><i class="bi bi-pencil"></i></a>
            <form method="post" action="/landing/announcements/<%= ann.id %>/delete" class="d-inline confirm-delete">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <button class="btn btn-sm btn-outline-danger" title="মুছুন"><i class="bi bi-trash"></i></button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div></div>
