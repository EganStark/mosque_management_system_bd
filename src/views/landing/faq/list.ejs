<div class="d-flex justify-content-between align-items-center mb-3">
  <h3 class="mb-0">ল্যান্ডিং পেজ FAQ (জিজ্ঞাসা ও উত্তর)</h3>
  <div>
    <a href="/landing" class="btn btn-outline-secondary me-2"><i class="bi bi-arrow-left me-1"></i> ফিরে যান</a>
    <a href="/landing/faq/new" class="btn btn-primary"><i class="bi bi-question-circle me-1"></i> নতুন FAQ যুক্ত করুন</a>
  </div>
</div>

<div class="card shadow-sm"><div class="card-body">
  <div class="table-responsive">
    <table class="table table-striped table-hover datatable w-100">
      <thead>
        <tr>
          <th>ক্রমিক</th>
          <th>প্রশ্ন (বাংলা)</th>
          <th>প্রশ্ন (ইংরেজি)</th>
          <th>ক্রম নং (শর্ট)</th>
          <th>স্ট্যাটাস</th>
          <th class="no-print">অ্যাকশন</th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(function(faq, i) { %>
        <tr>
          <td><%= bn.toBnDigits(i + 1) %></td>
          <td><strong><%= faq.question_bn %></strong></td>
          <td><%= faq.question_en %></td>
          <td><%= bn.toBnDigits(faq.sort_order) %></td>
          <td>
            <% if (faq.is_active) { %>
            <span class="badge bg-success">সক্রিয়</span>
            <% } else { %>
            <span class="badge bg-secondary">নিষ্ক্রিয়</span>
            <% } %>
          </td>
          <td class="no-print">
            <a href="/landing/faq/<%= faq.id %>/edit" class="btn btn-sm btn-outline-primary" title="সম্পাদনা"><i class="bi bi-pencil"></i></a>
            <form method="post" action="/landing/faq/<%= faq.id %>/delete" class="d-inline confirm-delete">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <button class="btn btn-sm btn-outline-danger" title="মুছুন"><i class="bi bi-trash"></i></button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div></div>
