<%
  const isEdit = faq !== null;
  const action = isEdit ? `/landing/faq/${faq.id}/edit` : '/landing/faq/new';
%>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h3 class="mb-0"><%= title %></h3>
  <a href="/landing/faq" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> ফিরে যান</a>
</div>

<div class="card shadow-sm"><div class="card-body">
  <form method="post" action="<%= action %>?_csrf=<%= encodeURIComponent(csrfToken) %>" class="row g-3">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

    <div class="col-md-6">
      <label class="form-label required">প্রশ্ন (বাংলা)</label>
      <input type="text" name="question_bn" class="form-control" value="<%= isEdit ? faq.question_bn : '' %>" required />
    </div>

    <div class="col-md-6">
      <label class="form-label required">প্রশ্ন (ইংরেজি)</label>
      <input type="text" name="question_en" class="form-control" value="<%= isEdit ? faq.question_en : '' %>" required />
    </div>

    <div class="col-md-6">
      <label class="form-label required">উত্তর (বাংলা)</label>
      <textarea name="answer_bn" class="form-control" rows="4" required><%= isEdit ? faq.answer_bn : '' %></textarea>
    </div>

    <div class="col-md-6">
      <label class="form-label required">উত্তর (ইংরেজি)</label>
      <textarea name="answer_en" class="form-control" rows="4" required><%= isEdit ? faq.answer_en : '' %></textarea>
    </div>

    <div class="col-md-6">
      <label class="form-label required">ক্রমিক নম্বর (শর্ট অর্ডার)</label>
      <input type="number" name="sort_order" class="form-control" value="<%= isEdit ? faq.sort_order : '0' %>" required />
    </div>

    <div class="col-12">
      <div class="form-check form-switch mt-2">
        <input class="form-check-input" type="checkbox" name="is_active" id="isActiveSwitch" value="true" <%= !isEdit || faq.is_active ? 'checked' : '' %>>
        <label class="form-check-label font-weight-bold" for="isActiveSwitch">সক্রিয় রাখুন (ল্যান্ডিং পেজে প্রদর্শন করার জন্য)</label>
      </div>
    </div>

    <div class="col-12 mt-4">
      <button class="btn btn-primary"><i class="bi bi-check-lg me-1"></i> সংরক্ষণ করুন</button>
    </div>
  </form>
</div></div>
