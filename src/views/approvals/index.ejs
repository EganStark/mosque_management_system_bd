<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4"><div><p class="text-uppercase text-primary fw-bold small mb-1">Decision workspace</p><h3 class="mb-1">অনুমোদন ইনবক্স</h3><p class="text-muted mb-0">বিভিন্ন মডিউলের সকল অপেক্ষমাণ সিদ্ধান্ত এক জায়গায়</p></div><div class="d-flex gap-2"><a href="/approvals/history" class="btn btn-primary">জবাবদিহি রিপোর্ট</a><a href="/dashboard" class="btn btn-outline-secondary">ড্যাশবোর্ডে ফিরুন</a></div></div>
<div class="row g-3 mb-4"><div class="col-md-4"><div class="card h-100"><div class="card-body"><small class="text-muted">মোট অপেক্ষমাণ</small><h2 class="mb-0"><%= bn.num(queue.total) %></h2></div></div></div><div class="col-md-4"><div class="card h-100 border-danger"><div class="card-body"><small class="text-muted">SLA পেরিয়েছে</small><h2 class="mb-0 text-danger"><%= bn.num(queue.overdue) %></h2></div></div></div><div class="col-md-4"><div class="card h-100"><div class="card-body"><small class="text-muted">অপেক্ষমাণ আর্থিক মান</small><h2 class="mb-0">৳ <%= bn.money(queue.amount) %></h2></div></div></div></div>
<% queue.groups.forEach(function(group){ %><div class="card mb-4"><div class="card-header d-flex justify-content-between align-items-center"><span><span class="material-symbols-outlined align-middle me-2"><%= group.icon %></span><%= group.label %></span><span class="badge text-bg-<%= group.items.some(function(item){return item.isOverdue})?'danger':group.items.length?'warning':'secondary' %>"><%= bn.num(group.items.length) %></span></div><div class="card-body p-0"><% if(!group.items.length){ %><p class="text-muted text-center py-4 mb-0">কোনো অপেক্ষমাণ সিদ্ধান্ত নেই</p><% }else{ %><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>রেফারেন্স</th><th>বিষয়</th><th>আবেদনকারী</th><th>অপেক্ষা</th><th class="text-end">পরিমাণ</th><th></th></tr></thead><tbody><% group.items.forEach(function(item){ %><tr class="<%= item.isOverdue?'table-danger':'' %>"><td><strong><%= item.reference %></strong><% if(item.urgency){ %><span class="badge text-bg-danger ms-2"><%= item.urgency %></span><% } %></td><td><%= item.title %><% if(item.detail){ %><small class="d-block text-muted text-truncate" style="max-width:360px"><%= item.detail %></small><% } %></td><td><%= item.requestedBy||'—' %></td><td><span class="badge text-bg-<%= item.isOverdue?'danger':'secondary' %>"><%= bn.num(item.ageDays) %> দিন<%= item.isOverdue?' · SLA পেরিয়েছে':'' %></span><small class="d-block text-muted mt-1"><%= item.requestedAt?bn.date(item.requestedAt):'—' %></small></td><td class="text-end"><%= item.amount===null?'—':'৳ '+bn.money(item.amount) %></td><td class="text-end"><a href="<%= item.href %>" class="btn btn-sm btn-primary">পর্যালোচনা</a></td></tr><% }) %></tbody></table></div><% } %></div></div><% }) %>
