<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4"><div><p class="text-uppercase text-primary fw-bold small mb-1">Accountability report</p><h3 class="mb-1">অনুমোদন জবাবদিহি</h3><p class="text-muted mb-0">সিদ্ধান্ত, সাড়ার সময় ও SLA পালন</p></div><div class="d-flex gap-2"><a href="/approvals" class="btn btn-outline-secondary">লাইভ ইনবক্স</a><a href="/approvals/history/export.csv?<%= new URLSearchParams(filters).toString() %>" class="btn btn-primary">CSV ডাউনলোড</a></div></div>
<form method="get" class="card card-body mb-4"><div class="row g-3"><div class="col-md-3"><label class="form-label">মডিউল</label><select name="type" class="form-select"><option value="">সব</option><% [['expenses','খরচ'],['loans','ঋণ'],['welfare','কল্যাণ'],['procurement','ক্রয়'],['documents','নথি'],['donations','অনলাইন দান']].forEach(function(option){ %><option value="<%= option[0] %>" <%= filters.type===option[0]?'selected':'' %>><%= option[1] %></option><% }) %></select></div><div class="col-md-3"><label class="form-label">সিদ্ধান্ত</label><select name="decision" class="form-select"><option value="">সব</option><option value="approved" <%= filters.decision==='approved'?'selected':'' %>>অনুমোদিত</option><option value="rejected" <%= filters.decision==='rejected'?'selected':'' %>>প্রত্যাখ্যাত</option></select></div><div class="col-md-2"><label class="form-label">শুরু</label><input type="date" name="from" value="<%= filters.from %>" class="form-control"/></div><div class="col-md-2"><label class="form-label">শেষ</label><input type="date" name="to" value="<%= filters.to %>" class="form-control"/></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary w-100">ফিল্টার</button></div></div></form>
<div class="row g-3 mb-4"><% [['মোট সিদ্ধান্ত',report.summary.decided,''],['অনুমোদিত',report.summary.approved,'text-success'],['প্রত্যাখ্্যাত',report.summary.rejected,'text-danger'],['SLA-র মধ্যে',report.summary.withinSla,'text-primary']].forEach(function(card){ %><div class="col-6 col-lg-3"><div class="card h-100"><div class="card-body"><small class="text-muted"><%= card[0] %></small><h3 class="mb-0 <%= card[2] %>"><%= bn.num(card[1]) %></h3></div></div></div><% }) %></div>
<div class="alert alert-info">গড় সাড়ার সময়: <strong><%= bn.num(report.summary.averageHours.toFixed(1)) %> ঘণ্টা</strong></div>
<div class="card"><div class="card-body p-0"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>মডিউল</th><th>রেফারেন্স</th><th>সিদ্ধান্ত</th><th>সিদ্ধান্তকারী</th><th>সময়</th><th>SLA</th><th></th></tr></thead><tbody><% report.rows.forEach(function(row){ %><tr><td><%= row.typeLabel %></td><td><strong><%= row.reference %></strong><small class="d-block text-muted"><%= row.title %></small></td><td><span class="badge text-bg-<%= row.decision==='approved'?'success':'danger' %>"><%= row.decision==='approved'?'অনুমোদিত':'প্রত্যাখ্যাত' %></span><% if(row.notes){ %><small class="d-block text-muted mt-1"><%= row.notes %></small><% } %></td><td><%= row.actorName %><small class="d-block text-muted"><%= bn.date(row.decidedAt) %></small></td><td><%= bn.num(row.responseHours.toFixed(1)) %> ঘণ্টা</td><td><span class="badge text-bg-<%= row.withinSla?'success':'danger' %>"><%= row.withinSla?'সময়মত':'বিলম্বিত' %></span></td><td><a href="<%= row.href %>" class="btn btn-sm btn-outline-primary">খুলুন</a></td></tr><% }) %><% if(!report.rows.length){ %><tr><td colspan="7" class="text-center text-muted py-5">কোনো সিদ্ধান্ত পাওয়া যায়নি</td></tr><% } %></tbody></table></div></div></div>
<script>
  (() => {
    const select = document.querySelector('select[name="type"]');
    if (!select) return;
    [['welfare-releases', 'কল্যাণ অর্থ ছাড়'], ['supplier-payments', 'সরবরাহকারী পেমেন্ট'], ['maintenance-completions', 'রক্ষণাবেক্ষণ সমাপ্তি'], ['payroll-payments', 'বেতন পেমেন্ট'], ['treasury-transfers', 'তহবিল স্থানান্তর']].forEach(([value, label]) => {
      if ([...select.options].some((option) => option.value === value)) return;
      const option = new Option(label, value, false, <%- JSON.stringify(filters.type) %> === value);
      select.add(option);
    });
  })();
</script>
