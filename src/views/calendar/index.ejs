<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4"><div><p class="text-uppercase text-primary fw-bold small mb-1" data-bn="মসজিদ কার্যক্রম" data-en="Mosque operations">মসজিদ কার্যক্রম</p><h3 class="mb-1" data-bn="সমন্বিত ক্যালেন্ডার" data-en="Unified calendar">সমন্বিত ক্যালেন্ডার</h3><p class="text-muted mb-0" data-bn="সভা, আয়োজন, ক্লাস, ডিউটি, জানাযা ও কাজের পূর্ণ সূচি" data-en="Complete schedule of meetings, events, classes, duties, Janaza and tasks">সভা, আয়োজন, ক্লাস, ডিউটি, জানাযা ও কাজের পূর্ণ সূচি</p></div><div class="d-flex align-items-center gap-2"><a class="btn btn-outline-secondary" href="/calendar?month=<%= schedule.previous %>"><span class="material-symbols-outlined align-middle">chevron_left</span></a><input class="form-control" type="month" value="<%= schedule.month %>" onchange="location.href='/calendar?month='+this.value"/><a class="btn btn-outline-secondary" href="/calendar?month=<%= schedule.next %>"><span class="material-symbols-outlined align-middle">chevron_right</span></a></div></div>
<div class="d-flex flex-wrap gap-2 mb-3"><% [{l:'আয়োজন',e:'Events',c:'primary'},{l:'সভা',e:'Meetings',c:'info'},{l:'বুকিং',e:'Bookings',c:'success'},{l:'প্রোগ্রাম',e:'Programs',c:'purple'},{l:'ক্লাস',e:'Classes',c:'indigo'},{l:'স্টাফ ডিউটি',e:'Staff duties',c:'teal'},{l:'কাজ',e:'Tasks',c:'warning'},{l:'রক্ষণাবেক্ষণ',e:'Maintenance',c:'danger'},{l:'জানাযা',e:'Janaza',c:'slate'}].forEach(function(x){ %><span class="badge rounded-pill border bg-white text-on-surface px-3 py-2"><span class="d-inline-block rounded-circle calendar-dot-<%= x.c %> me-1"></span><span data-bn="<%= x.l %>" data-en="<%= x.e %>"><%= x.l %></span></span><% }) %></div>
<div class="card overflow-hidden"><div class="calendar-grid calendar-head"><% ['রবি','সোম','মঙ্গল','বুধ','বৃহস্পতি','শুক্র','শনি'].forEach(function(day){ %><div><%= day %></div><% }) %></div><div class="calendar-grid"><% schedule.days.forEach(function(day){ %><div class="calendar-day <%= day.current?'':'is-muted' %> <%= day.today?'is-today':'' %>"><div class="calendar-date"><%= bn.num(day.number) %></div><div class="d-flex flex-column gap-1"><% day.entries.slice(0,4).forEach(function(item){ %><a href="<%= item.href %>" class="calendar-entry calendar-<%= item.color %> text-decoration-none" title="<%= item.detail %>"><span class="material-symbols-outlined"><%= item.icon %></span><span class="text-truncate"><%= item.time?item.time+' ':'' %><%= item.title %></span></a><% }) %><% if(day.entries.length>4){ %><small class="text-muted">+<%= bn.num(day.entries.length-4) %> আরও</small><% } %></div></div><% }) %></div></div>
<div class="card mt-4"><div class="card-header d-flex justify-content-between"><span data-bn="এই মাসের পূর্ণ সূচি" data-en="Complete schedule this month">এই মাসের পূর্ণ সূচি</span><span class="badge bg-primary"><%= bn.num(schedule.entries.length) %></span></div><div class="list-group list-group-flush"><% schedule.entries.forEach(function(item){ %><a href="<%= item.href %>" class="list-group-item list-group-item-action d-flex align-items-center gap-3"><span class="material-symbols-outlined calendar-icon-<%= item.color %>"><%= item.icon %></span><div class="flex-grow-1"><strong class="d-block"><%= item.title %></strong><small class="text-muted"><%= item.detail %></small></div><div class="text-end"><strong><%= bn.date(item.date) %></strong><small class="d-block text-muted"><%= item.time %></small></div></a><% }) %><% if(!schedule.entries.length){ %><div class="p-5 text-center text-muted" data-bn="এই মাসে কোনো সূচি নেই।" data-en="No schedule entries this month.">এই মাসে কোনো সূচি নেই।</div><% } %></div></div>
