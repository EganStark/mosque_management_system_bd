<div class="d-flex justify-content-between align-items-center mb-3">
  <h3 class="mb-0"><%= type === 'deposit' ? 'ব্যাংক জমা' : 'ব্যাংক উত্তোলন' %></h3>
  <div class="btn-group">
    <a href="/banks/transaction?type=deposit" class="btn btn-sm <%= type==='deposit'?'btn-success':'btn-outline-success' %>">জমা</a>
    <a href="/banks/transaction?type=withdraw" class="btn btn-sm <%= type==='withdraw'?'btn-danger':'btn-outline-danger' %>">উত্তোলন</a>
  </div>
</div>
<div class="card"><div class="card-body">
  <form method="post" action="/banks/transaction" class="row g-3">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <input type="hidden" name="type" value="<%= type %>" />
    <div class="col-md-4"><label class="form-label required">ব্যাংক</label>
      <select name="bank_id" class="form-select select2" required>
        <option value="">নির্বাচন করুন</option>
        <% bankList.forEach(function(b){ %><option value="<%= b.id %>"><%= b.name %></option><% }) %>
      </select></div>
    <div class="col-md-3"><label class="form-label required">পরিমাণ</label><input type="number" min="0.01" step="0.01" name="amount" class="form-control" required /></div>
    <div class="col-md-3"><label class="form-label required">তারিখ</label><input type="date" name="date" class="form-control" value="<%= new Date().toISOString().slice(0,10) %>" required /></div>
    <div class="col-md-2"><label class="form-label">চেক/ভাউচার নং</label><input type="text" name="cheque_number" class="form-control" /></div>
    <div class="col-md-3"><label class="form-label">পেমেন্ট মাধ্যম</label><input type="text" name="payment_method" class="form-control" /></div>
    <div class="col-md-9"><label class="form-label">মন্তব্য</label><input type="text" name="remarks" class="form-control" /></div>
    <div class="col-12"><button class="btn btn-primary"><i class="bi bi-check-lg me-1"></i> সংরক্ষণ</button></div>
  </form>
</div></div>
