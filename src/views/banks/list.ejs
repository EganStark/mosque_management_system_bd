<div class="d-flex justify-content-between align-items-center mb-3">
  <h3 class="mb-0">ব্যাংক লেনদেন</h3>
  <% if (currentUser.role !== 'viewer') { %>
  <div>
    <a href="/banks/transaction?type=deposit" class="btn btn-success btn-sm"><i class="bi bi-arrow-down-circle me-1"></i> জমা</a>
    <a href="/banks/transaction?type=withdraw" class="btn btn-danger btn-sm"><i class="bi bi-arrow-up-circle me-1"></i> উত্তোলন</a>
    <% if (currentUser.role === 'admin') { %><a href="/banks/setup" class="btn btn-outline-secondary btn-sm"><i class="bi bi-gear me-1"></i> ব্যাংক সেটআপ</a><% } %>
  </div>
  <% } %>
</div>
<div class="card"><div class="card-body"><div class="table-responsive">
  <table class="table table-striped table-hover datatable w-100">
    <thead><tr><th>ক্রমিক</th><th>ব্যাংক</th><th>ধরন</th><th>মন্তব্য</th><th>জমা</th><th>উত্তোলন</th><th>তারিখ</th><th class="no-print">অ্যাকশন</th></tr></thead>
    <tbody>
      <% rows.forEach(function(t,i){ %>
      <tr class="<%= t.status==='cancelled'?'text-muted':'' %>">
        <td><%= bn.toBnDigits(i+1) %></td>
        <td><%= t.bank_name||'' %></td>
        <td><span class="badge bg-<%= t.status==='cancelled'?'secondary':t.type==='deposit'?'success':'danger' %>"><%= t.status==='cancelled'?'বাতিল':t.type==='deposit'?'জমা':'উত্তোলন' %></span></td>
        <td><%= t.status==='cancelled'?(t.cancellation_reason||'বাতিল'):t.remarks||'' %></td>
        <td class="<%= t.status==='cancelled'?'text-decoration-line-through':'' %>"><%= t.type==='deposit'? bn.money(t.amount) : '' %></td>
        <td class="<%= t.status==='cancelled'?'text-decoration-line-through':'' %>"><%= t.type==='withdraw'? bn.money(t.amount) : '' %></td>
        <td><%= bn.date(t.date) %></td>
        <td class="no-print">
          <% if (currentUser.role === 'admin' && t.status==='posted') { %>
          <form method="post" action="/banks/<%= t.id %>/cancel" class="d-flex gap-1"><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><input name="cancellation_reason" class="form-control form-control-sm" placeholder="বাতিলের কারণ" required/><button class="btn btn-sm btn-outline-danger" onclick="return confirm('লেনদেনটি বাতিল করবেন?')"><i class="bi bi-x-circle"></i></button></form>
          <% } %>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div></div></div>
