<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4"><div><p class="text-uppercase text-primary fw-bold small mb-1"><%= asset.asset_code %></p><h3 class="mb-1"><%= asset.name %></h3><p class="text-muted mb-0"><%= asset.category_name||'অন্যান্য' %> · <%= asset.location||'অবস্থান দেওয়া হয়নি' %></p></div><div><a href="/assets/<%= asset.id %>/edit" class="btn btn-primary"><i class="bi bi-pencil me-1"></i> সম্পাদনা</a> <a href="/assets" class="btn btn-outline-secondary">ফিরে যান</a></div></div>
<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 mb-4"><div class="card"><div class="card-body"><p class="small text-muted mb-1">পরিমাণ</p><h4><%= bn.num(asset.quantity) %> <%= asset.unit %></h4></div></div><div class="card"><div class="card-body"><p class="small text-muted mb-1">ক্রয়মূল্য</p><h4>৳ <%= bn.money(asset.purchase_price) %></h4></div></div><div class="card"><div class="card-body"><p class="small text-muted mb-1">বর্তমান অবস্থা</p><h4><%= asset.condition==='excellent'?'চমৎকার':asset.condition==='good'?'ভালো':asset.condition==='needs_service'?'সার্ভিস প্রয়োজন':'ক্ষতিগ্রস্ত' %></h4></div></div><div class="card"><div class="card-body"><p class="small text-muted mb-1">দায়িত্বে</p><h4><%= asset.responsible_name||'নির্ধারিত নয়' %></h4></div></div></div>
<div class="row g-4"><div class="col-lg-5"><div class="card mb-4"><div class="card-header">সম্পদের তথ্য</div><div class="card-body"><dl class="row mb-0"><dt class="col-5">ক্রয়ের তারিখ</dt><dd class="col-7"><%= asset.purchase_date?bn.date(asset.purchase_date):'—' %></dd><dt class="col-5">সরবরাহকারী</dt><dd class="col-7"><%= asset.supplier||'—' %></dd><dt class="col-5">ইনভয়েস</dt><dd class="col-7"><%= asset.invoice_number||'—' %></dd><dt class="col-5">ওয়ারেন্টি</dt><dd class="col-7"><%= asset.warranty_until?bn.date(asset.warranty_until):'—' %></dd><dt class="col-5">বিবরণ</dt><dd class="col-7"><%= asset.description||'—' %></dd></dl></div></div><div class="card"><div class="card-header">রক্ষণাবেক্ষণ যোগ করুন</div><div class="card-body"><form method="post" action="/assets/<%= asset.id %>/maintenance" class="row g-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><div class="col-6"><label class="form-label required">তারিখ</label><input type="date" name="maintenance_date" value="<%= new Date().toISOString().slice(0,10) %>" class="form-control" required/></div><div class="col-6"><label class="form-label">ধরন</label><select name="maintenance_type" class="form-select"><option value="service">সার্ভিস</option><option value="repair">মেরামত</option><option value="inspection">পরিদর্শন</option><option value="replacement">যন্ত্রাংশ পরিবর্তন</option></select></div><div class="col-12"><label class="form-label required">বিবরণ</label><textarea name="description" class="form-control" required></textarea></div><div class="col-6"><label class="form-label">সেবাদাতা</label><input name="service_provider" class="form-control"/></div><div class="col-6"><label class="form-label">খরচ</label><input type="number" min="0" step="0.01" name="cost" value="0" class="form-control"/></div><div class="col-12"><label class="form-label">পরবর্তী সার্ভিস</label><input type="date" name="next_maintenance_date" class="form-control"/></div><div class="col-12"><button class="btn btn-primary">ইতিহাসে যোগ করুন</button></div></form></div></div></div>
<div class="col-lg-7"><div class="card"><div class="card-header">রক্ষণাবেক্ষণ ইতিহাস</div><div class="card-body"><div class="table-responsive"><table class="table table-hover"><thead><tr><th>তারিখ</th><th>বিবরণ</th><th>সেবাদাতা</th><th>খরচ</th><th>পরবর্তী</th></tr></thead><tbody><% asset.maintenance.forEach(function(m){ %><tr><td><%= bn.date(m.maintenance_date) %></td><td><strong><%= m.description %></strong><small class="d-block text-muted"><%= m.maintenance_type %></small></td><td><%= m.service_provider||'—' %></td><td>৳ <%= bn.money(m.cost) %></td><td><%= m.next_maintenance_date?bn.date(m.next_maintenance_date):'—' %></td></tr><% }) %><% if(!asset.maintenance.length){ %><tr><td colspan="5" class="text-center text-muted py-4">কোনো রক্ষণাবেক্ষণ ইতিহাস নেই</td></tr><% } %></tbody></table></div></div></div></div></div>
