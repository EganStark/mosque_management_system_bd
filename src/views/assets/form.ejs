<% var edit=!!asset; function val(k){return edit&&asset[k]!=null?asset[k]:''} function selected(k,v){return String(val(k))===String(v)?'selected':''} %>
<div class="d-flex justify-content-between align-items-center mb-4"><div><p class="text-uppercase text-primary fw-bold small mb-1">Asset register</p><h3 class="mb-1"><%= title %></h3><p class="text-muted mb-0">মসজিদের মালিকানাধীন সম্পদের পূর্ণ তথ্য</p></div><a href="/assets" class="btn btn-outline-secondary">ফিরে যান</a></div>
<div class="card"><div class="card-body"><form method="post" action="<%= edit?'/assets/'+asset.id:'/assets' %>" class="row g-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><div class="col-md-4"><label class="form-label required">সম্পদের নাম</label><input name="name" class="form-control" value="<%= val('name') %>" required/></div><div class="col-md-3"><label class="form-label required">সম্পদ কোড</label><input name="asset_code" class="form-control" value="<%= edit?val('asset_code'):nextCode %>" required/></div><div class="col-md-5"><label class="form-label">ক্যাটাগরি</label><select name="category_id" class="form-select"><option value="">নির্বাচন করুন</option><% categories.forEach(function(c){ %><option value="<%= c.id %>" <%= selected('category_id',c.id) %>><%= c.name %></option><% }) %></select></div><div class="col-md-3"><label class="form-label required">পরিমাণ</label><input type="number" min="0.01" step="0.01" name="quantity" value="<%= val('quantity')||1 %>" class="form-control" required/></div><div class="col-md-2"><label class="form-label">একক</label><input name="unit" value="<%= val('unit')||'টি' %>" class="form-control"/></div><div class="col-md-4"><label class="form-label">অবস্থান</label><input name="location" value="<%= val('location') %>" class="form-control" placeholder="যেমন: মূল নামাজ কক্ষ"/></div><div class="col-md-3"><label class="form-label">দায়িত্বপ্রাপ্ত সদস্য</label><select name="responsible_member_id" class="form-select select2"><option value="">নির্বাচন করুন</option><% memberOptions.forEach(function(m){ %><option value="<%= m.id %>" <%= selected('responsible_member_id',m.id) %>><%= m.id_no %> — <%= m.name %></option><% }) %></select></div><div class="col-md-3"><label class="form-label">ক্রয়ের তারিখ</label><input type="date" name="purchase_date" value="<%= val('purchase_date')?String(val('purchase_date')).slice(0,10):'' %>" class="form-control"/></div><div class="col-md-3"><label class="form-label">ক্রয়মূল্য</label><input type="number" min="0" step="0.01" name="purchase_price" value="<%= val('purchase_price')||0 %>" class="form-control"/></div><div class="col-md-3"><label class="form-label">সরবরাহকারী</label><input name="supplier" value="<%= val('supplier') %>" class="form-control"/></div><div class="col-md-3"><label class="form-label">ইনভয়েস নম্বর</label><input name="invoice_number" value="<%= val('invoice_number') %>" class="form-control"/></div><div class="col-md-3"><label class="form-label">ওয়ারেন্টি শেষ</label><input type="date" name="warranty_until" value="<%= val('warranty_until')?String(val('warranty_until')).slice(0,10):'' %>" class="form-control"/></div><div class="col-md-3"><label class="form-label">বর্তমান অবস্থা</label><select name="condition" class="form-select"><option value="excellent" <%= selected('condition','excellent') %>>চমৎকার</option><option value="good" <%= !edit||selected('condition','good') %>>ভালো</option><option value="needs_service" <%= selected('condition','needs_service') %>>সার্ভিস প্রয়োজন</option><option value="damaged" <%= selected('condition','damaged') %>>ক্ষতিগ্রস্ত</option></select></div><div class="col-md-3"><label class="form-label">স্ট্যাটাস</label><select name="status" class="form-select"><option value="active" <%= !edit||selected('status','active') %>>সক্রিয়</option><option value="retired" <%= selected('status','retired') %>>অবসরপ্রাপ্ত</option><option value="disposed" <%= selected('status','disposed') %>>অপসারিত</option><option value="lost" <%= selected('status','lost') %>>হারানো</option></select></div><div class="col-md-6"><label class="form-label">বিবরণ</label><textarea name="description" class="form-control"><%= val('description') %></textarea></div><div class="col-md-6"><label class="form-label">নোট</label><textarea name="notes" class="form-control"><%= val('notes') %></textarea></div><div class="col-12"><button class="btn btn-primary">সংরক্ষণ করুন</button></div></form></div></div>
