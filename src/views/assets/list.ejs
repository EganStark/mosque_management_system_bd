<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4"><div><p class="text-uppercase text-primary fw-bold small mb-1">Asset management</p><h3 class="mb-1">মসজিদের সম্পদ রেজিস্টার</h3><p class="text-muted mb-0">সরঞ্জাম, আসবাবপত্র, অবস্থান ও রক্ষণাবেক্ষণ</p></div><% if(currentUser.role!=='viewer'){ %><a href="/assets/new" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i> নতুন সম্পদ</a><% } %></div>
<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 mb-4"><div class="card"><div class="card-body"><p class="small text-muted mb-1">সক্রিয় সম্পদ</p><h4><%= bn.num(summary.activeCount) %></h4></div></div><div class="card"><div class="card-body"><p class="small text-muted mb-1">আনুমানিক ক্রয়মূল্য</p><h4>৳ <%= bn.money(summary.totalValue) %></h4></div></div><div class="card"><div class="card-body"><p class="small text-muted mb-1">মনোযোগ প্রয়োজন</p><h4 class="text-danger"><%= bn.num(summary.attentionCount) %></h4></div></div><div class="card"><div class="card-body"><p class="small text-muted mb-1">৩০ দিনে সার্ভিস</p><h4 class="text-warning"><%= bn.num(summary.maintenanceDue) %></h4></div></div></div>
<div class="card"><div class="card-body"><div class="table-responsive"><table class="table table-hover datatable w-100"><thead><tr><th>কোড</th><th>সম্পদ</th><th>অবস্থান</th><th>পরিমাণ</th><th>দায়িত্বে</th><th>অবস্থা</th><th>স্ট্যাটাস</th><th></th></tr></thead><tbody><% rows.forEach(function(a){ %><tr><td><strong><%= a.asset_code %></strong></td><td><strong><%= a.name %></strong><small class="d-block text-muted"><%= a.category_name||'অন্যান্য' %></small></td><td><%= a.location||'—' %></td><td><%= bn.num(a.quantity) %> <%= a.unit %></td><td><%= a.responsible_name||'—' %></td><td><%= a.condition==='excellent'?'চমৎকার':a.condition==='good'?'ভালো':a.condition==='needs_service'?'সার্ভিস প্রয়োজন':'ক্ষতিগ্রস্ত' %></td><td><span class="badge <%= a.status==='active'?'bg-success-subtle text-success':'bg-secondary-subtle text-secondary' %>"><%= a.status==='active'?'সক্রিয়':'অবসরপ্রাপ্ত' %></span></td><td><a href="/assets/<%= a.id %>" class="btn btn-sm btn-outline-primary">বিস্তারিত</a></td></tr><% }) %></tbody></table></div></div></div>
