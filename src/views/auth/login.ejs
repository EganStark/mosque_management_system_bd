<div class="auth-wrap">
  <div class="auth-card">
    <div class="text-center mb-4">
      <i class="bi bi-moon-stars-fill auth-logo"></i>
      <h1 class="h4 mt-2 mb-0"><%= company && company.company_name ? company.company_name : 'বায়তুর রহমান জামে মসজিদ' %></h1>
      <p class="text-muted small">প্রশাসনিক প্যানেল</p>
    </div>
    <%- include('../partials/flash') %>
    <form method="post" action="/login">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <div class="mb-3">
        <label class="form-label">ইউজারনেম</label>
        <input type="text" name="username" class="form-control form-control-lg" autofocus required />
      </div>
      <div class="mb-3">
        <label class="form-label">পাসওয়ার্ড</label>
        <input type="password" name="password" class="form-control form-control-lg" required />
      </div>
      <button type="submit" class="btn btn-primary btn-lg w-100">লগইন</button>
    </form>
  </div>
</div>
