<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4"><div><p class="text-uppercase text-primary fw-bold small mb-1"><%= item.request_no %></p><h3 class="mb-1"><%= item.title %></h3><p class="text-muted mb-0">অনুরোধ: <%= bn.date(item.request_date) %> · প্রয়োজন: <%= item.needed_by?bn.date(item.needed_by):'নির্ধারিত নয়' %> · <%= item.requester_name||'' %></p></div><div class="d-flex gap-2 no-print"><a href="/procurement" class="btn btn-outline-secondary">সব অনুরোধ</a><button onclick="window.print()" class="btn btn-outline-primary">প্রিন্ট</button><% if(currentUser.role!=='viewer'&&item.status==='draft'){ %><form method="post" action="/procurement/<%= item.id %>/submit"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><button class="btn btn-primary">অনুমোদনে পাঠান</button></form><% } %></div></div>
<div class="row g-4 mb-4"><div class="col-lg-8"><div class="card h-100"><div class="card-header">অনুরোধের বিবরণ</div><div class="card-body"><p><%= item.justification %></p><% if(item.work_order_no){ %><p class="small text-muted">কাজের আদেশ: <strong><%= item.work_order_no %> — <%= item.work_order_title %></strong></p><% } %><div class="table-responsive"><table class="table"><thead><tr><th>আইটেম</th><th>বিবরণ</th><th>পরিমাণ</th><th>দর</th><th>মোট</th></tr></thead><tbody><% item.items.forEach(function(x){ %><tr><td><%= x.item_name %></td><td><%= x.specification||'—' %></td><td><%= bn.num(x.quantity) %> <%= x.unit %></td><td>৳ <%= bn.money(x.estimated_unit_cost) %></td><td>৳ <%= bn.money(Number(x.quantity)*Number(x.estimated_unit_cost)) %></td></tr><% }) %></tbody><tfoot><tr><th colspan="4">প্রাক্কলিত মোট</th><th>৳ <%= bn.money(item.estimated_total) %></th></tr></tfoot></table></div></div></div></div><div class="col-lg-4"><div class="card h-100"><div class="card-header">নিয়ন্ত্রণ অবস্থা</div><div class="card-body"><dl class="row"><dt class="col-5">অবস্থা</dt><dd class="col-7"><strong><%= ({draft:'খসড়া',submitted:'অপেক্ষমাণ',approved:'অনুমোদিত',rejected:'প্রত্যাখ্যাত',ordered:'অর্ডার হয়েছে'})[item.status] %></strong></dd><dt class="col-5">অগ্রাধিকার</dt><dd class="col-7"><%= item.priority %></dd><dt class="col-5">সিদ্ধান্ত</dt><dd class="col-7"><%= item.decision_notes||'—' %></dd></dl><% if(currentUser.role==='admin'&&item.status==='submitted'){ %><form method="post" action="/procurement/<%= item.id %>/decision"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><textarea name="decision_notes" class="form-control mb-2" placeholder="সিদ্ধান্তের মন্তব্য"></textarea><div class="d-flex gap-2"><button name="status" value="approved" class="btn btn-success flex-fill">অনুমোদন</button><button name="status" value="rejected" class="btn btn-outline-danger flex-fill">প্রত্যাখ্যান</button></div></form><% } %></div></div></div></div>
<% if(['approved','ordered'].includes(item.status)){ %><div class="card mb-4"><div class="card-header">দরপত্র তুলনা</div><div class="card-body"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>বিক্রেতা</th><th>রেফারেন্স</th><th>দর</th><th>সরবরাহ</th><th>শর্ত</th></tr></thead><tbody><% item.quotations.forEach(function(q){ %><tr class="<%= q.is_selected?'table-success':'' %>"><td><strong><%= q.vendor_name %></strong><small class="d-block"><%= q.vendor_phone||'' %></small></td><td><%= q.quotation_ref||'—' %><small class="d-block"><%= bn.date(q.quotation_date) %></small></td><td>৳ <%= bn.money(q.quoted_amount) %></td><td><%= q.delivery_days?bn.num(q.delivery_days)+' দিন':'—' %></td><td><%= q.terms||'—' %></td></tr><% }) %></tbody></table></div><% if(currentUser.role!=='viewer'&&item.status==='approved'){ %><form method="post" action="/procurement/<%= item.id %>/quotations" class="row g-2 border-top pt-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><div class="col-md-3"><select name="vendor_id" class="form-select" required><option value="">বিক্রেতা</option><% vendors.forEach(function(v){ %><option value="<%= v.id %>"><%= v.name %></option><% }) %></select></div><div class="col-md-2"><input name="quotation_ref" class="form-control" placeholder="দরপত্র নং"/></div><div class="col-md-2"><input type="date" name="quotation_date" value="<%= new Date().toISOString().slice(0,10) %>" class="form-control" required/></div><div class="col-md-2"><input type="number" min="0.01" step="0.01" name="quoted_amount" class="form-control" placeholder="মোট দর" required/></div><div class="col-md-1"><input type="number" min="0" name="delivery_days" class="form-control" placeholder="দিন"/></div><div class="col-md-2"><input name="terms" class="form-control" placeholder="শর্ত"/></div><div class="col-12"><button class="btn btn-outline-primary">দরপত্র যোগ করুন</button></div></form><% } %><% if(currentUser.role==='admin'&&item.status==='approved'&&item.quotations.length){ %><form method="post" action="/procurement/<%= item.id %>/order" class="row g-2 border-top mt-3 pt-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><div class="col-md-4"><select name="quotation_id" class="form-select" required><option value="">বিজয়ী দরপত্র নির্বাচন</option><% item.quotations.forEach(function(q){ %><option value="<%= q.id %>"><%= q.vendor_name %> — ৳ <%= bn.money(q.quoted_amount) %></option><% }) %></select></div><div class="col-md-3"><input type="date" name="order_date" value="<%= new Date().toISOString().slice(0,10) %>" class="form-control" required/></div><div class="col-md-3"><input type="date" name="expected_delivery" class="form-control" title="প্রত্যাশিত সরবরাহ"/></div><div class="col-md-2"><button class="btn btn-primary w-100">ক্রয় আদেশ জারি</button></div></form><% } %></div></div><% } %>
<% if(item.order){ var paid=item.payments.reduce(function(s,p){return s+Number(p.amount);},0),due=Number(item.order.order_total)-paid; %><div class="card mb-4"><div class="card-header d-flex justify-content-between"><span>ক্রয় আদেশ <%= item.order.order_no %></span><strong>৳ <%= bn.money(item.order.order_total) %></strong></div><div class="card-body"><div class="row g-3 mb-3"><div class="col-md-4"><small class="text-muted d-block">বিক্রেতা</small><strong><%= item.order.vendor_name %></strong></div><div class="col-md-3"><small class="text-muted d-block">অর্ডার</small><%= bn.date(item.order.order_date) %></div><div class="col-md-3"><small class="text-muted d-block">সরবরাহ প্রত্যাশিত</small><%= item.order.expected_delivery?bn.date(item.order.expected_delivery):'—' %></div><div class="col-md-2"><small class="text-muted d-block">অবস্থা</small><strong><%= ({issued:'জারি',part_received:'আংশিক গৃহীত',received:'গৃহীত',paid:'পরিশোধিত'})[item.order.status]||item.order.status %></strong></div></div><% if(currentUser.role!=='viewer'&&['issued','part_received'].includes(item.order.status)){ %><form method="post" action="/procurement/orders/<%= item.order.id %>/receive" class="row g-2 border-top pt-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><input type="hidden" name="request_id" value="<%= item.id %>"/><div class="col-md-2"><input type="date" name="received_date" value="<%= new Date().toISOString().slice(0,10) %>" class="form-control" required/></div><div class="col-md-2"><input name="delivery_reference" class="form-control" placeholder="চালান নং"/></div><div class="col-md-2"><select name="condition_status" class="form-select"><option value="accepted">সম্পূর্ণ গ্রহণ</option><option value="partial">আংশিক</option><option value="rejected">ফেরত</option></select></div><div class="col-md-4"><input name="inspection_notes" class="form-control" placeholder="পরিদর্শন মন্তব্য" required/></div><div class="col-md-2"><button class="btn btn-success w-100">পণ্য গ্রহণ</button></div></form><% } %><% if(currentUser.role==='admin'&&item.order.status==='received'&&due>0){ %><form method="post" action="/procurement/orders/<%= item.order.id %>/pay" class="row g-2 border-top mt-3 pt-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><input type="hidden" name="request_id" value="<%= item.id %>"/><div class="col-md-2"><input type="number" min="0.01" max="<%= due %>" step="0.01" name="amount" value="<%= due %>" class="form-control" required/></div><div class="col-md-2"><input type="date" name="payment_date" value="<%= new Date().toISOString().slice(0,10) %>" class="form-control" required/></div><div class="col-md-2"><select name="payment_method" class="form-select" onchange="this.form.querySelector('[name=bank_id]').disabled=this.value!=='bank'"><option value="cash">নগদ</option><option value="bank">ব্যাংক</option><option value="mobile_banking">মোবাইল ব্যাংকিং</option></select></div><div class="col-md-2"><select name="bank_id" class="form-select" disabled><option value="">ব্যাংক নির্বাচন</option><% banks.forEach(function(bank){ %><option value="<%= bank.id %>"><%= bank.name %></option><% }) %></select></div><div class="col-md-2"><input name="reference" class="form-control" placeholder="রেফারেন্স"/></div><div class="col-md-2"><button class="btn btn-primary w-100">প্রদান</button></div></form><% } %></div></div><% } %>
<% if(item.order){
  var postedPaid=(item.payments||[]).filter(function(p){return p.status==='posted';}).reduce(function(s,p){return s+Number(p.amount);},0);
  var pendingReserved=(item.paymentRequests||[]).filter(function(p){return ['pending','processing'].includes(p.status);}).reduce(function(s,p){return s+Number(p.amount);},0);
  var availableDue=Math.max(0,Number(item.order.order_total)-postedPaid-pendingReserved);
%>
<div class="card mb-4">
  <div class="card-header d-flex justify-content-between align-items-center"><span>Supplier payment authorization</span><span class="badge text-bg-light">Available: ৳ <%= bn.money(availableDue) %></span></div>
  <div class="card-body">
    <% if(currentUser.role!=='viewer' && currentUser.role!=='admin' && item.order.status==='received' && availableDue>0){ %>
    <form method="post" action="/procurement/orders/<%= item.order.id %>/pay" class="row g-2 mb-4">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>"/><input type="hidden" name="request_id" value="<%= item.id %>"/>
      <div class="col-md-2"><input type="number" name="amount" min="0.01" max="<%= availableDue %>" step="0.01" value="<%= availableDue %>" class="form-control" required/></div>
      <div class="col-md-2"><input type="date" name="payment_date" value="<%= new Date().toISOString().slice(0,10) %>" class="form-control" required/></div>
      <div class="col-md-2"><select name="payment_method" class="form-select"><option value="cash">Cash</option><option value="bank">Bank</option><option value="mobile_banking">Mobile banking</option></select></div>
      <div class="col-md-2"><select name="bank_id" class="form-select"><option value="">Select bank</option><% banks.forEach(function(bank){ %><option value="<%= bank.id %>"><%= bank.name %></option><% }) %></select></div>
      <div class="col-md-2"><select name="mobile_wallet_id" class="form-select"><option value="">Select wallet</option><% wallets.forEach(function(wallet){ %><option value="<%= wallet.id %>"><%= wallet.name %></option><% }) %></select></div>
      <div class="col-md-2"><button class="btn btn-primary w-100">Request approval</button></div>
    </form>
    <% } %>
    <% if(!(item.paymentRequests||[]).length){ %><p class="text-muted mb-0">No supplier payment requests yet.</p><% } else { %>
    <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Date</th><th>Amount</th><th>Method</th><th>Requested by</th><th>Status</th><th></th></tr></thead><tbody>
      <% item.paymentRequests.forEach(function(request){ %><tr><td><%= bn.date(request.payment_date) %></td><td>৳ <%= bn.money(request.amount) %></td><td><%= request.payment_method %></td><td><%= request.requester_name||'—' %></td><td><span class="badge <%= request.status==='approved'?'text-bg-success':request.status==='rejected'?'text-bg-danger':'text-bg-warning' %>"><%= request.status %></span></td><td>
      <% if(currentUser.role==='admin' && request.status==='pending'){ %><form method="post" action="/procurement/orders/<%= item.order.id %>/payments/<%= request.id %>/decision" class="d-flex gap-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><input type="hidden" name="request_id" value="<%= item.id %>"/><input name="decision_notes" class="form-control form-control-sm" placeholder="Decision note"/><input name="budget_override_reason" class="form-control form-control-sm" placeholder="Budget override (if needed)"/><button name="decision" value="approved" class="btn btn-sm btn-success">Approve</button><button name="decision" value="rejected" class="btn btn-sm btn-outline-danger">Reject</button></form><% } %>
      </td></tr><% }) %>
    </tbody></table></div><% } %>
    <% if((item.payments||[]).length){ %><hr/><h6 class="mb-3">Posted payment history</h6><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Date</th><th>Amount</th><th>Reference</th><th>Posted by</th><th>Status</th><th></th></tr></thead><tbody>
      <% item.payments.forEach(function(payment){ %><tr class="<%= payment.status==='cancelled'?'opacity-50':'' %>"><td><%= bn.date(payment.payment_date) %></td><td>৳ <%= bn.money(payment.amount) %></td><td><%= payment.reference||'—' %></td><td><%= payment.payer_name||'—' %></td><td><span class="badge <%= payment.status==='posted'?'text-bg-success':'text-bg-danger' %>"><%= payment.status %></span><% if(payment.cancellation_reason){ %><small class="d-block text-danger"><%= payment.cancellation_reason %></small><% } %></td><td>
      <% if(currentUser.role==='admin' && payment.status==='posted'){ %><form method="post" action="/procurement/orders/<%= item.order.id %>/payments/<%= payment.id %>/cancel" class="d-flex gap-2" onsubmit="return confirm('Cancel this supplier payment and restore the order balance?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><input type="hidden" name="request_id" value="<%= item.id %>"/><input name="cancellation_reason" class="form-control form-control-sm" placeholder="Cancellation reason" required/><button class="btn btn-sm btn-outline-danger">Reverse</button></form><% } %>
      </td></tr><% }) %>
    </tbody></table></div><% } %>
  </div>
</div>
<% } %>
<script>
  (() => {
    const form = document.querySelector('form[action*="/procurement/orders/"][action$="/pay"]');
    if (!form || form.querySelector('[name="mobile_wallet_id"]')) return;
    const availableDue = <%= item.order ? JSON.stringify(Math.max(0, Number(item.order.order_total) - (item.payments||[]).filter(function(p){return p.status==='posted';}).reduce(function(s,p){return s+Number(p.amount);},0) - (item.paymentRequests||[]).filter(function(p){return ['pending','processing'].includes(p.status);}).reduce(function(s,p){return s+Number(p.amount);},0))) : '0' %>;
    const amountInput = form.querySelector('[name="amount"]');
    if (amountInput) { amountInput.max = availableDue; amountInput.value = availableDue; }
    const wrapper = document.createElement("div");
    wrapper.className = "col-md-2";
    const select = document.createElement("select");
    select.name = "mobile_wallet_id";
    select.className = "form-select";
    select.innerHTML = '<option value="">মোবাইল ওয়ালেট</option>';
    const options = <%- JSON.stringify(wallets.map(function(wallet){ return { id: wallet.id, name: wallet.name }; })).replace(/</g, "\\u003c") %>;
    options.forEach((wallet) => select.add(new Option(wallet.name, wallet.id)));
    wrapper.appendChild(select);
    form.querySelector('button').closest("div").before(wrapper);
  })();
</script>
