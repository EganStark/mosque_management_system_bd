<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4"><div><p class="text-uppercase text-primary fw-bold small mb-1">Purchase control</p><h3 class="mb-1">ক্রয় ও সরবরাহ ব্যবস্থাপনা</h3><p class="text-muted mb-0">অনুরোধ, দরপত্র, অনুমোদন, ক্রয় আদেশ, পণ্য গ্রহণ ও পেমেন্ট</p></div><% if(currentUser.role!=='viewer'){ %><a href="/procurement/new" class="btn btn-primary"><i class="bi bi-cart-plus me-1"></i> নতুন ক্রয় অনুরোধ</a><% } %></div>
<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 mb-4"><div class="card"><div class="card-body"><p class="small text-muted mb-1">খসড়া/অপেক্ষমাণ</p><h4><%= bn.num(summary.pending) %></h4></div></div><div class="card"><div class="card-body"><p class="small text-muted mb-1">দরপত্রের জন্য অনুমোদিত</p><h4><%= bn.num(summary.approved) %></h4></div></div><div class="card"><div class="card-body"><p class="small text-muted mb-1">সরবরাহের অপেক্ষায়</p><h4><%= bn.num(summary.ordered) %></h4></div></div><div class="card"><div class="card-body"><p class="small text-muted mb-1">এই মাসের অর্ডার</p><h4>৳ <%= bn.money(summary.monthValue) %></h4></div></div></div>
<div class="card"><div class="card-body"><div class="table-responsive"><table class="table table-hover datatable w-100"><thead><tr><th>অনুরোধ</th><th>বিষয়</th><th>তারিখ</th><th>প্রয়োজন</th><th>প্রাক্কলন</th><th>অবস্থা</th><th>ক্রয় আদেশ</th><th></th></tr></thead><tbody><% rows.forEach(function(r){ %><tr><td><strong><%= r.request_no %></strong></td><td><%= r.title %><small class="d-block text-muted"><%= r.priority %></small></td><td><%= bn.date(r.request_date) %></td><td><%= r.needed_by?bn.date(r.needed_by):'—' %></td><td>৳ <%= bn.money(r.estimated_total) %></td><td><%= ({draft:'খসড়া',submitted:'অনুমোদনের অপেক্ষায়',approved:'দরপত্র সংগ্রহ',rejected:'প্রত্যাখ্যাত',ordered:'অর্ডার হয়েছে'})[r.status] %></td><td><%= r.order_no||'—' %><small class="d-block text-muted"><%= r.vendor_name||'' %></small></td><td><a href="/procurement/<%= r.id %>" class="btn btn-sm btn-outline-primary">পরিচালনা</a></td></tr><% }) %></tbody></table></div></div></div>
