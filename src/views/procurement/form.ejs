<div class="d-flex justify-content-between align-items-center mb-4"><div><p class="text-uppercase text-primary fw-bold small mb-1">Purchase requisition</p><h3>নতুন ক্রয় অনুরোধ</h3></div><a href="/procurement" class="btn btn-outline-secondary">ফিরে যান</a></div><div class="card"><div class="card-body"><form method="post" action="/procurement" class="row g-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"/><div class="col-md-6"><label class="form-label">অনুরোধের শিরোনাম</label><input name="title" class="form-control" required/></div><div class="col-md-3"><label class="form-label">অনুরোধের তারিখ</label><input type="date" name="request_date" value="<%= new Date().toISOString().slice(0,10) %>" class="form-control" required/></div><div class="col-md-3"><label class="form-label">প্রয়োজনের তারিখ</label><input type="date" name="needed_by" class="form-control"/></div><div class="col-md-4"><label class="form-label">অগ্রাধিকার</label><select name="priority" class="form-select"><option value="normal">স্বাভাবিক</option><option value="high">উচ্চ</option><option value="critical">জরুরি</option><option value="low">কম</option></select></div><div class="col-md-8"><label class="form-label">রক্ষণাবেক্ষণ কাজের সাথে সম্পর্ক</label><select name="maintenance_work_order_id" class="form-select"><option value="">প্রযোজ্য নয়</option><% workOrders.forEach(function(w){ %><option value="<%= w.id %>"><%= w.work_order_no %> — <%= w.title %></option><% }) %></select></div><div class="col-12"><label class="form-label">কেন প্রয়োজন</label><textarea name="justification" rows="3" class="form-control" required></textarea></div><div class="col-12"><div class="d-flex justify-content-between align-items-center mb-2"><h6 class="mb-0">ক্রয়ের আইটেম</h6><button type="button" class="btn btn-sm btn-outline-primary" id="addPurchaseItem">আরও আইটেম</button></div><div id="purchaseItems"><div class="row g-2 purchase-item mb-2"><div class="col-md-3"><input name="item_name[]" class="form-control" placeholder="আইটেমের নাম" required/></div><div class="col-md-3"><input name="specification[]" class="form-control" placeholder="বিবরণ/মান"/></div><div class="col-md-2"><input type="number" min="0.01" step="0.01" name="quantity[]" class="form-control" placeholder="পরিমাণ" required/></div><div class="col-md-2"><input name="unit[]" class="form-control" placeholder="একক" required/></div><div class="col-md-2"><input type="number" min="0" step="0.01" name="estimated_unit_cost[]" class="form-control" placeholder="আনুমানিক দর"/></div></div></div></div><div class="col-12"><button class="btn btn-primary">খসড়া তৈরি করুন</button></div></form></div></div><script>document.addEventListener('DOMContentLoaded',function(){var host=document.getElementById('purchaseItems');document.getElementById('addPurchaseItem').addEventListener('click',function(){var row=host.firstElementChild.cloneNode(true);row.querySelectorAll('input').forEach(function(i){i.value='';});host.appendChild(row);});});</script>
