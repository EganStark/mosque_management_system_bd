{
  "name": "mosque-management-system",
  "version": "1.0.0",
  "description": "Bilingual mosque management system with a public website and comprehensive administration dashboard",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "seed": "knex seed:run",
    "db:setup": "node scripts/create-db.js",
    "test": "cross-env NODE_ENV=test jest --runInBand --forceExit",
    "test:db": "node scripts/ensure-test-db.js",
    "release:check-env": "node scripts/check-production-env.js",
    "release:preflight": "node scripts/production-preflight.js",
    "backup:database": "node scripts/scheduled-database-backup.js"
  },
  "keywords": [
    "mosque-management",
    "admin-dashboard",
    "express",
    "postgres"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20 <23"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "bcryptjs": "^3.0.3",
    "connect-flash": "^0.1.1",
    "connect-pg-simple": "^9.0.1",
    "cookie-parser": "^1.4.6",
    "csrf-csrf": "^3.0.6",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "knex": "^3.1.0",
    "multer": "^2.1.1",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  }
}
